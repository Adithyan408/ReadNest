<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Blogs | ReadNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>

  <body class="bg-gray-100">
    <!-- ================= BLOG SIDEBAR ================= -->
    <aside
      class="fixed top-[140px] left-0 w-60 h-[calc(100vh-140px)] bg-white/80 backdrop-blur border-r border-gray-100 px-6 py-8 z-30"
    >
      <h3
        class="text-xs font-semibold text-gray-400 uppercase mb-6 tracking-wider"
      >
        Explore
      </h3>

      <nav class="space-y-1">
        <a href="/" class="sidebar-link">
          <i class="fa-solid fa-house"></i>
          Home
        </a>

        <a href="/library" class="sidebar-link">
          <i class="fa-solid fa-book"></i>
          Library
        </a>

        <a href="/blogs" class="sidebar-link active">
          <i class="fa-solid fa-pen-nib"></i>
          Stories
        </a>

        <a href="/blog/stats" class="sidebar-link">
          <i class="fa-solid fa-chart-line"></i>
          Insights
        </a>

        <a href="/profile" class="sidebar-link">
          <i class="fa-solid fa-user"></i>
          Profile
        </a>
      </nav>

      <!-- Divider -->
      <div class="my-8 border-t border-gray-100"></div>

      <!-- Footer note -->
      <p class="text-xs text-gray-400 leading-relaxed">
        ReadNest Stories — thoughts, ideas & experiences from readers like you.
      </p>
    </aside>

    <style>
      .sidebar-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 12px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 500;
        color: #374151;
        transition: all 0.25s ease;
      }

      .sidebar-link:hover {
        background: #f9fafb;
        color: #111827;
        transform: translateX(2px);
      }

      .sidebar-link.active {
        background: #111827;
        color: #ffffff;
      }

      .sidebar-link i {
        width: 18px;
        text-align: center;
      }
    </style>

    <script>
      const links = document.querySelectorAll(".sidebar-link");
      const currentPath = window.location.pathname;

      links.forEach((link) => {
        const href = link.getAttribute("href");
        if (currentPath === href || currentPath.startsWith(href + "/")) {
          link.classList.add("active");
        }
      });
    </script>
  </body>
</html>
