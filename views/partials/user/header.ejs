<header class="bg-gray-300 shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-3">

    <!-- TOP ROW -->
    <div class="flex items-center justify-between gap-2 lg:gap-6">

      <!-- LOGO -->
      <div class="flex items-center space-x-2 shrink-0">
        <div class="w-10 h-10 lg:w-14 lg:h-14 rounded-full overflow-hidden">
          <a href="/">
            <img src="/images/logo2.png" class="w-full h-full object-cover" />
          </a>
        </div>
        <a href="/" class="text-lg lg:text-xl font-bold text-gray-800">
          ReadNest
        </a>
      </div>

     <!-- DESKTOP SEARCH -->
<div class="hidden md:block flex-1 max-w-md mx-4 lg:mx-8">
  <div class="flex items-center gap-2 relative">
    <div class="relative w-full">
      <input
        type="text"
        id="globalSearchInput"
        placeholder="Search books..."
        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:border-orange-500"
        autocomplete="off"
      />
      <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>

      <div
        id="globalSearchResults"
        class="absolute w-full bg-white border border-gray-200 rounded-lg mt-1 shadow hidden z-50 max-h-60 overflow-y-auto"
      ></div>
    </div>

    <!-- Search Button -->
    <button
      onclick="runGlobalSearch()"
      class="px-4 py-2 bg-[rgb(64_101_239)] text-white rounded-lg font-semibold hover:bg-orange-600 transition"
    >
      Search
    </button>

    <!-- Clear Button -->
    <button
      onclick="clearGlobalSearch()"
      class="px-3 py-2 bg-gray-200 text-gray-600 rounded-lg hover:bg-red-500 hover:text-white transition"
    >
      ✕
    </button>
  </div>
</div>


      <!-- RIGHT ICONS -->
      <div class="flex items-center space-x-3 lg:space-x-6">

        <button
          onclick="openBlog()"
          class="flex items-center p-2 lg:px-4 lg:py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50"
        >
          <i class="fas fa-bars text-gray-700"></i>
          <span class="hidden lg:inline text-sm font-medium text-gray-700 ml-2">
            BLOG
          </span>
        </button>

        <a href="/cart" class="relative flex items-center p-2">
          <i class="fas fa-shopping-cart text-xl lg:text-2xl text-gray-700"></i>
          <% if (cartCount > 0) { %>
            <span
              class="absolute top-0 right-0 bg-red-500 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center"
            >
              <%= cartCount %>
            </span>
          <% } %>
          <span class="hidden lg:inline text-sm font-medium text-gray-700 ml-1">
            Cart
          </span>
        </a>

        <% if (user) { %>
          <a
            href="/account"
            class="flex items-center p-2 lg:px-3 lg:py-2 hover:bg-gray-200 rounded-lg transition"
          >
            <i class="fas fa-user-circle text-xl lg:text-2xl text-gray-700"></i>
            <span class="hidden lg:inline text-sm font-medium text-gray-700 ml-2">
              <%= user.name %>
            </span>
            <i class="hidden lg:inline fas fa-chevron-down text-gray-700 text-xs ml-1"></i>
          </a>
        <% } else { %>
          <a href="/login" class="flex items-center p-2">
            <i class="fas fa-user-circle text-xl lg:text-2xl text-gray-700"></i>
            <span class="hidden lg:inline text-sm font-medium text-gray-700 ml-2">
              Login
            </span>
          </a>
        <% } %>
      </div>
    </div>

 <!-- MOBILE SEARCH -->
<div class="mt-3 md:hidden relative">
  <div class="flex items-center gap-2">
    <div class="relative w-full">
      <input
        type="text"
        id="mobileSearchInput"
        placeholder="Search books, authors..."
        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:border-orange-500 text-sm"
        autocomplete="off"
      />
      <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
    </div>

    <button
      onclick="runMobileSearch()"
      class="px-4 py-2 bg-[rgb(64_101_239)] text-white rounded-lg text-sm font-semibold"
    >
      Search
    </button>

    <button
      onclick="clearMobileSearch()"
      class="px-3 py-2 bg-gray-200 text-gray-600 rounded-lg text-sm"
    >
      ✕
    </button>
  </div>

  <div
    id="mobileSearchResults"
    class="absolute w-full bg-white border border-gray-200 rounded-lg mt-1 shadow hidden z-50 max-h-60 overflow-y-auto"
  ></div>
</div>


  </div>
</header>

<script>
  // Desktop
const globalSearchInput = document.getElementById("globalSearchInput");
const globalResults = document.getElementById("globalSearchResults");

// Mobile
const mobileSearchInput = document.getElementById("mobileSearchInput");
const mobileSearchResults = document.getElementById("mobileSearchResults");

  /* ================= DESKTOP SEARCH ================= */

function runGlobalSearch() {
  const q = globalSearchInput.value.trim();
  if (!q) return clearGlobalSearch();

  fetch(`/live-search?q=${encodeURIComponent(q)}`)
    .then(r => r.json())
    .then(renderResults(globalResults));
}

function clearGlobalSearch() {
  globalSearchInput.value = "";
  globalResults.innerHTML = "";
  globalResults.classList.add("hidden");
}

/* Enter key support */
globalSearchInput?.addEventListener("keydown", (e) => {
  if (e.key === "Enter") runGlobalSearch();
});

/* ================= MOBILE SEARCH ================= */

function runMobileSearch() {
  const q = mobileSearchInput.value.trim();
  if (!q) return clearMobileSearch();

  fetch(`/live-search?q=${encodeURIComponent(q)}`)
    .then(r => r.json())
    .then(renderResults(mobileSearchResults));
}

function clearMobileSearch() {
  mobileSearchInput.value = "";
  mobileSearchResults.innerHTML = "";
  mobileSearchResults.classList.add("hidden");
}

/* Enter key support */
mobileSearchInput?.addEventListener("keydown", (e) => {
  if (e.key === "Enter") runMobileSearch();
});



  /* ================= SHARED RENDER ================= */

  function renderResults(container) {
    return (items) => {
      if (!items.length) {
        container.innerHTML =
          `<p class="p-3 text-gray-500 text-sm">No results found</p>`;
        container.classList.remove("hidden");
        return;
      }

      container.innerHTML = items.map(p => `
        <a href="/product?id=${p._id}" class="block p-3 hover:bg-gray-100 border-b last:border-none">
          <div class="flex items-center gap-3">
            <img src="${p.productImage[0]}" class="w-10 h-14 object-cover rounded">
            <div>
              <p class="font-semibold text-sm">${p.productName}</p>
              <p class="text-xs text-gray-500">${p.author || ""}</p>
            </div>
          </div>
        </a>
      `).join("");

      container.classList.remove("hidden");
    };
  }

  /* ================= CLOSE ON OUTSIDE CLICK ================= */

  document.addEventListener("click", (e) => {
    if (
      !e.target.closest("#globalSearchInput") &&
      !e.target.closest("#globalSearchResults")
    ) {
      globalResults?.classList.add("hidden");
    }

    if (
      !e.target.closest("#mobileSearchInput") &&
      !e.target.closest("#mobileSearchResults")
    ) {
      mobileResults?.classList.add("hidden");
    }
  });

  function openBlog() {
    window.location.href = "/blog";
  }
</script>
