<header class="bg-gray-300 shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-3">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center space-x-2">
        <div class="w-14 h-14 rounded-full overflow-hidden">
          <a href="/">
            <img src="/images/logo2.png" class="w-full h-full object-cover" />
          </a>
        </div>
        <a href="/" class="text-xl font-bold text-gray-800">ReadNest</a>
      </div>

      <!-- Search Bar -->
      <div class="flex-1 max-w-md mx-8">
        <div class="relative w-full">
          <input
            type="text"
            id="globalSearchInput"
            placeholder="Search books, authors..."
            class="w-full pl-10 pr-10 py-2 rounded-lg border border-gray-300 focus:outline-none focus:border-orange-500"
            autocomplete="off"
          />

          <i
            class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"
          ></i>

          <button
            id="globalClearSearch"
            class="hidden absolute right-3 top-2.5 text-gray-500 hover:text-black"
            type="button"
          >
            ✕
          </button>

          <div
            id="globalSearchResults"
            class="absolute w-full bg-white border border-gray-200 rounded-lg mt-1 shadow hidden z-50 max-h-60 overflow-y-auto"
          ></div>
        </div>
      </div>

      <!-- Right Menu -->
      <div class="flex items-center space-x-6">
        <button
        onclick="openBlog()"
          class="flex items-center space-x-2 px-4 py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50"
        >
          <i class="fas fa-bars text-gray-700"></i>
          <span class="text-sm font-medium text-gray-700">BLOG</span>
        </button>

        <a href="/cart" class="relative flex items-center">
          <i class="fas fa-shopping-cart text-2xl text-gray-700"></i>

          <% if (cartCount > 0) { %>
          <span
            class="absolute -top-2 -right-2 bg-red-500 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center"
          >
            <%= cartCount %>
          </span>
          <% } %>

          <span class="text-sm font-medium text-gray-700 ml-1">Cart</span>
        </a>

        <% if (user) { %>
        <a
          href="/account"
          class="flex items-center space-x-2 hover:bg-gray-200 rounded-lg px-3 py-2 transition"
        >
          <i class="fas fa-user-circle text-2xl text-gray-700"></i>
          <span class="text-sm font-medium text-gray-700"
            ><%= user.name %></span
          >
          <i class="fas fa-chevron-down text-gray-700 text-xs"></i>
        </a>
        <% } else { %>
        <a href="/login" class="flex items-center space-x-2">
          <i class="fas fa-user-circle text-2xl text-gray-700"></i>
          <span class="text-sm font-medium text-gray-700">Login</span>
        </a>
        <% } %>
      </div>
    </div>
  </div>
</header>

<script>
  const globalInput = document.getElementById("globalSearchInput");
  const globalClear = document.getElementById("globalClearSearch");
  const globalResults = document.getElementById("globalSearchResults");

  let timer;

  globalInput.addEventListener("input", () => {
    if (document.activeElement !== globalInput) return;

    const q = globalInput.value.trim();
    globalClear.classList.toggle("hidden", q === "");

    clearTimeout(timer);

    timer = setTimeout(() => {
      if (!q) {
        globalResults.innerHTML = "";
        globalResults.classList.add("hidden");
        return;
      }

      fetch(`/live-search?q=${encodeURIComponent(q)}`)
        .then((r) => r.json())
        .then((items) => {
          if (!items.length) {
            globalResults.innerHTML = `<p class="p-3 text-gray-500">No results found</p>`;
            globalResults.classList.remove("hidden");
            return;
          }

          globalResults.innerHTML = items
            .map(
              (p) => `
            <a href="/product?id=${p._id}" class="block p-3 hover:bg-gray-100 border-b last:border-none">
              <div class="flex items-center gap-3">
                <img src="${p.productImage[0]}" class="w-12 h-16 object-cover rounded">
                <div>
                  <p class="font-semibold text-sm">${p.productName}</p>
                  <p class="text-xs text-gray-500">${p.author}</p>
                </div>
              </div>
            </a>
          `
            )
            .join("");

          globalResults.classList.remove("hidden");
        });
    }, 300);
  });

  globalClear.addEventListener("click", () => {
    globalInput.value = "";
    globalResults.innerHTML = "";
    globalResults.classList.add("hidden");
    globalClear.classList.add("hidden");
  });

  document.addEventListener("click", (e) => {
    if (
      !e.target.closest("#globalSearchResults") &&
      !e.target.closest("#globalSearchInput")
    ) {
      globalResults.classList.add("hidden");
    }
  });
  function openBlog() {
    window.location.href = "/blog";
  }
</script>
