<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Categories - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: all 0.3s ease;
      }

      .sidebar-item:hover {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }

      .sidebar-item.active {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }
      html,
      body {
        height: 100%;
        overflow: hidden; /* disable full page scroll */
      }

      .main-scroll-area {
        height: calc(100vh - 80px); /* header height is ~80px */
        overflow-y: auto; /* enable vertical scroll only on the right */
        overflow-x: hidden;
      }
    </style>
  </head>
  <body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <!-- Logo -->
        <a href="/admin">
          <div class="flex items-center space-x-3">
            <div
              class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div>
        </a>

        <!-- Right Side -->
        <div class="flex items-center space-x-6">
          <a href="/admin/blogs">
            <button
              class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition"
            >
              <i class="fas fa-blog text-gray-700"></i>
              <span class="text-base font-semibold text-gray-900">Blog</span>
            </button>
          </a>

          <div class="flex items-center space-x-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="text-base font-semibold text-gray-600">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="flex">
      <!-- Sidebar -->
      <aside
        class="w-80 bg-gray-300 h-[calc(100vh-80px)] border-r border-gray-400 flex flex-col"
      >
        <nav class="flex-1 overflow-y-auto py-4">
          <a
            href="/admin"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th-large text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">DashBoard</span>
          </a>

          <a
            href="/admin/products"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-box text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Products</span>
          </a>

          <a
            href="/admin/orders"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-shopping-bag text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Orders List</span>
          </a>

          <a
            href="/admin/users"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-users text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Customers</span>
          </a>

        

          <a
            href="/admin/category"
            class="sidebar-item active flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Category</span>
          </a>

          <a
            href="/admin/coupon"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-ticket-alt text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Voucher</span>
          </a>

          <a
            href="/admin/banner"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-image text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Banner</span>
          </a>
        </nav>

        <!-- Logout Button at Bottom -->

        <div class="border-t-2 border-gray-400 bg-gray-300">
          <a href="/admin/logout">
            <button
              class="w-full flex items-center px-6 py-5 hover:bg-red-50 transition-colors group"
            >
              <i
                class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"
              ></i>
              <span
                class="text-lg font-semibold text-gray-900 group-hover:text-red-600"
                >Log Out</span
              >
            </button>
          </a>
        </div>
      </aside>

      <!-- Main Content - Categories -->
      <main class="main-scroll-area flex-1 p-8 bg-gray-200 overflow-y-auto">
        <%- include('../../views/partials/breadcrumb') %>
        <div class="bg-white rounded-2xl shadow-md border border-gray-200">
          <!-- Header Section -->
          <div class="p-6 border-b border-gray-200">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-2xl font-bold text-gray-900">Categories</h2>
              <a href="/admin/category/addCategory">
                <button
                  class="px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition"
                >
                  ADD Category
                </button></a
              >
            </div>
            <div class="relative max-w-md">
              <input
                type="text"
                id="categorySearch"
                placeholder="Search Category"
                value="<%= search || '' %>"
                class="w-full px-4 py-3 pl-10 pr-10 bg-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 border border-gray-300"
              />

              <!-- Search Icon -->
              <i class="fas fa-search absolute left-3 top-4 text-gray-400"></i>

              <!-- Clear Button -->
              <button
                id="clearSearchBtn"
                class="absolute right-3 top-3 text-gray-500 hover:text-black text-lg <%= search ? '' : 'hidden' %>"
                type="button"
              >
                ✕
              </button>
            </div>
          </div>
          <div
            id="statusMessage"
            class="hidden text-center py-3 font-semibold rounded-md mb-4"
          ></div>

          <!-- Table Section -->
          <div class="overflow-x-auto">
            <div class="overflow-x-auto">
              <table class="w-full border-collapse">
                <thead>
                  <tr class="bg-black text-white">
                    <th class="px-6 py-4 text-left font-semibold border">SL</th>
                    <th class="px-6 py-4 text-left font-semibold border">
                      Category Name
                    </th>
                    <th class="px-6 py-4 text-left font-semibold border">
                      List/Unlist
                    </th>
                    <th class="px-6 py-4 text-center font-semibold border">
                      Action
                    </th>
                  </tr>
                </thead>

                <tbody id="categoryTableBody">
                  <% if (data.length === 0) { %>
                  <tr>
                    <td
                      colspan="4"
                      class="text-center py-10 text-gray-500 text-lg border"
                    >
                      <i
                        class="fas fa-search-minus text-3xl mb-3 text-gray-400"
                      ></i>
                      <div>No matching results found.</div>
                    </td>
                  </tr>
                  <% } else { %> <% for (let i = 0; i < data.length; i++) { %>
                  <tr class="border-b hover:bg-gray-50">
                    <td class="px-6 py-4 border">
                      <%= i + 1 + ((currentPage - 1) * limit) %>
                    </td>

                    <td class="px-6 py-4 border font-medium">
                      <%= data[i].categoryName %>
                    </td>

                    <td class="px-6 py-4 border">
                      <% if (data[i].isListed) { %>
                      <a
                        href="/admin/unlistCategory?id=<%= data[i]._id %>&page=<%= currentPage %>&search=<%= search %>"
                        class="inline-block px-6 py-1 rounded-full text-sm font-semibold bg-red-200 text-red-800 hover:bg-red-300"
                      >
                        UNLIST
                      </a>
                      <% } else { %>
                      <a
                        href="/admin/listCategory?id=<%= data[i]._id %>&page=<%= currentPage %>&search=<%= search %>"
                        class="inline-block px-6 py-1 rounded-full text-sm font-semibold bg-green-200 text-green-800 hover:bg-green-300"
                      >
                        LIST
                      </a>
                      <% } %>
                    </td>

                    <td class="px-6 py-4 border text-center">
                      <div class="flex justify-center items-center space-x-4">
                        <a href="/admin/editCategory?id=<%= data[i]._id %>">
                          <i
                            class="fas fa-edit text-lg hover:text-yellow-500"
                          ></i>
                        </a>
                        <button
                          onclick="confirmDelete('<%= data[i]._id %>')"
                          class="hover:text-red-600"
                        >
                          <i class="fas fa-trash-alt text-lg"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% } %> <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pagination -->
          <div
            class="flex justify-end items-center gap-2 p-6 border-t border-gray-200"
          >
            <nav aria-label="Page navigation">
              <ul class="flex items-center gap-2">
                <% for(let i = 1; i <= totalPages; i++) { %>
                <li>
                  <a
                    class="px-4 py-2 border border-gray-300 rounded-lg font-medium text-gray-700 transition <%= (i === currentPage) ? 'bg-indigo-600 text-white border-indigo-600 hover:bg-indigo-700' : 'bg-white hover:bg-gray-100' %>"
                    href="?page=<%= i %>"
                  >
                    <%= i %>
                  </a>
                </li>
                <% } %>
              </ul>
            </nav>
          </div>
        </div>
      </main>
    </div>
  </body>
  <script>
    function confirmDelete(categoryId) {
      Swal.fire({
        title: "Are you sure?",
        text: "This action cannot be undone!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#e3342f",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Yes, delete it!",
        cancelButtonText: "Cancel",
        reverseButtons: true,
      }).then((result) => {
        if (result.isConfirmed) {
          // Redirect to delete route
          window.location.href = `/admin/deleteCategory?id=${categoryId}`;
        }
      });
    }

    const searchInput = document.getElementById("categorySearch");
    const clearBtn = document.getElementById("clearSearchBtn");

    // Trigger search when typing
    searchInput.addEventListener("input", function () {
      const search = searchInput.value.trim();
      const params = new URLSearchParams(window.location.search);

      if (search) {
        params.set("search", search);
        clearBtn.classList.remove("hidden");
      } else {
        params.delete("search");
        clearBtn.classList.add("hidden");
      }

      params.set("page", 1);
      window.location.href = `/admin/category?${params.toString()}`;
    });

    // Clear search
    clearBtn.addEventListener("click", () => {
      searchInput.value = "";
      clearBtn.classList.add("hidden");

      const params = new URLSearchParams(window.location.search);
      params.delete("search");
      params.set("page", 1);

      window.location.href = `/admin/category?${params.toString()}`;
    });

    const urlParams = new URLSearchParams(window.location.search);
    const status = urlParams.get("status");
    const messageBox = document.getElementById("statusMessage");

    if (status) {
      let messageText = "";
      let bgColor = "";

      if (status === "added") {
        messageText = " Category added successfully!";
        bgColor = "bg-green-100 text-green-800 border border-green-300";
      } else if (status === "deleted") {
        messageText = " Category deleted successfully!";
        bgColor = "bg-red-100 text-red-800 border border-red-300";
      } else if (status === "error") {
        messageText = " Something went wrong. Please try again.";
        bgColor = "bg-yellow-100 text-yellow-800 border border-yellow-300";
      } else if (status === "updated") {
        messageText = " Category updated successfully!";
        bgColor = "bg-blue-100 text-blue-800 border border-blue-300";
      }

      messageBox.textContent = messageText;
      messageBox.className = `${bgColor} text-center py-3 font-semibold rounded-md mb-4 transition-all duration-500`;

      messageBox.classList.remove("hidden");

      setTimeout(() => {
        messageBox.classList.add("hidden");
      }, 5000);

      const newUrl = window.location.origin + window.location.pathname;
      window.history.replaceState({}, document.title, newUrl);
    }
  </script>
</html>
