<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Category | ReadNest Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/admin/css/editCategory.css">
</head>

<body class="bg-gray-100 min-h-screen lg:overflow-hidden">

    <header class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-600 focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
            <a href="/admin" class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-book-open text-white text-xl"></i>
                </div>
                <span class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase">ReadNest</span>
            </a>
        </div>

        <div class="flex items-center space-x-3 sm:space-x-6">
            <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100">
                <i class="fas fa-user-shield text-indigo-600"></i>
                <span class="text-xs font-black text-gray-700 uppercase tracking-widest">Admin</span>
            </div>
        </div>
    </header>

    <div class="flex">
        <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none">
            <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
                <a href="/admin" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-box w-8 text-lg"></i> Products</a>
                <a href="/admin/orders" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a>
                <a href="/admin/users" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-users w-8 text-lg"></i> Customers</a>
                <a href="/admin/category" class="sidebar-item active flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-th w-8 text-lg"></i> Category</a>
                <a href="/admin/coupon" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a>
                <a href="/admin/blogs" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-blog w-8 text-lg"></i> Blogs</a>
                <a href="/admin/banner" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-image w-8 text-lg"></i> Banner</a>
                <a href="/admin/logout" class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a>
            </nav>
        </aside>

        <main class="main-content flex-1 p-4 sm:p-8 lg:p-12 no-scrollbar bg-gray-50 w-full">
            <div class="max-w-4xl mx-auto">
                <div class="mb-6"><%- include('../../views/partials/breadCrumb') %></div>

                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
                    <div class="flex items-center gap-4">
                        <a href="/admin/category" class="w-10 h-10 flex items-center justify-center bg-white rounded-full text-gray-400 shadow-sm hover:text-gray-900 transition"><i class="fas fa-arrow-left"></i></a>
                        <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight uppercase leading-tight">Edit Category</h1>
                    </div>
                    <button onclick="confirmDelete('<%= category._id %>')" 
                            class="w-full sm:w-auto bg-rose-50 text-rose-500 border-2 border-rose-100 px-8 py-3.5 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-rose-500 hover:text-white transition active:scale-95">
                        <i class="fas fa-trash-alt mr-2"></i> Delete Forever
                    </button>
                </div>

                <div class="bg-white rounded-[2.5rem] shadow-xl shadow-indigo-900/5 p-6 sm:p-10 border border-white">
                    <form id="categoryForm" action="/admin/editCategory?id=<%= category._id %>" method="POST" class="space-y-10">
                        
                        <div>
                            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Identity</label>
                            <input type="text" id="categoryName" name="categoryName"
                            value="<%= category.categoryName %>"
                            class="w-full px-6 py-5 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 focus:bg-white outline-none transition-all font-bold text-gray-800 text-lg" />

                        <p id="err-categoryName"
                         class="text-rose-500 text-[11px] font-bold mt-2 hidden uppercase">
                        </p>
                        </div>

                        <div class="bg-indigo-50/30 rounded-[2rem] p-6 sm:p-10 border border-indigo-100">
                            <div class="flex items-center gap-3 mb-8">
                                <i class="fas fa-tag text-indigo-600"></i>
                                <h3 class="text-xs font-black text-indigo-900 uppercase tracking-widest">Pricing Strategy</h3>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                <div class="md:col-span-2">
                                    <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-2 block">Activation Status</label>
                                    <select name="isOffer" class="w-full px-6 py-4 bg-white border-2 border-gray-100 rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500 transition-all">
                                        <option value="false" <%= (!category.offer || category.offer.isOffer === false) ? "selected" : "" %>>Inactive (No Offer)</option>
                                        <option value="true"  <%= (category.offer && category.offer.isOffer === true) ? "selected" : "" %>>Active (Enable Discount)</option>
                                    </select>
                                </div>

                                <div class="md:col-span-2">
                                    <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-2 block">Discount Value (%)</label>
                                    <input type="number" name="discountValue"
                                    value="<%= category.offer ? category.offer.discountValue : '' %>"
                                    class="w-full px-6 py-4 bg-white border-2 border-gray-100 rounded-2xl font-black text-gray-800 outline-none focus:border-indigo-500 transition-all" />

                                <p id="err-discountValue"
                                class="text-rose-500 text-[11px] font-bold mt-2 hidden uppercase">
                                </p>
                                </div>

                                <div>
                                    <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-2 block">Start Date</label>
                                    <input type="date" name="startDate"
                                    value="<%= category.offer && category.offer.startDate
                                        ? (typeof category.offer.startDate === 'string'
                                        ? category.offer.startDate
                                        : category.offer.startDate.toISOString().split('T')[0])
                                        : '' %>"
                                    class="w-full px-6 py-4 bg-white border-2 border-gray-100 rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500 transition-all" />

                                <p id="err-startDate"
                                class="text-rose-500 text-[11px] font-bold mt-2 hidden uppercase">
                                </p>
                                 </div>

                                <div>
                                    <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-2 block">Expiry Date</label>
                                   <input type="date" name="endDate"
                                    value="<%= category.offer && category.offer.endDate
                                        ? (typeof category.offer.endDate === 'string'
                                        ? category.offer.endDate
                                        : category.offer.endDate.toISOString().split('T')[0])
                                        : '' %>"
                                    class="w-full px-6 py-4 bg-white border-2 border-gray-100 rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500 transition-all" />

                                <p id="err-endDate"
                                class="text-rose-500 text-[11px] font-bold mt-2 hidden uppercase">
                                </p>
                                 </div>
                            </div>
                        </div>

                        <div class="pt-6 border-t border-gray-50 flex flex-col sm:flex-row gap-4">
                            <button type="submit" class="flex-1 bg-indigo-600 text-white py-5 rounded-2xl font-black text-sm uppercase tracking-[0.2em] shadow-xl shadow-indigo-100 hover:bg-indigo-700 transition active:scale-[0.98]">
                                Update Configuration
                            </button>
                            <button type="button" onclick="window.location.href='/admin/category'" 
                                    class="px-10 py-5 bg-gray-100 text-gray-500 rounded-2xl font-bold text-sm uppercase tracking-widest hover:bg-gray-200 transition">
                                Discard
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

   <script src="/admin/js/editCategory.js"></script>
</body>
</html>