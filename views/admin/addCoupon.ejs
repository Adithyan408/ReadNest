<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Voucher | ReadNest Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");
        * { font-family: "Poppins", sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        
        .sidebar-item.active { background: #f3f4f6; border-right: 4px solid #4f46e5; color: #4f46e5; }
        #sidebar { transition: transform 0.3s ease-in-out; z-index: 60; }
        
        @media (min-width: 1024px) {
            .main-content { height: calc(100vh - 80px); overflow-y: auto; }
        }
    </style>
</head>

<body class="bg-gray-100 min-h-screen lg:overflow-hidden">

    <header class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-600 focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
            <a href="/admin" class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-book-open text-white text-xl"></i>
                </div>
                <span class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase">ReadNest</span>
            </a>
        </div>

        <div class="flex items-center space-x-3 sm:space-x-6">
            <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100">
                <i class="fas fa-ticket-alt text-indigo-600"></i>
                <span class="text-xs font-black text-gray-700 uppercase tracking-widest">Coupons</span>
            </div>
        </div>
    </header>

    <div class="flex">
       <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none">
            <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
                <a href="/admin" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-box w-8 text-lg"></i> Products</a>
                <a href="/admin/orders" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a>
                <a href="/admin/users" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-users w-8 text-lg"></i> Customers</a>
                <a href="/admin/category" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-th w-8 text-lg"></i> Category</a>
                <a href="/admin/coupon" class="sidebar-item active flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a>
                <a href="/admin/blogs" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-blog w-8 text-lg"></i> Blogs</a>
                <a href="/admin/banner" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-image w-8 text-lg"></i> Banner</a>
                <a href="/admin/logout" class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a>
            </nav>
        </aside>

        <main class="main-content flex-1 p-4 sm:p-8 lg:p-12 no-scrollbar bg-gray-50 w-full">
            <div class="max-w-4xl mx-auto">
                
                <div class="mb-6"><%- include('../../views/partials/breadCrumb') %></div>

                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center gap-4">
                        <a href="/admin/coupon" class="w-10 h-10 flex items-center justify-center bg-white rounded-full text-gray-400 shadow-sm hover:text-gray-900 transition"><i class="fas fa-arrow-left"></i></a>
                        <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight uppercase">Create Coupon</h1>
                    </div>
                </div>

                <div class="bg-white rounded-[2.5rem] shadow-xl shadow-indigo-900/5 border border-white overflow-hidden">
                    <form id="couponForm" action="/admin/coupon/addCoupon" method="POST" class="p-6 sm:p-10 space-y-8">
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div>
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Voucher Code</label>
                                <input type="text" name="code" placeholder="e.g. READNEST50" 
                                       class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 focus:bg-white outline-none transition-all font-bold text-gray-800 uppercase" />
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Discount Percentage (%)</label>
                                <input type="number" name="discount" placeholder="0" min="1" max="90"
                                       class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 focus:bg-white outline-none transition-all font-bold text-gray-800" />
                            </div>
                        </div>

                        <div class="bg-indigo-50/30 rounded-[2rem] p-6 sm:p-8 border border-indigo-100">
                            <div class="flex items-center gap-3 mb-6">
                                <i class="fas fa-sliders-h text-indigo-600"></i>
                                <h3 class="text-xs font-black text-indigo-900 uppercase tracking-widest">Redemption Rules</h3>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-2 block">Minimum Purchase (₹)</label>
                                    <input type="number" name="minPurchase" placeholder="0" min="0"
                                           class="w-full px-5 py-3.5 bg-white border border-gray-200 rounded-xl font-bold text-gray-800 focus:ring-2 focus:ring-indigo-500 outline-none" />
                                </div>
                                <div>
                                    <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-2 block">Max Discount Cap (₹)</label>
                                    <input type="number" name="maxDiscount" placeholder="No limit" min="0"
                                           class="w-full px-5 py-3.5 bg-white border border-gray-200 rounded-xl font-bold text-gray-800 focus:ring-2 focus:ring-indigo-500 outline-none" />
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div>
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Activation Date</label>
                                <input type="date" name="start" 
                                       class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500 transition-all" />
                            </div>
                            <div>
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Expiry Date</label>
                                <input type="date" name="expiry" 
                                       class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500 transition-all" />
                            </div>
                        </div>

                        <div class="pt-6 border-t border-gray-50">
                            <button type="submit" class="w-full bg-indigo-600 text-white py-5 rounded-2xl font-black text-sm uppercase tracking-[0.2em] shadow-xl shadow-indigo-100 hover:bg-indigo-700 transition active:scale-[0.98]">
                                Generate Coupon
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('-translate-x-full');
        }

        document.getElementById("couponForm").addEventListener("submit", function (e) {
            e.preventDefault();

            const form = e.target;
            const code = form.code.value.trim();
            const discount = form.discount.value;
            const minPurchase = form.minPurchase.value;
            const maxDiscount = form.maxDiscount.value;
            const expiry = form.expiry.value;
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            if (!code || !/^[A-Z0-9]{3,20}$/.test(code)) {
                return Swal.fire("Error", "Valid code required (3-20 uppercase/numbers)", "warning");
            }
            if (!discount || discount < 1 || discount > 90) {
                return Swal.fire("Error", "Discount must be between 1% and 90%", "warning");
            }
            if (!maxDiscount || maxDiscount < 0) {
                return Swal.fire("Error", "Please set a valid Maximum Discount cap", "warning");
            }
            if (!expiry || new Date(expiry) <= today) {
                return Swal.fire("Error", "Expiry must be a future date", "warning");
            }

            form.submit();
        });
    </script>
</body>
</html>