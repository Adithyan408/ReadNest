<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update Banner - ReadNest</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


  <!-- Cropper -->
  <link rel="stylesheet" href="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.css" />
  <script src="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.js"></script>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");
    * { font-family: "Poppins", sans-serif; }

    .sidebar-item { transition: .3s ease; }
    .sidebar-item:hover, .sidebar-item.active { background: #d1d5db; }

    .upload-area {
      border: 2px dashed #cbd5e0;
      transition: .3s ease;
    }
    .upload-area:hover {
      background:#f7fafc;
      border-color:#667eea;
    }
                  html, body {
    height: 100%;
    overflow: hidden;  /* disable full page scroll */
  }

  .main-scroll-area {
    height: calc(100vh - 80px); /* header height is ~80px */
    overflow-y: auto;           /* enable vertical scroll only on the right */
    overflow-x: hidden;
  }
  </style>
</head>

<body class="bg-gray-100">

  <!-- HEADER -->
  <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
    <div class="flex items-center justify-between px-6 py-4">

      <a href="/admin">
        <div class="flex items-center space-x-3">
          <div class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center">
            <i class="fas fa-book-open text-white text-2xl"></i>
          </div>
          <span class="text-2xl font-bold text-gray-800">ReadNest</span>
        </div>
      </a>

      <div class="flex items-center space-x-6">

       <a href="/admin/blogs">
        <button
          class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition"
        >
        <i class="fas fa-blog text-gray-700"></i>
        <span class="text-base font-semibold text-gray-900">Blog</span>
        </button>
      </a>

        <div class="flex items-center space-x-3">
          <i class="fas fa-user-circle text-4xl text-gray-600"></i>
          <span class="font-semibold text-gray-700">ADMIN</span>
        </div>

      </div>

    </div>
  </header>

  <div class="flex">

    <!-- SIDEBAR -->
    <aside class="w-80 bg-gray-300 h-[calc(100vh-80px)] border-r border-gray-400 flex flex-col">
      <nav class="flex-1 overflow-y-auto py-4">

        <a href="/admin" class="sidebar-item flex px-6 py-4 border-b border-gray-400">
          <i class="fas fa-th-large text-xl mr-4"></i>
          <span class="text-lg font-semibold text-gray-900">Dashboard</span>
        </a>

        <a href="/admin/products" class="sidebar-item flex px-6 py-4 border-b border-gray-400">
          <i class="fas fa-box text-xl mr-4"></i>
          <span class="text-lg font-semibold text-gray-900">Products</span>
        </a>

        <a href="/admin/orders" class="sidebar-item flex px-6 py-4 border-b border-gray-400">
          <i class="fas fa-shopping-bag text-xl mr-4"></i>
          <span class="text-lg font-semibold text-gray-900">Orders</span>
        </a>

        <a href="/admin/users" class="sidebar-item flex px-6 py-4 border-b border-gray-400">
          <i class="fas fa-users text-xl mr-4"></i>
          <span class="text-lg font-semibold text-gray-900">Customers</span>
        </a>

        <a href="/admin/sales" class="sidebar-item flex px-6 py-4 border-b border-gray-400">
          <i class="fas fa-chart-line text-xl mr-4"></i>
          <span class="text-lg font-semibold text-gray-900">Sales</span>
        </a>

        <a href="/admin/category" class="sidebar-item flex px-6 py-4 border-b border-gray-400">
          <i class="fas fa-th text-xl mr-4"></i>
          <span class="text-lg font-semibold text-gray-900">Category</span>
        </a>

        <a href="/admin/coupon" class="sidebar-item flex px-6 py-4 border-b border-gray-400">
          <i class="fas fa-ticket-alt text-xl mr-4"></i>
          <span class="text-lg font-semibold text-gray-900">Voucher</span>
        </a>

        <a href="/admin/banner" class="sidebar-item active flex px-6 py-4 border-b border-gray-400">
          <i class="fas fa-image text-xl mr-4"></i>
          <span class="text-lg font-semibold text-gray-900">Banner</span>
        </a>

      </nav>

      <!-- Logout fixed bottom -->
      <div class="border-t-2 border-gray-400 bg-gray-300">
        <a href="/admin/logout">
          <button class="w-full flex items-center px-6 py-5 hover:bg-red-50 group">
            <i class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"></i>
            <span class="text-lg font-semibold text-gray-900 group-hover:text-red-600">LOG OUT</span>
          </button>
        </a>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-scroll-area flex-1 p-8 bg-gray-200 overflow-y-auto">

      <%- include('../../views/partials/breadcrumb') %>

      <div class="max-w-6xl mx-auto">

        <!-- Page Title -->
        <div class="flex items-center mb-6">
          <a href="/admin/banner" class="mr-4">
            <i class="fas fa-chevron-left text-2xl text-gray-700 hover:text-gray-900"></i>
          </a>
          <h2 class="text-3xl font-bold text-gray-900">Update Banner</h2>
        </div>

        <!-- CARD -->
        <div class="bg-white rounded-2xl p-10 shadow-xl">

          <form action="/admin/banner/updateBanner?id=<%= data._id %>" method="POST" enctype="multipart/form-data">

            <input type="hidden" name="existingImage" value="<%= data.bannerImage %>"/>

            <div class="space-y-8">

              <!-- TITLE -->
              <input 
                type="text" 
                name="title" 
                value="<%= data.title %>"
                placeholder="Banner Title"
                class="w-full px-5 py-4 bg-gray-50 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500"
                required
              />

              <!-- IMAGE UPLOAD -->
              <div class="bg-gray-100 rounded-xl p-8">
                <div class="upload-area rounded-xl p-10 text-center">

                  <p class="text-gray-600 mb-4 font-medium">Current Image</p>

                  <div id="bannerPreview" class="mb-6">
                    <img 
                      src="<%= data.bannerImage %>" 
                      class="rounded-xl shadow-lg max-h-56 object-cover"
                    />
                  </div>

                  <input 
                    type="file"
                    id="bannerImage"
                    name="bannerImage"
                    accept="image/*"
                    class="hidden"
                    onchange="startBannerCrop(event)"
                  />

                  <button type="button"
                    onclick="document.getElementById('bannerImage').click()"
                    class="px-8 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
                    Change Image
                  </button>

                </div>
              </div>

              <!-- STATUS + DATES -->
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <select name="status"
                  class="px-5 py-4 bg-gray-50 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500"
                >
                  <option value="ACTIVE" <%= data.status === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                  <option value="INACTIVE" <%= data.status === 'INACTIVE' ? 'selected' : '' %>>INACTIVE</option>
                </select>

                <input type="date" name="startDate"
                  value="<%= data.startDate %>"
                  class="px-5 py-4 bg-gray-50 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500"
                />

                <input type="date" name="endDate"
                  value="<%= data.endDate %>"
                  class="px-5 py-4 bg-gray-50 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500"
                  required
                />

              </div>

              <!-- BUTTONS -->
              <div class="flex justify-center gap-4 pt-6">

                <button type="button"
                  onclick="window.location.href='/admin/banner'"
                  class="px-16 py-4 bg-gray-500 text-white rounded-lg hover:bg-gray-600">
                  CANCEL
                </button>

                <button type="button"
                  onclick="confirmDelete('<%= data._id %>')"
                  class="px-16 py-4 bg-red-600 text-white rounded-lg hover:bg-red-700">
                  DELETE
                </button>

                <button type="submit"
                  class="px-16 py-4 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                  UPDATE
                </button>

              </div>

            </div>

          </form>

        </div>

      </div>

    </main>
  </div>

  <!-- CROP MODAL -->
  <div id="cropperModal"
    class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm hidden justify-center items-center z-50">

    <div class="bg-white rounded-xl shadow-2xl p-4 w-[95%] max-w-xl animate-fadeIn">

      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-semibold text-gray-800">Crop Banner</h2>
        <button onclick="closeBannerCrop()" class="text-gray-600 hover:text-gray-900 text-xl">✕</button>
      </div>

      <div class="h-[60vh] overflow-hidden flex items-center justify-center bg-gray-100 rounded-lg border">
        <img id="cropperImage" class="max-w-full max-h-full select-none" />
      </div>

      <div class="flex justify-end gap-3 mt-5">
        <button onclick="closeBannerCrop()"
          class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-200">
          Cancel
        </button>

        <button onclick="applyBannerCrop()"
          class="px-5 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">
          Crop & Apply
        </button>
      </div>

    </div>

  </div>

  <!-- CROP LOGIC -->
  <script>
    let cropper = null;

    const bannerInput = document.getElementById("bannerImage");
    const modal = document.getElementById("cropperModal");
    const cropImg = document.getElementById("cropperImage");
    const preview = document.getElementById("bannerPreview");

    window.startBannerCrop = function(event) {
      const file = event.target.files[0];
      if (!file) return;

      cropImg.src = URL.createObjectURL(file);
      modal.classList.remove("hidden");

      cropImg.onload = () => {
        if (cropper) cropper.destroy();

        cropper = new Cropper(cropImg, {
          aspectRatio: NaN,
          viewMode: 1,
          autoCropArea: 1,
          movable: true,
          zoomable: true,
          cropBoxResizable: true,
          cropBoxMovable: true
        });
      };
    };

    window.closeBannerCrop = function() {
      modal.classList.add("hidden");
      if (cropper) cropper.destroy();
      cropper = null;
      bannerInput.value = "";
    };

    window.applyBannerCrop = function() {
      if (!cropper) return;

      const canvas = cropper.getCroppedCanvas();

      canvas.toBlob((blob) => {
        const file = new File([blob], "banner_cropped.jpg", { type: "image/jpeg" });

        const dt = new DataTransfer();
        dt.items.add(file);
        bannerInput.files = dt.files;

        preview.innerHTML = `
          <img src="${URL.createObjectURL(blob)}"
            class="rounded-xl shadow-lg max-h-56 object-cover"/>
        `;

        modal.classList.add("hidden");
        cropper.destroy();
        cropper = null;
      }, "image/jpeg", 0.9);
    };

    function confirmDelete(bannerId) {
        Swal.fire({
          title: "Are you sure?",
          text: "This action cannot be undone!",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#d33", 
          cancelButtonColor: "#6b7280", 
          confirmButtonText: "Yes, delete it!",
          cancelButtonText: "Cancel",
          reverseButtons: true,
          focusCancel: true,
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = `/admin/deleteBanner?id=${bannerId}`;
          }
        });
      }
  </script>

</body>
</html>
