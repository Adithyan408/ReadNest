<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Products | ReadNest Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");
        * { font-family: "Poppins", sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .sidebar-item.active { background: #f3f4f6; border-right: 4px solid #4f46e5; color: #4f46e5; }
        #sidebar { transition: transform 0.3s ease-in-out; z-index: 60; }
        @media (min-width: 1024px) {
            .main-content { height: calc(100vh - 80px); overflow-y: auto; }
        }
    </style>
</head>

<body class="bg-gray-100 min-h-screen lg:overflow-hidden">

    <header class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-600 focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
            <a href="/admin" class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-book-open text-white text-xl"></i>
                </div>
                <span class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase">ReadNest</span>
            </a>
        </div>
        <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100">
            <i class="fas fa-user-shield text-indigo-600"></i>
            <span class="text-xs font-black text-gray-700 uppercase tracking-widest">Store Admin</span>
        </div>
    </header>

    <div class="flex">
       <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none">
            <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
                <a href="/admin" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-item active flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-box w-8 text-lg"></i> Products</a>
                <a href="/admin/orders" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a>
                <a href="/admin/users" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-users w-8 text-lg"></i> Customers</a>
                <a href="/admin/category" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-th w-8 text-lg"></i> Category</a>
                <a href="/admin/coupon" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a>
                <a href="/admin/blogs" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600  font-bold text-sm"><i class="fas fa-blog w-8 text-lg"></i> Blogs</a>
                <a href="/admin/banner" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-image w-8 text-lg"></i> Banner</a>
                <a href="/admin/logout" class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a>
            </nav>
        </aside>

        <main class="main-content flex-1 p-4 sm:p-8 lg:p-12 no-scrollbar bg-gray-50 w-full">
            <div class="max-w-7xl mx-auto">
                <div class="mb-6"><%- include('../../views/partials/breadCrumb') %></div>

                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
                    <div>
                        <h1 class="text-2xl sm:text-4xl font-black text-gray-900 tracking-tight uppercase leading-tight">Master Catalog</h1>
                        <p class="text-gray-500 text-sm font-medium mt-1">Manage, update, and monitor store inventory</p>
                    </div>
                    <a href="/admin/products/addProducts" class="w-full sm:w-auto">
                        <button class="w-full bg-indigo-600 text-white px-8 py-4 rounded-2xl font-black text-xs uppercase tracking-widest shadow-xl shadow-indigo-100 hover:bg-indigo-700 transition active:scale-95 flex items-center justify-center gap-2">
                            <i class="fas fa-plus"></i> New Product
                        </button>
                    </a>
                </div>

                <div class="bg-white p-6 rounded-t-[2.5rem] border border-gray-100 flex flex-col lg:flex-row gap-4 items-center justify-between shadow-sm">
                    <div class="flex flex-1 w-full gap-3">
                        <div class="relative flex-1 group">
                            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-300 group-focus-within:text-indigo-500 transition-colors"></i>
                            <input id="productSearch" type="text" value="<%= search || '' %>" placeholder="Search by title..." 
                                   class="w-full pl-12 pr-12 py-3.5 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 focus:bg-white outline-none transition-all font-bold text-sm" />
                            <button id="clearSearchBtn" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-rose-500 transition-colors hidden">
                                <i class="fas fa-times-circle"></i>
                            </button>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                        <select id="categoryFilter" onchange="applyFilters()" class="flex-1 lg:flex-none px-6 py-3.5 bg-gray-50 border-2 border-transparent rounded-2xl font-black text-[10px] uppercase tracking-widest text-gray-600 hover:bg-white hover:border-indigo-100 transition-all outline-none">
                            <option value="">All Categories</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.categoryName %>" <%= category === cat.categoryName ? "selected" : "" %>><%= cat.categoryName %></option>
                            <% }) %>
                        </select>

                        <select id="sortFilter" onchange="applyFilters()" class="flex-1 lg:flex-none px-6 py-3.5 bg-gray-50 border-2 border-transparent rounded-2xl font-black text-[10px] uppercase tracking-widest text-gray-600 hover:bg-white hover:border-indigo-100 transition-all outline-none">
                            <option value="">Sort By</option>
                            <option value="priceAsc" <%= sort === "priceAsc" ? "selected" : "" %>>Price: Low → High</option>
                            <option value="priceDesc" <%= sort === "priceDesc" ? "selected" : "" %>>Price: High → Low</option>
                            <option value="nameAsc" <%= sort === "nameAsc" ? "selected" : "" %>>A → Z</option>
                            <option value="newest" <%= sort === "newest" ? "selected" : "" %>>Newest First</option>
                        </select>
                    </div>
                </div>

                <div class="bg-white rounded-b-[2.5rem] shadow-xl shadow-indigo-900/5 border border-gray-100 overflow-hidden">
                    <div id="statusMessage" class="hidden text-center py-4 text-xs font-black uppercase tracking-[0.2em]"></div>
                    
                    <div class="overflow-x-auto no-scrollbar">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-900 text-white text-[10px] font-black uppercase tracking-widest">
                                    <th class="px-8 py-5">Visual</th>
                                    <th class="px-8 py-5">Product Details</th>
                                    <th class="px-8 py-5 hidden md:table-cell">Inventory</th>
                                    <th class="px-8 py-5">Visibility</th>
                                    <th class="px-8 py-5 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <% if (data.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="py-24 text-center">
                                            <div class="bg-gray-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                                                <i class="fas fa-box-open text-gray-200 text-3xl"></i>
                                            </div>
                                            <p class="text-gray-400 font-black uppercase tracking-widest text-xs">No matching products found</p>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% data.forEach(product => { %>
                                        <tr class="hover:bg-indigo-50/30 transition-colors group">
                                            <td class="px-8 py-6">
                                                <div class="w-14 h-20 rounded-xl overflow-hidden shadow-sm border border-white bg-gray-50">
                                                    <img src="<%= product.productImage[0] %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Book" onerror="this.src='/images/placeholder.png'">
                                                </div>
                                            </td>
                                            <td class="px-8 py-6">
                                                <p class="font-black text-gray-800 tracking-tight leading-tight"><%= product.productName %></p>
                                                <div class="flex items-center gap-2 mt-1">
                                                    <span class="text-[9px] font-black text-indigo-400 uppercase tracking-widest"><%= product.category %></span>
                                                    <span class="text-gray-300">•</span>
                                                    <span class="text-[9px] font-bold text-gray-400 uppercase tracking-widest"><%= product.language %></span>
                                                </div>
                                            </td>
                                            <td class="px-8 py-6 hidden md:table-cell">
                                                <p class="text-sm font-black text-gray-700"><%= product.stock %></p>
                                                <p class="text-[9px] font-bold text-gray-400 uppercase">In Stock</p>
                                            </td>
                                            <td class="px-8 py-6">
                                                <% if (product.isListed) { %>
                                                    <a href="/admin/unlistProduct?id=<%= product._id %>&page=<%= currentPage %>&category=<%= category || '' %>&search=<%= search || '' %>" 
                                                       class="px-5 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-emerald-50 text-emerald-600 border border-emerald-100 hover:bg-rose-500 hover:text-white hover:border-rose-600 transition-all">
                                                       Listed
                                                    </a>
                                                <% } else { %>
                                                    <a href="/admin/listProduct?id=<%= product._id %>&page=<%= currentPage %>&category=<%= category || '' %>&search=<%= search || '' %>" 
                                                       class="px-5 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-rose-50 text-rose-700 border border-rose-100 hover:bg-emerald-500 hover:text-white hover:border-emerald-600 transition-all">
                                                       Hidden
                                                    </a>
                                                <% } %>
                                            </td>
                                            <td class="px-8 py-6 text-right">
                                                <div class="flex justify-end items-center gap-3">
                                                    <a href="/admin/updateProduct?id=<%= product._id %>" class="w-10 h-10 flex items-center justify-center bg-gray-50 text-indigo-600 rounded-xl hover:bg-indigo-600 hover:text-white transition-all shadow-sm">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button onclick="confirmDelete('<%= product._id %>')" class="w-10 h-10 flex items-center justify-center bg-gray-50 text-rose-500 rounded-xl hover:bg-rose-500 hover:text-white transition-all shadow-sm">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% if (totalPages > 1) { %>
                        <div class="flex justify-center sm:justify-end items-center gap-2 p-8 border-t border-gray-50 bg-gray-50/30">
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <a href="?page=<%= i %>&search=<%= search %>&category=<%= category %>" 
                                   class="w-10 h-10 flex items-center justify-center rounded-xl font-black text-xs transition-all <%= currentPage===i ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-white text-gray-400 border border-gray-100 hover:bg-gray-50' %>">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <script>
        function toggleSidebar() { document.getElementById("sidebar").classList.toggle("-translate-x-full"); }

        function applyFilters() {
            const search = document.getElementById("productSearch").value.trim();
            const category = document.getElementById("categoryFilter").value;
            const sort = document.getElementById("sortFilter").value;
            const queryParams = new URLSearchParams();
            if (search) queryParams.set("search", search);
            if (category) queryParams.set("category", category);
            if (sort) queryParams.set("sort", sort);
            queryParams.set("page", 1);
            window.location.href = `/admin/products?${queryParams.toString()}`;
        }

        const searchInput = document.getElementById("productSearch");
        const clearBtn = document.getElementById("clearSearchBtn");
        let typingTimer;

        searchInput.addEventListener("input", () => {
            clearBtn.classList.toggle("hidden", searchInput.value === "");
            clearTimeout(typingTimer);
            typingTimer = setTimeout(applyFilters, 800);
        });

        clearBtn.onclick = () => {
            searchInput.value = "";
            applyFilters();
        };

        function confirmDelete(id) {
            Swal.fire({
                title: "Delete Product?",
                text: "This removal is permanent and cannot be undone.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#f43f5e",
                confirmButtonText: "YES, DELETE",
                customClass: {
                    title: 'font-black uppercase tracking-tight',
                    confirmButton: 'rounded-xl font-bold uppercase py-4 px-8',
                    cancelButton: 'rounded-xl font-bold uppercase py-4 px-8'
                }
            }).then((res) => { if (res.isConfirmed) window.location.href = `/admin/deleteProduct?id=${id}`; });
        }

        // Status Logic
        window.onload = () => {
            const params = new URLSearchParams(window.location.search);
            const status = params.get("status");
            const box = document.getElementById("statusMessage");
            if (status) {
                const config = {
                    added: ["Item Published", "bg-emerald-50 text-emerald-600 border-emerald-100"],
                    deleted: ["Item Deleted", "bg-rose-50 text-rose-600 border-rose-100"],
                    updated: ["Item Updated ", "bg-indigo-50 text-indigo-600 border-indigo-100"]
                };
                if (config[status]) {
                    box.textContent = config[status][0];
                    box.className = `${config[status][1]} border p-4 rounded-2xl mb-6 block text-center`;
                    setTimeout(() => box.style.display = 'none', 4000);
                }
                const cleanUrl = window.location.origin + window.location.pathname;
                window.history.replaceState({}, document.title, cleanUrl);
            }
        };
    </script>
</body>
</html>