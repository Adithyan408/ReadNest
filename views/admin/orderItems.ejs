<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order #<%= order.orderId %> | ReadNest Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/admin/css/orderItems.css">
</head>

<body class="bg-gray-100 min-h-screen lg:overflow-hidden">

    <header class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-600 focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
            <a href="/admin" class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-book-open text-white text-xl"></i>
                </div>
                <span class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase">ReadNest</span>
            </a>
        </div>
        <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100">
            <i class="fas fa-user-shield text-indigo-600"></i>
            <span class="text-xs font-black text-gray-700 uppercase tracking-widest">Order Admin</span>
        </div>
    </header>

    <div class="flex">
       <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none">
            <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
                <a href="/admin" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-box w-8 text-lg"></i> Products</a>
                <a href="/admin/orders" class="sidebar-item active flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a>
                <a href="/admin/users" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-users w-8 text-lg"></i> Customers</a>
                <a href="/admin/category" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-th w-8 text-lg"></i> Category</a>
                <a href="/admin/coupon" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a>
                <a href="/admin/blogs" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-blog w-8 text-lg"></i> Blogs</a>
                <a href="/admin/banner" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-image w-8 text-lg"></i> Banner</a>
                <a href="/admin/logout" class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a>
            </nav>
        </aside>

        <main class="main-content flex-1 p-4 sm:p-8 lg:p-12 no-scrollbar bg-gray-50 w-full">
            <div class="max-w-6xl mx-auto">
                <div class="mb-6"><%- include('../../views/partials/breadCrumb') %></div>

                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
                    <div class="flex items-center gap-4">
                        <a href="/admin/orders" class="w-10 h-10 flex items-center justify-center bg-white rounded-full text-gray-400 shadow-sm hover:text-gray-900 transition"><i class="fas fa-arrow-left"></i></a>
                        <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight uppercase">Order #<%= order.orderId %></h1>
                    </div>
                    <% 
                        let statusColor = "bg-gray-100 text-gray-600 border-gray-200";
                        if (order.status === "processing") statusColor = "bg-amber-50 text-amber-600 border-amber-100";
                        else if (order.status === "cancelled") statusColor = "bg-rose-50 text-rose-600 border-rose-100";
                        else if (order.status === "completed") statusColor = "bg-emerald-50 text-emerald-600 border-emerald-100";
                    %>
                    <span class="px-6 py-2 rounded-2xl text-xs font-black uppercase tracking-widest border <%= statusColor %>">
                        <%= order.status %>
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                    <div class="bg-white p-8 rounded-[2rem] shadow-xl shadow-indigo-900/5 border border-white">
                        <h4 class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-4">Transaction</h4>
                        <div class="space-y-3">
                            <p class="text-sm font-bold text-gray-700 flex justify-between">Date: <span class="text-gray-400"><%= new Date(order.createdAt).toLocaleDateString() %></span></p>
                            <p class="text-sm font-bold text-gray-700 flex justify-between">Pay Via: <span class="text-indigo-600"><%= order.paymentId ? "Online" : "COD" %></span></p>
                            <div class="pt-4 mt-4 border-t border-gray-50">
                                <p class="text-[10px] font-black text-gray-400 uppercase mb-1">Final Total</p>
                                <p class="text-3xl font-black text-gray-900 tracking-tighter">₹<%= order.finalPayable ?? order.total %></p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-8 rounded-[2rem] shadow-xl shadow-indigo-900/5 border border-white">
                        <h4 class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-4">Shipping Info</h4>
                        <p class="text-sm font-black text-gray-900 mb-1 uppercase tracking-tight"><%= order.user?.name %></p>
                        <p class="text-xs text-gray-400 font-bold mb-4 lowercase"><%= order.user?.email %></p>
                        <% if (order.address) { %>
                            <address class="text-xs text-gray-500 font-medium leading-relaxed not-italic">
                                <%= order.address.houseName %>, <%= order.address.street %><br>
                                <%= order.address.post %>, <%= order.address.district %><br>
                                <%= order.address.state %> - <%= order.address.pincode %>
                            </address>
                        <% } %>
                    </div>

                    <div class="bg-indigo-900 p-8 rounded-[2rem] shadow-xl text-white">
                        <h4 class="text-[10px] font-black text-indigo-300 uppercase tracking-widest mb-4">Logistics</h4>
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center"><i class="fas fa-truck-loading"></i></div>
                            <div>
                                <p class="text-xs font-bold text-indigo-100 mb-1">Status Summary</p>
                                <p class="text-lg font-black tracking-tight capitalize"><%= order.status %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-[2.5rem] shadow-xl shadow-indigo-900/5 border border-white overflow-hidden mb-20">
                    <div class="p-8 border-b border-gray-50 bg-gray-50/50">
                        <h3 class="text-lg font-black text-gray-900 uppercase tracking-tight">Order Manifest</h3>
                    </div>

                    <div class="p-4 sm:p-8 space-y-4">
                        <% order.items.forEach(item => { %>
                            <% 
                                let iBadge = "bg-gray-100 text-gray-600 border-gray-200";
                                if (item.status === "ordered") iBadge = "bg-amber-50 text-amber-600 border-amber-100";
                                else if (item.status === "shipped") iBadge = "bg-blue-50 text-blue-600 border-blue-100";
                                else if (item.status === "delivered") iBadge = "bg-emerald-50 text-emerald-600 border-emerald-100";
                                else if (item.status === "cancelled") iBadge = "bg-rose-50 text-rose-600 border-rose-100";
                                else if (item.status === "returned") iBadge = "bg-purple-50 text-purple-600 border-purple-100";

                                let imgSrc = (item.productImage && item.productImage[0]) || "/images/placeholder.png";
                                const isFinalized = ['cancelled', 'returned', 'delivered'].includes(item.status);
                            %>

                            <div class="flex flex-col md:flex-row items-center gap-6 p-6 rounded-[2rem] border border-gray-100 hover:border-indigo-100 transition-all bg-white group">
                                <div class="relative flex-shrink-0">
                                    <img src="<%= imgSrc %>" class="w-20 h-28 object-cover rounded-2xl border-2 border-white shadow-sm bg-gray-50" />
                                    <% if (item.quantity > 1) { %>
                                        <span class="absolute -top-2 -right-2 w-7 h-7 bg-indigo-600 text-white text-[10px] font-black rounded-full flex items-center justify-center shadow-lg">
                                            <%= item.quantity %>
                                        </span>
                                    <% } %>
                                </div>
                                
                                <div class="flex-1 text-center md:text-left">
                                    <p class="text-[9px] font-black text-indigo-400 uppercase tracking-[0.2em] mb-1">SKU Item</p>
                                    <h4 class="text-base font-black text-gray-800 leading-tight mb-2 tracking-tight group-hover:text-indigo-600 transition-colors">
                                        <%= item.productName %>
                                    </h4>
                                    <div class="flex flex-wrap justify-center md:justify-start gap-4 text-[10px] font-bold uppercase text-gray-400">
                                        <span>Rate: ₹<%= item.unitPrice %></span>
                                        <span class="text-indigo-600 font-black">Total: ₹<%= item.subtotal %></span>
                                    </div>
                                </div>

                                <div class="flex flex-col items-center md:items-end gap-3 min-w-[140px]">
                                    <div class="relative">
                                        <button id="item-badge-<%= item._id %>" 
                                                class="px-5 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest border transition-all active:scale-95 <%= iBadge %> 
                                                <%= isFinalized ? 'cursor-default' : 'hover:shadow-lg hover:border-indigo-200 cursor-pointer' %>"
                                                <% if (!isFinalized) { %> onclick="toggleItemStatusMenu('<%= item._id %>')" <% } %>>
                                            <%= item.status %> 
                                            <% if (!isFinalized) { %>
                                                <i class="fas fa-chevron-down ml-2 opacity-40"></i>
                                            <% } %>
                                        </button>

                                        <% if (!isFinalized) { %>
  <div
    id="item-menu-<%= item._id %>"
    class="hidden absolute right-0 bottom-full md:bottom-auto md:top-full mt-2 bg-white shadow-2xl border border-gray-100 rounded-2xl w-52 z-[70] overflow-hidden animate-in fade-in zoom-in-95 duration-200"
  >
    <div class="px-5 py-3 border-b border-gray-50 bg-gray-50/50">
      <p class="text-[8px] font-black text-gray-400 uppercase tracking-widest">
        Next Status
      </p>
    </div>

    <% if (item.status === "ordered") { %>
      <div
        onclick="updateItemStatus('<%= order.orderId %>', '<%= item._id %>', 'shipped')"
        class="px-5 py-3 text-[10px] font-black uppercase tracking-widest text-blue-600 hover:bg-blue-50 cursor-pointer transition border-b border-gray-50"
      >
        Mark as Shipped
      </div>
    <% } %>

    <% if (item.status === "shipped") { %>
      <div
        onclick="updateItemStatus('<%= order.orderId %>', '<%= item._id %>', 'delivered')"
        class="px-5 py-3 text-[10px] font-black uppercase tracking-widest text-emerald-600 hover:bg-emerald-50 cursor-pointer transition border-b border-gray-50"
      >
        Confirm Delivery
      </div>
    <% } %>

    <% if (item.status !== "delivered") { %>
      <div
        onclick="updateItemStatus('<%= order.orderId %>', '<%= item._id %>', 'cancelled')"
        class="px-5 py-3 text-[10px] font-black uppercase tracking-widest text-rose-500 hover:bg-rose-50 cursor-pointer transition"
      >
        Cancel Item
      </div>
    <% } %>
  </div>
<% } %>

                                    </div>

                                    <% if (item.returnStatus === "requested") { %>
                                        <div class="flex flex-col gap-2 p-2 bg-indigo-50/50 rounded-2xl border border-indigo-100 animate-pulse">
                                            <p class="text-[8px] font-black text-indigo-400 uppercase tracking-widest text-center">Return Requested</p>
                                            <div class="flex gap-2">
                                                <button onclick="approveReturn('<%= order.orderId %>', '<%= item._id %>')" class="px-4 py-1.5 bg-emerald-500 text-white text-[9px] font-black uppercase rounded-lg hover:bg-emerald-600 shadow-md transition active:scale-90">Approve</button>
                                                <button onclick="rejectReturn('<%= order.orderId %>', '<%= item._id %>')" class="px-4 py-1.5 bg-rose-500 text-white text-[9px] font-black uppercase rounded-lg hover:bg-rose-600 shadow-md transition active:scale-90">Reject</button>
                                            </div>
                                        </div>
                                    <% } else if (item.returnStatus === "approved") { %>
                                        <div class="flex items-center gap-2 px-3 py-1.5 bg-emerald-50 text-emerald-600 rounded-xl border border-emerald-100">
                                            <i class="fas fa-check-double text-[9px]"></i>
                                            <span class="text-[9px] font-black uppercase tracking-widest">Refund Processed</span>
                                        </div>
                                    <% } else if (item.returnStatus === "rejected") { %>
                                        <div class="flex items-center gap-2 px-3 py-1.5 bg-rose-50 text-rose-600 rounded-xl border border-rose-100">
                                            <i class="fas fa-times-circle text-[9px]"></i>
                                            <span class="text-[9px] font-black uppercase tracking-widest">Return Rejected</span>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </main>
    </div>

   <script src="/admin/js/orderItems.js"></script>
</body>
</html>