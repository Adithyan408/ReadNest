<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Details - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: all 0.3s ease;
      }

      .sidebar-item:hover {
        background-color: #d1d5db;
      }

      .sidebar-item.active {
        background-color: #d1d5db;
      }

      html, body {
        height: 100%;
        overflow: hidden; /* disable full page scroll */
      }

      .main-scroll-area {
        height: calc(100vh - 80px); /* header height is ~80px */
        overflow-y: auto;           /* enable vertical scroll only on the right */
        overflow-x: hidden;
      }
    </style>
  </head>
  <body class="bg-gray-100">
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <a href="/admin">
          <div class="flex items-center space-x-3">
            <div class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center">
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div>
        </a>

        <div class="flex items-center space-x-6">
          <a href="/admin/blogs">
            <button class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition">
              <i class="fas fa-blog text-gray-700"></i>
              <span class="text-base font-semibold text-gray-900">Blog</span>
            </button>
          </a>
          <div class="flex items-center space-x-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="text-base font-semibold text-gray-600">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <div class="flex">
      <aside class="w-80 bg-gray-300 h-[calc(100vh-80px)] border-r border-gray-400 flex flex-col flex-shrink-0">
        <nav class="flex-1 overflow-y-auto py-4">
          <a href="/admin" class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400">
            <i class="fas fa-th-large text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">DashBoard</span>
          </a>
          <a href="/admin/products" class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400">
            <i class="fas fa-box text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Products</span>
          </a>
          <a href="/admin/orders" class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400">
            <i class="fas fa-shopping-bag text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Orders List</span>
          </a>
          <a href="/admin/users" class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400">
            <i class="fas fa-users text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Customers</span>
          </a>
          <a href="/admin/category" class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400">
            <i class="fas fa-th text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Category</span>
          </a>
          <a href="/admin/coupon" class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400">
            <i class="fas fa-ticket-alt text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Voucher</span>
          </a>
          <a href="/admin/banner" class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400">
            <i class="fas fa-image text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Banner</span>
          </a>
        </nav>

        <div class="border-t-2 border-gray-400 bg-gray-300">
          <a href="/admin/logout">
            <button class="w-full flex items-center px-6 py-5 hover:bg-red-50 transition-colors group">
              <i class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"></i>
              <span class="text-lg font-semibold text-gray-900 group-hover:text-red-600">LOG OUT</span>
            </button>
          </a>
        </div>
      </aside>

      <main class="main-scroll-area flex-1 p-8 bg-gray-200">
        <div class="max-w-5xl mx-auto">
          
          <%- include('../../views/partials/breadCrumb') %>

          <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div class="p-6 border-b border-gray-200">
              <div class="flex items-center justify-between">
                <h2 class="text-3xl font-bold text-gray-900">Order Details</h2>
                
                <% 
                  let statusClass = "";
                  if (order.status === "processing") statusClass = "bg-yellow-100 text-yellow-700";
                  else if (order.status === "cancelled") statusClass = "bg-red-100 text-red-700";
                  else if (order.status === "partially_cancelled") statusClass = "bg-orange-100 text-orange-700";
                  else if (order.status === "completed") statusClass = "bg-green-100 text-green-700";
                %>
                <span class="px-6 py-2 rounded-full text-sm font-bold uppercase tracking-wide <%= statusClass %>">
                  <%= order.status %>
                </span>
              </div>
            </div>

            <div class="p-8">
              <div class="grid md:grid-cols-3 gap-8 mb-10 border-b border-gray-100 pb-10">
                <div>
                  <h4 class="text-gray-400 uppercase text-xs font-bold mb-3 tracking-widest">Order Info</h4>
                  <p class="text-gray-900 font-semibold mb-1">ID: <span class="text-indigo-600">#<%= order.orderId %></span></p>
                  <p class="text-sm text-gray-600">Placed: <%= new Date(order.createdAt).toLocaleString() %></p>
                  <% let d = new Date(order.createdAt); d.setDate(d.getDate() + 5); %>
                  <p class="text-sm text-gray-600 mt-1 italic">Est. Delivery: <%= d.toDateString() %></p>
                </div>

                <div>
                  <h4 class="text-gray-400 uppercase text-xs font-bold mb-3 tracking-widest">Shipping To</h4>
                  <p class="text-gray-900 font-bold"><%= order.user?.name %></p>
                  <p class="text-sm text-gray-600 mb-2"><%= order.user?.email %></p>
                  
                  <% if (order.address) { %>
                    <address class="text-sm text-gray-600 not-italic leading-relaxed">
                      <%= order.address.houseName %>, <%= order.address.street %><br>
                      <%= order.address.post %>, <%= order.address.district %><br>
                      <%= order.address.state %> - <%= order.address.pincode %><br>
                      <span class="font-medium text-gray-800">Phone:</span> <%= order.address.phone %>
                    </address>
                  <% } else { %>
                    <p class="text-red-500 text-sm italic">Address details unavailable</p>
                  <% } %>
                </div>

                <div>
                  <h4 class="text-gray-400 uppercase text-xs font-bold mb-3 tracking-widest">Payment Details</h4>
                  <p class="text-sm text-gray-700 mb-1">
                    <span class="font-semibold">Method:</span> 
                    <%= order.paymentId ? "Online Payment" : "Cash on Delivery" %>
                  </p>
                  <p class="text-2xl font-bold text-gray-900 mt-2">₹ <%= order.finalPayable ?? order.total %></p>
                  <p class="text-xs text-gray-500">Total Items: <%= order.items.length %></p>
                </div>
              </div>

              <h3 class="text-xl font-bold text-gray-800 mb-6">Order Items</h3>
              <div class="space-y-4">
                <% order.items.forEach(item => { %>
                  <% 
                    let itemBadge = "";
                    if (item.status === "ordered") itemBadge = "bg-yellow-100 text-yellow-700";
                    else if (item.status === "shipped") itemBadge = "bg-blue-100 text-blue-700";
                    else if (item.status === "cancelled") itemBadge = "bg-red-100 text-red-700";
                    else if (item.status === "delivered") itemBadge = "bg-green-100 text-green-700";
                    else if (item.status === "returned") itemBadge = "bg-orange-100 text-orange-700";

                    let imgSrc = "/images/placeholder.png";
                    if (item.productImage?.length) imgSrc = item.productImage[0];
                    else if (item.product?.productImage?.length) imgSrc = item.product.productImage[0];
                  %>

                  <div class="flex flex-col md:flex-row items-center gap-6 p-6 bg-gray-50 rounded-xl border border-gray-200">
                    <img src="<%= imgSrc %>" class="w-24 h-24 object-cover rounded-lg shadow-sm border bg-white" />
                    
                    <div class="flex-1 text-center md:text-left">
                      <h4 class="text-lg font-bold text-gray-900"><%= item.productName %></h4>
                      <div class="mt-1 text-sm text-gray-600 flex flex-wrap justify-center md:justify-start gap-x-4">
                        <span>Price: ₹<%= item.unitPrice %></span>
                        <span>Qty: <%= item.quantity %></span>
                        <span class="font-bold text-gray-800">Subtotal: ₹<%= item.subtotal %></span>
                      </div>
                    </div>

                    <div class="flex flex-col items-center md:items-end gap-3">
                      <div class="relative">
                        <span id="item-badge-<%= item._id %>" 
                              class="px-4 py-1.5 rounded-lg text-xs font-bold uppercase cursor-pointer <%= itemBadge %> <%= ['cancelled','returned'].includes(item.status) ? 'opacity-70 cursor-not-allowed' : '' %>"
                              <% if (!['cancelled','returned'].includes(item.status)) { %> onclick="toggleItemStatusMenu('<%= item._id %>')" <% } %>>
                          <%= item.status %>
                        </span>

                        <% if (!['cancelled','returned'].includes(item.status)) { %>
                          <div id="item-menu-<%= item._id %>" class="hidden absolute right-0 bg-white shadow-2xl border border-gray-200 rounded-xl w-40 mt-2 z-50 overflow-hidden">
                            <div onclick="updateItemStatus('<%= order.orderId %>', '<%= item._id %>', 'ordered')" class="px-4 py-2 text-sm hover:bg-indigo-50 cursor-pointer transition">Ordered</div>
                            <div onclick="updateItemStatus('<%= order.orderId %>', '<%= item._id %>', 'shipped')" class="px-4 py-2 text-sm hover:bg-indigo-50 cursor-pointer transition">Shipped</div>
                            <div onclick="updateItemStatus('<%= order.orderId %>', '<%= item._id %>', 'delivered')" class="px-4 py-2 text-sm hover:bg-indigo-50 cursor-pointer transition">Delivered</div>
                            <div onclick="updateItemStatus('<%= order.orderId %>', '<%= item._id %>', 'cancelled')" class="px-4 py-2 text-sm hover:bg-red-50 text-red-600 cursor-pointer transition">Cancelled</div>
                          </div>
                        <% } %>
                      </div>

                      <% if (item.returnStatus === "requested") { %>
                        <div class="flex gap-2">
                          <button onclick="approveReturn('<%= order.orderId %>', '<%= item._id %>')" class="px-3 py-1 bg-green-600 text-white text-xs rounded hover:bg-green-700 transition">Approve</button>
                          <button onclick="rejectReturn('<%= order.orderId %>', '<%= item._id %>')" class="px-3 py-1 bg-red-600 text-white text-xs rounded hover:bg-red-700 transition">Reject</button>
                        </div>
                      <% } else if (item.returnStatus === "approved") { %>
                        <span class="text-xs text-green-600 font-bold">✔ Refunded ₹<%= item.refundAmount %></span>
                      <% } else if (item.returnStatus === "rejected") { %>
                        <span class="text-xs text-red-600 font-bold">❌ Return Rejected</span>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>

              <div class="mt-12 flex justify-center">
                <a href="/admin/orders" class="px-10 py-3 bg-gray-800 text-white font-semibold rounded-lg hover:bg-black transition shadow-lg">
                  Back to Orders List
                </a>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <script>
      function toggleItemStatusMenu(itemId) {
        document.querySelectorAll("[id^='item-menu-']").forEach(menu => {
          if (menu.id !== `item-menu-${itemId}`) menu.classList.add("hidden");
        });
        document.getElementById(`item-menu-${itemId}`).classList.toggle("hidden");
      }

      function updateItemStatus(orderId, itemId, newStatus) {
        Swal.fire({
          title: "Update Status?",
          text: `Change item status to ${newStatus}?`,
          icon: "question",
          showCancelButton: true,
          confirmButtonColor: "#4f46e5"
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(`/admin/orders/${orderId}/items/${itemId}/status`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ status: newStatus })
            })
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                location.reload();
              } else {
                Swal.fire("Error", data.message, "error");
              }
            });
          }
        });
      }

      function approveReturn(orderId, itemId) {
        Swal.fire({
          title: "Approve Return?",
          text: "User will be refunded and stock will be updated.",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#16a34a"
        }).then(async (result) => {
          if (!result.isConfirmed) return;
          const res = await fetch(`/admin/orders/${orderId}/items/${itemId}/approve-return`, { method: "POST" });
          const data = await res.json();
          if (data.success) {
            Swal.fire("Success", "Return Approved", "success").then(() => location.reload());
          }
        });
      }

      function rejectReturn(orderId, itemId) {
        Swal.fire({
          title: "Reject Return",
          input: "text",
          inputPlaceholder: "Reason for rejection...",
          showCancelButton: true,
          confirmButtonColor: "#dc2626"
        }).then((result) => {
          if (result.isConfirmed && result.value) {
            fetch(`/admin/orders/${orderId}/items/${itemId}/reject-return`, {
              method: "POST",
              headers: {"Content-Type": "application/json"},
              body: JSON.stringify({ note: result.value })
            })
            .then(res => res.json())
            .then(data => {
              if (data.success) location.reload();
            });
          }
        });
      }

      // Close dropdowns on outside click
      window.addEventListener('click', function(e){
        if (!e.target.matches('[id^="item-badge-"]')) {
          document.querySelectorAll("[id^='item-menu-']").forEach(menu => menu.classList.add("hidden"));
        }
      });
    </script>
  </body>
</html>