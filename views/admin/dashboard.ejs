<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Intelligence | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/admin/css/dashboard.css">
</head>

<body class="bg-gray-50 min-h-screen lg:overflow-hidden">

    <header class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-600 focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
            <a href="/admin" class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-chart-line text-white text-xl"></i>
                </div>
                <span class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase">ReadNest</span>
            </a>
        </div>

        <div class="flex items-center space-x-3 sm:space-x-6">
            <div class="flex items-center gap-2 bg-indigo-50 px-4 py-2 rounded-full border border-indigo-100">
                <i class="fas fa-user-shield text-indigo-600"></i>
                <span class="text-xs font-black text-indigo-700 uppercase tracking-widest">Master Admin</span>
            </div>
        </div>
    </header>

    <div class="flex">
        <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none">
            <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
                <a href="/admin" class="sidebar-item active flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-box w-8 text-lg"></i> Products</a>
                <a href="/admin/orders" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a>
                <a href="/admin/users" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-users w-8 text-lg"></i> Customers</a>
                <a href="/admin/category" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-th w-8 text-lg"></i> Category</a>
                <a href="/admin/coupon" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a>
                <a href="/admin/blogs" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-blog w-8 text-lg"></i> Blogs</a>
                <a href="/admin/banner" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-image w-8 text-lg"></i> Banner</a>
                <a href="/admin/logout" class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a>
            </nav>
        </aside>

        <main class="main-content flex-1 p-4 sm:p-8 lg:p-12 no-scrollbar bg-gray-50 w-full">
            <div class="max-w-[1400px] mx-auto">
                
                <div class="mb-6"><%- include('../../views/partials/breadCrumb') %></div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-8 overflow-hidden group">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-10 h-10 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600"><i class="fas fa-trophy"></i></div>
                            <h3 class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Top 5 Products</h3>
                        </div>
                        <ul class="space-y-4">
                            <% topProducts.forEach((p, index) => { %>
                                <li class="flex justify-between items-center text-sm">
                                    <div class="flex items-center gap-3">
                                        <span class="w-6 h-6 flex items-center justify-center rounded-full bg-gray-50 text-[10px] font-black text-gray-400"><%= index + 1 %></span>
                                        <span class="font-bold text-gray-700 truncate max-w-[150px]"><%= p.name %></span>
                                    </div>
                                    <span class="bg-indigo-50 text-indigo-600 px-3 py-1 rounded-lg font-black text-[10px]"><%= p.sold %> Sold</span>
                                </li>
                            <% }) %>
                        </ul>
                    </div>

                    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-8">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-10 h-10 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600"><i class="fas fa-tags"></i></div>
                            <h3 class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Top Genres</h3>
                        </div>
                        <ul class="space-y-4">
                            <% topCategories.forEach((c, index) => { %>
                                <li class="flex justify-between items-center text-sm">
                                    <span class="font-bold text-gray-700 uppercase tracking-tighter text-xs"><%= c.name %></span>
                                    <div class="h-2 w-24 bg-gray-100 rounded-full overflow-hidden">
                                        <div class="h-full bg-emerald-400" style="width: <%= (c.sold/topCategories[0].sold)*100 %>%"></div>
                                    </div>
                                    <span class="text-xs font-black text-gray-400"><%= c.sold %></span>
                                </li>
                            <% }) %>
                        </ul>
                    </div>

                    <div class="bg-indigo-900 rounded-[2.5rem] shadow-xl p-8 text-white relative overflow-hidden">
                        <div class="relative z-10">
                            <h3 class="text-[10px] font-black text-indigo-300 uppercase tracking-widest mb-4">Top Payment Channel</h3>
                            <h2 class="text-3xl font-black tracking-tighter mb-2"><%= topPaymentMethod?.method || "Razorpay" %></h2>
                            <p class="text-indigo-200 text-xs font-medium opacity-70">Total Volume: <%= topPaymentMethod?.count || 0 %> Txns</p>
                            <div class="mt-8 pt-8 border-t border-white/10 flex items-center justify-between">
                                <span class="text-[10px] font-black uppercase tracking-widest">Gateway Health</span>
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            </div>
                        </div>
                        <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full"></div>
                    </div>
                </div>

                <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
                    <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
                        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Customers</p>
                        <h3 class="text-3xl font-black text-gray-900 tracking-tighter"><%= totalCustomers %></h3>
                    </div>
                    <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
                        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">All-Time Orders</p>
                        <h3 class="text-3xl font-black text-gray-900 tracking-tighter"><%= lifetime.totalOrders %></h3>
                    </div>
                    <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
                        <p class="text-[10px] font-black text-emerald-500 uppercase tracking-widest mb-2">Lifetime Sales</p>
                        <h3 class="text-3xl font-black text-gray-900 tracking-tighter">₹<%= Number(lifetime.totalSales).toLocaleString() %></h3>
                    </div>
                    <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
                        <p class="text-[10px] font-black text-rose-500 uppercase tracking-widest mb-2">Total Savings</p>
                        <h3 class="text-3xl font-black text-gray-900 tracking-tighter">₹<%= Number(lifetime.totalDiscount).toLocaleString() %></h3>
                    </div>
                </div>

                <div class="bg-white rounded-[2.5rem] shadow-xl shadow-indigo-900/5 border border-white p-6 sm:p-10 mb-10">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10">
                        <div>
                            <h2 class="text-2xl font-black text-gray-900 tracking-tight uppercase">Sales Engine</h2>
                            <p class="text-gray-400 text-xs font-bold mt-1 uppercase">Configure and export financial reports</p>
                        </div>
                        <div class="flex gap-3">
                            <a href="/admin/sales-report/download?<%= filter ? `filter=${filter}&start=${start || ''}&end=${end || ''}` : '' %>" 
                               class="bg-rose-50 text-rose-600 px-6 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-rose-600 hover:text-white transition-all active:scale-95 shadow-sm">
                                Export PDF
                            </a>
                            <a href="/admin/sales-report/excel?<%= filter ? `filter=${filter}&start=${start || ''}&end=${end || ''}` : '' %>" 
                               class="bg-emerald-50 text-emerald-600 px-6 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-emerald-600 hover:text-white transition-all active:scale-95 shadow-sm">
                                Export Excel
                            </a>
                        </div>
                    </div>

                    <form method="GET" action="/admin" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10 p-6 bg-gray-50 rounded-3xl border border-gray-100">
                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-gray-400 uppercase ml-1">Period</label>
                            <select name="filter" onchange="this.form.submit()" class="w-full bg-white border-2 border-transparent rounded-xl p-3 font-bold text-xs text-gray-700 outline-none focus:border-indigo-500 transition-all">
                                <option value="today" <%= filter === "today" ? "selected" : "" %>>Today</option>
                                <option value="week" <%= filter === "week" ? "selected" : "" %>>Last 7 Days</option>
                                <option value="month" <%= filter === "month" ? "selected" : "" %>>This Month</option>
                                <option value="year" <%= filter === "year" ? "selected" : "" %>>This Year</option>
                                <option value="custom" <%= filter === "custom" ? "selected" : "" %>>Custom Range</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-gray-400 uppercase ml-1">Start Date</label>
                            <input type="date" name="start" value="<%= start || '' %>" class="w-full bg-white border-2 border-transparent rounded-xl p-3 font-bold text-xs text-gray-700 outline-none focus:border-indigo-500 transition-all"/>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-gray-400 uppercase ml-1">End Date</label>
                            <input type="date" name="end" value="<%= end || '' %>" class="w-full bg-white border-2 border-transparent rounded-xl p-3 font-bold text-xs text-gray-700 outline-none focus:border-indigo-500 transition-all"/>
                        </div>
                        <div class="flex items-end">
                            <button type="submit" class="w-full bg-indigo-600 text-white py-3.5 rounded-xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-indigo-100 hover:bg-indigo-700 active:scale-95 transition-all">
                                Refresh Data
                            </button>
                        </div>
                    </form>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="bg-gray-50/50 p-6 rounded-3xl border border-gray-100">
                            <p class="text-[9px] font-black text-gray-400 uppercase mb-1">Orders</p>
                            <p class="text-xl font-black text-gray-800"><%= filtered.ordersCount %></p>
                        </div>
                        <div class="bg-gray-50/50 p-6 rounded-3xl border border-gray-100">
                            <p class="text-[9px] font-black text-gray-400 uppercase mb-1">Gross Amount</p>
                            <p class="text-xl font-black text-gray-800">₹<%= Number(filtered.orderAmount).toLocaleString() %></p>
                        </div>
                        <div class="bg-gray-50/50 p-6 rounded-3xl border border-gray-100">
                            <p class="text-[9px] font-black text-rose-400 uppercase mb-1">Deduction</p>
                            <p class="text-xl font-black text-rose-600">₹<%= Number(filtered.discountAmount).toLocaleString() %></p>
                        </div>
                        <div class="bg-emerald-50/50 p-6 rounded-3xl border border-emerald-100">
                            <p class="text-[9px] font-black text-emerald-400 uppercase mb-1">Net Realization</p>
                            <p class="text-xl font-black text-emerald-600">₹<%= Number(filtered.netSales).toLocaleString() %></p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
                    <div class="bg-white rounded-[2.5rem] shadow-sm border border-gray-100 p-8 flex flex-col items-center">
                        <h2 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-8">Revenue Composition</h2>
                        <div class="w-64 h-64 relative">
                            <canvas id="salesDiscountChart"></canvas>
                        </div>
                        <div class="flex gap-8 mt-8">
                            <div class="flex items-center gap-2"><span class="w-3 h-3 bg-indigo-600 rounded-full"></span><span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Net Sales</span></div>
                            <div class="flex items-center gap-2"><span class="w-3 h-3 bg-rose-500 rounded-full"></span><span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Discounts</span></div>
                        </div>
                    </div>

                    <div class="bg-white rounded-[2.5rem] shadow-sm border border-gray-100 p-8">
                        <h2 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-8">Sales Velocity</h2>
                        <div class="h-64">
                            <canvas id="monthlySalesChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-[2.5rem] shadow-xl shadow-indigo-900/5 border border-white overflow-hidden mb-20">
                    <div class="p-8 border-b border-gray-50 bg-gray-50/50">
                        <h2 class="text-lg font-black text-gray-900 tracking-tight uppercase">Transaction Log</h2>
                        <p class="text-gray-400 text-[10px] font-bold mt-1 uppercase tracking-widest">Detailed order breakdown for active period</p>
                    </div>

                    <div class="overflow-x-auto no-scrollbar">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-900 text-white text-[10px] font-black uppercase tracking-widest">
                                    <th class="px-8 py-5">Index</th>
                                    <th class="px-8 py-5">Customer</th>
                                    <th class="px-8 py-5">Product Details</th>
                                    <th class="px-8 py-5">Qty</th>
                                    <th class="px-8 py-5">Timestamp</th>
                                    <th class="px-8 py-5 text-right">Net Value</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <% salesRows.forEach((row, i) => { %>
                                <tr class="hover:bg-indigo-50/30 transition-colors group">
                                    <td class="px-8 py-6 text-[10px] font-black text-gray-400">#<%= (pagination.current - 1) * pagination.limit + i + 1 %></td>
                                    <td class="px-8 py-6 font-black text-gray-700 text-sm"><%= row.username %></td>
                                    <td class="px-8 py-6">
                                        <p class="text-sm font-bold text-gray-800 truncate max-w-[200px]"><%= row.product %></p>
                                    </td>
                                    <td class="px-8 py-6 text-sm font-black text-gray-400">x<%= row.quantity %></td>
                                    <td class="px-8 py-6 text-xs text-gray-500 font-medium tracking-tighter"><%= new Date(row.date).toDateString() %></td>
                                    <td class="px-8 py-6 text-right font-black text-indigo-600">₹<%= row.amount.toFixed(2) %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% if(pagination.total > 1) { %>
                    <div class="p-8 border-t border-gray-50 bg-gray-50/50 flex justify-center sm:justify-end gap-2">
                        <% for(let i = 1; i <= pagination.total; i++) { %>
                        <a href="?page=<%= i %>&filter=<%= filter %>&start=<%= start || '' %>&end=<%= end || '' %>" 
                           class="w-10 h-10 flex items-center justify-center rounded-xl font-bold text-xs transition-all <%= pagination.current === i ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-white text-gray-400 border border-gray-100 hover:bg-gray-50' %>">
                            <%= i %>
                        </a>
                        <% } %>
                    </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <script src="/admin/js/dashboard.js"></script>
</body>
</html>