<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: all 0.3s ease;
      }

      .sidebar-item:hover {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }

      .sidebar-item.active {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }

      .stat-card {
        animation: fadeIn 0.5s ease-in;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      html,
      body {
        height: 100%;
        overflow: hidden; /* disable full page scroll */
      }

      .main-scroll-area {
        height: calc(100vh - 80px); /* header height is ~80px */
        overflow-y: auto; /* enable vertical scroll only on the right */
        overflow-x: hidden;
      }
    </style>
  </head>
  <body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <!-- Logo -->
        <a href="/admin">
          <div class="flex items-center space-x-3">
            <div
              class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div></a
        >

        <!-- Right Side -->
        <div class="flex items-center space-x-6">
          <a href="/admin/blogs">
            <button
              class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition"
            >
          <i class="fas fa-blog text-gray-700"></i>
          <span class="text-base font-semibold text-gray-900">Blog</span>
          </button>
        </a>

          <div class="flex items-center space-x-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="text-base font-semibold text-gray-600">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="flex">
      <!-- Sidebar -->
      <aside
        class="w-80 bg-gray-300 h-[calc(100vh-80px)] border-r border-gray-400 flex flex-col"
      >
        <nav class="flex-1 overflow-y-auto py-4">
          <a
            href="/admin"
            class="sidebar-item active flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th-large text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">DashBoard</span>
          </a>

          <a
            href="/admin/products"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-box text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Products</span>
          </a>

          <a
            href="/admin/orders"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-shopping-bag text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Orders List</span>
          </a>

          <a
            href="/admin/users"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-users text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Customers</span>
          </a>

          

          <a
            href="/admin/category"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Category</span>
          </a>

          <a
            href="/admin/coupon"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-ticket-alt text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Voucher</span>
          </a>

          <a
            href="/admin/banner"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-image text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Banner</span>
          </a>
        </nav>

        <!-- Logout Button at Bottom -->
        <div class="border-t-2 border-gray-400 bg-gray-300">
          <a href="/admin/logout">
            <button
              class="w-full flex items-center px-6 py-5 hover:bg-red-50 transition-colors group"
            >
              <i
                class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"
              ></i>
              <span
                class="text-lg font-semibold text-gray-900 group-hover:text-red-600"
                >Log Out</span
              >
            </button></a
          >
        </div>
      </aside>

      <!-- Main Dashboard Content -->
<main class="main-scroll-area flex-1 p-8 bg-gray-200 overflow-y-auto">
  <%- include('../../views/partials/breadcrumb') %>

  <!-- ================= INSIGHTS ================= -->
<div class="grid grid-cols-3 gap-6 mb-10">

  <!-- Best Selling Product -->
<div class="bg-white rounded-2xl shadow p-6 border">
  <p class="text-sm text-gray-500 mb-3">Top 5 Selling Products</p>

  <ul class="space-y-2">
    <% topProducts.forEach((p, index) => { %>
      <li class="flex justify-between text-sm">
        <span class="font-medium text-gray-800">
          <%= index + 1 %>. <%= p.name %>
        </span>
        <span class="text-gray-600">
          <%= p.sold %>
        </span>
      </li>
    <% }) %>
  </ul>
</div>


  <!-- Best Selling Category -->
  <div class="bg-white rounded-2xl shadow p-6 border">
  <p class="text-sm text-gray-500 mb-3">Top 3 Categories</p>

  <ul class="space-y-2">
    <% topCategories.forEach((c, index) => { %>
      <li class="flex justify-between text-sm">
        <span class="font-medium text-gray-800">
          <%= index + 1 %>. <%= c.name %>
        </span>
        <span class="text-gray-600">
          <%= c.sold %>
        </span>
      </li>
    <% }) %>
  </ul>
</div>


  <!-- Top Payment Method -->
  <div class="bg-white rounded-2xl shadow p-6 border">
    <p class="text-sm text-gray-500">Top Payment Method</p>
    <h3 class="text-lg font-bold text-gray-900 mt-2">
      <%= topPaymentMethod?.method || "—" %>
    </h3>
    <p class="text-sm text-gray-600 mt-1">
      Transactions: <%= topPaymentMethod?.count || 0 %>
    </p>
  </div>

</div>

  <!-- ================= TOP STATS ================= -->
  <div class="grid grid-cols-4 gap-6 mb-10">

    <!-- Customers -->
    <div class="bg-white rounded-2xl shadow p-6 border">
      <p class="text-sm text-gray-500">Customers</p>
      <h3 class="text-2xl font-bold text-gray-900">
        <%= totalCustomers %>
      </h3>
    </div>

    <!-- Total Orders -->
    <div class="bg-white rounded-2xl shadow p-6 border">
      <p class="text-sm text-gray-500">Total Orders</p>
      <h3 class="text-2xl font-bold text-gray-900">
        <%= lifetime.totalOrders %>
      </h3>
    </div>

    <!-- Total Sales -->
    <div class="bg-white rounded-2xl shadow p-6 border">
      <p class="text-sm text-gray-500">Total Sales</p>
      <h3 class="text-2xl font-bold text-gray-900">
        ₹<%= Number(lifetime.totalSales).toLocaleString() %>
      </h3>
    </div>

    <!-- Total Discount -->
    <div class="bg-white rounded-2xl shadow p-6 border">
      <p class="text-sm text-gray-500">Total Discount</p>
      <h3 class="text-2xl font-bold text-red-600">
        ₹<%= Number(lifetime.totalDiscount).toLocaleString() %>
      </h3>
    </div>

  </div>

  <!-- ================= SALES REPORT ================= -->
  <div class="bg-white rounded-2xl shadow p-6 border mb-10">

   <div class="flex items-center justify-between mb-6">
  <h2 class="text-xl font-bold text-gray-900">Sales Report</h2>

  <div class="flex gap-3">
    <a
      href="/admin/sales-report/download?<%= 
        filter ? `filter=${filter}&start=${start || ''}&end=${end || ''}` : '' 
      %>"
      class="px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-semibold hover:bg-red-700"
    >
      PDF
    </a>

    <a
      href="/admin/sales-report/excel?<%= 
        filter ? `filter=${filter}&start=${start || ''}&end=${end || ''}` : '' 
      %>"
      class="px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-semibold hover:bg-green-700"
    >
      Excel
    </a>
  </div>
</div>


    <!-- Filters -->
    <form method="GET" action="/admin" class="flex flex-wrap gap-4 items-end mb-6">
    <select name="filter" onchange="this.form.submit()" class="border rounded-lg px-4 py-2">
  <option value="today" <%= filter === "today" ? "selected" : "" %>>Today</option>
  <option value="week" <%= filter === "week" ? "selected" : "" %>>Last 7 Days</option>
  <option value="month" <%= filter === "month" ? "selected" : "" %>>This Month</option>
  <option value="year" <%= filter === "year" ? "selected" : "" %>>This Year</option>
  <option value="custom" <%= filter === "custom" ? "selected" : "" %>>Custom</option>
</select>



    <input
  type="date"
  name="start"
  value="<%= start || '' %>"
  class="border rounded-lg px-4 py-2"
/>

<input
  type="date"
  name="end"
  value="<%= end || '' %>"
  class="border rounded-lg px-4 py-2"
/>


      <button
        class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-indigo-700">
        Apply
      </button>
    </form>

    <!-- ================= FILTERED SUMMARY ================= -->
    <div class="grid grid-cols-4 gap-6 text-center">

      <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs text-gray-500">Orders</p>
        <p class="text-xl font-bold text-gray-900">
          <%= filtered.ordersCount %>
        </p>
      </div>

      <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs text-gray-500">Order Amount</p>
        <p class="text-xl font-bold text-gray-900">
          ₹<%= Number(filtered.orderAmount).toLocaleString() %>
        </p>
      </div>

      <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs text-gray-500">Discount</p>
        <p class="text-xl font-bold text-red-600">
          ₹<%= Number(filtered.discountAmount).toLocaleString() %>
        </p>
      </div>

      <div class="bg-gray-50 rounded-xl p-4">
        <p class="text-xs text-gray-500">Net Sales</p>
        <p class="text-xl font-bold text-green-600">
          ₹<%= Number(filtered.netSales).toLocaleString() %>
        </p>
      </div>

    </div>
  </div>

  <!-- ================= CHARTS ================= -->
<div class="grid grid-cols-2 gap-6">

  <!-- SALES vs DISCOUNT (DOUGHNUT) -->
  <div class="bg-white rounded-2xl shadow p-6 border flex flex-col items-center">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">
      Sales vs Discount
    </h2>

    <div class="w-56 h-56">
  <canvas id="salesDiscountChart"></canvas>
</div>


    <!-- Legend -->
    <div class="flex gap-6 mt-4 text-sm">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-indigo-600 rounded-full"></span>
        <span>Total Sales</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-red-500 rounded-full"></span>
        <span>Total Discount</span>
      </div>
    </div>
  </div>

  <!-- MONTHLY SALES BAR CHART -->
  <div class="bg-white rounded-2xl shadow p-6 border h-[320px]">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">
      Monthly Sales
    </h2>
    <canvas id="monthlySalesChart" height="140"></canvas>
  </div>

</div>


</main>

<script>
  let chartLabels = <%- JSON.stringify(chartLabels) %>;
  let chartValues = <%- JSON.stringify(chartValues) %>;

  if (!chartLabels.length) {
    chartLabels = ["No Data"];
    chartValues = [0];
  }

  const ctx = document
    .getElementById("monthlySalesChart")
    .getContext("2d");

  new Chart(ctx, {
    type: "bar",
    data: {
      labels: chartLabels,
      datasets: [
        {
          label: "Monthly Sales",
          data: chartValues,
          backgroundColor: "#4f46e5",
          borderRadius: 8,
          barThickness: 36,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: (ctx) => "₹" + ctx.raw.toLocaleString(),
          },
        },
      },
      scales: {
        x: { grid: { display: false } },
        y: {
          ticks: { callback: (v) => "₹" + v },
          grid: { borderDash: [4, 4] },
        },
      },
    },
  });

  const salesDiscountCtx = document
    .getElementById("salesDiscountChart")
    .getContext("2d");

  new Chart(salesDiscountCtx, {
    type: "doughnut",
    data: {
      labels: ["Sales", "Discount"],
      datasets: [
        {
          data: [
            <%= filtered.netSales %>,
            <%= filtered.discountAmount %>
          ],
          backgroundColor: ["#4f46e5", "#ef4444"],
          borderWidth: 0,
        },
      ],
    },
    options: {
      responsive: true,
      cutout: "65%",
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: (ctx) => "₹" + ctx.raw.toLocaleString(),
          },
        },
      },
    },
  });
</script>





    
  </body>
</html>
