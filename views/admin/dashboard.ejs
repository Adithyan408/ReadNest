<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: all 0.3s ease;
      }

      .sidebar-item:hover {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }

      .sidebar-item.active {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }

      .stat-card {
        animation: fadeIn 0.5s ease-in;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      html,
      body {
        height: 100%;
        overflow: hidden; /* disable full page scroll */
      }

      .main-scroll-area {
        height: calc(100vh - 80px); /* header height is ~80px */
        overflow-y: auto; /* enable vertical scroll only on the right */
        overflow-x: hidden;
      }
    </style>
  </head>
  <body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <!-- Logo -->
        <a href="/admin">
          <div class="flex items-center space-x-3">
            <div
              class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div></a
        >

        <!-- Right Side -->
        <div class="flex items-center space-x-6">
          <button
            class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition"
          >
            <i class="fas fa-blog text-gray-700"></i>
            <span class="text-base font-semibold text-gray-900">Blog</span>
          </button>

          <div class="flex items-center space-x-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="text-base font-semibold text-gray-600">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="flex">
      <!-- Sidebar -->
      <aside
        class="w-80 bg-gray-300 h-[calc(100vh-80px)] border-r border-gray-400 flex flex-col"
      >
        <nav class="flex-1 overflow-y-auto py-4">
          <a
            href="/admin"
            class="sidebar-item active flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th-large text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">DashBoard</span>
          </a>

          <a
            href="/admin/products"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-box text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Products</span>
          </a>

          <a
            href="/admin/orders"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-shopping-bag text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Orders List</span>
          </a>

          <a
            href="/admin/users"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-users text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Customers</span>
          </a>

          <a
            href="/admin/sales"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-chart-line text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Sales</span>
          </a>

          <a
            href="/admin/category"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Category</span>
          </a>

          <a
            href="/admin/coupon"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-ticket-alt text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Voucher</span>
          </a>

          <a
            href="/admin/banner"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-image text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Banner</span>
          </a>
        </nav>

        <!-- Logout Button at Bottom -->
        <div class="border-t-2 border-gray-400 bg-gray-300">
          <a href="/admin/logout">
            <button
              class="w-full flex items-center px-6 py-5 hover:bg-red-50 transition-colors group"
            >
              <i
                class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"
              ></i>
              <span
                class="text-lg font-semibold text-gray-900 group-hover:text-red-600"
                >Log Out</span
              >
            </button></a
          >
        </div>
      </aside>

      <!-- Main Dashboard Content -->
      <main class="main-scroll-area flex-1 p-8 bg-gray-200 overflow-y-auto">
  <%- include('../../views/partials/breadcrumb') %>

  <% 
    /* ================= PRECOMPUTED UI VALUES ================= */

    const radius = 72;
    const circumference = 2 * Math.PI * radius;
    const progressOffset = circumference * (1 - normalizedGrowth / 100);

    let statusClass = "bg-red-100 text-red-700";
    if (targetStatus === "Achieved") {
      statusClass = "bg-green-100 text-green-700";
    } else if (targetStatus === "On Track") {
      statusClass = "bg-blue-100 text-blue-700";
    }

    const growthColor = growthPercent >= 0 ? "#16a34a" : "#dc2626";
    const growthTextClass = growthPercent >= 0 ? "text-green-600" : "text-red-600";
    const growthArrow = growthPercent >= 0 ? "↑" : "↓";

    const growthSummary =
      growthPercent >= 0
        ? "Revenue increased compared to last month"
        : "Revenue declined compared to last month";
  %>

  <!-- ================= STATS CARDS ================= -->
  <div class="grid grid-cols-4 gap-6 mb-8">

    <!-- Customers -->
    <div class="stat-card bg-white rounded-2xl shadow-md p-6 border">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-3">
        <i class="fas fa-users text-2xl text-green-600"></i>
      </div>
      <p class="text-sm text-gray-600">Total Customers</p>
      <h3 class="text-3xl font-bold text-gray-900"><%= totalCustomers %></h3>
      <p class="text-sm font-semibold <%= growthTextClass %>">
        <%= growthArrow %> <%= Math.abs(growthPercent) %>% this month
      </p>
    </div>

    <!-- Orders -->
    <div class="stat-card bg-white rounded-2xl shadow-md p-6 border">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-3">
        <i class="fas fa-shopping-cart text-2xl text-green-600"></i>
      </div>
      <p class="text-sm text-gray-600">Total Orders</p>
      <h3 class="text-3xl font-bold text-gray-900"><%= totalOrders %></h3>
    </div>

    <!-- Sales -->
    <div class="stat-card bg-white rounded-2xl shadow-md p-6 border">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-3">
        <i class="fas fa-rupee-sign text-2xl text-green-600"></i>
      </div>
      <p class="text-sm text-gray-600">Total Sales</p>
      <h3 class="text-3xl font-bold text-gray-900">
        ₹<%= Number(totalSales).toLocaleString() %>
      </h3>
    </div>

    <!-- Pending -->
    <div class="stat-card bg-white rounded-2xl shadow-md p-6 border">
      <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-3">
        <i class="fas fa-clock text-2xl text-gray-600"></i>
      </div>
      <p class="text-sm text-gray-600">Pending Items</p>
      <h3 class="text-3xl font-bold text-gray-900"><%= pendingOrders %></h3>
    </div>

  </div>

  <!-- ================= SALES OVERVIEW ================= -->
  <div class="mb-10">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Sales Overview</h2>

      <a
        href="/admin/sales-report/download?range=monthly"
        class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded-lg text-sm font-semibold"
      >
        <i class="fas fa-download"></i>
        Download Report
      </a>
    </div>

    <div class="grid grid-cols-3 gap-6">

      <!-- ================= SALES PROGRESS ================= -->
      <div class="bg-white rounded-2xl shadow p-6 border">

        <!-- Header -->
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900">Sales Progress</h3>
            <p class="text-sm text-gray-500">Current Month</p>
          </div>

          <span class="text-xs px-3 py-1 rounded-full <%= statusClass %>">
            <%= targetStatus %>
          </span>
        </div>

        <!-- Progress Circle -->
        <div class="relative w-44 h-44 mx-auto my-6">
          <svg class="transform -rotate-90 w-44 h-44">
            <circle
              cx="88"
              cy="88"
              r="<%= radius %>"
              stroke="#e5e7eb"
              stroke-width="14"
              fill="none"
            />
            <circle
              cx="88"
              cy="88"
              r="<%= radius %>"
              stroke="<%= growthColor %>"
              stroke-width="14"
              fill="none"
              stroke-dasharray="<%= circumference %>"
              stroke-dashoffset="<%= progressOffset %>"
              stroke-linecap="round"
              class="transition-all duration-700 ease-out"
            />
          </svg>

          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="text-3xl font-bold text-gray-900">
              <%= normalizedGrowth %>%
            </span>
            <span class="text-sm font-semibold <%= growthTextClass %>">
              <%= growthArrow %> <%= Math.abs(growthPercent) %>% growth
            </span>
          </div>
        </div>

        <p class="text-center text-sm text-gray-600 mb-6">
          <%= growthSummary %>
        </p>

        <!-- KPIs -->
        <div class="grid grid-cols-3 gap-4 text-center">
          <div class="bg-gray-50 rounded-lg py-3">
            <p class="text-xs text-gray-500">Target</p>
            <p class="text-lg font-bold text-gray-900">
              ₹<%= Number(monthlyTarget).toLocaleString() %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg py-3">
            <p class="text-xs text-gray-500">Revenue</p>
            <p class="text-lg font-bold text-gray-900">
              ₹<%= Number(monthlyRevenue).toLocaleString() %>
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg py-3">
            <p class="text-xs text-gray-500">Today</p>
            <p class="text-lg font-bold text-gray-900">
              ₹<%= Number(todayRevenue).toLocaleString() %>
            </p>
          </div>
        </div>
      </div>

      <!-- ================= SALES CHART ================= -->
      <div class="col-span-2 bg-white rounded-2xl shadow p-6 border">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-lg font-semibold text-gray-900">Sales Activity</h3>
        </div>

        <canvas id="activityChart" height="90"></canvas>
      </div>

    </div>
  </div>
</main>

<script>
  const chartLabels = <%- JSON.stringify(chartLabels) %>;
  const chartValues = <%- JSON.stringify(chartValues) %>;

  const ctx = document.getElementById("activityChart").getContext("2d");

  new Chart(ctx, {
    type: "line",
    data: {
      labels: chartLabels,
      datasets: [{
        label: "Delivered Revenue",
        data: chartValues,
        borderWidth: 2,
        tension: 0.35,
        fill: true
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: {
          ticks: {
            callback: value => "₹" + value
          }
        }
      }
    }
  });
</script>

    
  </body>
</html>
