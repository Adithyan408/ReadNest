<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Access | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin/css/admin-login.css">
</head>

<body class="flex items-center justify-center min-h-screen p-4 sm:p-6 lg:p-8">
    <div class="form-container bg-white/95 backdrop-blur-sm rounded-[2.5rem] shadow-2xl max-w-lg w-full p-8 sm:p-12 lg:p-16 relative border border-white/20">
        
        <div class="absolute -top-5 left-1/2 transform -translate-x-1/2 whitespace-nowrap">
            <div class="bg-indigo-600 text-white px-6 py-2 rounded-full shadow-xl border-2 border-white/50 animate-pulse">
                <i class="fas fa-user-shield mr-2"></i>
                <span class="text-xs font-black uppercase tracking-widest">Secure Admin Portal</span>
            </div>
        </div>
        
        <div class="text-center mb-10 mt-4">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 leading-tight uppercase tracking-tighter">Log-In</h1>
            <p class="text-gray-400 text-xs sm:text-sm font-bold mt-2 uppercase tracking-widest">ReadNest Control Panel</p>
        </div>
        
        <div id="errorMessage" class="hidden mb-6 p-4 bg-rose-50 border-l-4 border-rose-500 text-rose-700 rounded-r-xl text-xs sm:text-sm font-bold items-center gap-3">
            <i class="fas fa-circle-exclamation text-lg"></i>
            <span id="errorText"></span>
        </div>
        
        <form id="adminLoginForm" class="space-y-5" action="/admin/login" method="POST">
            <div>
                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-4 mb-2 block">Admin Email</label>
                <input 
                    type="email" 
                    id="email"
                    name="email"
                    placeholder="admin " 
                    class="input-field w-full px-8 py-5 bg-gray-50 rounded-3xl border-2 border-transparent outline-none text-gray-800 placeholder-gray-300 font-bold focus:border-indigo-500 focus:bg-white transition-all"
                >
                <p id="emailError" class="hidden text-rose-500 text-[10px] font-black uppercase mt-2 ml-6 tracking-widest">
                    <i class="fas fa-triangle-exclamation mr-1"></i><span></span>
                </p>
            </div>
            
            <div class="relative">
                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-4 mb-2 block">Security Code</label>
                <div class="relative group">
                    <input 
                        type="password" 
                        id="password"
                        name="password"
                        placeholder="••••••••" 
                        class="input-field w-full px-8 py-5 bg-gray-50 rounded-3xl border-2 border-transparent outline-none text-gray-800 placeholder-gray-300 font-bold focus:border-indigo-500 focus:bg-white transition-all pr-16"
                    >
                    <i class="fas fa-eye absolute right-6 top-1/2 -translate-y-1/2 text-gray-300 cursor-pointer hover:text-indigo-600 transition-colors text-xl" onclick="togglePassword('password', this)"></i>
                </div>
                <p id="passwordError" class="hidden text-rose-500 text-[10px] font-black uppercase mt-2 ml-6 tracking-widest">
                    <i class="fas fa-triangle-exclamation mr-1"></i><span></span>
                </p>
            </div>
            
            <div class="text-right pr-4">
                <a href="/admin/forgot-password" class="text-gray-400 font-black text-[10px] uppercase tracking-widest hover:text-indigo-600 transition-colors">
                    Reset Access Credentials?
                </a>
            </div>
            
            <button 
                type="submit" 
                class="w-full bg-indigo-600 text-white font-black text-lg py-6 rounded-[2rem] shadow-xl shadow-indigo-200 hover:bg-indigo-700 active:scale-[0.98] transition-all mt-8 uppercase tracking-[0.2em]"
            >
                Authorize Session
            </button>
        </form>
        
        <div class="mt-10 pt-6 border-t border-gray-50 flex items-center justify-center gap-2 text-gray-400 text-[10px] font-bold uppercase tracking-widest">
            <i class="fas fa-lock"></i>
            <span>AES-256 Encrypted Admin Session</span>
        </div>
    </div>

   <script src="/admin/js/admin-login.js"></script>
</body>
</html>