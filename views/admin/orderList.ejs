<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Orders List - ReadNest</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");
      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: 0.3s;
      }
      .sidebar-item:hover {
        background: #d1d5db;
        border-left: 4px solid #667eea;
      }
      .sidebar-item.active {
        background: #d1d5db;
        border-left: 4px solid #667eea;
      }

      .badge {
        padding: 6px 12px;
        border-radius: 9999px;
        font-size: 13px;
        font-weight: 600;
      }
      .processing {
        background: #fef3c7;
        color: #92400e;
      }
      .shipped {
        background: #dbeafe;
        color: #1e40af;
      }
      .delivered {
        background: #d1fae5;
        color: #065f46;
      }
      .cancelled {
        background: #fee2e2;
        color: #991b1b;
      }

      .main-scroll-area {
        height: calc(100vh - 80px);
        overflow-y: auto;
      }
      .badge {
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        display: inline-block;
      }

      .badge.ordered {
        background: #fef3c7;
        color: #b45309;
      }
      .badge.shipped {
        background: #dbeafe;
        color: #1e40af;
      }
      .badge.delivered {
        background: #d1fae5;
        color: #065f46;
      }
      .badge.cancelled {
        background: #fee2e2;
        color: #991b1b;
      }
    </style>
  </head>

  <body class="bg-gray-100">
    <!-- HEADER -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <a href="/admin">
          <div class="flex items-center gap-3">
            <div
              class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div>
        </a>

        <div class="flex items-center gap-6">
          <button
            class="px-6 py-2 bg-white rounded-lg border border-gray-400 flex items-center gap-2 hover:bg-gray-50"
          >
            <i class="fas fa-blog text-gray-700"></i>
            <span class="font-semibold">Blog</span>
          </button>

          <div class="flex items-center gap-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="font-semibold text-gray-700">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <div class="flex">
      <!-- SIDEBAR -->
      <aside
        class="w-80 bg-gray-300 border-r border-gray-400 flex flex-col h-[calc(100vh-80px)]"
      >
        <nav class="flex-1 py-4 overflow-y-auto">
          <a
            href="/admin"
            class="sidebar-item flex items-center px-6 py-4 border-b"
            ><i class="fas fa-th-large text-xl mr-4"></i>Dashboard</a
          >
          <a
            href="/admin/products"
            class="sidebar-item flex items-center px-6 py-4 border-b"
            ><i class="fas fa-box text-xl mr-4"></i>Products</a
          >
          <a
            href="/admin/orders"
            class="sidebar-item active flex items-center px-6 py-4 border-b"
            ><i class="fas fa-shopping-bag text-xl mr-4"></i>Orders List</a
          >
          <a
            href="/admin/users"
            class="sidebar-item flex items-center px-6 py-4 border-b"
            ><i class="fas fa-users text-xl mr-4"></i>Customers</a
          >
          <a
            href="/admin/sales"
            class="sidebar-item flex items-center px-6 py-4 border-b"
            ><i class="fas fa-chart-line text-xl mr-4"></i>Sales</a
          >
          <a
            href="/admin/category"
            class="sidebar-item flex items-center px-6 py-4 border-b"
            ><i class="fas fa-th text-xl mr-4"></i>Category</a
          >
          <a
            href="/admin/voucher"
            class="sidebar-item flex items-center px-6 py-4 border-b"
            ><i class="fas fa-ticket-alt text-xl mr-4"></i>Voucher</a
          >
          <a
            href="/admin/banner"
            class="sidebar-item flex items-center px-6 py-4 border-b"
            ><i class="fas fa-image text-xl mr-4"></i>Banner</a
          >
        </nav>

        <div class="border-t-2 border-gray-400">
          <a href="/admin/logout">
            <button class="w-full flex items-center px-6 py-5 hover:bg-red-50">
              <i class="fas fa-sign-out-alt text-xl mr-4"></i>
              <span class="text-lg font-semibold">LOG OUT</span>
            </button>
          </a>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="main-scroll-area flex-1 p-8 bg-gray-200">
        <div class="bg-white rounded-2xl shadow-md border">
          <!-- SEARCH -->
          <div class="p-6 border-b">
            <h2 class="text-2xl font-bold mb-4">Orders List</h2>

            <div class="flex gap-3">
              <div class="relative flex-1 max-w-md">
                <input
                  id="searchInput"
                  value="<%= search || '' %>"
                  type="text"
                  placeholder="Search Order ID / User"
                  class="w-full px-4 py-3 pl-10 bg-gray-100 rounded-lg border"
                />
                <i
                  class="fas fa-search absolute left-3 top-4 text-gray-400"
                ></i>
              </div>

              <button
                onclick="searchOrders()"
                class="px-6 py-3 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700"
              >
                Search
              </button>

              <% if (search) { %>
              <button
                onclick="clearSearch()"
                class="px-6 py-3 bg-gray-600 text-white rounded-lg font-semibold hover:bg-gray-700"
              >
                Clear
              </button>
              <% } %>
            </div>
          </div>

          <!-- TABLE -->
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-gray-900 text-white text-sm">
                  <th class="px-6 py-4 border">Order ID</th>
                  <th class="px-6 py-4 border">Product</th>
                  <th class="px-6 py-4 border">Customer</th>
                  <th class="px-6 py-4 border">Price</th>
                  <th class="px-6 py-4 border">Qty</th>
                  <th class="px-6 py-4 border">Subtotal</th>
                  <th class="px-6 py-4 border">Date</th>
                  <th class="px-6 py-4 border">Status</th>
                </tr>
              </thead>

              <tbody>
                <% if (orders.length === 0) { %>
                <tr>
                  <td colspan="8" class="py-6 text-center text-gray-500">
                    No Orders Found
                  </td>
                </tr>
                <% } %> <% orders.forEach(item => { %>
                <tr class="border-b hover:bg-gray-50">
                  <!-- ORDER ID -->
                  <td class="px-6 py-4 border text-indigo-600 font-semibold">
                    #<%= item.orderId %>
                  </td>

                  <!-- PRODUCT INFO -->
                  <td class="px-6 py-4 border">
                    <div class="flex items-center gap-3">
                      <img
                        src="<%= item.productImage %>"
                        class="w-12 h-16 object-cover rounded shadow"
                      />
                      <div>
                        <p class="font-semibold text-gray-800">
                          <%= item.productName %>
                        </p>
                      </div>
                    </div>
                  </td>

                  <!-- CUSTOMER -->
                  <td class="px-6 py-4 border">
                    <p class="font-semibold"><%= item.user?.name %></p>
                    <p class="text-sm text-gray-500"><%= item.user?.email %></p>
                  </td>

                  <!-- PRICE -->
                  <td class="px-6 py-4 border font-semibold">
                    ₹ <%= item.price %>
                  </td>

                  <!-- QUANTITY -->
                  <td class="px-6 py-4 border font-semibold">
                    <%= item.quantity %>
                  </td>

                  <!-- SUBTOTAL -->
                  <td class="px-6 py-4 border font-semibold">
                    ₹ <%= item.subtotal %>
                  </td>

                  <!-- DATE -->
                  <td class="px-6 py-4 border text-gray-600">
                    <%= new Date(item.createdAt).toLocaleString() %>
                  </td>

                  <!-- STATUS -->
                  <td class="px-6 py-4 border relative">
                    <!-- CLICKABLE BADGE -->
                    <div
                      class="badge <%= item.status %> cursor-pointer select-none"
                      onclick="toggleStatusMenu('<%= item.itemId %>')"
                      id="status-badge-<%= item.itemId %>"
                    >
                      <%= item.status %>
                    </div>

                    <!-- HIDDEN MENU -->
                    <div
                      id="status-menu-<%= item.itemId %>"
                      class="hidden absolute bg-white shadow-lg border rounded-lg w-36 mt-2 z-50"
                    >
                      <div
                        onclick="updateStatus('<%= item.orderId %>', '<%= item.itemId %>', 'ordered')"
                        class="px-4 py-2 hover:bg-gray-100 cursor-pointer"
                      >
                        Ordered
                      </div>

                      <div
                        onclick="updateStatus('<%= item.orderId %>', '<%= item.itemId %>', 'shipped')"
                        class="px-4 py-2 hover:bg-gray-100 cursor-pointer"
                      >
                        Shipped
                      </div>

                      <div
                        onclick="updateStatus('<%= item.orderId %>', '<%= item.itemId %>', 'delivered')"
                        class="px-4 py-2 hover:bg-gray-100 cursor-pointer"
                      >
                        Delivered
                      </div>

                      <div
                        onclick="updateStatus('<%= item.orderId %>', '<%= item.itemId %>', 'cancelled')"
                        class="px-4 py-2 hover:bg-gray-100 cursor-pointer text-red-600"
                      >
                        Cancelled
                      </div>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- PAGINATION -->
          <div class="flex justify-end p-6 border-t">
            <ul class="flex gap-2">
              <% for (let i = 1; i <= totalPages; i++) { %>
              <li>
                <a
                  href="?page=<%= i %>&search=<%= search %>"
                  class="px-4 py-2 border rounded-lg <%= currentPage===i ? 'bg-indigo-600 text-white' : 'bg-white hover:bg-gray-100' %>"
                >
                  <%= i %>
                </a>
              </li>
              <% } %>
            </ul>
          </div>
        </div>
      </main>
    </div>

    <script>
      function searchOrders() {
        const q = document.getElementById("searchInput").value.trim();
        window.location.href = `/admin/orders?search=${encodeURIComponent(q)}`;
      }

      function clearSearch() {
        window.location.href = "/admin/orders";
      }
      function toggleStatusMenu(itemId) {
        document
          .querySelectorAll("[id^='status-menu-']")
          .forEach((menu) => menu.classList.add("hidden"));

        const menu = document.getElementById(`status-menu-${itemId}`);
        menu.classList.toggle("hidden");
      }

      function updateStatus(orderId, itemId, newStatus) {
        fetch(`/admin/orders/${orderId}/item/${itemId}/status`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ status: newStatus }),
        })
          .then((res) => res.json())
          .then((data) => {
            if (data.success) {
              const badge = document.getElementById(`status-badge-${itemId}`);

              // Update badge text
              badge.textContent = newStatus;

              // Update badge color class
              badge.className = `badge ${newStatus}`;

              // Hide dropdown
              document
                .getElementById(`status-menu-${itemId}`)
                .classList.add("hidden");

              Swal.fire(
                "Updated",
                "Order item status changed successfully",
                "success"
              );
            } else {
              Swal.fire("Error", "Failed to update status", "error");
            }
          });
      }
    </script>
  </body>
</html>
