<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Management | ReadNest Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/admin/css/orderList.css">
</head>

<body class="bg-gray-100 min-h-screen lg:overflow-hidden">

    <header class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-600 focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
            <a href="/admin" class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-book-open text-white text-xl"></i>
                </div>
                <span class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase">ReadNest</span>
            </a>
        </div>
        <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100">
            <i class="fas fa-user-shield text-indigo-600"></i>
            <span class="text-xs font-black text-gray-700 uppercase tracking-widest">Order Admin</span>
        </div>
    </header>

    <div class="flex">
        <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none">
            <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
                <a href="/admin" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-box w-8 text-lg"></i> Products</a>
                <a href="/admin/orders" class="sidebar-item active flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a>
                <a href="/admin/users" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-users w-8 text-lg"></i> Customers</a>
                <a href="/admin/category" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-th w-8 text-lg"></i> Category</a>
                <a href="/admin/coupon" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a>
                <a href="/admin/blogs" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-blog w-8 text-lg"></i> Blogs</a>
                <a href="/admin/banner" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-image w-8 text-lg"></i> Banner</a>
                <a href="/admin/logout" class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a>
            </nav>
        </aside>

        <main class="main-content flex-1 p-4 sm:p-8 lg:p-12 no-scrollbar bg-gray-50 w-full">
            <div class="max-w-7xl mx-auto">
                <div class="mb-6"><%- include('../../views/partials/breadCrumb') %></div>

                <div class="mb-10">
                    <h1 class="text-2xl sm:text-4xl font-black text-gray-900 tracking-tight uppercase leading-tight">Order Logs</h1>
                    <p class="text-gray-500 text-sm font-medium mt-1">Monitor and fulfill store transactions</p>
                </div>

                <div class="bg-white p-6 rounded-t-[2.5rem] border border-gray-100 flex flex-col lg:flex-row gap-4 items-center justify-between shadow-sm">
                    <div class="flex flex-1 w-full gap-3">
                        <div class="relative flex-1 group">
                            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-300 group-focus-within:text-indigo-500 transition-colors"></i>
                            <input id="searchInput" type="text" value="<%= search || '' %>" placeholder="ID or Customer Name..." 
                                   class="w-full pl-12 pr-12 py-3.5 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 focus:bg-white outline-none transition-all font-bold text-sm" />
                        </div>
                        <button onclick="searchOrders()" class="bg-indigo-600 text-white px-8 py-3.5 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition active:scale-95">
                            Search
                        </button>
                        <% if (search) { %>
                            <button onclick="clearSearch()" class="bg-gray-100 text-gray-400 px-6 py-3.5 rounded-2xl font-black text-[10px] uppercase tracking-widest hover:bg-rose-500 hover:text-white transition-all">
                                <i class="fas fa-times"></i>
                            </button>
                        <% } %>
                    </div>

                    <div class="relative w-full lg:w-48 filter-wrapper">
                        <button onclick="toggleFilterMenu()" class="w-full px-6 py-3.5 bg-gray-50 border-2 border-transparent rounded-2xl flex items-center justify-between font-black text-[10px] uppercase tracking-widest text-gray-600 hover:bg-white hover:border-indigo-100 transition-all">
                            <span><i class="fas fa-filter mr-2"></i> Filter: <%= statusFilter || 'All' %></span>
                            <i class="fas fa-chevron-down opacity-50"></i>
                        </button>
                        <div id="filterMenu" class="hidden absolute right-0 mt-3 bg-white shadow-2xl border border-gray-100 rounded-[1.5rem] w-56 z-50 overflow-hidden animate-in fade-in zoom-in-95 duration-200">
                            <div class="p-4 border-b border-gray-50 bg-gray-50/50 text-[8px] font-black text-gray-400 uppercase tracking-widest">Select Status</div>
                            <% ['processing', 'partially_cancelled', 'cancelled', 'completed'].forEach(st => { %>
                                <a href="?status=<%= st %>" class="block px-6 py-3 text-xs font-bold text-gray-600 hover:bg-indigo-50 hover:text-indigo-600 transition capitalize"><%= st.replace('_', ' ') %></a>
                            <% }) %>
                            <a href="/admin/orders" class="block px-6 py-4 text-[10px] font-black uppercase tracking-widest text-rose-500 hover:bg-rose-50 transition border-t border-gray-50">Clear Filter</a>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-b-[2.5rem] shadow-xl shadow-indigo-900/5 border border-gray-100 overflow-hidden mb-20">
                    <div class="overflow-x-auto no-scrollbar">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-900 text-white text-[10px] font-black uppercase tracking-widest">
                                    <th class="px-8 py-5">Order ID</th>
                                    <th class="px-8 py-5">Customer Profile</th>
                                    <th class="px-8 py-5 hidden md:table-cell text-center">Items</th>
                                    <th class="px-8 py-5">Workflow State</th>
                                    <th class="px-8 py-5 text-right">Activity</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <% if (!orders || orders.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="py-24 text-center">
                                            <div class="bg-gray-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                                                <i class="fas fa-box-open text-gray-200 text-3xl"></i>
                                            </div>
                                            <p class="text-gray-400 font-black uppercase tracking-widest text-xs">Zero Orders Found</p>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% orders.forEach(function(order) { %>
                                        <tr class="hover:bg-indigo-50/30 transition-colors group">
                                            <td class="px-8 py-6 font-black text-indigo-600 tracking-wider">
                                                #<%= order.orderId %>
                                            </td>
                                            <td class="px-8 py-6">
                                                <p class="font-black text-gray-800 tracking-tight leading-tight"><%= order.user?.name %></p>
                                                <p class="text-[10px] text-gray-400 font-bold truncate max-w-[150px] lowercase italic"><%= order.user?.email %></p>
                                                <p class="md:hidden text-[9px] text-indigo-400 mt-1 uppercase font-bold"><%= new Date(order.createdAt).toLocaleDateString() %></p>
                                            </td>
                                            <td class="px-8 py-6 hidden md:table-cell text-center">
                                                <span class="w-8 h-8 rounded-lg bg-gray-50 border border-gray-100 flex items-center justify-center mx-auto text-xs font-black text-gray-500">
                                                    <%= order.items ? order.items.length : 0 %>
                                                </span>
                                            </td>
                                            <td class="px-8 py-6">
                                                <% 
                                                    let bClass = "bg-gray-100 text-gray-600 border-gray-200";
                                                    if (order.overallStatus === "processing") bClass = "bg-amber-100 text-amber-700 border-amber-200";
                                                    else if (order.overallStatus === "cancelled") bClass = "bg-rose-100 text-rose-700 border-rose-200";
                                                    else if (order.overallStatus === "completed") bClass = "bg-emerald-100 text-emerald-700 border-emerald-200";
                                                %>
                                                <div class="flex flex-col gap-1">
                                                    <span class="px-4 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-widest border inline-block w-fit <%= bClass %>">
                                                        <%= order.overallStatus %>
                                                    </span>
                                                    <% if (order.hasReturnRequest) { %>
                                                        <span class="text-[8px] font-black text-purple-600 uppercase tracking-widest animate-pulse">● Return Requested</span>
                                                    <% } %>
                                                </div>
                                            </td>
                                            <td class="px-8 py-6 text-right">
                                                <a href="/admin/orders/<%= order.orderId %>" 
                                                   class="w-12 h-12 flex items-center justify-center bg-white border border-gray-100 text-indigo-600 rounded-2xl shadow-sm hover:bg-indigo-600 hover:text-white transition-all ml-auto group-hover:shadow-indigo-100">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% if (totalPages > 1) { %>
                        <div class="flex justify-center sm:justify-end items-center gap-2 p-8 border-t border-gray-50 bg-gray-50/30">
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <a href="?page=<%= i %>&search=<%= search %>&status=<%= statusFilter %>" 
                                   class="w-10 h-10 flex items-center justify-center rounded-xl font-black text-xs transition-all <%= currentPage===i ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-white text-gray-400 border border-gray-100 hover:bg-gray-50' %>">
                                    <%= i %>
                                </a>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>
    <script src="/admin/js/orderList.js"></script>
</body>
</html>