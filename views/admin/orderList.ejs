<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Orders - ReadNest</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: all 0.3s ease;
      }

      .sidebar-item:hover {
        background-color: #d1d5db;
      }

      .sidebar-item.active {
        background-color: #d1d5db;
      }

      .badge {
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        display: inline-block;
        text-transform: capitalize;
      }

      .badge.processing {
        background: #fef3c7;
        color: #92400e;
      }

      .badge.partially_cancelled {
        background: #fde68a;
        color: #b45309;
      }

      .badge.cancelled {
        background: #fee2e2;
        color: #991b1b;
      }

      .badge.completed {
        background: #d1fae5;
        color: #065f46;
      }

      .badge.Multiple {
        background: #e0e7ff;
        color: #4338ca;
      }

      html,
      body {
        height: 100%;
        overflow: hidden;
      }

      .main-scroll-area {
        height: calc(100vh - 80px);
        overflow-y: auto;
        overflow-x: hidden;
      }
    </style>
  </head>

  <body class="bg-gray-100">
    <!-- HEADER -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <!-- Logo -->
        <a href="/admin">
          <div class="flex items-center space-x-3">
            <div
              class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div>
        </a>

        <!-- Right Side -->
        <div class="flex items-center space-x-6">
          <button
            class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition"
          >
            <i class="fas fa-blog text-gray-700"></i>
            <span class="text-base font-semibold text-gray-900">Blog</span>
          </button>

          <div class="flex items-center space-x-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="text-base font-semibold text-gray-600">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <!-- LAYOUT -->
    <div class="flex">
      <!-- SIDEBAR -->
      <aside
        class="w-80 bg-gray-300 h-[calc(100vh-80px)] border-r border-gray-400 flex flex-col"
      >
        <nav class="flex-1 overflow-y-auto py-4">
          <a
            href="/admin"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th-large text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">DashBoard</span>
          </a>

          <a
            href="/admin/products"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-box text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Products</span>
          </a>

          <a
            href="/admin/orders"
            class="sidebar-item active flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-shopping-bag text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Orders List</span>
          </a>

          <a
            href="/admin/users"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-users text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Customers</span>
          </a>

          <a
            href="/admin/sales"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-chart-line text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Sales</span>
          </a>

          <a
            href="/admin/category"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Category</span>
          </a>

          <a
            href="/admin/coupon"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-ticket-alt text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Voucher</span>
          </a>

          <a
            href="/admin/banner"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-image text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Banner</span>
          </a>
        </nav>

        <!-- Logout -->
        <div class="border-t-2 border-gray-400 bg-gray-300">
          <a href="/admin/logout">
            <button
              class="w-full flex items-center px-6 py-5 hover:bg-red-50 transition-colors group"
            >
              <i
                class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"
              ></i>
              <span
                class="text-lg font-semibold text-gray-900 group-hover:text-red-600"
                >LOG OUT</span
              >
            </button>
          </a>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="main-scroll-area flex-1 p-8 bg-gray-200">
        <div class="bg-white rounded-2xl shadow-md border">
          <!-- SEARCH & FILTER -->
          <div class="p-6 border-b">
            <h2 class="text-2xl font-bold mb-4">Orders List</h2>
            <%- include('../../views/partials/breadcrumb') %>
            <div class="flex gap-3 items-center justify-between">
              <!-- SEARCH -->
              <div class="flex gap-3 flex-1">
                <div class="relative flex-1 max-w-md">
                  <input
                    id="searchInput"
                    value="<%= search || '' %>"
                    type="text"
                    placeholder="Search Order ID / User"
                    class="w-full px-4 py-3 pl-10 bg-gray-100 rounded-lg border"
                  />
                  <i
                    class="fas fa-search absolute left-3 top-4 text-gray-400"
                  ></i>
                </div>

                <button
                  onclick="searchOrders()"
                  class="px-6 py-3 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700"
                >
                  Search
                </button>

                <% if (search) { %>
                <button
                  onclick="clearSearch()"
                  class="px-6 py-3 bg-gray-600 text-white rounded-lg font-semibold hover:bg-gray-700"
                >
                  Clear
                </button>
                <% } %>
              </div>

              <!-- FILTER DROPDOWN -->
              <div class="relative filter-wrapper">
                <button
                  onclick="toggleFilterMenu()"
                  class="px-4 py-3 bg-white border rounded-lg shadow-sm hover:bg-gray-100 flex items-center gap-2"
                >
                  <i class="fas fa-filter text-gray-700"></i>
                  <span class="font-semibold">Filter</span>
                </button>

                <div
                  id="filterMenu"
                  class="hidden absolute right-0 mt-2 bg-white shadow-lg border rounded-lg w-48 z-50"
                >
                  <a
                    href="?status=processing"
                    class="block px-4 py-2 hover:bg-gray-100"
                    >Processing</a
                  >
                  <a
                    href="?status=partially_cancelled"
                    class="block px-4 py-2 hover:bg-gray-100"
                    >Partially Cancelled</a
                  >
                  <a
                    href="?status=cancelled"
                    class="block px-4 py-2 hover:bg-gray-100"
                    >Cancelled</a
                  >
                  <a
                    href="?status=completed"
                    class="block px-4 py-2 hover:bg-gray-100"
                    >Completed</a
                  >
                  <a
                    href="/admin/orders"
                    class="block px-4 py-2 hover:bg-gray-100 text-red-600 font-semibold"
                    >Clear Filter</a
                  >
                </div>
              </div>
            </div>
          </div>

          <!-- TABLE -->
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-gray-900 text-white text-sm">
                  <th class="px-6 py-4 border">Order ID</th>
                  <th class="px-6 py-4 border">Customer</th>
                  <th class="px-6 py-4 border">Placed Date</th>
                  <th class="px-6 py-4 border">Items</th>
                  <th class="px-6 py-4 border">Status</th>
                  <th class="px-6 py-4 border text-center">View</th>
                </tr>
              </thead>

              <tbody>
                <% if (!orders || orders.length === 0) { %>
                <tr>
                  <td colspan="6" class="py-6 text-center text-gray-500">
                    No Orders Found
                  </td>
                </tr>
                <% } else { %> <% orders.forEach(function(order) { %>
                <tr class="border-b hover:bg-gray-50">
                  <!-- ORDER ID -->
                  <td
                    class="px-6 py-4 border text-indigo-600 font-semibold relative"
                  >
                    #<%= order.orderId %>
                  </td>

                  <!-- CUSTOMER -->
                  <td class="px-6 py-4 border">
                    <p class="font-semibold">
                      <%= order.user ? order.user.name : '' %>
                    </p>
                    <p class="text-sm text-gray-500">
                      <%= order.user ? order.user.email : '' %>
                    </p>
                  </td>

                  <!-- PLACED DATE -->
                  <td class="px-6 py-4 border text-gray-600">
                    <%= new Date(order.createdAt).toLocaleString() %>
                  </td>

                  <!-- NUMBER OF ITEMS -->
                  <td class="px-6 py-4 border font-semibold text-center">
                    <%= order.items ? order.items.length : 0 %>
                  </td>

                  <!-- OVERALL STATUS + DROPDOWN -->
                  <td class="px-6 py-4 border relative order-status-wrapper">
                    <div
                      class="badge cursor-pointer <%= order.overallStatus %> status-badge"
                     
                      id="order-status-<%= order._id %>"
                    >
                      <%= order.overallStatus %>
                    </div>

                    <!-- ORDER STATUS CHANGE MENU -->
                    <div
                      id="order-menu-<%= order._id %>"
                      class="order-menu hidden absolute right-0 mt-2 bg-white shadow-lg border rounded-lg w-40 z-50"
                    >
                      <% if (order.hasReturnRequest === true) { %>
                      <div
                        class="px-4 py-2 bg-purple-50 text-purple-700 font-medium cursor-default"
                      >
                        Return Requested
                      </div>
                      <% } else { %>

                      <div
                       
                        class="px-4 py-2 hover:bg-gray-100 cursor-pointer"
                      >
                        Processing
                      </div>

                      <div
                       
                        class="px-4 py-2 hover:bg-gray-100 cursor-pointer"
                      >
                        Partially Cancelled
                      </div>

                      <div
                        
                        class="px-4 py-2 hover:bg-gray-100 text-red-600 cursor-pointer"
                      >
                        Cancelled
                      </div>

                      <div
                       
                        class="px-4 py-2 hover:bg-gray-100 cursor-pointer"
                      >
                        Completed
                      </div>

                      <% } %>
                    </div>
                  </td>

                  <!-- VIEW BUTTON -->
                  <td class="px-6 py-4 border text-center">
                    <a
                      href="/admin/orders/<%= order.orderId %>"
                      class="text-indigo-600 text-xl hover:text-indigo-800"
                      title="View Order"
                    >
                      <i class="fas fa-eye"></i>
                    </a>
                  </td>
                </tr>
                <% }); %> <% } %>
              </tbody>
            </table>
          </div>

          <!-- PAGINATION -->
          <div class="flex justify-end p-6 border-t">
            <ul class="flex gap-2">
              <% for (let i = 1; i <= totalPages; i++) { %>
              <li>
                <a
                  href="?page=<%= i %>&search=<%= search %>&status=<%= statusFilter %>"
                  class="px-4 py-2 border rounded-lg <%= currentPage===i ? 'bg-indigo-600 text-white' : 'bg-white hover:bg-gray-100' %>"
                >
                  <%= i %>
                </a>
              </li>
              <% } %>
            </ul>
          </div>
        </div>
      </main>
    </div>

    <script>
      // ------- SEARCH -------
      function searchOrders() {
        var q = document.getElementById("searchInput").value.trim();
        window.location.href = "/admin/orders?search=" + encodeURIComponent(q);
      }

      function clearSearch() {
        window.location.href = "/admin/orders";
      }

      // ------- FILTER MENU -------
      function toggleFilterMenu() {
        var menu = document.getElementById("filterMenu");
        menu.classList.toggle("hidden");
      }

      // Close filter menu on outside click
      document.addEventListener("click", function (event) {
        var menu = document.getElementById("filterMenu");
        var wrapper = document.querySelector(".filter-wrapper");

        if (!menu) return;

        if (
          !wrapper.contains(event.target) && // click outside filter area
          !menu.classList.contains("hidden")
        ) {
          menu.classList.add("hidden");
        }
      });

      // ------- ORDER STATUS MENUS -------
      function closeAllOrderMenus() {
        var menus = document.querySelectorAll(".order-menu");
        menus.forEach(function (m) {
          m.classList.add("hidden");
        });
      }

      function toggleOrderStatusMenu(orderId) {
        // Close all other menus first
        closeAllOrderMenus();

        var menu = document.getElementById("order-menu-" + orderId);
        if (menu) {
          menu.classList.toggle("hidden");
        }
      }

      // Close order status menus on outside click
      document.addEventListener("click", function (event) {
        const isStatusCell = event.target.closest(".order-status-wrapper");
        if (!isStatusCell) {
          closeAllOrderMenus();
        }
      });
    </script>
  </body>
</html>
