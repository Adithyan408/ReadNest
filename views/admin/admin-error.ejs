<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Admin Access Error | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/admin/css/admin-error.css">
</head>

<body class="flex flex-col items-center justify-center min-h-screen p-6 overflow-x-hidden">
    
    <div class="fixed top-[-10%] left-[-10%] w-[40%] h-[40%] bg-indigo-600/10 blur-[120px] pointer-events-none"></div>
    <div class="fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-purple-600/10 blur-[120px] pointer-events-none"></div>

    <div class="max-w-3xl w-full text-center relative z-10">
        
        <div class="mb-2">
            <h1 class="text-8xl sm:text-9xl font-black italic tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-indigo-400 to-indigo-700 glitch">
                404
            </h1>
        </div>

        <div class="mb-10">
            <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-widest text-white mb-4">
                Access Point Missing
            </h2>
            <div class="h-1 w-20 bg-indigo-500 mx-auto rounded-full mb-6"></div>
            <p class="text-gray-400 text-sm sm:text-base leading-relaxed max-w-lg mx-auto">
                The administrative resource you requested is unavailable or has been relocated within the secure sector.
            </p>
        </div>

        <div class="flex justify-center mb-12">
            <div class="relative">
                <div class="absolute inset-0 bg-indigo-500/20 blur-3xl rounded-full animate-pulse"></div>
                
                <div class="admin-blur-bg w-40 h-52 sm:w-48 sm:h-60 rounded-[2.5rem] flex flex-col items-center justify-center shadow-2xl floating-shield relative">
                    <div class="w-16 h-16 bg-indigo-500/20 rounded-2xl flex items-center justify-center mb-4">
                        <i class="fas fa-user-shield text-indigo-400 text-4xl"></i>
                    </div>
                    <p class="text-[10px] font-black text-indigo-300 uppercase tracking-[0.3em]">Restricted</p>
                    <p class="text-xs font-bold text-gray-500 mt-1 uppercase">Admin Zone</p>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-center gap-4 max-w-md mx-auto">
            <button
                onclick="goDashboard()"
                class="flex-1 px-8 py-4 bg-indigo-600 text-white text-xs font-black uppercase tracking-widest rounded-2xl shadow-xl shadow-indigo-900/40 hover:bg-indigo-500 active:scale-95 transition-all flex items-center justify-center gap-3"
            >
                <i class="fas fa-th-large"></i> Dashboard
            </button>
            <button
                onclick="goBack()"
                class="flex-1 px-8 py-4 bg-gray-800 text-gray-300 text-xs font-black uppercase tracking-widest rounded-2xl border border-gray-700 hover:bg-gray-700 hover:text-white active:scale-95 transition-all flex items-center justify-center gap-3"
            >
                <i class="fas fa-chevron-left"></i> Go Back
            </button>
        </div>

        <div class="mt-16 flex items-center justify-center gap-4 opacity-30">
            <div class="h-[1px] w-12 bg-gray-500"></div>
            <p class="text-[10px] font-bold uppercase tracking-[0.4em] text-gray-400">
                ReadNest Security Protocol
            </p>
            <div class="h-[1px] w-12 bg-gray-500"></div>
        </div>
    </div>

    <script src="/admin/js/admin-error.js"></script>
</body>
</html>