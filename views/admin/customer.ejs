<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Management | ReadNest Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
   <link rel="stylesheet" href="/admin/css/customer.css">
  </head>

  <body class="bg-gray-100 min-h-screen lg:overflow-hidden">
    <header
      class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between"
    >
      <div class="flex items-center gap-4">
        <button
          onclick="toggleSidebar()"
          class="lg:hidden text-gray-600 focus:outline-none"
        >
          <i class="fas fa-bars text-2xl"></i>
        </button>
        <a href="/admin" class="flex items-center space-x-3">
          <div
            class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg"
          >
            <i class="fas fa-book-open text-white text-xl"></i>
          </div>
          <span
            class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase"
            >ReadNest</span
          >
        </a>
      </div>

      <div
        class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100"
      >
        <i class="fas fa-user-shield text-indigo-600"></i>
        <span class="text-xs font-black text-gray-700 uppercase tracking-widest"
          >Admin Panel</span
        >
      </div>
    </header>

    <div class="flex">
      <aside
        id="sidebar"
        class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none"
      >
        <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
          <a
            href="/admin"
            class="sidebar-item flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"
            ><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a
          >
          <a
            href="/admin/products"
            class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"
            ><i class="fas fa-box w-8 text-lg"></i> Products</a
          >
          <a
            href="/admin/orders"
            class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"
            ><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a
          >
          <a
            href="/admin/users"
            class="sidebar-item active flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"
            ><i class="fas fa-users w-8 text-lg"></i> Customers</a
          >
          <a
            href="/admin/category"
            class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"
            ><i class="fas fa-th w-8 text-lg"></i> Category</a
          >
          <a
            href="/admin/coupon"
            class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"
            ><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a
          >
          <a
            href="/admin/blogs"
            class="sidebar-item flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"
            ><i class="fas fa-blog w-8 text-lg"></i> Blogs</a
          >
          <a
            href="/admin/banner"
            class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"
            ><i class="fas fa-image w-8 text-lg"></i> Banner</a
          >
          <a
            href="/admin/logout"
            class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"
            ><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a
          >
        </nav>
      </aside>

      <main
        class="main-content flex-1 p-4 sm:p-8 lg:p-12 no-scrollbar bg-gray-50 w-full"
      >
        <div class="max-w-7xl mx-auto">
          <div class="mb-6">
            <%- include('../../views/partials/breadCrumb') %>
          </div>

          <div class="mb-10">
            <h1
              class="text-2xl sm:text-4xl font-black text-gray-900 tracking-tight uppercase leading-tight"
            >
              Customer Database
            </h1>
            <p class="text-gray-500 text-sm font-medium mt-1">
              Manage user access and account statuses
            </p>
          </div>

          <div class="bg-white p-6 rounded-t-[2rem] border border-gray-100 border-b-0">
  <div class="flex flex-wrap items-center gap-2 max-w-xl">
    <!-- Search Input -->
    <div class="relative flex-1 min-w-[220px] group">
      <i
        class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-300 group-focus-within:text-indigo-500 transition-colors"
      ></i>
      <input
        type="text"
        id="customerSearch"
        placeholder="Search by name or email..."
        class="w-full pl-12 pr-4 py-4 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 focus:bg-white outline-none transition-all font-bold text-sm"
      />
    </div>

    <!-- Search Button -->
    <button
      onclick="searchCustomers()"
      class="px-6 py-4 bg-indigo-600 text-white rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-indigo-700 transition active:scale-95 flex items-center gap-2"
    >
      <i class="fas fa-search"></i>
      <span class="hidden sm:inline">Search</span>
    </button>

    <!-- Clear Button -->
    <button
      onclick="clearCustomerSearch()"
      class="px-6 py-4 bg-gray-100 text-gray-600 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-rose-500 hover:text-white transition active:scale-95 flex items-center gap-2"
    >
      <i class="fas fa-times"></i>
      <span class="hidden sm:inline">Clear</span>
    </button>
  </div>
</div>


          <div
            class="bg-white rounded-b-[2rem] shadow-xl shadow-indigo-900/5 border border-gray-100 overflow-hidden"
          >
            <div class="overflow-x-auto no-scrollbar">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr
                    class="bg-gray-900 text-white text-[10px] font-black uppercase tracking-widest"
                  >
                    <th class="px-8 py-5">Customer Profile</th>
                    <th class="px-8 py-5 hidden md:table-cell">
                      Wallet Credits
                    </th>
                    <th class="px-8 py-5">Access Status</th>
                    <th class="px-8 py-5 text-right">Restrict / Allow</th>
                  </tr>
                </thead>
                <tbody id="customerTableBody" class="divide-y divide-gray-50">
                  <% if (data.length === 0) { %>
                  <tr>
                    <td colspan="4" class="py-24 text-center">
                      <div
                        class="bg-gray-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4"
                      >
                        <i class="fas fa-user-slash text-gray-200 text-3xl"></i>
                      </div>
                      <p
                        class="text-gray-400 font-black uppercase tracking-widest text-xs"
                      >
                        No users found
                      </p>
                    </td>
                  </tr>
                  <% } else { %> <% data.forEach((userItem) => { %>
                  <tr class="hover:bg-indigo-50/30 transition-colors group">
                    <td class="px-8 py-6">
                      <div class="flex items-center gap-4">
                        <div
                          class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 font-black text-sm uppercase"
                        >
                          <%= userItem.name.charAt(0) %>
                        </div>
                        <div>
                          <p
                            class="font-black text-gray-800 tracking-tight leading-tight"
                          >
                            <%= userItem.name %>
                          </p>
                          <p
                            class="text-xs text-gray-400 font-medium truncate max-w-[150px] sm:max-w-xs lowercase"
                          >
                            <%= userItem.email %>
                          </p>
                        </div>
                      </div>
                    </td>
                    <td class="px-8 py-6 hidden md:table-cell">
                      <p class="text-sm font-black text-emerald-600">
                        ₹ <%= userItem.walletBalance || 0 %>
                      </p>
                      <p
                        class="text-[9px] font-bold text-gray-400 uppercase tracking-tighter"
                      >
                        Available
                      </p>
                    </td>
                    <td class="px-8 py-6">
                      <span
                        id="status-<%= userItem._id %>"
                        class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest border <%= userItem.isBlocked ? 'bg-rose-50 text-rose-600 border-rose-100' : 'bg-emerald-50 text-emerald-600 border-emerald-100' %>"
                      >
                        <%= userItem.isBlocked ? 'Blocked' : 'Active' %>
                      </span>
                    </td>
                    <td class="px-8 py-6 text-right">
                      <div class="flex justify-end">
                        <button
                          id="btn-<%= userItem._id %>"
                          onclick="confirmAction('<%= userItem._id %>', '<%= userItem.isBlocked ? 'unblock' : 'block' %>')"
                          class="<%= userItem.isBlocked ? 'bg-emerald-500 hover:bg-emerald-600 shadow-emerald-100' : 'bg-rose-500 hover:bg-rose-600 shadow-rose-100' %> text-white px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-lg transition active:scale-95"
                        >
                          <%= userItem.isBlocked ? 'Unblock' : 'Block' %>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% }) %> <% } %>
                </tbody>
              </table>
            </div>

            <% if (totalPages > 1) { %>
            <div
              class="flex justify-center sm:justify-end items-center gap-2 p-8 border-t border-gray-50 bg-gray-50/30"
            >
              <% for(let i = 1; i <= totalPages; i++) { %>
              <a
                href="?page=<%= i %>"
                class="w-10 h-10 flex items-center justify-center rounded-xl font-bold text-xs transition-all <%= (i === currentPage) ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-white text-gray-400 border border-gray-100 hover:bg-gray-50' %>"
              >
                <%= i %>
              </a>
              <% } %>
            </div>
            <% } %>
          </div>
        </div>
      </main>
    </div>

    <script src="/admin/js/customer.js"></script>
  </body>
</html>
