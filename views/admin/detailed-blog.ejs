<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogs - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: all 0.3s ease;
      }

      .sidebar-item:hover {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }

      .sidebar-item.active {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }
      html,
      body {
        height: 100%;
        overflow: hidden; /* disable full page scroll */
      }

      .main-scroll-area {
        height: calc(100vh - 80px); /* header height is ~80px */
        overflow-y: auto; /* enable vertical scroll only on the right */
        overflow-x: hidden;
      }
    </style>
  </head>
  <body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <!-- Logo -->
        <a href="/admin">
          <div class="flex items-center space-x-3">
            <div
              class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div>
        </a>

        <!-- Right Side -->
        <div class="flex items-center space-x-6">
          <a href="/admin/blogs">
            <button
              class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition"
            >
              <i class="fas fa-blog text-gray-700"></i>
              <span class="text-base font-semibold text-gray-900">Blog</span>
            </button>
          </a>

          <div class="flex items-center space-x-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="text-base font-semibold text-gray-600">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="flex">
      <!-- Sidebar -->
      <aside
        class="w-80 bg-gray-300 h-[calc(100vh-80px)] border-r border-gray-400 flex flex-col"
      >
        <nav class="flex-1 overflow-y-auto py-4">
          <a
            href="/admin"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th-large text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">DashBoard</span>
          </a>

          <a
            href="/admin/products"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-box text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Products</span>
          </a>

          <a
            href="/admin/orders"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-shopping-bag text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Orders List</span>
          </a>

          <a
            href="/admin/users"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-users text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Customers</span>
          </a>

          <a
            href="/admin/sales"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-chart-line text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Sales</span>
          </a>

          <a
            href="/admin/category"
            class="sidebar-item active flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Category</span>
          </a>

          <a
            href="/admin/coupon"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-ticket-alt text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Voucher</span>
          </a>

          <a
            href="/admin/banner"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-image text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Banner</span>
          </a>
        </nav>

        <!-- Logout Button at Bottom -->

        <div class="border-t-2 border-gray-400 bg-gray-300">
          <a href="/admin/logout">
            <button
              class="w-full flex items-center px-6 py-5 hover:bg-red-50 transition-colors group"
            >
              <i
                class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"
              ></i>
              <span
                class="text-lg font-semibold text-gray-900 group-hover:text-red-600"
                >Log Out</span
              >
            </button>
          </a>
        </div>
      </aside>

      <!-- Main Content - Categories -->
      <main class="flex-1 main-scroll-area px-6 py-6">
        <div class="max-w-3xl mx-auto bg-white shadow rounded-lg p-6">
          <!-- Title -->
          <button
            onclick="window.history.back()"
            class="inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-blue-800 mb-4"
          >
            <i class="fa-solid fa-arrow-left"></i>
            Back
          </button>
          <!-- BLOG HEADER -->
          <div class="border-b pb-4 mb-6">
            <div class="flex justify-between items-start">
              <div>
                <h1 class="text-3xl font-bold text-gray-900 mb-1">
                  <%= blog.title %>
                </h1>

                <p class="text-sm text-gray-500">
                  By
                  <span class="font-medium text-gray-700">
                    <%= blog.author?.name || "Unknown" %>
                  </span>
                  · <%= new Date(blog.createdAt).toLocaleString() %>
                </p>
              </div>

              <!-- ADMIN ACTIONS -->
              <div class="flex gap-3">
                <!-- BLOCK / UNBLOCK -->
                <button
                  onclick="toggleBlockBlog('<%= blog._id %>')"
                  class="px-4 py-2 text-sm rounded <%= blog.isBlocked ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>"
                >
                  <i class="fa-solid fa-ban"></i>
                  <%= blog.isBlocked ? "Unblock" : "Block" %>
                </button>
              </div>
            </div>
          </div>

          <!-- Blog Content -->
          <article class="prose max-w-none bg-gray-50 p-6 rounded-lg">
            <%- blog.content %>
          </article>

          <!-- Divider -->
          <hr class="my-8" />

          <!-- LIKE BUTTON -->
          <div class="flex items-center gap-2 text-gray-700 mb-6">
            <i class="fa-solid fa-heart text-red-500"></i>
            <span class="font-medium"><%= likeCount %></span>
            <span class="text-sm text-gray-500">likes</span>
          </div>

          <!-- COMMENTS -->
          <h3 class="mt-10 mb-4 font-semibold text-xl">
            Comments (<%= comments.length %>)
          </h3>

          <% if (comments.length === 0) { %>
          <p class="text-sm text-gray-500">No comments yet.</p>
          <% } %> <% comments.forEach(c => { %>
          <div class="border rounded-lg p-4 mb-4 bg-white">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-sm font-semibold text-gray-800">
                  <%= c.user?.name || "Unknown User" %>
                </p>
                <p class="text-xs text-gray-400 mb-2">
                  <%= new Date(c.createdAt).toLocaleString() %>
                </p>
                <p class="text-gray-700"><%= c.comment %></p>
              </div>

              <!-- ADMIN DELETE COMMENT -->
              <button
                onclick="deleteComment('<%= c._id %>')"
                class="text-red-500 hover:text-red-700"
                title="Delete comment"
              >
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
          <% }) %>
        </div>
      </main>
    </div>

    <script>
      function toggleBlockBlog(blogId) {
        Swal.fire({
          title: "Change blog visibility?",
          icon: "warning",
          showCancelButton: true,
          confirmButtonText: "Yes",
        }).then(async (result) => {
          if (result.isConfirmed) {
            const res = await fetch(`/admin/blog/block/${blogId}`, {
              method: "PATCH",
            });

            const data = await res.json();
            if (data.success) location.reload();
          }
        });
      }

      function deleteComment(commentId) {
        Swal.fire({
          title: "Delete this comment?",
          text: "This action cannot be undone",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#d33",
          confirmButtonText: "Delete",
        }).then(async (result) => {
          if (result.isConfirmed) {
            const res = await fetch(`/admin/blogs/comment/${commentId}`, {
              method: "DELETE",
            });

            const data = await res.json();
            if (data.success) {
              Swal.fire("Deleted!", "Comment removed", "success").then(() =>
                location.reload()
              );
            }
          }
        });
      }

      function toggleBlockBlog(blogId) {
        Swal.fire({
          title: "Change blog visibility?",
          text: "Blocked blogs will not be visible to users",
          icon: "warning",
          showCancelButton: true,
          confirmButtonText: "Yes",
        }).then(async (result) => {
          if (result.isConfirmed) {
            const res = await fetch(`/admin/blogs/block/${blogId}`, {
              method: "PATCH",
            });

            const data = await res.json();
            if (data.success) {
              Swal.fire("Updated!", "Blog status changed", "success").then(() =>
                location.reload()
              );
            }
          }
        });
      }
    </script>
  </body>
</html>
