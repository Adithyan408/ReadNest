<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Product - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <!-- Cropper CSS -->
    <link
      href="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.css"
      rel="stylesheet"
    />

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: all 0.3s ease;
      }

      .sidebar-item:hover {
        background-color: #d1d5db;
      }

      .sidebar-item.active {
        background-color: #d1d5db;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: scale(0.95);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      .animate-fadeIn {
        animation: fadeIn 0.2s ease-out;
      }
          html, body {
    height: 100%;
    overflow: hidden;  /* disable full page scroll */
  }

  .main-scroll-area {
    height: calc(100vh - 80px); /* header height is ~80px */
    overflow-y: auto;           /* enable vertical scroll only on the right */
    overflow-x: hidden;
  }
    </style>
  </head>
  <body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <!-- Logo -->
        <a href="/admin">
          <div class="flex items-center space-x-3">
            <div
              class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div>
        </a>

        <!-- Right Side -->
        <div class="flex items-center space-x-6">
          <a href="/admin/blogs">
            <button
              class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition"
            >
            <i class="fas fa-blog text-gray-700"></i>
            <span class="text-base font-semibold text-gray-900">Blog</span>
            </button>
      </a>


          <div class="flex items-center space-x-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="text-base font-semibold text-gray-600">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="flex">
      <!-- Sidebar -->
      <aside class="w-80 bg-gray-300 h-[calc(100vh-80px)] border-r border-gray-400 flex flex-col">
        <nav class="flex-1 overflow-y-auto py-4">
          <a
            href="/admin"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th-large text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">DashBoard</span>
          </a>

          <a
            href="/admin/products"
            class="sidebar-item active flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-box text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Products</span>
          </a>

          <a
            href="/admin/orders"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-shopping-bag text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Orders List</span>
          </a>

          <a
            href="/admin/users"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-users text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Customers</span>
          </a>

          <a
            href="/admin/sales"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-chart-line text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Sales</span>
          </a>

          <a
            href="/admin/category"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Category</span>
          </a>

          <a
            href="/admin/coupon"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-ticket-alt text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Voucher</span>
          </a>

          <a
            href="/admin/banner"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-image text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Banner</span>
          </a>
        </nav>

        <!-- Logout Button at Bottom -->
        <div class="border-t-2 border-gray-400 bg-gray-300">
          <a href="/admin/logout">
            <button
              class="w-full flex items-center px-6 py-5 hover:bg-red-50 transition-colors group"
            >
              <i
                class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"
              ></i>
              <span
                class="text-lg font-semibold text-gray-900 group-hover:text-red-600"
                >LOG OUT</span
              >
            </button>
          </a>
        </div>
      </aside>

      <!-- Main Content - Edit Product -->
      <main class="main-scroll-area flex-1 p-8 bg-gray-200 overflow-y-auto">
        <%- include('../../views/partials/breadcrumb') %>
        <div class="bg-white rounded-2xl shadow-lg">
          <!-- Header Section -->
          <div class="p-6 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <h2 class="text-3xl font-bold text-gray-900">
                Products >> <%= data.productName %>
              </h2>
              <a href="/admin/products">
                <button
                  class="px-6 py-2 bg-gray-500 text-white font-semibold rounded-lg hover:bg-gray-600 transition shadow-md"
                >
                  <i class="fas fa-arrow-left mr-2"></i>Back to Products
                </button>
              </a>
            </div>
          </div>

          <!-- Edit Form -->
          <div class="p-8">
            <form
              action="/admin/updateProduct?id=<%= data._id %>"
              method="POST"
              enctype="multipart/form-data"
            >
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Left Column - Product Image -->
                <div class="space-y-6">
                  <div class="space-y-6">
                    <div class="bg-gray-100 rounded-2xl p-8">
                      <div class="text-center">
                        <% if (data.productImage && data.productImage.length >
                        0) { %>
                        <div
                          id="productImagePreviewContainer"
                          class="flex flex-wrap justify-center gap-4 mb-6"
                        >
                          <% data.productImage.forEach(image => { %>
                          <div
                            class="relative group w-40 h-56"
                            data-existing-image-url="<%= image %>"
                          >
                            <img
                              src="<%= image %>"
                              class="w-full h-full object-cover rounded-lg shadow"
                            />

                            <!-- Replace Button -->
                            <button
                              type="button"
                              onclick="startReplaceImage('<%= image %>')"
                              class="absolute top-2 right-2 bg-blue-600 text-white px-2 py-1 rounded text-xs opacity-0 group-hover:opacity-100 transition"
                            >
                              Replace
                            </button>

                            <!-- Remove Button -->
                            <button
                              type="button"
                              onclick="removeExistingImage('<%= image %>')"
                              class="absolute bottom-2 right-2 bg-red-600 text-white px-2 py-1 rounded text-xs opacity-0 group-hover:opacity-100 transition"
                            >
                              Delete
                            </button>
                          </div>
                          <% }) %>
                        </div>
                        <% } else { %>
                        <div
                          id="productImagePreviewContainer"
                          class="w-64 h-80 bg-gray-300 rounded-lg flex items-center justify-center mx-auto mb-4"
                        >
                          <i class="fas fa-image text-gray-400 text-6xl"></i>
                        </div>
                        <% } %>

                        <!-- Hidden Old Images -->
                        <div id="oldImagesContainer">
                          <% if (data.productImage && data.productImage.length >
                          0) { %> <% data.productImage.forEach(image => { %>
                          <input
                            type="hidden"
                            name="oldImages[]"
                            value="<%= image %>"
                          />
                          <% }) %> <% } %>
                        </div>

                        <!-- Upload Button -->
                        <label
                          for="productImages"
                          class="inline-block px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition cursor-pointer shadow-md"
                        >
                          <i class="fas fa-upload mr-2"></i>Upload / Change
                          Images
                        </label>
                        <input
                          type="file"
                          id="productImages"
                          name="productImage"
                          accept="image/*"
                          multiple
                          class="hidden"
                        />

                        <!-- New Images Previews (Croppped) -->
                        <div
                          id="newImagesPreviewContainer"
                          class="flex flex-wrap justify-center gap-4 mt-6"
                        ></div>
                      </div>
                    </div>
                  </div>

                  <!-- Listing Status -->
                  <div class="bg-gray-50 rounded-xl p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-4">
                      Product Status
                    </h3>
                    <div class="flex items-center justify-between">
                      <span class="text-lg font-semibold text-gray-700"
                        >Listing Status:</span
                      >
                      <% if (data.isListed) { %>
                      <span
                        class="px-6 py-2 bg-green-200 text-green-800 rounded-full font-semibold"
                      >
                        <i class="fas fa-check-circle mr-2"></i>LISTED
                      </span>
                      <% } else { %>
                      <span
                        class="px-6 py-2 bg-red-200 text-red-800 rounded-full font-semibold"
                      >
                        <i class="fas fa-times-circle mr-2"></i>UNLISTED
                      </span>
                      <% } %>
                    </div>
                  </div>
                </div>

                <!-- Right Column - Product Details -->
                <div class="space-y-6">
                  <!-- Product Name -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Product Name <span class="text-red-600">*</span>
                    </label>
                    <input
                      type="text"
                      name="productName"
                      value="<%= data.productName %>"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
                      placeholder="Enter product name"
                    />
                  </div>
                  <!-- Category -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Category <span class="text-red-600">*</span>
                    </label>
                    <select
                      name="category"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base cursor-pointer"
                    >
                      <option value=""><%= data.category %></option>
                      <% categories.forEach(category => { %>
                      <option value="<%= category.categoryName %>">
                        <%= category.categoryName %>
                      </option>
                      <% }) %>
                    </select>
                  </div>

                  <!-- Language -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Language <span class="text-red-600">*</span>
                    </label>
                    <select
                      name="language"
                      class="w-full px-4 py-4 bg-white rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base appearance-none cursor-pointer shadow-sm"
                    >
                      <option value=""><%= data.language%></option>
                      <option value="English">English</option>
                      <option value="Malayalam">Malayalam</option>
                    </select>
                  </div>

                  <!-- Description -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Description
                    </label>
                    <textarea
                      name="description"
                      rows="3"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base resize-none"
                      placeholder="Enter product description"
                    ><%= data.description || '' %></textarea>
                  </div>

                  <!-- Author -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Author <span class="text-red-600">*</span>
                    </label>
                    <input
                      type="text"
                      name="author"
                      value="<%= data.author || '' %>"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
                      placeholder="Enter author name"
                    />
                  </div>

                  <!-- Author Description -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Author Description
                    </label>
                    <textarea
                      name="authorDescription"
                      rows="3"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base resize-none"
                      placeholder="Enter author description"
                    ><%= data.authorDescription || '' %></textarea>
                  </div>

                  <!-- Publisher -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Publisher <span class="text-red-600">*</span>
                    </label>
                    <input
                      type="text"
                      name="publisher"
                      value="<%= data.publisher || '' %>"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
                      placeholder="Enter publisher name"
                    />
                  </div>

                  <!-- Year of Publishing -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Year of Publishing <span class="text-red-600">*</span>
                    </label>
                    <input
                      type="number"
                      name="yearOfPublishing"
                      value="<%= data.yearOfPublishing || '' %>"
                      min="1800"
                      max="2100"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
                      placeholder="Enter year of publishing"
                    />
                  </div>

                  <!-- Pages -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Pages <span class="text-red-600">*</span>
                    </label>
                    <input
                      type="number"
                      name="pages"
                      value="<%= data.pages || '' %>"
                      min="1"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
                      placeholder="Enter number of pages"
                    />
                  </div>

                  <!-- Regular Price -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Regular Price <span class="text-red-600">*</span>
                    </label>
                    <input
                      type="number"
                      name="regularPrice"
                      value="<%= data.regularPrice || '' %>"
                      min="0"
                      step="0.01"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
                      placeholder="Enter regular price"
                    />
                  </div>
                  <!-- Offer Section -->
<div class="mt-6 p-4 border border-gray-300 rounded-lg bg-gray-50">

  <h3 class="text-lg font-bold text-gray-900 mb-4">Offer Details</h3>

  <!-- Enable Offer -->
  <div class="mb-4">
    <label class="block text-lg font-bold text-gray-900 mb-2">Enable Offer</label>
    <select
      name="isOffer"
      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 text-base"
    >
      <option 
        value="false" 
        <%= (!data.offer || data.offer.isOffer === false) ? "selected" : "" %>
      >
        No
      </option>

      <option 
        value="true" 
        <%= (data.offer && data.offer.isOffer === true) ? "selected" : "" %>
      >
        Yes
      </option>
    </select>
  </div>

  <!-- Discount Percentage -->
  <div class="mb-4">
    <label class="block text-lg font-bold text-gray-900 mb-2">Discount (%)</label>
    <input
      type="number"
      name="discountValue"
      placeholder="Enter discount percentage"
      step="0.01"
      min="0"
      max="100"
      value="<%= data.offer ? data.offer.discountValue : '' %>"
      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
    />
  </div>

  <!-- Offer Start Date -->
  <div class="mb-4">
    <label class="block text-lg font-bold text-gray-900 mb-2">Offer Start Date</label>
    <input
      type="date"
      name="startDate"
      value="<%= data.offer && data.offer.startDate 
                ? (typeof data.offer.startDate === 'string' 
                    ? data.offer.startDate 
                    : data.offer.startDate.toISOString().split('T')[0]) 
                : '' %>"
      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 text-base"
    />
  </div>

  <!-- Offer End Date -->
  <div class="mb-4">
    <label class="block text-lg font-bold text-gray-900 mb-2">Offer End Date</label>
    <input
      type="date"
      name="endDate"
      value="<%= data.offer && data.offer.endDate 
                ? (typeof data.offer.endDate === 'string' 
                    ? data.offer.endDate 
                    : data.offer.endDate.toISOString().split('T')[0]) 
                : '' %>"
      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 text-base"
    />
  </div>

</div>


                  <!-- Quantity (Stock) -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      Quantity <span class="text-red-600">*</span>
                    </label>
                    <input
                      type="number"
                      name="stock"
                      value="<%= data.stock || data.stock || '' %>"
                      min="0"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
                      placeholder="Enter stock quantity"
                    />
                  </div>

                  <!-- ISBN Number -->
                  <div>
                    <label class="block text-lg font-bold text-gray-900 mb-2">
                      ISBN Number
                    </label>
                    <input
                      type="text"
                      name="isbnNumber"
                      value="<%= data.isbnNumber || '' %>"
                      class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
                      placeholder="Enter ISBN number"
                    />
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div
                class="flex justify-center items-center gap-6 mt-8 pt-8 border-t border-gray-200"
              >
                <!-- UPDATE Button -->
                <button
                  type="submit"
                  class="px-12 py-4 bg-green-600 text-white font-bold text-lg rounded-lg hover:bg-green-700 transition shadow-lg"
                >
                  <i class="fas fa-save mr-2"></i>UPDATE
                </button>

                <!-- DELETE BUTTON (with SweetAlert2) -->
                <button
                  type="button"
                  onclick="confirmDelete('<%= data._id %>')"
                  class="px-12 py-4 bg-red-600 text-white font-bold text-lg rounded-lg hover:bg-red-700 transition shadow-lg"
                >
                  <i class="fas fa-trash-alt mr-2"></i>DELETE
                </button>

                <!-- CANCEL Button -->
                <a href="/admin/products">
                  <button
                    type="button"
                    class="px-12 py-4 bg-slate-500 text-white font-bold text-lg rounded-lg hover:bg-slate-600 transition shadow-lg"
                  >
                    <i class="fas fa-times mr-2"></i>CANCEL
                  </button>
                </a>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>

    <!-- Cropper Modal (local to this page) -->
    <div
      id="cropperModal"
      class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm flex items-center justify-center hidden z-50"
    >
      <div
        class="bg-white rounded-xl shadow-2xl p-4 w-[95%] max-w-xl animate-fadeIn"
      >
        <div class="flex items-center justify-between mb-3">
          <h2 id="cropperTitle" class="text-lg font-semibold text-gray-800">
            Crop Product Image (3:4)
          </h2>
          <button
            type="button"
            onclick="handleCropCancel()"
            class="text-gray-600 hover:text-gray-900 text-xl"
          >
            ✕
          </button>
        </div>

        <div
          class="h-[60vh] overflow-hidden flex items-center justify-center bg-gray-100 rounded-lg border"
        >
          <img
            id="cropperImage"
            class="max-w-full max-h-full select-none"
            alt="Crop preview"
          />
        </div>

        <div class="flex justify-end gap-3 mt-5">
          <button
            type="button"
            onclick="handleCropCancel()"
            class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-200 transition"
          >
            Cancel
          </button>
          <button
            id="cropperConfirmBtn"
            type="button"
            class="px-5 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition disabled:opacity-50"
          >
            Crop & Save
          </button>
        </div>
      </div>
    </div>

    <!-- Cropper JS -->
    <script src="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.js"></script>

    <script>
      /* ---------------------------
         DELETE PRODUCT
      --------------------------- */
      function confirmDelete(productId) {
        Swal.fire({
          title: "Are you sure?",
          text: "This action cannot be undone!",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#d33",
          cancelButtonColor: "#6b7280",
          confirmButtonText: "Yes, delete it!",
          cancelButtonText: "Cancel",
          reverseButtons: true,
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = `/admin/deleteProduct?id=${productId}`;
          }
        });
      }

      // -----------------------------
      // Cropper Logic (Page Local)
      // -----------------------------
      const fileInput = document.getElementById("productImages");
      const existingPreviewContainer = document.getElementById(
        "productImagePreviewContainer"
      );
      const newImagesPreviewContainer = document.getElementById(
        "newImagesPreviewContainer"
      );
      const oldImagesContainer = document.getElementById("oldImagesContainer");

      const cropperModal = document.getElementById("cropperModal");
      const cropperImage = document.getElementById("cropperImage");
      const cropperConfirmBtn = document.getElementById("cropperConfirmBtn");

      let cropper = null;
      let pendingFiles = [];
      let currentFileIndex = 0;
      let newCroppedFiles = []; // { file, url }
      let cropMode = null; // "add" | "replace"
      let replaceTargetOldUrl = null;

      // Handle new images selection
      fileInput.addEventListener("change", function (e) {
        const files = Array.from(e.target.files || []);
        if (!files.length) return;

        pendingFiles = files;
        currentFileIndex = 0;
        cropMode = "add";
        fileInput.value = "";

        openCropperForCurrentFile();
      });

      function openCropperForCurrentFile() {
        if (
          !pendingFiles.length ||
          currentFileIndex < 0 ||
          currentFileIndex >= pendingFiles.length
        ) {
          return;
        }

        const file = pendingFiles[currentFileIndex];
        const imageUrl = URL.createObjectURL(file);

        cropperImage.src = imageUrl;
        cropperModal.classList.remove("hidden");

        cropperImage.onload = function () {
          if (cropper) cropper.destroy();

          cropper = new Cropper(cropperImage, {
            aspectRatio: 3 / 4,
            viewMode: 1,
            autoCropArea: 1,
          });
        };
      }

      function closeCropperModal() {
        cropperModal.classList.add("hidden");
        if (cropper) {
          cropper.destroy();
          cropper = null;
        }
      }

      function handleCropCancel() {
        closeCropperModal();
        currentFileIndex++;
        if (currentFileIndex < pendingFiles.length) {
          openCropperForCurrentFile();
        } else {
          pendingFiles = [];
          currentFileIndex = 0;
          cropMode = null;
          replaceTargetOldUrl = null;
        }
      }

      cropperConfirmBtn.addEventListener("click", function () {
        if (!cropper) return;

        cropperConfirmBtn.disabled = true;
        cropperConfirmBtn.innerText = "Processing...";

        const canvas = cropper.getCroppedCanvas({
          width: 600,
          height: 800,
        });

        if (!canvas) {
          cropperConfirmBtn.disabled = false;
          cropperConfirmBtn.innerText = "Crop & Save";
          alert("Something went wrong while cropping.");
          return;
        }

        canvas.toBlob(
          function (blob) {
            cropperConfirmBtn.disabled = false;
            cropperConfirmBtn.innerText = "Crop & Save";

            if (!blob) {
              alert("Failed to generate cropped image.");
              return;
            }

            const fileName = `product_edit_${Date.now()}_${
              currentFileIndex + 1
            }.jpg`;
            const croppedFile = new File([blob], fileName, {
              type: "image/jpeg",
            });
            const url = URL.createObjectURL(croppedFile);

            const item = { file: croppedFile, url };
            newCroppedFiles.push(item);

            if (cropMode === "replace" && replaceTargetOldUrl) {
              replaceImage(replaceTargetOldUrl, item);
            } else {
              addNewImagePreview(item);
            }

            closeCropperModal();
            currentFileIndex++;
            if (currentFileIndex < pendingFiles.length) {
              openCropperForCurrentFile();
            } else {
              pendingFiles = [];
              currentFileIndex = 0;
              cropMode = null;
              replaceTargetOldUrl = null;
            }
          },
          "image/jpeg",
          0.9
        );
      });

      // Add preview for new cropped images
      function addNewImagePreview(item) {
        const box = document.createElement("div");
        box.className = "relative group w-40 h-56";
        box.dataset.newImageUrl = item.url;

        box.innerHTML = `
          <img src="${item.url}" class="w-full h-full object-cover rounded-lg shadow">
          <button type="button"
            class="absolute bottom-2 right-2 bg-red-600 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100">
            Delete
          </button>
        `;

        const deleteBtn = box.querySelector("button");
        deleteBtn.addEventListener("click", function () {
          removeNewImage(item.url);
        });

        newImagesPreviewContainer.appendChild(box);
      }

      // Remove existing image (old URL)
      function removeExistingImage(url) {
        // Remove preview card(s)
        document
          .querySelectorAll(
            `[data-existing-image-url="${CSS.escape ? CSS.escape(url) : url}"]`
          )
          .forEach((card) => card.remove());

        // Remove hidden input(s)
        if (oldImagesContainer) {
          oldImagesContainer
            .querySelectorAll(`input[value="${url}"]`)
            .forEach((input) => input.remove());
        }
      }

      // Start replace flow for an existing image
      function startReplaceImage(oldUrl) {
        const picker = document.createElement("input");
        picker.type = "file";
        picker.accept = "image/*";

        picker.onchange = (event) => {
          const file = event.target.files[0];
          if (!file) return;

          pendingFiles = [file];
          currentFileIndex = 0;
          cropMode = "replace";
          replaceTargetOldUrl = oldUrl;

          openCropperForCurrentFile();
        };

        picker.click();
      }

      // Replace: remove old existing image, add new cropped image
      function replaceImage(oldUrl, newItem) {
        removeExistingImage(oldUrl);
        addNewImagePreview(newItem);
      }

      // Remove a new cropped image
      function removeNewImage(url) {
        newCroppedFiles = newCroppedFiles.filter((item) => item.url !== url);

        document
          .querySelectorAll(
            `[data-new-image-url="${CSS.escape ? CSS.escape(url) : url}"]`
          )
          .forEach((card) => card.remove());
      }

      /* Show/Hide Sale Price when Offer Type changes */
document.getElementById("offerTypeSelect").addEventListener("change", function () {
  const saleWrapper = document.getElementById("salePriceWrapper");

  if (this.value === "combo" || this.value === "rush-hour") {
    saleWrapper.classList.remove("hidden");
  } else {
    saleWrapper.classList.add("hidden");
  }
});


      // Before submitting → attach new files to file input & basic validation
      const form = document.querySelector("form");
      form.addEventListener("submit", function (e) {
        const oldImagesCount =
          oldImagesContainer?.querySelectorAll("input[name='oldImages[]']")
            .length || 0;

        const totalImages = oldImagesCount + newCroppedFiles.length;

        if (totalImages === 0) {
          e.preventDefault();
          if (window.Swal) {
            Swal.fire(
              "Error",
              "Please keep at least one product image or upload a new one.",
              "error"
            );
          } else {
            alert(
              "Please keep at least one product image or upload a new one."
            );
          }
          return;
        }

        const dataTransfer = new DataTransfer();
        newCroppedFiles.forEach((item) => {
          dataTransfer.items.add(item.file);
        });

        fileInput.files = dataTransfer.files;
      });

      // Expose cancel handler for modal close button
      window.handleCropCancel = handleCropCancel;
      window.startReplaceImage = startReplaceImage;
      window.removeExistingImage = removeExistingImage;
    </script>
  </body>
</html>
