<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Product | ReadNest Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    <link href="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/admin/css/editProduct.css">
</head>

<body class="bg-gray-100 min-h-screen lg:overflow-hidden">

    <header class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-600 focus:outline-none"><i class="fas fa-bars text-2xl"></i></button>
            <a href="/admin" class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-book-open text-white text-xl"></i>
                </div>
                <span class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase">ReadNest</span>
            </a>
        </div>
        <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100">
            <i class="fas fa-user-shield text-indigo-600"></i>
            <span class="text-xs font-black text-gray-700 uppercase tracking-widest">Editor Mode</span>
        </div>
    </header>

    <div class="flex">
        <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none">
            <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
                <a href="/admin" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-item active flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-box w-8 text-lg"></i> Products</a>
                <a href="/admin/orders" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a>
                <a href="/admin/users" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-users w-8 text-lg"></i> Customers</a>
                <a href="/admin/category" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-th w-8 text-lg"></i> Category</a>
                <a href="/admin/coupon" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a>
                <a href="/admin/blogs" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-blog w-8 text-lg"></i> Blogs</a>
                <a href="/admin/banner" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-image w-8 text-lg"></i> Banner</a>
                <a href="/admin/logout" class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a>
            </nav>
        </aside>

        <main class="main-content flex-1 p-4 sm:p-8 lg:p-12 no-scrollbar bg-gray-50 w-full">
            <div class="max-w-6xl mx-auto">
                <div class="mb-6"><%- include('../../views/partials/breadCrumb') %></div>

                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
                    <div class="flex items-center gap-4">
                        <a href="/admin/products" class="w-10 h-10 flex items-center justify-center bg-white rounded-full text-gray-400 shadow-sm hover:text-gray-900 transition"><i class="fas fa-arrow-left"></i></a>
                        <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight uppercase truncate max-w-[250px] sm:max-w-lg"><%= data.productName %></h1>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border <%= data.isListed ? 'bg-emerald-50 text-emerald-600 border-emerald-100' : 'bg-rose-50 text-rose-600 border-rose-100' %>">
                            <%= data.isListed ? 'Listed' : 'Unlisted' %>
                        </span>
                    </div>
                </div>

                <form id="productForm" action="/admin/updateProduct?id=<%= data._id %>" method="POST" enctype="multipart/form-data" class="space-y-8 pb-10">
                    
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        
                        <div class="space-y-8">
                            <div class="bg-white rounded-[2rem] shadow-xl shadow-indigo-900/5 p-6 sm:p-10 border border-white">
                                <h2 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-6">Gallery Management</h2>
                                
                                <div id="productImagePreviewContainer" class="grid grid-cols-2 gap-4 mb-8">
                                    <% if (data.productImage && data.productImage.length > 0) { %>
                                        <% data.productImage.forEach(image => { %>
                                            <div class="relative group aspect-[3/4]" data-existing-image-url="<%= image %>">
                                                <img src="<%= image %>" class="w-full h-full object-cover rounded-2xl border border-gray-100 shadow-sm" />
                                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl flex flex-col items-center justify-center gap-2">
                                                    <button type="button" onclick="startReplaceImage('<%= image %>')" class="bg-white text-indigo-600 px-4 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest hover:bg-indigo-600 hover:text-white transition-all">Replace</button>
                                                    <button type="button" onclick="removeExistingImage('<%= image %>')" class="bg-rose-600 text-white px-4 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest hover:bg-rose-700 transition-all">Remove</button>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                    <div id="newImagesPreviewContainer" class="contents"></div>
                                </div>

                                <div id="oldImagesContainer">
                                    <% if (data.productImage) { data.productImage.forEach(image => { %>
                                        <input type="hidden" name="oldImages[]" value="<%= image %>" />
                                    <% })} %>
                                </div>

                                <button type="button" onclick="document.getElementById('productImages').click()" class="w-full py-4 border-2 border-dashed border-indigo-100 rounded-2xl text-indigo-400 hover:border-indigo-500 hover:text-indigo-600 transition-all flex items-center justify-center gap-3 font-bold text-sm bg-indigo-50/30">
                                    <i class="fas fa-plus-circle"></i> Add New Image
                                </button>
                                <input type="file" id="productImages" name="productImages" accept="image/*" multiple class="hidden" />
                                <p id="err-images" class="text-rose-500 text-[10px] font-bold mt-2 text-center hidden uppercase">Min 1 image required</p>
                            </div>

                            <div class="bg-white rounded-[2rem] shadow-xl shadow-indigo-900/5 p-6 sm:p-10 border border-white space-y-6">
  <h2 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-4">
    Metadata
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    
    <!-- ISBN -->
    <div>
      <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">
        ISBN
      </label>
      <input
        type="text"
        name="isbnNumber"
        value="<%= data.isbnNumber %>"
        class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 font-bold text-gray-800"
      />
    </div>

    <!-- Year of Publishing -->
    <div>
      <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">
        Year of Publishing
      </label>
      <input
        type="number"
        name="yearOfPublishing"
        id="yearOfPublishing"
        value="<%= data.yearOfPublishing %>"
        class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 font-bold text-gray-800"
      />
      <p id="err-yearOfPublishing" class="text-rose-500 text-[9px] font-bold mt-1 ml-2 hidden uppercase"></p>
    </div>

    <!-- Genre -->
    <div>
      <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">
        Genre
      </label>
      <select
        name="category"
        id="category"
        class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500 transition-all"
      >
        <option value="<%= data.category %>"><%= data.category %></option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.categoryName %>"><%= cat.categoryName %></option>
        <% }) %>
      </select>
    </div>

    <!-- Language -->
    <div>
      <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">
        Language
      </label>
      <select
        name="language"
        id="language"
        class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500"
      >
        <option value="<%= data.language %>"><%= data.language %></option>
        <option value="English">English</option>
        <option value="Malayalam">Malayalam</option>
      </select>
    </div>

  </div>
</div>

                        </div>

                        <div class="space-y-8">
                            <div class="bg-white rounded-[2rem] shadow-xl shadow-indigo-900/5 p-6 sm:p-10 border border-white space-y-6">
                                <h2 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-4">Product Info</h2>
                                <div>
                                    <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">Title *</label>
                                    <input type="text" name="productName" id="productName" value="<%= data.productName %>" class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 font-bold text-gray-800" />
                                    <p id="err-productName" class="text-rose-500 text-[9px] font-bold mt-1 ml-2 hidden uppercase"></p>
                                </div>
                                <div>
                                    <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">Synopsis</label>
                                    <textarea name="description" id="description" rows="4" class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 font-bold text-gray-800 resize-none"><%= data.description %></textarea>
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">Author *</label>
                                        <input type="text" name="author" id="author" value="<%= data.author %>" class="w-full px-4 py-3.5 bg-gray-50 border-2 border-transparent rounded-xl focus:border-indigo-500 font-bold text-gray-800" />
                                        <p id="err-author" class="text-rose-500 text-[9px] font-bold mt-1 ml-2 hidden uppercase"></p>
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">Publisher *</label>
                                        <input type="text" name="publisher" id="publisher" value="<%= data.publisher %>" class="w-full px-4 py-3.5 bg-gray-50 border-2 border-transparent rounded-xl focus:border-indigo-500 font-bold text-gray-800" />
                                        <p id="err-publisher" class="text-rose-500 text-[9px] font-bold mt-1 ml-2 hidden uppercase"></p>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-white rounded-[2rem] shadow-xl shadow-indigo-900/5 p-6 sm:p-10 border border-white space-y-6">
                                <div class="grid grid-cols-2 gap-8">
                                    <div class="space-y-4">
                                        <h3 class="text-xs font-black text-emerald-600 uppercase tracking-widest flex items-center gap-2"><i class="fas fa-coins"></i> Commerce</h3>
                                        <div>
                                            <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">Price (INR) *</label>
                                            <input type="number" name="regularPrice" id="regularPrice"  value="<%= data.regularPrice %>" class="w-full px-5 py-4 bg-emerald-50/50 rounded-2xl border-2 border-transparent focus:border-emerald-500 font-black text-emerald-700 text-xl" />
                                            <p id="err-regularPrice" class="text-rose-500 text-[9px] font-bold mt-1 ml-2 hidden uppercase"></p>
                                        </div>
                                        <div>
                                            <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1 block">Inventory *</label>
                                            <input type="number" name="stock" id="stock" value="<%= data.stock %>" class="w-full px-5 py-4 bg-gray-50 rounded-2xl border-2 border-transparent focus:border-indigo-500 font-black text-gray-800 text-xl" />
                                            <p id="err-stock" class="text-rose-500 text-[9px] font-bold mt-1 ml-2 hidden uppercase"></p>
                                        </div>
                                    </div>

                                    <div class="bg-indigo-50/30 p-6 rounded-3xl border border-indigo-50 space-y-4">
                                        <h3 class="text-xs font-black text-indigo-600 uppercase tracking-widest flex items-center gap-2"><i class="fas fa-bolt"></i> Discount</h3>
                                        <div>
                                            <select name="isOffer" id="isOffer" class="w-full px-3 py-2.5 bg-white border-2 border-gray-100 rounded-xl font-bold text-xs text-gray-700">
                                                <option value="false" <%= (!data.offer || !data.offer.isOffer) ? 'selected' : '' %>>No Promo</option>
                                                <option value="true" <%= (data.offer && data.offer.isOffer) ? 'selected' : '' %>>Enabled</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-[10px] font-black text-gray-500 uppercase ml-1 mb-1">Value (%)</label>
                                            <input type="number" name="discountValue" id="discountValue" value="<%= data.offer ? data.offer.discountValue : '' %>" class="w-full px-3 py-2 bg-white border-2 border-gray-100 rounded-xl font-bold text-indigo-600" />
                                            <p id="err-discountValue" class="text-rose-500 text-[9px] font-bold hidden"></p>
                                        </div>
                                        <div class="grid grid-cols-2 gap-2">
                                            <input type="date" name="startDate" id="startDate" value="<%= data.offer && data.offer.startDate ? (typeof data.offer.startDate === 'string' ? data.offer.startDate : data.offer.startDate.toISOString().split('T')[0]) : '' %>" class="w-full px-1 py-2 bg-white border border-gray-100 rounded-lg text-[10px] font-bold" />
                                            <input type="date" name="endDate" id="endDate" value="<%= data.offer && data.offer.endDate ? (typeof data.offer.endDate === 'string' ? data.offer.endDate : data.offer.endDate.toISOString().split('T')[0]) : '' %>" class="w-full px-1 py-2 bg-white border border-gray-100 rounded-lg text-[10px] font-bold" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-10 flex flex-col sm:flex-row gap-4">
                        <button type="submit" class="flex-1 bg-indigo-600 text-white py-6 rounded-3xl font-black text-sm uppercase tracking-[0.3em] shadow-2xl shadow-indigo-100 hover:bg-indigo-700 transition active:scale-95">Update Product Listing</button>
                        <button type="button" onclick="confirmDelete('<%= data._id %>')" class="px-12 py-6 bg-rose-50 text-rose-500 border-2 border-rose-100 rounded-3xl font-black text-sm uppercase tracking-widest hover:bg-rose-500 hover:text-white transition active:scale-95">Delete</button>
                        <button type="button" onclick="window.history.back()" class="px-12 py-6 bg-gray-100 text-gray-500 rounded-3xl font-bold text-sm uppercase tracking-widest hover:bg-gray-200 transition">Cancel</button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <div id="cropperModal" class="fixed inset-0 bg-black/90 backdrop-blur-md hidden flex flex-col justify-center items-center z-[100] p-4">
        <div class="bg-white rounded-[2.5rem] w-full max-w-xl overflow-hidden shadow-2xl">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h2 class="font-black text-gray-800 uppercase text-xs tracking-widest">Adjust Frame</h2>
                <button type="button" onclick="handleCropCancel()" class="w-10 h-10 flex items-center justify-center bg-gray-200 rounded-full text-xs">✕</button>
            </div>
            <div class="p-4 bg-gray-900 flex justify-center items-center max-h-[60vh] overflow-hidden"><img id="cropperImage" class="max-w-full block" /></div>
            <div class="p-6 bg-gray-50 flex flex-col sm:flex-row gap-3">
                <button type="button" onclick="handleCropCancel()" class="flex-1 py-4 rounded-2xl font-bold text-gray-500 bg-white">Cancel</button>
                <button type="button" id="cropperConfirmBtn" class="flex-1 py-4 rounded-2xl font-black text-xs uppercase bg-indigo-600 text-white shadow-lg">Save Crop</button>
            </div>
        </div>
    </div>

    <script>
    window.backendErrors = <%- JSON.stringify(errors || {}) %>;
    </script>
    <script src="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.js"></script>


    <script src="/admin/js/editProduct.js"></script>
</body>
</html>