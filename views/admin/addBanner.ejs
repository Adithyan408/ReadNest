<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Banner - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    <link rel="stylesheet" href="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.css"/>
    <script src="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.js"></script>
    <link rel="stylesheet" href="/admin/css/addBanner.css">
</head>

<body class="bg-gray-100 min-h-screen lg:overflow-hidden">

    <header class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-600 focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
            <a href="/admin" class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-book-open text-white text-xl"></i>
                </div>
                <span class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase">ReadNest</span>
            </a>
        </div>

        <div class="flex items-center space-x-3 sm:space-x-6">
            <a href="/admin/blogs" class="hidden sm:block">
                <button class="px-4 py-2 text-sm font-bold text-gray-600 hover:text-indigo-600 transition">Blogs</button>
            </a>
            <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100">
                <i class="fas fa-user-shield text-indigo-600"></i>
                <span class="text-xs font-black text-gray-700 uppercase tracking-widest">Admin</span>
            </div>
        </div>
    </header>

    <div class="flex">
        <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none">
            <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
                <a href="/admin" class="sidebar-item active flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-box w-8 text-lg"></i> Products</a>
                <a href="/admin/orders" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a>
                <a href="/admin/users" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-users w-8 text-lg"></i> Customers</a>
                <a href="/admin/category" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-th w-8 text-lg"></i> Category</a>
                <a href="/admin/coupon" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a>
                <a href="/admin/blogs" class="sidebar-item active flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-blog w-8 text-lg"></i> Blogs</a>
                <a href="/admin/banner" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-image w-8 text-lg"></i> Banner</a>
                <a href="/admin/logout" class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a>
            </nav>
        </aside>

        <main class="main-content flex-1 p-4 sm:p-8 lg:p-12 no-scrollbar bg-gray-50 w-full">
            <div class="max-w-4xl mx-auto">
                
                <div class="flex items-center gap-4 mb-8">
                    <a href="/admin/banner" class="w-10 h-10 flex items-center justify-center bg-white rounded-full text-gray-400 shadow-sm hover:text-gray-900 transition"><i class="fas fa-arrow-left"></i></a>
                    <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight uppercase">New Banner</h1>
                </div>

                <div class="bg-white rounded-[2rem] shadow-xl shadow-indigo-900/5 p-6 sm:p-10 border border-white">
                    <form id="bannerForm" action="/admin/banner/addBanner" method="POST" enctype="multipart/form-data" class="space-y-8">
                        
                        <div>
                            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Campaign Title</label>
                            <input type="text" name="title" placeholder="e.g. Summer Book Fest 2026" value="<%= oldInput?.title || '' %>"
                                   class="w-full px-6 py-4 bg-gray-50 rounded-2xl border-2 border-transparent focus:border-indigo-500 focus:bg-white outline-none transition-all font-bold text-gray-800" />
                            <% if (errors?.title) { %><p class="text-red-500 text-xs mt-2 font-bold ml-2"><%= errors.title %></p><% } %>
                        </div>

                        <div>
                            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Visual Content</label>
                            <div class="bg-gray-50 border-2 border-dashed border-gray-200 rounded-3xl p-8 sm:p-12 text-center group hover:border-indigo-400 transition-all cursor-pointer"
                                 onclick="document.getElementById('bannerImage').click()">
                                
                                <div id="uploadUI">
                                    <i class="fas fa-cloud-upload-alt text-5xl text-gray-300 group-hover:text-indigo-400 transition-colors mb-4"></i>
                                    <p class="text-sm font-bold text-gray-500">Tap to upload banner image</p>
                                    <p class="text-[10px] text-gray-400 mt-1 uppercase">JPG, PNG or WEBP (Max 2MB)</p>
                                </div>

                                <input type="file" id="bannerImage" name="bannerImage" accept="image/*" class="hidden"/>
                                <div id="bannerPreview" class="mt-4 flex justify-center"></div>
                            </div>
                            <% if (errors?.bannerImage) { %><p class="text-red-500 text-xs mt-2 font-bold ml-2"><%= errors.bannerImage %></p><% } %>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div>
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Status</label>
                                <select name="status" class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500 focus:bg-white transition-all">
                                    <option value="">Select Status</option>
                                    <option value="ACTIVE" <%= oldInput?.status === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                                    <option value="INACTIVE" <%= oldInput?.status === 'INACTIVE' ? 'selected' : '' %>>INACTIVE</option>
                                </select>
                                <% if (errors?.status) { %><p class="text-red-500 text-[10px] mt-2 font-bold ml-2 uppercase"><%= errors.status %></p><% } %>
                            </div>

                            <div>
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Start Date</label>
                                <input type="date" name="startDate" value="<%= oldInput?.startDate || '' %>"
                                       class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500 focus:bg-white transition-all" />
                                <% if (errors?.startDate) { %><p class="text-red-500 text-[10px] mt-2 font-bold ml-2 uppercase"><%= errors.startDate %></p><% } %>
                            </div>

                            <div>
                                <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">End Date</label>
                                <input type="date" name="endDate" value="<%= oldInput?.endDate || '' %>"
                                       class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent rounded-2xl font-bold text-gray-700 outline-none focus:border-indigo-500 focus:bg-white transition-all" />
                                <% if (errors?.endDate) { %><p class="text-red-500 text-[10px] mt-2 font-bold ml-2 uppercase"><%= errors.endDate %></p><% } %>
                            </div>
                        </div>

                        <div class="pt-6">
                            <button type="submit" class="w-full bg-indigo-600 text-white py-5 rounded-2xl font-black text-sm uppercase tracking-[0.2em] shadow-xl shadow-indigo-100 hover:bg-indigo-700 transition active:scale-[0.98]">
                                Add to Library
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <div id="cropperModal" class="fixed inset-0 bg-black/80 backdrop-blur-md hidden flex flex-col justify-center items-center z-[100] p-4">
        <div class="bg-white rounded-[2.5rem] w-full max-w-2xl overflow-hidden shadow-2xl animate-in zoom-in-95 duration-300">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h2 class="font-black text-gray-800 uppercase text-xs tracking-widest">Adjust Banner Frame</h2>
                <button onclick="cancelCrop()" class="w-10 h-10 flex items-center justify-center bg-gray-200 rounded-full text-xs text-gray-500">✕</button>
            </div>
            <div class="p-4 bg-gray-900 flex justify-center items-center max-h-[60vh] overflow-hidden">
                <img id="cropperImage" class="max-w-full block" />
            </div>
            <div class="p-6 bg-gray-50 flex flex-col sm:flex-row gap-3">
                <button onclick="cancelCrop()" class="flex-1 py-4 rounded-xl font-bold text-gray-500 bg-white border border-gray-200">Cancel</button>
                <button onclick="applyCrop()" class="flex-1 py-4 rounded-xl font-black text-xs uppercase tracking-widest bg-indigo-600 text-white shadow-lg shadow-indigo-100">Apply Changes</button>
            </div>
        </div>
    </div>

    <script src="/admin/js/addBanner.js"></script>
</body>
</html>