<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Banner - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: all 0.3s ease;
      }

      .sidebar-item:hover {
        background-color: #d1d5db;
      }

      .sidebar-item.active {
        background-color: #d1d5db;
      }

      .upload-area {
        border: 2px dashed #cbd5e0;
        transition: all 0.3s ease;
        min-height: 300px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .upload-area:hover {
        border-color: #667eea;
        background-color: #f7fafc;
      }

      #imagePreview img {
        max-width: 100%;
        max-height: 200px;
        object-fit: contain;
      }
    </style>
  </head>
  <body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <!-- Logo -->
        <a href="/admin">
          <div class="flex items-center space-x-3">
            <div
              class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div>
        </a>

        <!-- Right Side -->
        <div class="flex items-center space-x-6">
          <button
            class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition"
          >
            <i class="fas fa-blog text-gray-700"></i>
            <span class="text-base font-semibold text-gray-900">Blog</span>
          </button>

          <div class="flex items-center space-x-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="text-base font-semibold text-gray-600">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="flex">
      <!-- Sidebar -->
      <aside
        class="w-80 bg-gray-300 min-h-screen border-r border-gray-400 relative"
      >
        <nav class="py-4 pb-24">
          <a
            href="/admin"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th-large text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">DashBoard</span>
          </a>

          <a
            href="/admin/products"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-box text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Products</span>
          </a>

          <a
            href="/admin/orders"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-shopping-bag text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Orders List</span>
          </a>

          <a
            href="/admin/users"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-users text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Customers</span>
          </a>

          <a
            href="/admin/sales"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-chart-line text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Sales</span>
          </a>

          <a
            href="/admin/category"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Category</span>
          </a>

          <a
            href="/admin/voucher"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-ticket-alt text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Voucher</span>
          </a>

          <a
            href="/admin/banner"
            class="sidebar-item active flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-image text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Banner</span>
          </a>
        </nav>

        <!-- Logout Button at Bottom -->
        <div
          class="absolute bottom-0 left-0 right-0 bg-gray-300 border-t-2 border-gray-400"
        >
          <a href="/admin/logout">
            <button
              class="w-full flex items-center px-6 py-5 hover:bg-red-50 transition-colors group"
            >
              <i
                class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"
              ></i>
              <span
                class="text-lg font-semibold text-gray-900 group-hover:text-red-600"
                >LOG OUT</span
              >
            </button>
          </a>
        </div>
      </aside>

      <!-- Main Content - Add Banner Form -->
      <main class="flex-1 p-8 bg-gray-200">
        <div class="max-w-4xl mx-auto">
          <!-- Page Title -->
          <div class="mb-6">
            <h2 class="text-3xl font-bold text-gray-900">Banners</h2>
          </div>


          <!-- Form Card -->
          <div class="bg-gray-300 rounded-2xl shadow-lg p-8">
            <h3 class="text-2xl font-bold text-gray-900 text-center mb-8">
              ADD Banner
            </h3>

            <form
              id="bannerForm"
              action="/admin/addBanner"
              method="POST"
              enctype="multipart/form-data"
            >
              <div class="space-y-6">
                <!-- Title Input -->
                <div>
                  <input
                    type="text"
                    name="title"
                    id="bannerTitle"
                    placeholder="Title"
                    class="w-full px-4 py-4 bg-white rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base"
                    
                  />
                </div>

                <!-- Image Upload Section -->
                <div class="bg-white rounded-lg p-8">
                  <div class="upload-area rounded-lg p-8">
                    <div class="text-center">
                      <div class="mb-4">
                        <i class="fas fa-image text-6xl text-gray-400"></i>
                      </div>
                      <p class="text-gray-600 mb-4">
                        Drag and drop image or Click add image
                      </p>
                      <input
                        type="file"
                        name="bannerImage"
                        id="bannerImage"
                        accept="image/*"
                       
                
                      />
                      <button
                        type="button"
                        onclick="document.getElementById('bannerImage').click()"
                        class="px-8 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition"
                      >
                        ADD IMAGE
                      </button>
                      <div id="imagePreview" class="mt-6"></div>
                    </div>
                  </div>
                </div>

                <!-- Active Status, Starting Date, Ending Date -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                  <!-- Active Dropdown -->
                  <div>
                    <select
                      name="status"
                      id="activeStatus"
                      class="w-full px-4 py-4 bg-white rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base appearance-none cursor-pointer"
                      required
                    >
                      <option value="">Status</option>
                      <option value="ACTIVE">Active</option>
                      <option value="INACTIVE">INACTIVE</option>
                    </select>
                  </div>

                  <!-- Starting Date -->
                  <div>
                    <input
                      type="date"
                      name="startDate"
                      id="startDate"
                      placeholder="Starting Date"
                      class="w-full px-4 py-4 bg-white rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base text-gray-500"
                      required
                    />
                  </div>

                  <!-- Ending Date -->
                  <div>
                    <input
                      type="date"
                      name="endDate"
                      id="endDate"
                      placeholder="Ending Date"
                      class="w-full px-4 py-4 bg-white rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-base text-gray-500"
                      required
                    />
                  </div>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-center pt-6">
                  <button
                    type="submit"
                    class="px-20 py-4 bg-indigo-600 text-white text-lg font-bold rounded-lg hover:bg-indigo-700 transition shadow-lg"
                  >
                    ADD
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>

   
    
     
  </body>
</html>