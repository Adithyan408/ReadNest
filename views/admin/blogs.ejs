<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Management | ReadNest Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");
        * { font-family: "Poppins", sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        .sidebar-item.active { background: #f3f4f6; border-right: 4px solid #4f46e5; color: #4f46e5; }
        #sidebar { transition: transform 0.3s ease-in-out; z-index: 60; }
        
        @media (min-width: 1024px) {
            .main-content-scroll { height: calc(100vh - 80px); overflow-y: auto; }
        }
        
        .blog-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .blog-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05); }
    </style>
</head>

<body class="bg-gray-100 min-h-screen lg:overflow-hidden">

    <header class="bg-white shadow-md sticky top-0 z-50 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-600 focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
            <a href="/admin" class="flex items-center space-x-3">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-900 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-book-open text-white text-xl"></i>
                </div>
                <span class="text-xl sm:text-2xl font-black text-gray-800 tracking-tighter uppercase">ReadNest</span>
            </a>
        </div>

        <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-100">
            <i class="fas fa-user-shield text-indigo-600"></i>
            <span class="text-xs font-black text-gray-700 uppercase tracking-widest">Admin</span>
        </div>
    </header>

    <div class="flex">
       <aside id="sidebar" class="fixed inset-y-0 left-0 w-72 bg-white border-r border-gray-100 -translate-x-full lg:translate-x-0 lg:static lg:h-[calc(100vh-80px)] flex flex-col transition-transform duration-300 shadow-2xl lg:shadow-none">
            <nav class="flex-1 overflow-y-auto py-6 no-scrollbar space-y-1">
                <a href="/admin" class="sidebar-item  flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-th-large w-8 text-lg"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-box w-8 text-lg"></i> Products</a>
                <a href="/admin/orders" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-shopping-bag w-8 text-lg"></i> Orders</a>
                <a href="/admin/users" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-users w-8 text-lg"></i> Customers</a>
                <a href="/admin/category" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-th w-8 text-lg"></i> Category</a>
                <a href="/admin/coupon" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-ticket-alt w-8 text-lg"></i> Voucher</a>
                <a href="/admin/blogs" class="sidebar-item active flex items-center px-8 py-4 text-indigo-600 font-bold text-sm"><i class="fas fa-blog w-8 text-lg"></i> Blogs</a>
                <a href="/admin/banner" class="sidebar-item flex items-center px-8 py-4 text-gray-500 font-bold text-sm hover:text-indigo-600 transition-all"><i class="fas fa-image w-8 text-lg"></i> Banner</a>
                <a href="/admin/logout" class="flex items-center px-8 py-4 text-rose-500 font-bold text-sm mt-10 border-t border-gray-50 pt-8 hover:bg-rose-50 transition-colors"><i class="fas fa-sign-out-alt w-8 text-lg"></i> LOG OUT</a>
            </nav>
        </aside>

        <div class="flex-1 flex flex-col h-[calc(100vh-80px)] w-full">
            
            <section class="bg-white border-b border-gray-100 sticky top-0 z-40">
                <div class="max-w-6xl mx-auto px-6 sm:px-10 py-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight uppercase">Content Feed</h2>
                        <p class="text-gray-400 text-xs font-bold uppercase tracking-widest mt-1">Manage community stories</p>
                    </div>

                    <div class="relative group">
                        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-300 group-focus-within:text-indigo-500 transition-colors"></i>
                        <input
                            type="text"
                            id="blogSearch"
                            placeholder="Search by title..."
                            class="w-full md:w-72 pl-12 pr-10 py-3 bg-gray-50 border-2 border-transparent rounded-2xl focus:border-indigo-500 focus:bg-white outline-none transition-all font-bold text-sm"
                            oninput="searchBlogs(this.value)"
                        />
                        <button
                            id="clearSearchBtn"
                            onclick="clearSearch()"
                            class="hidden absolute right-3 top-1/2 -translate-y-1/2 w-6 h-6 flex items-center justify-center bg-gray-200 text-gray-500 rounded-full hover:bg-rose-500 hover:text-white transition-all"
                        >
                            <i class="fa-solid fa-xmark text-[10px]"></i>
                        </button>
                    </div>
                </div>
            </section>

            <main class="main-content-scroll flex-1 px-4 sm:px-10 py-8 no-scrollbar bg-gray-50">
                <div class="max-w-4xl mx-auto" id="blogsContainer">
                    
                    <% if (blogs.length === 0) { %>
                        <div class="text-center py-20 bg-white rounded-[2.5rem] border-4 border-dashed border-gray-100">
                            <i class="fas fa-feather-pointed text-gray-200 text-6xl mb-4 block"></i>
                            <p class="text-gray-400 font-black uppercase tracking-widest">No stories found</p>
                        </div>
                    <% } %>

                    <% blogs.forEach(blog => { %>
                    <div class="blog-card bg-white rounded-[2rem] border border-gray-100 p-6 sm:p-8 mb-6 shadow-sm">
                        
                        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 font-black text-sm">
                                    <%= blog.author?.name ? blog.author.name.charAt(0) : '?' %>
                                </div>
                                <div>
                                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none mb-1">Author</p>
                                    <p class="text-sm font-bold text-gray-700"><%= blog.author?.name || "Unknown User" %></p>
                                </div>
                            </div>

                            <span class="px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest border <%= blog.isBlocked ? 'bg-rose-50 text-rose-600 border-rose-100' : 'bg-emerald-50 text-emerald-600 border-emerald-100' %>">
                                <%= blog.isBlocked ? 'Blocked' : 'Published' %>
                            </span>
                        </div>

                        <h3 class="text-xl sm:text-2xl font-black text-gray-900 leading-tight mb-4 hover:text-indigo-600 transition-colors">
                            <%= blog.title %>
                        </h3>

                        <div class="flex items-center justify-between border-t border-gray-50 pt-6">
                            <div class="flex gap-6">
                                <div class="flex items-center gap-2 text-gray-400">
                                    <i class="fa-solid fa-heart text-rose-500"></i>
                                    <span class="text-xs font-black"><%= blog.likeCount %></span>
                                </div>
                                <div class="flex items-center gap-2 text-gray-400">
                                    <i class="fa-solid fa-comment text-indigo-500"></i>
                                    <span class="text-xs font-black"><%= blog.commentCount %></span>
                                </div>
                                <div class="hidden sm:flex items-center gap-2 text-gray-400 border-l border-gray-100 pl-6">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span class="text-xs font-bold"><%= new Date(blog.createdAt).toLocaleDateString() %></span>
                                </div>
                            </div>

                            <a href="/admin/blogs/<%= blog._id %>" class="bg-gray-50 text-indigo-600 px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-indigo-600 hover:text-white transition-all active:scale-95 shadow-sm border border-indigo-50">
                                Manage Activity <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </main>
        </div>
    </div>

    <script>
        // Sidebar Toggle
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
        }

        // Live Search Logic
        let searchTimeout;
        function searchBlogs(query) {
            const clearBtn = document.getElementById("clearSearchBtn");
            clearBtn.classList.toggle("hidden", !query);

            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(async () => {
                try {
                    const res = await fetch(`/admin/blogs/search?q=${encodeURIComponent(query)}`);
                    const data = await res.text();
                    document.getElementById("blogsContainer").innerHTML = data;
                } catch (err) {
                    console.error("Search failed:", err);
                }
            }, 400);
        }

        function clearSearch() {
            document.getElementById("blogSearch").value = "";
            document.getElementById("clearSearchBtn").classList.add("hidden");
            searchBlogs("");
        }
    </script>
</body>
</html>