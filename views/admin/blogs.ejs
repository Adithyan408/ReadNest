<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogs - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }

      .sidebar-item {
        transition: all 0.3s ease;
      }

      .sidebar-item:hover {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }

      .sidebar-item.active {
        background-color: #d1d5db;
        border-left: 4px solid #667eea;
      }
      html,
      body {
        height: 100%;
        overflow: hidden; 
      }

      
    </style>
  </head>
  <body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="flex items-center justify-between px-6 py-4">
        <!-- Logo -->
        <a href="/admin">
          <div class="flex items-center space-x-3">
            <div
              class="w-14 h-14 bg-orange-900 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-book-open text-white text-2xl"></i>
            </div>
            <span class="text-2xl font-bold text-gray-800">ReadNest</span>
          </div>
        </a>

        <!-- Right Side -->
        <div class="flex items-center space-x-6">
          <a href="/admin/blogs">
            <button
              class="flex items-center space-x-2 px-6 py-2 bg-white rounded-lg border border-gray-400 hover:bg-gray-50 transition"
            >
              <i class="fas fa-blog text-gray-700"></i>
              <span class="text-base font-semibold text-gray-900">Blog</span>
            </button>
          </a>

          <div class="flex items-center space-x-3">
            <i class="fas fa-user-circle text-4xl text-gray-600"></i>
            <span class="text-base font-semibold text-gray-600">ADMIN</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="flex">
      <!-- Sidebar -->
      <aside
        class="w-80 bg-gray-300 h-[calc(100vh-80px)] border-r border-gray-400 flex flex-col"
      >
        <nav class="flex-1 overflow-y-auto py-4">
          <a
            href="/admin"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th-large text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">DashBoard</span>
          </a>

          <a
            href="/admin/products"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-box text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Products</span>
          </a>

          <a
            href="/admin/orders"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-shopping-bag text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Orders List</span>
          </a>

          <a
            href="/admin/users"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-users text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Customers</span>
          </a>

          <a
            href="/admin/sales"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-chart-line text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Sales</span>
          </a>

          <a
            href="/admin/category"
            class="sidebar-item active flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-th text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Category</span>
          </a>

          <a
            href="/admin/coupon"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-ticket-alt text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Voucher</span>
          </a>

          <a
            href="/admin/banner"
            class="sidebar-item flex items-center px-6 py-4 border-b border-gray-400"
          >
            <i class="fas fa-image text-xl mr-4"></i>
            <span class="text-lg font-semibold text-gray-900">Banner</span>
          </a>
        </nav>

        <!-- Logout Button at Bottom -->

        <div class="border-t-2 border-gray-400 bg-gray-300">
          <a href="/admin/logout">
            <button
              class="w-full flex items-center px-6 py-5 hover:bg-red-50 transition-colors group"
            >
              <i
                class="fas fa-sign-out-alt text-xl mr-4 text-gray-700 group-hover:text-red-600"
              ></i>
              <span
                class="text-lg font-semibold text-gray-900 group-hover:text-red-600"
                >Log Out</span
              >
            </button>
          </a>
        </div>
      </aside>

      <!-- ================= BLOGS SECOND HEADER ================= -->
      <div class="flex-1 flex flex-col h-[calc(100vh-80px)]">
        <section
          class="bg-gray-100 border-b border-gray-300 sticky top-[80px] z-40"
        >
          <div class="max-w-6xl mx-auto px-10 py-4">
            <div class="flex items-center gap-6">
              <!-- HEADING -->
              <h2 class="text-2xl font-semibold text-gray-800">Blogs</h2>

              <!-- SEARCH BAR -->
              <div class="relative">
                <input
                  type="text"
                  id="blogSearch"
                  placeholder="Search blogs..."
                  class="w-64 pl-10 pr-10 py-2 text-sm border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500"
                  oninput="searchBlogs(this.value)"
                />

                <i
                  class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"
                ></i>

                <button
                  id="clearSearchBtn"
                  onclick="clearSearch()"
                  class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500"
                >
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- Main Content - Categories -->
        <main class="flex-1 overflow-y-auto px-10 py-6">
          <div class="max-w-6xl mx-auto" id="blogsContainer">
            <!-- PAGE HEADING + SEARCH -->

            <% if (blogs.length === 0) { %>
            <p class="text-center text-gray-500 mt-20 text-sm">
              No blogs published yet
            </p>
            <% } %> <% blogs.forEach(blog => { %>
            <div
              class="bg-white rounded-xl border border-gray-200 hover:shadow transition p-6 mb-5"
            >
              <!-- TITLE + STATUS -->
              <div class="flex items-start justify-between">
                <h3
                  class="text-lg font-semibold text-gray-900 hover:text-blue-700"
                >
                  <%= blog.title %>
                </h3>

                <% if (blog.isBlocked) { %>
                <!-- BLOCKED -->
                <span
                  class="text-xs px-3 py-1 rounded-full bg-red-100 text-red-700 font-medium"
                >
                  Blocked
                </span>
                <% } else { %>
                <!-- PUBLISHED -->
                <span
                  class="text-xs px-3 py-1 rounded-full bg-green-100 text-green-700 font-medium"
                >
                  Published
                </span>
                <% } %>
              </div>

              <!-- META -->
              <p class="text-sm text-gray-500 mt-1">
                By
                <span class="font-medium text-gray-700"
                  ><%= blog.author?.name || "Unknown" %></span
                >
                · <%= new Date(blog.createdAt).toDateString() %>
              </p>

              <!-- ACTION ROW -->
              <div
                class="flex justify-between items-center border-t border-gray-100 mt-4 pt-4 text-gray-600"
              >
                <!-- LEFT: STATS -->
                <div class="flex gap-6 text-sm">
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-heart text-red-500"></i>
                    <span><%= blog.likeCount %></span>
                  </div>

                  <div class="flex items-center gap-2">
                    <i class="fa-regular fa-comment"></i>
                    <span><%= blog.commentCount %></span>
                  </div>
                </div>

                <!-- RIGHT: VIEW -->
                <a
                  href="/admin/blogs/<%= blog._id %>"
                  class="text-blue-600 text-sm font-medium hover:underline"
                >
                  View Blog →
                </a>
              </div>
            </div>

            <% }) %>
          </div>
        </main>
      </div>
    </div>
    <script>
      let searchTimeout;

      function searchBlogs(query) {
        const clearBtn = document.getElementById("clearSearchBtn");

        // Toggle clear button
        clearBtn.classList.toggle("hidden", !query);

        // Debounce (prevents too many requests)
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(async () => {
          const res = await fetch(
            `/admin/blogs/search?q=${encodeURIComponent(query)}`
          );
          const data = await res.text();

          // Replace blog list HTML
          document.getElementById("blogsContainer").innerHTML = data;
        }, 300);
      }

      function clearSearch() {
        document.getElementById("blogSearch").value = "";
        document.getElementById("clearSearchBtn").classList.add("hidden");
        searchBlogs("");
      }
    </script>
  </body>
</html>
