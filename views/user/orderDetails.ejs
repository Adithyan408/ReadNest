<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Details - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/user/css/orderDetails.css">
</head>

<body class="bg-gray-50">
    <%- include("../../views/partials/user/header") %>

    <main class="max-w-5xl mx-auto px-4 py-8 lg:py-16">
        <h1 class="text-2xl lg:text-3xl font-bold text-gray-800 mb-8 text-center">Order Details</h1>

        <div class="bg-white shadow-sm rounded-2xl p-5 lg:p-8 mb-8 border border-gray-100">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 border-b border-gray-50 pb-6">
                <div>
                    <h2 class="text-lg lg:text-xl font-bold text-gray-800">
                        Order ID: <span class="text-blue-600">#<%= order.orderId %></span>
                    </h2>
                    <p class="text-xs text-gray-400 mt-1 uppercase tracking-widest font-bold">
                        Placed on <%= new Date(order.createdAt).toLocaleDateString() %>
                    </p>
                </div>

                <%
                    let orderStatusClasses = "";
                    if (order.status === "processing") orderStatusClasses = "bg-yellow-100 text-yellow-700";
                    else if (order.status === "cancelled") orderStatusClasses = "bg-red-100 text-red-700";
                    else if (order.status === "partially_cancelled") orderStatusClasses = "bg-orange-100 text-orange-700";
                    else orderStatusClasses = "bg-green-100 text-green-700";
                %>

                <button 
                    <% if (order.couponCode && order.status !== "cancelled") { %>
                        onclick="confirmFullOrderCancel('<%= order.orderId %>')"
                    <% } %>
                    class="px-4 py-2 rounded-full text-xs font-black uppercase tracking-tighter shadow-sm transition active:scale-95 <%= orderStatusClasses %>"
                >
                    <%= order.status %>
                </button>
                <% if (isRetryEligible) { %>
  <button
    onclick="retryPayment('<%= order.orderId %>')"
    class="mt-2 px-5 py-2 rounded-full bg-red-600 text-white text-xs font-black uppercase tracking-wider shadow hover:bg-red-700 transition active:scale-95"
  >
    <i class="fa-solid fa-rotate-right mr-2"></i> Retry Payment
  </button>
<% } %>

            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="space-y-2 text-sm">
                    <h3 class="font-bold text-gray-900 border-b border-gray-50 pb-2 mb-3">Billing Summary</h3>
                    <div class="flex justify-between"><span>Items Total:</span><span class="font-bold">₹<%= order.items.reduce((sum, i) => sum + i.subtotal, 0) %></span></div>
                    <div class="flex justify-between text-gray-500"><span>Shipping:</span><span>₹<%= order.shippingCharge %></span></div>
                    <% if (order.discount > 0) { %>
                        <div class="flex justify-between text-red-500 font-medium"><span>Discount:</span><span>- ₹<%= order.discount %></span></div>
                    <% } %>
                    <div class="flex justify-between text-lg font-black text-gray-900 pt-2 border-t mt-2">
                        <span>Total Paid:</span><span>₹<%= order.finalPayable ?? order.total %></span>
                    </div>
                </div>

               <div class="text-sm">
  <h3 class="font-bold text-gray-900 border-b border-gray-50 pb-2 mb-3">
    Delivery Info
  </h3>

  <p class="text-gray-600 leading-relaxed">
    <span class="font-bold text-gray-800">Status:</span>
    <%= order.paymentId ? "Prepaid" : "Cash on Delivery" %>
    <br>

    <% if (order.createdAt) { 
      const d = new Date(order.createdAt);
      d.setDate(d.getDate() + 6);
    %>
      <span class="font-bold text-gray-800">Est. Delivery:</span>
      <%= d.toDateString() %>
    <% } %>
  </p>

  <!-- Invoice Section -->
  <div class="mt-4">
  <% if (!isRetryEligible) { %>

    <button
      <% if (!isInvoiceAvailable) { %> disabled <% } %>
      onclick="downloadInvoice('<%= order.orderId %>')"
      class="w-full lg:w-auto px-4 py-2 rounded-lg font-bold text-xs transition
      <%= isInvoiceAvailable 
          ? 'bg-blue-600 text-white hover:bg-blue-700'
          : 'bg-gray-100 text-gray-400 cursor-not-allowed' %>">

      <i class="fa-solid fa-download mr-2"></i>
      <%= isInvoiceAvailable ? 'INVOICE' : 'INVOICE PENDING' %>
    </button>

  <% } %>
</div>
</div>

                <div class="text-sm">
                    <h3 class="font-bold text-gray-900 border-b border-gray-50 pb-2 mb-3">Shipping Address</h3>
                    <% if (typeof selectedAddress !== "undefined" && selectedAddress) { %>
                        <p class="text-gray-600 leading-relaxed">
                            <span class="font-bold text-gray-800"><%= selectedAddress.addressLabel %>:</span> <%= selectedAddress.houseName %>, <%= selectedAddress.street %><br>
                            <%= selectedAddress.district %>, <%= selectedAddress.state %> - <%= selectedAddress.pincode %><br>
                            <span class="font-medium text-gray-900">Mob: <%= selectedAddress.phone %></span>
                        </p>
                    <% } %>
                </div>
            </div>
        </div>

        <h2 class="text-xl lg:text-2xl font-bold text-gray-800 mb-6 px-1">Ordered Items</h2>
        <div class="space-y-4">
            <% order.items.forEach(item => { %>
                <div class="bg-white shadow-sm rounded-2xl p-4 lg:p-6 border border-gray-100">
                    <div class="flex flex-col sm:flex-row gap-4 lg:gap-6">
                        <div class="flex sm:block items-center justify-between gap-4">
                            <%
                                let imgSrc = "/images/placeholder.png";
                                if (item.productImage && item.productImage.length > 0) imgSrc = item.productImage[0];
                                else if (item.product?.productImage?.length > 0) imgSrc = item.product.productImage[0];
                            %>
                            <img src="<%= imgSrc %>" class="w-20 h-20 lg:w-24 lg:h-24 object-cover rounded-xl border border-gray-100" />
                            
                           <% if (!isRetryEligible) { %>
  <span class="hidden sm:inline-block px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-tighter bg-gray-100 text-gray-600">
    <%= item.status %>
  </span>
<% } %>

                        </div>

                        <div class="flex-1">
                            <div class="flex justify-between items-start">
                                <h3 class="font-bold text-gray-900 lg:text-lg"><%= item.productName %></h3>
                                <% if (!isRetryEligible) { %>
  <span class="sm:hidden px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-tighter bg-gray-100 text-gray-600">
    <%= item.status %>
  </span>
<% } %>
                            </div>

                            <div class="mt-2 grid grid-cols-2 sm:flex sm:gap-8 text-sm">
                                <div><p class="text-gray-400 text-xs">Unit Price</p><p class="font-bold">₹<%= item.unitPrice %></p></div>
                                <div><p class="text-gray-400 text-xs">Qty</p><p class="font-bold"><%= item.quantity %></p></div>
                                <div class="col-span-2 sm:col-auto"><p class="text-gray-400 text-xs">Subtotal</p><p class="font-black text-blue-600">₹<%= item.subtotal %></p></div>
                            </div>

                            <div class="mt-6 flex flex-wrap gap-3">
                               <% if (!isRetryEligible) { %>

                     <% if (!item.returnStatus || item.returnStatus === "none") { %>

                       <% if ((item.status === "ordered" || item.status === "shipped") && canCancelIndividually) { %>
                         <button
                           onclick="confirmCancel('<%= order.orderId %>', '<%= item._id %>')"
                           class="flex-1 sm:flex-none bg-red-50 text-red-600 px-5 py-2 rounded-lg font-bold text-xs hover:bg-red-100 transition uppercase tracking-wider">
                           Cancel
                         </button>
                       <% } %>

                       <% if (item.status === "delivered") { %>
                         <button
                           onclick="confirmReturn('<%= order.orderId %>', '<%= item._id %>')"
                           class="flex-1 sm:flex-none bg-orange-50 text-orange-600 px-5 py-2 rounded-lg font-bold text-xs hover:bg-orange-100 transition uppercase tracking-wider">
                           Return
                         </button>
                       <% } %>

                     <% } %>

                   <% } %>


                                <% if (item.status !== "delivered" && !canCancelIndividually ) { %>
                                    <p class="text-[10px] font-medium text-gray-400 italic">Individual cancellation restricted by coupon.</p>
                                <% } %>
                            </div>

                            <% if (item.returnStatus && item.returnStatus !== 'none') { %>
                                <div class="mt-4 p-3 rounded-xl text-xs font-bold flex items-center gap-3
                                    <%= item.returnStatus === 'requested' ? 'bg-yellow-50 text-yellow-700' : '' %>
                                    <%= item.returnStatus === 'approved' ? 'bg-green-50 text-green-700' : '' %>
                                    <%= item.returnStatus === 'rejected' ? 'bg-red-50 text-red-700' : '' %>">
                                    <i class="fas fa-info-circle"></i>
                                    <span>
                                        Return <%= item.returnStatus.charAt(0).toUpperCase() + item.returnStatus.slice(1) %>: 
                                        <%= item.adminReturnNote || item.returnReason || 'Awaiting verification' %>
                                    </span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <div class="mt-12 flex justify-center">
            <a href="/orders" class="w-full sm:w-auto bg-gray-100 text-gray-600 px-8 py-3 rounded-xl font-bold hover:bg-gray-200 transition text-center">
                Back to History
            </a>
        </div>
    </main>

    <%- include("../../views/partials/user/footer") %>

    <script src="/user/js/orderDetails.js"></script>
</body>
</html>