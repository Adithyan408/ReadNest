<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Details - ReadNest</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }
    </style>
  </head>

  <body class="bg-gray-100">
    <!-- Header -->
    <%- include("../../views/partials/user/header") %>

    <main class="max-w-5xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-gray-800 mb-10 text-center">
    Order Details
  </h1>

  <!-- Order Summary Card -->
  <div class="bg-white shadow-xl rounded-2xl p-8 mb-10">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-bold text-gray-800">
        Order ID:
        <span class="text-blue-600"><%= order.orderId %></span>
      </h2>

      <%
        let orderStatusClasses = "";
        if (order.status === "processing") {
          orderStatusClasses = "bg-yellow-100 text-yellow-700";
        } else if (order.status === "cancelled") {
          orderStatusClasses = "bg-red-100 text-red-700";
        } else if (order.status === "partially_cancelled") {
          orderStatusClasses = "bg-orange-100 text-orange-700";
        } else {
          orderStatusClasses = "bg-green-100 text-green-700";
        }
      %>

          <span
  class="px-4 py-2 rounded-lg text-sm font-semibold <%= orderStatusClasses %>
         <%= (order.couponCode && order.status !== 'cancelled')
              ? 'cursor-pointer hover:opacity-80'
              : 'cursor-default' %>"
  <% if (order.couponCode && order.status !== "cancelled") { %>
    onclick="confirmFullOrderCancel('<%= order.orderId %>')"
    title="Cancel full order"
  <% } %>
>
  <%= order.status %>
</span>


    </div>

    <div class="grid md:grid-cols-3 gap-6 mt-4">

      <!-- Total + Items -->
      <div class="space-y-3">
      <p class="text-gray-700">
  <span class="font-semibold">Items Total:</span>
  ₹ <%= order.items.reduce((sum, i) => sum + i.subtotal, 0) %>
  </p>

          <p class="text-gray-700">
            <span class="font-semibold">Shipping:</span>
            ₹ <%= order.shippingCharge %>
          </p>

          <% if (order.discount && order.discount > 0) { %>
          <p class="text-gray-700">
          <span class="font-semibold">Discount:</span>
            - ₹ <%= order.discount %>
          </p>
        <% } %>

          <p class="text-gray-800 text-lg font-bold mt-2">
          Total Paid: ₹ <%= order.finalPayable ?? order.total %>
          </p>


        <p class="text-gray-700">
          <span class="font-semibold">Items:</span> <%= order.items.length %>
        </p>

        <% if (isInvoiceAvailable) { %>
  <button
    type="button"
    onclick="downloadInvoice('<%= order.orderId %>')"
    class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg
           hover:bg-blue-700 transition w-fit cursor-pointer"
  >
    <i class="fa-solid fa-file-invoice"></i>
    Download Invoice
  </button>

<% } else { %>
  <button
    type="button"
    disabled
    onclick="showInvoiceInfo()"
    class="inline-flex items-center gap-2 bg-gray-300 text-gray-600 px-4 py-2 rounded-lg
           cursor-not-allowed w-fit"
    title="Invoice will be available after delivery/payment"
  >
    <i class="fa-solid fa-file-invoice"></i>
    Invoice Not Available
  </button>
<% } %>


      </div>

      <div>
        <p class="text-gray-700">
          <span class="font-semibold">Placed On:</span><br />
          <%= new Date(order.createdAt).toLocaleString() %>
        </p>

        <% if (order.createdAt) { 
             let d = new Date(order.createdAt);
             d.setDate(d.getDate() + 6);
        %>
          <p class="text-gray-700 mt-2">
            <span class="font-semibold">Delivery Date:</span><br />
            <%= d.toDateString() %>
          </p>
        <% } %>
      </div>

      <div>
        <p class="text-gray-700">
          <span class="font-semibold">Payment:</span>
          <%= order.paymentId ? "Paid" : "COD" %>
        </p>

        <% if (typeof selectedAddress !== "undefined" && selectedAddress) { %>
          <p class="text-gray-700 mt-2">
            <span class="font-semibold">Delivery Address:</span><br />

            <%= selectedAddress.addressLabel %> Address <br />
            <%= selectedAddress.houseName %>
            <% if (selectedAddress.houseNumber) { %>
              , <%= selectedAddress.houseNumber %>
            <% } %>,
            <%= selectedAddress.street %><br />

            <%= selectedAddress.post %>, <%= selectedAddress.district %><br />
            <%= selectedAddress.state %> - <%= selectedAddress.pincode %><br />

            Phone: <%= selectedAddress.phone %><br />
            Alternate: <%= selectedAddress.altPhone %>
          </p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Items List -->
<h2 class="text-2xl font-bold text-gray-800 mb-6">Ordered Items</h2>

<div class="space-y-6">

  <% order.items.forEach(item => { %>
    <div class="bg-white shadow-md rounded-xl p-6 border border-gray-100">

      <!-- Product Image + Title + Status -->
      <div class="flex justify-between items-center">

        <div class="flex items-center gap-4">
          <%
            let imgSrc = "/images/placeholder.png";
            if (item.productImage && item.productImage.length > 0) {
              imgSrc = item.productImage[0];
            } else if (item.product && item.product.productImage && item.product.productImage.length > 0) {
              imgSrc = item.product.productImage[0];
            }
          %>

          <img src="<%= imgSrc %>" class="w-20 h-20 object-cover rounded-lg border" />

          <h3 class="text-lg font-bold text-gray-800"><%= item.productName %></h3>
        </div>

        <%
          let itemStatusClasses = "";
          if (item.status === "ordered") {
            itemStatusClasses = "bg-yellow-100 text-yellow-700";
          } else if (item.status === "cancelled") {
            itemStatusClasses = "bg-red-100 text-red-700";
          } else if (item.status === "returned") {
            itemStatusClasses = "bg-orange-100 text-orange-700";
          } else if (item.status === "delivered") {
            itemStatusClasses = "bg-green-100 text-green-700";
          }
        %>

        <span class="px-3 py-1 rounded-md text-xs font-semibold <%= itemStatusClasses %>">
          <%= item.status %>
        </span>
      </div>

      <!-- Price & Quantity -->
      <div class="mt-3 text-gray-700">
        <p><span class="font-semibold">Price:</span> ₹ <%= item.unitPrice %></p>
        <p><span class="font-semibold">Quantity:</span> <%= item.quantity %></p>
        <p><span class="font-semibold">Subtotal:</span> ₹ <%= item.subtotal %></p>
      </div>

      <!-- ACTION BUTTONS -->
      <div class="mt-5 flex gap-4">

        <% if (!item.returnStatus || item.returnStatus === "none") { %>

            

          <% if (
            (item.status === "ordered" || item.status === "shipped") &&
            canCancelIndividually
            ) { %>
          <button
            type="button"
           onclick="confirmCancel('<%= order.orderId %>', '<%= item._id %>')"
            class="bg-red-600 text-white px-5 py-2 rounded-lg hover:bg-red-700 transition"
            >
              Cancel Item
            </button>
          <% } %>

          <% if (item.status !== "delivered" && !canCancelIndividually ) { %>
              <p class="text-sm text-gray-500">
                Item cannot be cancelled individually due to coupon conditions.
                You may cancel the full order instead.
              </p>
            <% } %>

          <% if (item.status === "delivered") { %>
            <!-- RETURN -->
            <button
              type="button"
              onclick="confirmReturn('<%= order.orderId %>', '<%= item._id %>')"
              class="bg-orange-500 text-white px-5 py-2 rounded-lg hover:bg-orange-600 transition"
            >
              Return Item
            </button>
          <% } %>

        <% } %>

      </div>

      <!-- RETURN REQUESTED VIEW -->
      <% if (item.returnStatus === "requested") { %>
        <div class="mt-4 bg-yellow-100 text-yellow-800 px-4 py-3 rounded-lg">
          <p class="font-semibold">Return Requested</p>

          <% if (item.returnReason) { %>
            <p class="text-sm mt-1"><span class="font-semibold">Reason:</span> <%= item.returnReason %></p>
          <% } %>

          <p class="text-xs mt-1">Waiting for admin approval...</p>
        </div>
      <% } %>

      <!-- RETURN APPROVED VIEW -->
      <% if (item.returnStatus === "approved") { %>
        <div class="mt-4 bg-green-100 text-green-800 px-4 py-3 rounded-lg">
          <p class="font-semibold">Return Approved</p>

          <% if (item.refundAmount) { %>
            <p class="text-sm mt-1">Refund: ₹ <%= item.refundAmount %> credited to wallet.</p>
          <% } %>
        </div>
      <% } %>

      <!-- RETURN REJECTED VIEW -->
      <% if (item.returnStatus === "rejected") { %>
        <div class="mt-4 bg-red-100 text-red-800 px-4 py-3 rounded-lg">
          <p class="font-semibold">Return Request Rejected</p>

          <% if (item.adminReturnNote) { %>
            <p class="text-sm mt-1"><span class="font-semibold">Reason:</span> <%= item.adminReturnNote %></p>
          <% } %>

          <% if (item.returnReason) { %>
            <p class="text-xs mt-1"><span class="font-semibold">Your return reason:</span> <%= item.returnReason %></p>
          <% } %>
        </div>
      <% } %>

    </div>
  <% }) %>
</div>

  <!-- Back Button -->
  <div class="text-center mt-12">
    <a
      href="/orders"
      class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg text-lg font-semibold hover:bg-gray-300 transition"
    >
      Back to Orders
    </a>
  </div>
</main>


    <%- include("../../views/partials/user/footer") %>
  </body>
  <script>

     function showInvoiceInfo() {
    Swal.fire({
      icon: "info",
      title: "Invoice not available",
      text: "Invoice will be available after at least one item is delivered.",
      confirmButtonColor: "#2563eb",
    });
  }
  async function downloadInvoice(orderId) {
  try {
    const res = await fetch(`/orders/${orderId}/invoice`);

    if (!res.ok) {
      const data = await res.json();

      Swal.fire({
        icon: "info",
        title: "Invoice not available",
        text: data.message,
        confirmButtonColor: "#2563eb",
      });

      return;
    }

    window.location.href = `/orders/${orderId}/invoice`;

  } catch (err) {
    Swal.fire({
      icon: "error",
      title: "Something went wrong",
      text: "Please try again later.",
    });
  }
}
    // CANCEL ITEM
    function confirmCancel(orderId, itemId) {
  Swal.fire({
    title: "Cancel this item?",
    text: "This action cannot be undone.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#d33",
    cancelButtonColor: "#3085d6",
    confirmButtonText: "Yes, cancel it",
  }).then(async (result) => {
    if (!result.isConfirmed) return;

    try {
      const res = await fetch(
        `/orders/${orderId}/items/${itemId}/cancel`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
        }
      );

      const data = await res.json();

      // ❌ Cannot cancel due to coupon
      if (!res.ok && data.reason === "COUPON_MIN_BREAK") {
        return Swal.fire({
          icon: "info",
          title: "Cannot cancel item",
          text: data.message,
          confirmButtonColor: "#2563eb",
        });
      }

      // ❌ Other failure
      if (!res.ok) {
        return Swal.fire({
          icon: "error",
          title: "Unable to cancel item",
          text: "Please try again later.",
        });
      }

      // ✅ Success
      Swal.fire({
        icon: "success",
        title: "Item cancelled",
        text: "The item has been cancelled successfully.",
        timer: 1500,
        showConfirmButton: false,
      }).then(() => {
        window.location.reload();
      });

    } catch (err) {
      Swal.fire({
        icon: "error",
        title: "Something went wrong",
        text: "Please try again later.",
      });
    }
  });
}

function confirmFullOrderCancel(orderId) {
  Swal.fire({
    title: "Cancel entire order?",
    text: "Items cannot be cancelled individually due to coupon conditions. Cancelling the full order will cancel all remaining items.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#d33",
    cancelButtonColor: "#3085d6",
    confirmButtonText: "Yes, cancel full order",
  }).then(async (result) => {
    if (!result.isConfirmed) return;

    try {
      const res = await fetch(`/orders/${orderId}/cancel`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
      });

      const data = await res.json();

      if (!res.ok) {
        return Swal.fire({
          icon: "error",
          title: "Cannot cancel order",
          text: data.message || "Please try again later.",
        });
      }

      Swal.fire({
        icon: "success",
        title: "Order cancelled",
        text: "Your order has been cancelled successfully.",
        timer: 1500,
        showConfirmButton: false,
      }).then(() => {
        window.location.reload();
      });

    } catch (err) {
      Swal.fire({
        icon: "error",
        title: "Something went wrong",
        text: "Please try again later.",
      });
    }
  });
}

    // RETURN ITEM WITH REASON
    function confirmReturn(orderId, itemId) {
      Swal.fire({
        title: "Return this item?",
        text: "Please provide a return reason.",
        icon: "question",
        input: "textarea",
        inputLabel: "Return Reason",
        inputPlaceholder: "Type your reason here...",
        inputAttributes: { "aria-label": "Return reason" },
        showCancelButton: true,
        confirmButtonText: "Submit Return",
        cancelButtonText: "Cancel",
        inputValidator: (value) => {
          if (!value) return "Please enter a reason!";
        },
      }).then((result) => {
        if (result.isConfirmed) {
          const form = document.createElement("form");
          form.method = "POST";
          form.action = `/orders/${orderId}/items/${itemId}/return`;

          const inputReason = document.createElement("input");
          inputReason.type = "hidden";
          inputReason.name = "returnReason";
          inputReason.value = result.value;

          form.appendChild(inputReason);
          document.body.appendChild(form);
          form.submit();
        }
      });
    }
    window.history.pushState(null, "", window.location.href);
    window.onpopstate = function () {
      location.reload();
    };
  </script>
</html>
