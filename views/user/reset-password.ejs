<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/user/css/reset-password.css">
</head>

<body class="flex items-center justify-center min-h-screen p-4 sm:p-6 lg:p-8">
    <div class="form-container bg-white/95 backdrop-blur rounded-3xl shadow-2xl max-w-md w-full p-6 sm:p-10 lg:p-12 border border-white/20">
        
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-indigo-50 rounded-full mb-4 animate-pulse">
                <i class="fas fa-shield-alt text-3xl sm:text-4xl text-indigo-600"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-gray-900 leading-tight">Secure Your Account</h1>
            <p class="text-gray-500 text-sm sm:text-base font-medium mt-3 px-2">
                Choose a password that is hard to guess but easy for you to remember.
            </p>
        </div>

        <div id="errorMessage" class="error-message mb-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded-r-xl text-xs sm:text-sm font-bold flex items-center gap-3">
            <i class="fas fa-circle-exclamation text-lg"></i>
            <span id="errorText"></span>
        </div>

        <div id="successMessage" class="hidden mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-700 rounded-r-xl text-xs sm:text-sm font-bold flex items-center gap-3">
            <i class="fas fa-circle-check text-lg"></i>
            <span>Success! Redirecting to login...</span>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
        <div class="mb-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded-r-xl text-xs sm:text-sm font-bold flex items-center gap-3">
            <i class="fas fa-circle-exclamation text-lg"></i>
            <span><%= message %></span>
        </div>
        <% } %>

        <form id="resetPasswordForm" class="space-y-6" action="/reset-password" method="POST">
            <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" />

            <div>
                <div class="relative group">
                    <input
                        type="password"
                        id="newPassword"
                        name="newPassword"
                        placeholder="New Password"
                        class="w-full px-6 py-4 bg-gray-50 border-2 border-gray-100 rounded-2xl outline-none text-gray-800 font-bold focus:border-indigo-600 focus:bg-white transition-all placeholder:text-gray-300 pr-12"
                    />
                    <i class="fas fa-eye absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 cursor-pointer hover:text-indigo-600 transition-colors"
                       onclick="togglePassword('newPassword', this)"></i>
                </div>
                
                <div class="strength-meter">
                    <div id="strengthBar" class="strength-bar"></div>
                </div>
                <div class="flex justify-between mt-1 px-1">
                    <span id="strengthText" class="text-[10px] font-black uppercase tracking-wider"></span>
                </div>
            </div>

            <div class="bg-gray-50/50 rounded-2xl p-4 border border-gray-100 grid grid-cols-1 sm:grid-cols-2 gap-2">
                <div class="requirement" id="req-length"><i class="fas fa-circle text-[8px]"></i> 8+ Characters</div>
                <div class="requirement" id="req-uppercase"><i class="fas fa-circle text-[8px]"></i> Uppercase</div>
                <div class="requirement" id="req-lowercase"><i class="fas fa-circle text-[8px]"></i> Lowercase</div>
                <div class="requirement" id="req-number"><i class="fas fa-circle text-[8px]"></i> Number</div>
            </div>

            <div>
                <div class="relative group">
                    <input
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        placeholder="Confirm Password"
                        class="w-full px-6 py-4 bg-gray-50 border-2 border-gray-100 rounded-2xl outline-none text-gray-800 font-bold focus:border-indigo-600 focus:bg-white transition-all placeholder:text-gray-300 pr-12"
                    />
                    <i class="fas fa-eye absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 cursor-pointer hover:text-indigo-600 transition-colors"
                       onclick="togglePassword('confirmPassword', this)"></i>
                </div>
                <p id="confirmPasswordError" class="error-message text-red-600 text-[10px] font-black uppercase tracking-widest mt-2 ml-2">
                    <i class="fas fa-triangle-exclamation mr-1"></i>
                    <span></span>
                </p>
            </div>

            <button
                type="submit"
                class="w-full bg-indigo-600 text-white font-black text-lg py-4 rounded-2xl hover:bg-indigo-700 shadow-lg shadow-indigo-100 active:scale-[0.98] transition-all mt-4"
            >
                Reset Password
            </button>
        </form>

        <div class="text-center mt-8">
            <p class="text-gray-500 text-sm font-bold">
                Know your password? 
                <a href="/login" class="text-indigo-600 hover:underline ml-1">Log In</a>
            </p>
        </div>
    </div>

    <script src="/user/js/reset-password.js"></script>
</body>
</html>