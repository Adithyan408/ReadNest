<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Insights | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/user/css/blogInsights.css" />
  </head>

  <body class="bg-gray-100">
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div
              class="w-10 h-10 lg:w-14 lg:h-14 rounded-full overflow-hidden shrink-0"
            >
              <a href="/"
                ><img
                  src="/images/logo2.png"
                  class="w-full h-full object-cover"
              /></a>
            </div>
            <a
              href="/"
              class="text-lg lg:text-xl font-bold text-gray-800 uppercase tracking-tight"
              >ReadNest</a
            >
          </div>

          <div class="flex items-center space-x-3 lg:space-x-6">
            <button
              onclick="window.location.href = '/blog'"
              class="flex items-center p-2 lg:px-4 lg:py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50 transition"
            >
              <i class="fas fa-bars text-gray-700"></i>
              <span class="hidden lg:inline text-sm font-medium ml-2"
                >BLOG</span
              >
            </button>
            <a href="/cart" class="p-2"
              ><i
                class="fas fa-shopping-cart text-xl lg:text-2xl text-gray-700"
              ></i
            ></a>
            <a href="/account" class="p-2 flex items-center gap-2">
              <i
                class="fas fa-user-circle text-2xl lg:text-3xl text-gray-700"
              ></i>
              <span class="hidden md:inline text-sm font-semibold text-gray-700"
                ><%= user.name %></span
              >
            </a>
          </div>
        </div>
      </div>
    </header>

    <section
      class="sticky top-[64px] lg:top-[76px] z-40 bg-white/95 backdrop-blur border-b border-gray-200"
    >
      <div
        class="max-w-7xl mx-auto px-4 lg:px-6 py-3 flex items-center justify-between"
      >
        <div class="flex items-center gap-3">
          <div
            class="w-9 h-9 lg:w-10 lg:h-10 rounded-full bg-blue-100 flex items-center justify-center shrink-0"
          >
            <i class="fa-solid fa-chart-line text-blue-600"></i>
          </div>
          <div>
            <h2 class="text-sm lg:text-lg font-bold text-gray-800 leading-none">
              Insights
            </h2>
            <p
              class="hidden sm:block text-[10px] lg:text-xs text-gray-500 mt-1"
            >
              Activity summary (last 30 days)
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <button
            onclick="window.location.href = '/blog/addBlog'"
            class="flex items-center gap-2 px-4 py-2 rounded-full bg-blue-600 text-white text-xs lg:text-sm font-bold hover:bg-blue-700 transition shadow-md"
          >
            <i class="fa-solid fa-pen text-[10px]"></i>
            <span class="hidden xs:inline">Publish</span>
          </button>
          <button
            id="notificationBtn"
            class="relative w-9 h-9 lg:w-10 lg:h-10 rounded-full bg-gray-100 flex items-center justify-center hover:bg-blue-100 transition"
          >
            <i class="fa-regular fa-bell text-blue-600"></i>
            <span
              id="notifCount"
              class="hidden absolute -top-1 -right-1 bg-red-600 text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-white"
            ></span>
          </button>
        </div>
      </div>
    </section>

    <div class="flex flex-col lg:flex-row min-h-screen">
      <%- include("../../views/partials/user/blogSidebar") %>

      <main class="flex-1 lg:ml-60 p-4 lg:p-10 main-content no-scrollbar">
        <div class="max-w-5xl mx-auto">
          <div class="lg:hidden mb-6 text-center">
            <h1 class="text-2xl font-bold text-gray-800">Your Activity</h1>
            <p class="text-xs text-gray-500">Summary of your engagement</p>
          </div>

          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4 lg:gap-8"
          >
            <div
              class="bg-white rounded-2xl border border-gray-100 p-6 lg:p-8 flex items-center gap-5 hover:shadow-lg transition-all group"
            >
              <div
                class="w-14 h-14 lg:w-16 lg:h-16 rounded-2xl bg-red-50 flex items-center justify-center group-hover:bg-red-100 transition"
              >
                <i
                  class="fa-solid fa-heart text-red-500 text-2xl lg:text-3xl"
                ></i>
              </div>
              <div>
                <p
                  class="text-xs lg:text-sm font-semibold text-gray-400 uppercase tracking-wider"
                >
                  Likes Received
                </p>
                <h2
                  class="text-3xl lg:text-4xl font-bold text-gray-900 mt-1 tracking-tight"
                >
                  <%= likes %>
                </h2>
              </div>
            </div>

            <div
              class="bg-white rounded-2xl border border-gray-100 p-6 lg:p-8 flex items-center gap-5 hover:shadow-lg transition-all group"
            >
              <div
                class="w-14 h-14 lg:w-16 lg:h-16 rounded-2xl bg-blue-50 flex items-center justify-center group-hover:bg-blue-100 transition"
              >
                <i
                  class="fa-solid fa-comment text-blue-600 text-2xl lg:text-3xl"
                ></i>
              </div>
              <div>
                <p
                  class="text-xs lg:text-sm font-semibold text-gray-400 uppercase tracking-wider"
                >
                  Comments
                </p>
                <h2
                  class="text-3xl lg:text-4xl font-bold text-gray-900 mt-1 tracking-tight"
                >
                  <%= comments %>
                </h2>
              </div>
            </div>

            <div
              class="bg-white rounded-2xl border border-gray-100 p-6 lg:p-8 flex items-center gap-5 hover:shadow-lg transition-all group"
            >
              <div
                class="w-14 h-14 lg:w-16 lg:h-16 rounded-2xl bg-purple-50 flex items-center justify-center group-hover:bg-purple-100 transition"
              >
                <i
                  class="fa-solid fa-pen-nib text-purple-600 text-2xl lg:text-3xl"
                ></i>
              </div>
              <div>
                <p
                  class="text-xs lg:text-sm font-semibold text-gray-400 uppercase tracking-wider"
                >
                  Stories Published
                </p>
                <h2
                  class="text-3xl lg:text-4xl font-bold text-gray-900 mt-1 tracking-tight"
                >
                  <%= posts %>
                </h2>
              </div>
            </div>

            <div
              class="bg-white rounded-2xl border border-gray-100 p-6 lg:p-8 flex items-center gap-5 hover:shadow-lg transition-all group"
            >
              <div
                class="w-14 h-14 lg:w-16 lg:h-16 rounded-2xl bg-green-50 flex items-center justify-center group-hover:bg-green-100 transition"
              >
                <i
                  class="fa-solid fa-fire text-green-600 text-2xl lg:text-3xl"
                ></i>
              </div>
              <div>
                <p
                  class="text-xs lg:text-sm font-semibold text-gray-400 uppercase tracking-wider"
                >
                  Your Interactions
                </p>
                <h2
                  class="text-3xl lg:text-4xl font-bold text-gray-900 mt-1 tracking-tight"
                >
                  <%= interactions %>
                </h2>
              </div>
            </div>
          </div>
        </div>

        <div
          id="notificationModal"
          class="hidden fixed lg:absolute right-4 left-4 lg:left-auto lg:right-6 top-[120px] lg:top-[132px] z-50 w-auto lg:w-96 animate-in fade-in zoom-in-95"
        >
          <div
            class="bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden"
          >
            <div
              class="flex justify-between items-center px-4 py-3 border-b bg-gray-50"
            >
              <button
                id="closeNotification"
                class="text-xs text-gray-500 font-bold flex items-center gap-1"
              >
                <i class="fa-solid fa-chevron-left text-[10px]"></i> Close
              </button>
              <h3
                class="font-bold text-xs uppercase tracking-wider text-gray-400"
              >
                Activity
              </h3>
              <button id="markAllRead" class="text-xs text-blue-600 font-bold">
                Clear All
              </button>
            </div>
            <div
              id="notificationList"
              class="max-h-80 overflow-y-auto divide-y divide-gray-50"
            ></div>
          </div>
        </div>
      </main>
    </div>
    <script src="/user/js/blogInsights.js"></script>
  </body>
</html>
