<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Addresses | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
   <link rel="stylesheet" href="/user/css/address.css">

</head>

<body class="bg-gray-50">
    <%- include("../../views/partials/user/header") %>

    <div class="max-w-[1440px] mx-auto flex flex-col lg:flex-row">
        
        <aside class="w-full lg:w-72 bg-white border-b lg:border-b-0 lg:border-r border-gray-200 sidebar-fixed">
            <div class="hidden lg:block p-8 border-b border-gray-100">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">Logged in as</p>
                <h2 class="text-xl font-black text-gray-800 truncate"><%= user.name %></h2>
            </div>

            <nav class="flex flex-row lg:flex-col overflow-x-auto lg:overflow-x-visible no-scrollbar p-2 lg:p-0">
                <a href="/account" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm transition-all hover:bg-gray-50">
                    <i class="fas fa-user-circle text-lg text-gray-400"></i> Profile Details
                </a>
                <a href="/address" class="sidebar-link active flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm bg-blue-50 text-blue-600 border-r-4 border-blue-600 lg:border-r-4 lg:border-b-0">
                    <i class="fas fa-map-marked-alt text-lg"></i> Addresses
                </a>
                <a href="/orders" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm transition-all hover:bg-gray-50">
                    <i class="fas fa-shopping-bag text-lg text-gray-400"></i> My Orders
                </a>
                <a href="/wallet" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm transition-all hover:bg-gray-50">
                    <i class="fas fa-wallet text-lg text-gray-400"></i> Wallet
                </a>
                <a href="/wishlist" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm transition-all hover:bg-gray-50">
                    <i class="fas fa-heart text-lg text-gray-400"></i> Wishlist
                </a>
                <a href="/logout" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap font-semibold text-sm text-red-500 hover:bg-red-50">
                    <i class="fas fa-sign-out-alt text-lg"></i> Logout
                </a>
            </nav>
        </aside>

        <main class="flex-1 p-4 sm:p-8 lg:p-12 desktop-scroll-area no-scrollbar">
            
            <% if (typeof message !== 'undefined') { %>
                <div class="<%= status === 'success' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200' %> border p-4 rounded-2xl mb-8 flex items-center gap-3 shadow-sm">
                    <i class="fas <%= status === 'success' ? 'fa-check-circle' : 'fa-circle-exclamation' %>"></i>
                    <span class="text-sm font-bold"><%= message %></span>
                </div>
            <% } %>

            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden mb-8">
                <div class="p-6 lg:p-8 border-b border-gray-50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <h2 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-1">Your saved locations</h2>
                        <h1 class="text-2xl font-black text-gray-900 leading-tight">Addresses</h1>
                    </div>
                    <button onclick="openAddAddressModal()" class="w-full sm:w-auto bg-blue-600 text-white px-8 py-3.5 rounded-2xl font-black text-xs uppercase tracking-widest shadow-lg shadow-blue-100 hover:bg-blue-700 transition active:scale-95 flex items-center justify-center gap-2">
                        <i class="fas fa-plus"></i> New Address
                    </button>
                </div>

                <div class="p-6 lg:p-10">
                    <% if (addresses && addresses.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <% addresses.forEach((addr, i) => { %>
                                <div class="bg-gray-50 border border-gray-100 p-6 rounded-[2rem] hover:bg-white hover:border-blue-200 hover:shadow-xl hover:shadow-blue-900/5 transition-all duration-300 group">
                                    <div class="flex flex-col h-full justify-between">
                                        <div>
                                            <div class="flex items-center gap-3 mb-4">
                                                <span class="bg-white text-blue-600 text-[10px] font-black uppercase tracking-tighter px-3 py-1 rounded-full border border-blue-50">
                                                    <%= addr.addressLabel || 'Home' %>
                                                </span>
                                                <h3 class="font-black text-gray-800 tracking-tight"><%= addr.houseName %></h3>
                                            </div>
                                            
                                            <p class="text-gray-500 text-sm leading-relaxed mb-6 font-medium">
                                                <%= addr.houseNumber %>, <%= addr.street %><br />
                                                <%= addr.post %>, <%= addr.district %><br />
                                                <%= addr.state %> - <span class="font-bold text-gray-900 tracking-wider"><%= addr.pincode %></span>
                                            </p>

                                            <div class="flex flex-col gap-2 mb-6">
                                                <span class="text-xs text-gray-400 font-bold uppercase tracking-widest flex items-center gap-2">
                                                    <i class="fas fa-phone-alt text-gray-300"></i> <%= addr.phone %>
                                                </span>
                                                <% if(addr.altPhone) { %>
                                                <span class="text-xs text-gray-400 font-bold uppercase tracking-widest flex items-center gap-2">
                                                    <i class="fas fa-phone text-gray-300"></i> <%= addr.altPhone %>
                                                </span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div class="flex gap-3 pt-6 border-t border-gray-100">
                                            <button onclick="editAddress('<%= addr._id %>')" class="flex-1 bg-white text-gray-700 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest border border-gray-200 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all">
                                                Edit
                                            </button>
                                            <button onclick="deleteAddress('<%= addr._id %>')" class="flex-1 bg-white text-rose-500 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest border border-gray-200 hover:bg-rose-500 hover:text-white hover:border-rose-500 transition-all">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-20 bg-gray-50 rounded-3xl border-4 border-dashed border-gray-100">
                            <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm">
                                <i class="fas fa-map-location-dot text-3xl text-gray-200"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-400 uppercase tracking-widest">No Addresses Found</h3>
                            <p class="text-gray-400 text-sm mt-2">Add a new location to get started with your orders.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <div id="addAddressModal" class="fixed inset-0 bg-black/80 backdrop-blur-md hidden justify-center items-center z-[200] p-4">
        <div class="bg-white w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-[2.5rem] shadow-2xl no-scrollbar flex flex-col">
            <div class="sticky top-0 bg-white/90 backdrop-blur px-8 py-6 border-b border-gray-50 flex items-center justify-between z-10">
                <h2 class="text-xl font-black text-gray-900 uppercase tracking-tighter">Add New Address</h2>
                <button onclick="closeAddAddressModal()" class="w-10 h-10 flex items-center justify-center bg-gray-50 rounded-full text-gray-400 hover:text-red-500 transition">✕</button>
            </div>

            <div class="p-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">Type</label>
                        <select id="addrLabel" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 text-gray-700 font-bold focus:bg-white focus:border-blue-500 outline-none transition-all">
                            <option value="Home">Home</option>
                            <option value="Office">Office</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">House Name</label><input id="addrHouseName" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none focus:bg-white focus:border-blue-500" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">Flat/House Number</label><input id="addrHouseNumber" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none focus:bg-white focus:border-blue-500" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">Street</label><input id="addrStreet" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none focus:bg-white focus:border-blue-500" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">Post Office</label><input id="addrPost" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none focus:bg-white focus:border-blue-500" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">District</label><input id="addrDistrict" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none focus:bg-white focus:border-blue-500" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">State</label><input id="addrState" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none focus:bg-white focus:border-blue-500" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">Pincode</label><input id="addrPincode" type="number" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none focus:bg-white focus:border-blue-500" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">Phone</label><input id="addrPhone" type="number" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none focus:bg-white focus:border-blue-500" /></div>
                    <div class="md:col-span-2"><label class="text-[10px] font-black text-gray-400 uppercase ml-1 mb-1 block">Alt Phone</label><input id="addrAltPhone" type="number" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none focus:bg-white focus:border-blue-500" /></div>
                </div>

                <div class="mt-10 flex flex-col sm:flex-row gap-4">
                    <button onclick="saveNewAddress()" class="flex-1 bg-blue-600 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest shadow-lg shadow-blue-100 transition active:scale-95">SAVE ADDRESS</button>
                    <button onclick="resetAddressFields()" class="flex-1 bg-gray-100 text-gray-500 py-4 rounded-2xl font-bold transition active:scale-95">CLEAR ALL</button>
                </div>
            </div>
        </div>
    </div>

    <div id="editAddressModal" class="fixed inset-0 bg-black/80 backdrop-blur-md hidden justify-center items-center z-[200] p-4">
        <div class="bg-white w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-[2.5rem] shadow-2xl no-scrollbar flex flex-col">
            <div class="sticky top-0 bg-white/90 backdrop-blur px-8 py-6 border-b border-gray-50 flex items-center justify-between z-10">
                <h2 class="text-xl font-black text-gray-900 uppercase tracking-tighter">Edit Address</h2>
                <button onclick="closeEditAddressModal()" class="w-10 h-10 flex items-center justify-center bg-gray-50 rounded-full text-gray-400">✕</button>
            </div>

            <div class="p-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2"><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">Type</label><select id="editAddrLabel" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 text-gray-700 font-bold focus:border-blue-500 outline-none"><option value="Home">Home</option><option value="Office">Office</option><option value="Other">Other</option></select></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">House Name</label><input id="editHouseName" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">House Number</label><input id="editHouseNumber" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">Street</label><input id="editStreet" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">Post</label><input id="editPost" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">District</label><input id="editDistrict" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">State</label><input id="editState" type="text" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">Pincode</label><input id="editPincode" type="number" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none" /></div>
                    <div><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">Phone</label><input id="editPhone" type="number" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none" /></div>
                    <div class="md:col-span-2"><label class="text-[10px] font-black text-gray-400 uppercase ml-1 block mb-1">Alt Phone</label><input id="editAltPhone" type="number" class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 font-bold outline-none" /></div>
                </div>

                <div class="mt-10 flex gap-4">
                    <button onclick="updateAddress(window.editingAddressId)" class="flex-1 bg-blue-600 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-widest shadow-lg shadow-blue-100 transition active:scale-95">UPDATE ADDRESS</button>
                    <button onclick="closeEditAddressModal()" class="flex-1 bg-gray-100 text-gray-500 py-4 rounded-2xl font-bold transition active:scale-95">CANCEL</button>
                </div>
            </div>
        </div>
    </div>

    <%- include("../../views/partials/user/footer") %>
    <script src="/user/js/address.js"></script>

</body>
</html>