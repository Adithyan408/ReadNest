<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout - ReadNest</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }
    </style>
  </head>

  <body class="bg-gray-100">
    <!-- Header -->
    <%- include("../../views/partials/user/header") %>

    <main class="max-w-4xl mx-auto px-6 py-16">
      <!-- Success Card -->
      <div class="bg-white shadow-xl rounded-2xl p-10 text-center space-y-6">
        <!-- Success Icon -->
        <div class="flex justify-center">
          <div class="bg-green-100 p-5 rounded-full">
            <i class="fa-solid fa-circle-check text-green-600 text-5xl"></i>
          </div>
        </div>

        <!-- Heading -->
        <h1 class="text-3xl font-bold text-gray-800">
          Your Order Has Been Successfully Placed!
        </h1>

        <!-- Message -->
        <p class="text-gray-600 text-lg leading-relaxed">
          Thank you for shopping with
          <span class="font-semibold text-blue-600">ReadNest</span>. We’ve
          received your order and it’s now being processed.
        </p>

        <!-- Order Details Summary -->
        <div class="bg-gray-50 border rounded-xl p-6 text-left space-y-3">
          <h2 class="text-xl font-bold text-gray-800 mb-3">Order Summary</h2>

          <p class="text-gray-700">
            <span class="font-semibold">Name:</span> <%= user.name %>
          </p>

          <p class="text-gray-700">
            <span class="font-semibold">Order Amount:</span> ₹ <%= totalAmount
            %>
          </p>

          <% if (selectedAddress) { %>
          <p class="text-gray-700">
            <span class="font-semibold">Delivery Address:</span><br />
            <span class="text-gray-600 text-sm">
              <%= selectedAddress.houseName %>, <%= selectedAddress.street %><br />
              <%= selectedAddress.district %> - <%= selectedAddress.pincode
              %><br />
              Phone: <%= selectedAddress.phone %>
            </span>
          </p>
          <% } %>
        </div>

        <!-- Buttons -->
        <div class="flex justify-center gap-4 mt-8">
          <a
            href="/orders"
            class="bg-blue-600 text-white px-6 py-3 rounded-lg text-lg font-semibold hover:bg-blue-700 transition"
          >
            View My Orders
          </a>

          <a
            href="/"
            class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg text-lg font-semibold hover:bg-gray-300 transition"
          >
            Continue Shopping
          </a>
        </div>
      </div>
    </main>

    <%- include("../../views/partials/user/footer") %>
    <script>
      // Prevent loading previous checkout page
      window.history.pushState(null, "", window.location.href);
      window.onpopstate = function () {
        window.location.href = "/cart"; 
      };
    </script>
  </body>
</html>
