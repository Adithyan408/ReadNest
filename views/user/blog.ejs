<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogs</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>

  <body class="bg-gray-100">
    <!-- ================= GLOBAL HEADER ================= -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <!-- Logo -->
          <div class="flex items-center space-x-2">
            <div class="w-14 h-14 rounded-full overflow-hidden">
              <a href="/">
                <img
                  src="/images/logo2.png"
                  class="w-full h-full object-cover"
                />
              </a>
            </div>
            <a href="/" class="text-xl font-bold text-gray-800">ReadNest</a>
          </div>

        

          <!-- Right Menu -->
          <div class="flex items-center space-x-6">
            <button
              onclick="openBlog()"
              class="flex items-center space-x-2 px-4 py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50"
            >
              <i class="fas fa-bars text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700">BLOG</span>
            </button>

            <a href="/cart" class="flex items-center space-x-1">
              <i class="fas fa-shopping-cart text-xl text-gray-700"></i>
              <span class="text-sm text-gray-700">Cart</span>
            </a>

            <a href="/account" class="flex items-center space-x-2">
              <i class="fas fa-user-circle text-2xl text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700"><%= user.name %></span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ================= PAGE TOOLBAR ================= -->
    <section class="max-w-7xl mx-auto px-4 mt-6">
      <div
        class="bg-white rounded-xl shadow-sm px-6 py-4 flex justify-between items-center"
      >
        <h2 class="text-xl font-semibold text-gray-800">Blogs</h2>

        <div class="flex items-center gap-4">
          <button
            onclick="window.location.href='/blog/addBlog'"
            class="flex items-center gap-2 px-5 py-2 rounded-full bg-blue-600 text-white text-sm font-medium hover:bg-blue-700"
          >
            <i class="fa-solid fa-pen"></i>
            Publish
          </button>

          <button
            class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center hover:bg-blue-100"
          >
            <i class="fa-regular fa-bell text-blue-600"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- ================= BLOG CONTENT ================= -->
    <main class="max-w-7xl mx-auto px-4 py-8">
      <div class="max-w-xl mx-auto">
        <% if (blogs.length === 0) { %>
        <p class="text-center text-gray-500 mt-20">
          No blogs published yet
        </p>
        <% } %>

        <% blogs.forEach(blog => { %>
        <div
          class="bg-white rounded-xl shadow-md p-6 mb-6"
        >
          <h3 class="text-lg font-semibold text-gray-800 mb-2">
            <%= blog.title %>
          </h3>
          
           <p class="text-sm text-gray-500 mb-3">
          By <span class="font-medium text-gray-700">
            <%= blog.author?.name || "Unknown" %>
          </span>
          · <%= new Date(blog.createdAt).toDateString() %>
        </p>

          <a
            href="/blogs/<%= blog._id %>"
            class="text-blue-600 text-sm font-medium hover:underline"
          >
            Read more →
          </a>

          <div
            class="flex justify-around border-t mt-4 pt-4 text-gray-600"
          >
            <button class="flex items-center gap-2 hover:text-blue-600">
              <i class="fa-regular fa-heart"></i> Like
            </button>

            <button class="flex items-center gap-2 hover:text-blue-600">
              <i class="fa-regular fa-comment"></i> Comment
            </button>

            <button class="flex items-center gap-2 hover:text-blue-600">
              <i class="fa-solid fa-share"></i> Share
            </button>
          </div>
        </div>
        <% }) %>
      </div>
    </main>

    <!-- ================= SCRIPT ================= -->
    <script>
      function openBlog() {
        window.location.href = "/blog";
      }
    </script>
  </body>
</html>
