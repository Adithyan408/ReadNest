<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogs | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/user/css/blog">
    
  </head>

  <body class="bg-gray-100">
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="w-10 h-10 lg:w-14 lg:h-14 rounded-full overflow-hidden shrink-0">
              <a href="/"><img src="/images/logo2.png" class="w-full h-full object-cover" /></a>
            </div>
            <a href="/" class="text-lg lg:text-xl font-bold text-gray-800">ReadNest</a>
          </div>

          <div class="flex items-center space-x-3 lg:space-x-6">
            <button onclick="openBlog()" class="flex items-center p-2 lg:px-4 lg:py-2 bg-white rounded-lg border border-gray-300">
              <i class="fas fa-bars text-gray-700"></i>
              <span class="hidden lg:inline text-sm font-medium ml-2">BLOG</span>
            </button>
            <a href="/cart" class="p-2"><i class="fas fa-shopping-cart text-xl text-gray-700"></i></a>
            <a href="/account" class="p-2"><i class="fas fa-user-circle text-2xl text-gray-700"></i></a>
          </div>
        </div>
      </div>
    </header>

    <section class="sticky top-[64px] lg:top-[76px] z-40 bg-white/90 backdrop-blur border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 py-3 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="hidden sm:flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
            <i class="fa-solid fa-book-open text-blue-600"></i>
          </div>
          <div>
            <h2 class="text-base lg:text-lg font-bold text-gray-800 leading-none">Blogs</h2>
            <p class="text-[10px] lg:text-xs text-gray-500">Community Thoughts</p>
          </div>
        </div>

        <div class="relative w-full md:w-64 lg:w-96">
          <input type="text" id="blogSearch" placeholder="Search blogs..." 
                 class="w-full pl-10 pr-10 py-2 text-sm border border-gray-300 rounded-full focus:ring-2 focus:ring-blue-500 outline-none"
                 oninput="searchBlogs(this.value)" />
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <button id="clearSearchBtn" onclick="clearSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="flex items-center justify-between w-full md:w-auto gap-4">
          <button onclick="window.location.href='/blog/addBlog'" class="flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-2 rounded-full bg-blue-600 text-white text-sm font-bold shadow-md hover:bg-blue-700">
            <i class="fa-solid fa-pen text-xs"></i> Publish
          </button>
          <button id="notificationBtn" class="relative w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
            <i class="fa-regular fa-bell text-blue-600"></i>
            <span id="notifCount" class="hidden absolute -top-1 -right-1 bg-red-600 text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-white"></span>
          </button>
        </div>
      </div>
    </section>

    <%- include("../../views/partials/user/blogSidebar") %>
    
    <main class="max-w-7xl mx-auto px-4 py-6 lg:py-10">
      <div class="max-w-3xl mx-auto" id="blogsContainer">
        <% if (blogs.length === 0) { %>
          <div class="text-center py-20 text-gray-500">
            <i class="fa-solid fa-cloud-moon text-4xl mb-4 block"></i>
            <p>No blogs published yet</p>
          </div>
        <% } %> 
        
        <% blogs.forEach(blog => { %>
        <div class="blog-card bg-white rounded-2xl border border-gray-200 shadow-sm p-5 lg:p-8 mb-6">
          <h3 class="text-lg lg:text-xl font-bold text-gray-900 leading-tight mb-2 hover:text-blue-700 transition">
            <%= blog.title %>
          </h3>
          <p class="text-xs text-gray-500 mb-4 italic">
            By <span class="font-bold text-gray-700"><%= blog.author?.name || "Unknown" %></span> · <%= new Date(blog.createdAt).toDateString() %>
          </p>
          <a href="/blogs/<%= blog._id %>" class="inline-flex items-center gap-1 text-blue-600 text-sm font-bold hover:underline mb-6">
            Read full story <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
          
          <div class="flex justify-between items-center border-t border-gray-50 pt-4">
            <div class="flex gap-4 lg:gap-8">
              <button onclick="toggleLike('<%= blog._id %>')" class="flex items-center gap-2 text-gray-600 hover:text-red-500 transition">
                <i class="fa-heart <%= blog.userLiked ? 'fa-solid text-red-500' : 'fa-regular' %>"></i>
                <span class="text-xs font-bold"><%= blog.likeCount %></span>
              </button>
              <a href="/blogs/<%= blog._id %>#comments" class="flex items-center gap-2 text-gray-600 hover:text-blue-600">
                <i class="fa-regular fa-comment"></i>
                <span class="text-xs font-bold"><%= blog.commentCount %></span>
              </a>
            </div>

            <div class="flex items-center gap-4 lg:gap-6">
              <button onclick="toggleSave('<%= blog._id %>')" class="p-2">
                <i class="fa-bookmark text-lg <%= blog.isSaved ? 'fa-solid text-blue-600' : 'fa-regular text-gray-400 hover:text-black' %>"></i>
              </button>
              <button class="text-gray-500 text-xs font-bold flex items-center gap-1 hover:text-indigo-600" 
                      data-id="<%= blog._id %>" data-title="<%= blog.title %>" onclick="openShareModal(this)">
                <i class="fa-solid fa-share-nodes"></i> <span class="hidden sm:inline">Share</span>
              </button>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <div id="notificationModal" class="hidden fixed lg:absolute right-4 left-4 lg:left-auto lg:right-6 top-[180px] lg:top-[132px] z-50 w-auto lg:w-96">
        <div class="bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden">
          <div class="flex justify-between items-center px-4 py-3 border-b bg-gray-50">
            <button id="closeNotification" class="text-xs text-gray-500 font-bold flex items-center gap-1">
              <i class="fa-solid fa-chevron-left text-[10px]"></i> Close
            </button>
            <h3 class="font-bold text-xs uppercase tracking-wider text-gray-400">Activity</h3>
            <button id="markAllRead" class="text-xs text-blue-600 font-bold">Clear All</button>
          </div>
          <div id="notificationList" class="max-h-80 overflow-y-auto divide-y divide-gray-50"></div>
        </div>
      </div>

      <div id="shareModal" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-[60] p-4">
        <div class="bg-white rounded-2xl w-full max-w-xs p-6 relative shadow-2xl animate-in zoom-in-95">
          <h3 class="text-lg font-bold mb-6 text-center text-gray-900">Spread the word</h3>
          <div class="flex justify-around text-3xl mb-6">
            <a id="whatsappShare" target="_blank" class="text-green-500 hover:scale-110 transition"><i class="fab fa-whatsapp"></i></a>
            <a id="facebookShare" target="_blank" class="text-blue-600 hover:scale-110 transition"><i class="fab fa-facebook"></i></a>
            <a id="twitterShare" target="_blank" class="text-black hover:scale-110 transition"><i class="fab fa-x-twitter"></i></a>
          </div>
          <button onclick="copyLink()" class="w-full bg-gray-100 py-3 rounded-xl text-sm font-bold text-gray-700 hover:bg-gray-200 active:bg-gray-300">
            <i class="fa-solid fa-link mr-2"></i> Copy Link
          </button>
          <button onclick="closeShareModal()" class="absolute -top-3 -right-3 w-8 h-8 bg-white rounded-full shadow-lg text-gray-400 hover:text-red-500 transition">✕</button>
        </div>
      </div>
    </main>

   <script src="/user/js/blog.js"></script>
  </body>
</html>