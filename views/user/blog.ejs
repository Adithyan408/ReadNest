
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogs</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>

  <body class="bg-gray-100">
    <!-- ================= GLOBAL HEADER ================= -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <!-- Logo -->
          <div class="flex items-center space-x-2">
            <div class="w-14 h-14 rounded-full overflow-hidden">
              <a href="/">
                <img
                  src="/images/logo2.png"
                  class="w-full h-full object-cover"
                />
              </a>
            </div>
            <a href="/" class="text-xl font-bold text-gray-800">ReadNest</a>
          </div>

          <!-- Right Menu -->
          <div class="flex items-center space-x-6">
            <button
              onclick="openBlog()"
              class="flex items-center space-x-2 px-4 py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50"
            >
              <i class="fas fa-bars text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700">BLOG</span>
            </button>

            <a href="/cart" class="flex items-center space-x-1">
              <i class="fas fa-shopping-cart text-xl text-gray-700"></i>
              <span class="text-sm text-gray-700">Cart</span>
            </a>

            <a href="/account" class="flex items-center space-x-2">
              <i class="fas fa-user-circle text-2xl text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700"
                ><%= user.name %></span
              >
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ================= PAGE TOOLBAR ================= -->
    <section
      class="sticky top-[76px] z-40 bg-white/90 backdrop-blur border-b border-gray-200"
    >
      <div
        class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between"
      >
        <!-- Left -->
        <div class="flex items-center gap-3">
          <div
            class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center"
          >
            <i class="fa-solid fa-book-open text-blue-600"></i>
          </div>
          <div>
            <h2 class="text-lg font-semibold text-gray-800">Blogs</h2>
            <p class="text-xs text-gray-500">
              Read & share thoughts from the community
            </p>
          </div>
        </div>

        <!-- Right -->
        <div class="flex items-center gap-4">
          <button
            onclick="window.location.href='/blog/addBlog'"
            class="flex items-center gap-2 px-5 py-2 rounded-full bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition shadow-sm"
          >
            <i class="fa-solid fa-pen"></i>
            Publish
          </button>

          <button
            class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center hover:bg-blue-100 transition"
          >
            <i class="fa-regular fa-bell text-blue-600"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- ================= BLOG CONTENT ================= -->
    <%- include("../../views/partials/user/blogSidebar") %>
    <main class="max-w-7xl mx-auto px-4 py-10">
  <div class="max-w-3xl mx-auto px-8">
    <% if (blogs.length === 0) { %>
      <p class="text-center text-gray-500 mt-20 text-sm">
        No blogs published yet
      </p>
    <% } %>
    <% blogs.forEach(blog => { %>
      <div
        class="bg-white rounded-2xl border border-gray-200
               hover:shadow-sm transition p-8 mb-6"
      >
        <!-- TITLE -->
        <h3
          class="text-xl font-semibold text-gray-900
                 leading-snug mb-2 hover:text-blue-700 transition"
        >
          <%= blog.title %>
        </h3>
        <!-- META -->
        <p class="text-sm text-gray-500 mb-4">
          By
          <span class="font-medium text-gray-700">
            <%= blog.author?.name || "Unknown" %>
          </span>
          · <%= new Date(blog.createdAt).toDateString() %>
        </p>
        <!-- CTA -->
        <a
          href="/blog/<%= blog._id %>"
          class="inline-flex items-center gap-1
                 text-blue-600 text-sm font-medium
                 hover:underline mb-5"
        >
          Read more
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
        <!-- ACTION BAR -->
        <div
          class="flex justify-between items-center
                 border-t border-gray-100 pt-4 text-gray-600"
        >
          <!-- LEFT ACTIONS -->
          <div class="flex gap-6">
            <!-- LIKE -->
            <button
              onclick="toggleLike('<%= blog._id %>')"
              class="flex items-center gap-2 hover:text-red-500 transition"
            >
              <i
                class="fa-heart
                <%= blog.userLiked ? 'fa-solid text-red-500' : 'fa-regular' %>"
              ></i>
              <span class="text-sm">
                <%= blog.likeCount %>
              </span>
            </button>
            <!-- COMMENT -->
            <a
              href="/blog/<%= blog._id %>#comments"
              class="flex items-center gap-2 hover:text-blue-600 transition"
            >
              <i class="fa-regular fa-comment"></i>
              <span class="text-sm">
                <%= blog.commentCount %>
              </span>
            </a>
          </div>
          <!-- SHARE -->
          <button
            class="flex items-center gap-2 hover:text-blue-600 transition text-sm"
          >
            <i class="fa-solid fa-share"></i>
            Share
          </button>
        </div>
      </div>
    <% }) %>
  </div>
</main>

    <!-- ================= SCRIPT ================= -->
    <script>
      function openBlog() {
        window.location.href = "/blog";
      }

      async function toggleLike(blogId) {
        try {
          const res = await fetch("/blog/like", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ blogId }),
          });

          const data = await res.json();
          if (data.success !== false) {
            location.reload(); // simple & safe
          }
        } catch (err) {
          console.error("Like failed");
        }
      }
    </script>
  </body>
</html>