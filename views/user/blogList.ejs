<% if (!blogs || blogs.length === 0) { %>
  <p class="text-center text-gray-500 mt-20 text-sm">
    No blogs found
  </p>
<% } else { %>

  <% blogs.forEach(blog => { %>
    <div
      class="bg-white rounded-2xl border border-gray-200 hover:shadow-sm transition p-8 mb-6"
    >
      <!-- TITLE -->
      <h3
        class="text-xl font-semibold text-gray-900 leading-snug mb-2 hover:text-blue-700 transition"
      >
        <%= blog.title %>
      </h3>

      <!-- META -->
      <p class="text-sm text-gray-500 mb-4">
        By
        <span class="font-medium text-gray-700">
          <%= blog.author?.name || "Unknown" %>
        </span>
        · <%= new Date(blog.createdAt).toDateString() %>
      </p>

      <!-- CTA -->
      <a
        href="/blogs/<%= blog._id %>"
        class="inline-flex items-center gap-1 text-blue-600 text-sm font-medium hover:underline mb-5"
      >
        Read more
        <i class="fa-solid fa-arrow-right text-xs"></i>
      </a>

      <!-- ACTION BAR -->
      <div
        class="flex justify-between items-center border-t border-gray-100 pt-4 text-gray-600"
      >
        <!-- LEFT -->
        <div class="flex gap-6">
          <!-- LIKE -->
          <button
            onclick="toggleLike('<%= blog._id %>')"
            class="flex items-center gap-2 hover:text-red-500 transition"
          >
            <i
              class="fa-heart <%= blog.userLiked ? 'fa-solid text-red-500' : 'fa-regular' %>"
            ></i>
            <span class="text-sm"><%= blog.likeCount || 0 %></span>
          </button>

          <!-- COMMENT -->
          <a
            href="/blogs/<%= blog._id %>#comments"
            class="flex items-center gap-2 hover:text-blue-600 transition"
          >
            <i class="fa-regular fa-comment"></i>
            <span class="text-sm"><%= blog.commentCount || 0 %></span>
          </a>
        </div>

        <!-- RIGHT -->
        <div class="flex items-center gap-5">
          <!-- SAVE -->
          <button
            onclick="toggleSave('<%= blog._id %>')"
            class="transition"
            title="Save"
          >
            <i
              class="fa-bookmark text-lg transition <%= blog.isSaved ? 'fa-solid text-blue-600' : 'fa-regular text-gray-500 hover:text-black' %>"
            ></i>
          </button>

          <!-- SHARE -->
          <button
            class="flex items-center gap-2 hover:text-blue-600 transition text-sm"
          >
            <i class="fa-solid fa-share"></i>
            Share
          </button>
        </div>
      </div>
    </div>
  <% }) %>

<% } %>
