<% if (!blogs || blogs.length === 0) { %>
  <div class="flex flex-col items-center justify-center py-20 px-4">
    <i class="fa-solid fa-magnifying-glass text-gray-300 text-4xl mb-4"></i>
    <p class="text-center text-gray-500 text-sm italic">
      No blogs found matching your criteria.
    </p>
  </div>
<% } else { %>

  <% blogs.forEach(blog => { %>
    <div class="bg-white rounded-2xl border border-gray-200 hover:shadow-md transition-shadow p-5 lg:p-8 mb-6 shadow-sm">
      
      <a href="/blogs/<%= blog._id %>" class="block group">
        <h3 class="text-lg lg:text-xl font-bold text-gray-900 leading-snug mb-2 group-hover:text-blue-700 transition-colors">
          <%= blog.title %>
        </h3>
      </a>

      <p class="text-xs lg:text-sm text-gray-500 mb-4 flex items-center flex-wrap gap-1">
        <span>By</span>
        <span class="font-semibold text-gray-700"><%= blog.author?.name || "Unknown" %></span>
        <span class="mx-1 text-gray-300">•</span>
        <span><%= new Date(blog.createdAt).toLocaleDateString() %></span>
      </p>

      <a
        href="/blogs/<%= blog._id %>"
        class="inline-flex items-center gap-1 text-blue-600 text-sm font-bold hover:underline mb-6"
      >
        Read more
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>

      <div class="flex justify-between items-center border-t border-gray-100 pt-4 text-gray-600">
        
        <div class="flex gap-5 lg:gap-8">
          <button
            onclick="toggleLike('<%= blog._id %>')"
            class="flex items-center gap-2 hover:text-red-500 transition-colors py-1"
          >
            <i class="fa-heart <%= blog.userLiked ? 'fa-solid text-red-500' : 'fa-regular' %> text-lg lg:text-base"></i>
            <span class="text-xs lg:text-sm font-medium"><%= blog.likeCount || 0 %></span>
          </button>

          <a
            href="/blogs/<%= blog._id %>#comments"
            class="flex items-center gap-2 hover:text-blue-600 transition-colors py-1"
          >
            <i class="fa-regular fa-comment text-lg lg:text-base"></i>
            <span class="text-xs lg:text-sm font-medium"><%= blog.commentCount || 0 %></span>
          </a>
        </div>

        <div class="flex items-center gap-4 lg:gap-6">
          <button
            onclick="toggleSave('<%= blog._id %>')"
            class="p-1 transition-transform active:scale-90"
            title="Save"
          >
            <i class="fa-bookmark text-lg lg:text-xl transition-colors <%= blog.isSaved ? 'fa-solid text-blue-600' : 'fa-regular text-gray-400 hover:text-black' %>"></i>
          </button>

          <button
            data-id="<%= blog._id %>"
            data-title="<%= blog.title %>"
            onclick="openShareModal(this)"
            class="flex items-center gap-2 hover:text-indigo-600 transition-colors text-xs lg:text-sm font-bold"
          >
            <i class="fa-solid fa-share-nodes text-base lg:text-sm"></i>
            <span class="hidden sm:inline">Share</span>
          </button>
        </div>
      </div>
    </div>
  <% }) %>

<% } %>