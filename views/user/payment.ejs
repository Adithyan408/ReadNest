<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout - ReadNest</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }
    </style>
  </head>

  <body class="bg-gray-100">
    <!-- Header -->
    <%- include("../../views/partials/user/header") %>

    <main class="max-w-7xl mx-auto px-4 py-8">
      <%- include('../../views/partials/breadcrumb') %>

      <div class="flex flex-col lg:flex-row gap-8 px-4 lg:px-20">
        <!-- LEFT SIDE CONTENT -->
        <div class="flex-1 space-y-6">
          <!-- USER DETAILS -->
          <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-xl font-bold text-gray-800 mb-4">User Details</h2>

            <p class="text-gray-700">
              <span class="font-semibold">Name:</span> <%= user.name %>
            </p>
            <p class="text-gray-700">
              <span class="font-semibold">Email:</span> <%= user.email %>
            </p>
            <p class="text-gray-700">
              <span class="font-semibold">Phone:</span> <%= user.phone %>
            </p>
          </div>

          <!-- DELIVERY ADDRESS -->
          <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-xl font-bold text-gray-800">Delivery Address</h2>

            <% if (!selectedAddress) { %>
            <p class="text-gray-600 mt-3">No address selected</p>
            <% } else { %>

            <div class="mt-4 border p-4 rounded-lg bg-gray-50 relative">
              <p class="font-semibold">
                <%= selectedAddress.addressLabel %> Address
              </p>
              <p class="text-gray-700 text-sm">
                <%= selectedAddress.houseName %>, <%= selectedAddress.street %>
              </p>
              <p class="text-gray-600 text-sm">
                <%= selectedAddress.district %> - <%= selectedAddress.pincode %>
              </p>
              <p class="text-gray-600 text-sm">
                Phone: <%= selectedAddress.phone %>
              </p>
            </div>

            <% } %>
          </div>

          <!-- ORDER SUMMARY -->
          <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-xl font-bold text-gray-800 mb-4">Order Summary</h2>

            <% if (isBuyNow && cart.length === 1) { %>

            <!-- BUY NOW -->
            <p class="text-gray-700 font-medium">
              Product:
              <span class="font-bold"><%= cart[0].name %></span>
            </p>

            <p class="text-gray-700 font-medium mt-2">
              Quantity: <span class="font-bold"><%= cart[0].quantity %></span>
            </p>

            <p class="text-gray-700 font-medium mt-2">
              Price:
              <span class="font-bold" id="singlePrice"
                >₹ <%= cart[0].price * cart[0].quantity %></span
              >
            </p>

            <p class="text-gray-700 font-medium mt-2">
              Total Amount:
              <span class="font-bold">₹ <%= totalAmount %></span>
            </p>

            <% } else { %>

            <!-- NORMAL CART -->
            <p class="text-gray-700 font-medium">
              Total Products:
              <span class="font-bold"><%= cart.length %></span>
            </p>

            <p class="text-gray-700 font-medium mt-2">
              Total Amount:
              <span class="font-bold" id="singleTotal"
                >₹ <%= totalAmount %></span
              >
            </p>
            <% } %>
          </div>
        </div>

        <!-- RIGHT SIDE: PAYMENT + COUPON SECTION -->
        <div class="w-full lg:w-96">
          <div class="bg-white p-6 rounded-lg shadow sticky top-20">
            <h2 class="text-xl font-bold text-gray-800 mb-6">
              Payment Options
            </h2>

            <!-- PAYMENT METHOD -->
            <label class="text-gray-700 font-medium"
              >Select Payment Method</label
            >
            <select
              id="paymentMethod"
              class="w-full p-3 border mt-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="">Choose payment method</option>
              <option value="COD">Cash On Delivery</option>
              <option value="Razorpay">Razorpay</option>
              <option value="Wallet">Wallet</option>
            </select>

            <!-- COUPON DROPDOWN -->
            <div class="mt-6">
              <input type="hidden" id="couponCode" />
              <label class="text-gray-700 font-medium">Choose Coupon</label>

              <div id="couponWrapper" class="relative mt-2">
                <!-- Dropdown Button -->
                <div
                  onclick="toggleCouponDropdown()"
                  class="w-full p-3 border rounded-lg bg-white cursor-pointer flex justify-between items-center hover:bg-gray-50 transition"
                >
                  <div class="flex items-center gap-2">
                    <!-- Coupon pill -->
                    <span
                      id="selectedCouponText"
                      class="text-gray-600 px-2 py-1 rounded-md bg-gray-100 text-sm font-medium"
                    >
                      Select a coupon
                    </span>

                    <!-- Remove Button -->
                    <button
                      id="removeCouponBtn"
                      onclick="removeCoupon(event)"
                      class="hidden text-red-600 text-xs font-semibold px-2 py-1 rounded-md bg-red-100 hover:bg-red-200 transition"
                    >
                      Remove
                    </button>
                  </div>

                  <i class="fas fa-chevron-down text-gray-500"></i>
                </div>

                <!-- Dropdown List -->
                <div
                  id="couponDropdown"
                  class="absolute w-full bg-white border rounded-lg mt-1 hidden shadow-lg max-h-56 overflow-y-auto z-20"
                >
                  <% if (coupons.length === 0) { %>

                  <p class="text-sm text-gray-500 p-3">No coupons available</p>

                  <% } else { %> <% coupons.forEach(c => { %>

                  <div
                    class="p-3 border-b cursor-pointer hover:bg-gray-100"
                    onclick="selectCouponFromList('<%= c.code %>')"
                  >
                    <div class="flex justify-between">
                      <span class="font-semibold text-gray-800"
                        ><%= c.code %></span
                      >
                      <span class="text-green-700 font-semibold"
                        ><%= c.discount %>% OFF</span
                      >
                    </div>

                    <p class="text-xs text-gray-500">
                      Min purchase: ₹<%= c.minPurchase || 0 %>
                    </p>

                    <p class="text-xs text-gray-400">
                      Expires: <%= c.expiry.toDateString() %>
                    </p>
                  </div>

                  <% }) %> <% } %>
                </div>
                <p id="couponMessage" class="text-sm mt-2 hidden"></p>
              </div>
            </div>

            <!-- PRICE DETAILS -->
            <div class="mt-6 border-t pt-4">
              <div class="flex justify-between mb-3">
                <span class="text-gray-700">Items Total</span>
                <span class="font-semibold text-gray-800"
                  >₹ <%= subtotal %></span
                >
              </div>

              <div
                id="discountBox"
                class="flex justify-between mb-3 <%= discount > 0 ? '' : 'hidden' %>"
              >
                <span class="text-gray-700">Discount</span>
                <span class="font-semibold text-green-700" id="discountAmount">
                  ₹ <%= discount %>
                </span>
              </div>

              <div class="flex justify-between mb-3">
                <span class="text-gray-700">Shipping Charge</span>
                <span class="font-semibold text-gray-800"
                  >₹ <%= shippingCharge %></span
                >
              </div>

              <div class="flex justify-between text-lg font-bold border-t pt-4">
                <span>Total Amount</span>
                <span id="totalAmount">₹ <%= payableAmount %></span>
              </div>
            </div>

            <!-- BUTTON -->
            <button
              onclick="processPayment()"
              class="w-full mt-6 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg text-lg font-bold"
            >
              Proceed to Pay
            </button>
          </div>
        </div>
      </div>
    </main>

    <%- include("../../views/partials/user/footer") %>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>
      const SHIPPING = Number("<%= shippingCharge %>");
    </script>

    <script>
      let baseTotal = Number("<%= totalAmount %>"); // original VAT + subtotal + shipping
      let originalTotal = baseTotal;
       let couponValid = true;
      function toggleCouponDropdown() {
        document.getElementById("couponDropdown").classList.toggle("hidden");
      }

      function selectCouponFromList(code) {
        // Set text in dropdown
        document.getElementById("selectedCouponText").textContent = code;

        // Apply coupon in input box
        document.getElementById("couponCode").value = code;

        // Hide dropdown
        document.getElementById("couponDropdown").classList.add("hidden");

        // Apply coupon automatically
        applyCoupon();
      }

      // Close dropdown if clicked outside
      document.addEventListener("click", function (event) {
        const wrapper = document.getElementById("couponWrapper");
        const dropdown = document.getElementById("couponDropdown");

        if (!wrapper.contains(event.target)) {
          dropdown.classList.add("hidden");
        }
      });

      function selectCouponFromList(code) {
        document.getElementById("selectedCouponText").textContent = code;
        document.getElementById("couponCode").value = code;

        // SHOW REMOVE BUTTON
        document.getElementById("removeCouponBtn").classList.remove("hidden");

        document.getElementById("couponDropdown").classList.add("hidden");

        applyCoupon();
      }

      function applyCoupon() {
        const coupon = document.getElementById("couponCode").value.trim();
        if (!coupon) {
          Swal.fire("Error", "Enter a coupon code!", "error");
          return;
        }

        fetch("/apply-coupon", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            coupon,
            totalAmount: originalTotal,
          }),
        })
          .then((res) => res.json())
          .then((data) => {
            const message = document.getElementById("couponMessage");
            const discountElement = document.getElementById("discountAmount");
            const totalElement = document.getElementById("totalAmount");

            if (!data.success) {
              couponValid = false;
              message.innerHTML = data.message;
              message.classList.remove("hidden");
              message.classList.add("text-red-600");

              Swal.fire("Invalid Coupon", data.message, "error");
              return;
            }

            // SUCCESS — now coupon is valid
            couponValid = true;

            message.innerHTML = data.message;
            message.classList.remove("text-red-600");
            message.classList.remove("hidden");

            discountElement.innerText = "₹ " + data.discount;

            const newTotal = data.finalAmount + SHIPPING;
            totalElement.innerText = "₹ " + newTotal;

            originalTotal = data.finalAmount;
            document.getElementById("discountBox").classList.remove("hidden");
          });
      }

      function removeCoupon(e) {
       
        e.stopPropagation();

        couponValid = true;
        document.getElementById("couponCode").value = "";
        document.getElementById("selectedCouponText").textContent =
          "Select a coupon";

        document.getElementById("removeCouponBtn").classList.add("hidden");

        document.getElementById("discountAmount").innerText = "₹ 0";
        document.getElementById("couponMessage").classList.add("hidden");

        document.getElementById("totalAmount").innerText = "₹ " + baseTotal;

        const singleTotalEl = document.getElementById("singleTotal");
        if (singleTotalEl) singleTotalEl.innerText = "₹ " + baseTotal;

        originalTotal = baseTotal;

        fetch("/remove-coupon", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        });
      }

      async function processPayment() {
        const method = document.getElementById("paymentMethod").value;

        if (!method) {
          Swal.fire("Wait!", "Please select a payment method", "warning");
          return;
        }

        if (method === "COD") {
          if (!couponValid) {
            Swal.fire(
              "Coupon Error",
              "Cannot place order because the coupon is invalid.",
              "error"
            );
            return;
          }

          window.location.href = `/place-order?payment=COD`;
          return;
        }

        if (method === "Razorpay") {
          try {
            const orderData = await fetch("/create-razorpay-order", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
            });

            const { success, order } = await orderData.json();
            if (!success) {
              return Swal.fire(
                "Error",
                "Unable to create payment order",
                "error"
              );
            }

            const options = {
              key: "<%= process.env.RAZO_API_KEY %>",
              amount: order.amount,
              currency: "INR",
              name: "ReadNest",
              description: "Order Payment",
              order_id: order.id,

              handler: async function (response) {
                const verify = await fetch("/verify-razorpay-payment", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(response),
                });

                const verifyRes = await verify.json();

                if (verifyRes.success) {
                  window.location.href = `/place-order?payment=ONLINE`;
                } else {
                  Swal.fire(
                    "Payment Failed",
                    "Verification error occurred",
                    "error"
                  );
                }
              },
            };

            const rzp = new Razorpay(options);
            rzp.open();
          } catch (e) {
            console.error(e);
            Swal.fire("Error", "Something went wrong with payment", "error");
          }
        }
      }
    </script>
  </body>
</html>
