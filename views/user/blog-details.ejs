<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= blog.title %> | ReadNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content="<%= blog.title %>" />
    <meta
      property="og:description"
      content="<%= blog.content.replace(/<[^>]+>/g, '').slice(0, 150) %>"
    />
    <meta property="og:url" content="<%= blogUrl %>" />
    <meta property="og:site_name" content="ReadNest" />

    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>
    <link rel="stylesheet" href="/user/css/blog-details.css">
    
  </head>

  <body class="bg-gray-50">
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div
              class="w-10 h-10 lg:w-14 lg:h-14 rounded-full overflow-hidden shrink-0"
            >
              <a href="/"
                ><img
                  src="/images/logo2.png"
                  class="w-full h-full object-cover"
              /></a>
            </div>
            <a href="/" class="text-lg lg:text-xl font-bold text-gray-800"
              >ReadNest</a
            >
          </div>

          <div class="flex items-center space-x-3 lg:space-x-6">
            <button
              onclick="openBlog()"
              class="flex items-center p-2 lg:px-4 lg:py-2 bg-white rounded-lg border border-gray-300"
            >
              <i class="fas fa-bars text-gray-700"></i>
              <span class="hidden lg:inline text-sm font-medium ml-2"
                >BLOG</span
              >
            </button>
            <a href="/cart" class="flex items-center p-2"
              ><i class="fas fa-shopping-cart text-xl text-gray-700"></i
            ></a>
            <a href="/account" class="flex items-center p-2"
              ><i class="fas fa-user-circle text-2xl text-gray-700"></i
            ></a>
          </div>
        </div>
      </div>
    </header>

    <section
      class="sticky top-[64px] lg:top-[76px] z-40 bg-white border-b border-blue-100 shadow-sm"
    >
      <div
        class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between"
      >
        <button
          onclick="window.history.back()"
          class="flex items-center gap-2 text-blue-600 font-medium hover:text-blue-700 text-sm lg:text-base"
        >
          <i class="fa-solid fa-arrow-left"></i> Back
        </button>

        <button
          id="notificationBtn"
          class="relative w-9 h-9 lg:w-10 lg:h-10 rounded-full bg-gray-100 flex items-center justify-center hover:bg-blue-100 transition"
        >
          <i class="fa-regular fa-bell text-blue-600"></i>
          <span
            id="notifCount"
            class="hidden absolute -top-1 -right-1 bg-red-600 text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-white"
          ></span>
        </button>
      </div>
    </section>

    <div
      id="notificationModal"
      class="hidden fixed lg:absolute right-4 left-4 lg:left-auto top-[120px] lg:top-[132px] z-50 w-auto lg:w-96"
    >
      <div
        class="bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden"
      >
        <div
          class="flex justify-between items-center px-4 py-3 border-b bg-gray-50"
        >
          <h3 class="font-bold text-sm text-gray-700">Notifications</h3>
          <button id="markAllRead" class="text-xs text-blue-600 font-semibold">
            Mark all read
          </button>
        </div>
        <div
          id="notificationList"
          class="max-h-80 lg:max-h-96 overflow-y-auto divide-y"
        ></div>
      </div>
    </div>

    <div class="flex flex-col lg:flex-row">
      <%- include("../../views/partials/user/blogSidebar") %>

      <main class="flex-1 max-w-3xl mx-auto px-4 lg:px-0 py-6 lg:py-10">
        <div
          class="bg-white p-5 lg:p-10 shadow-sm rounded-xl border border-gray-100"
        >
          <p
            class="text-xs lg:text-sm text-gray-500 mb-4 flex items-center gap-2"
          >
            <i class="fa-regular fa-calendar"></i>
            <%= new Date(blog.createdAt).toDateString() %> ·
            <span class="font-medium text-gray-700"
              >By <%= blog.author?.name || "Unknown" %></span
            >
          </p>

          <div
            class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6"
          >
            <h1
              class="text-2xl lg:text-4xl font-extrabold text-gray-900 leading-tight"
            >
              <%= blog.title %>
            </h1>

            <% if (user && blog.author && blog.author._id.toString() ===
            user._id.toString()) { %>
            <div
              class="flex flex-row md:flex-col items-center md:items-end gap-3 shrink-0"
            >
              <span
                class="text-[10px] uppercase tracking-widest px-3 py-1 rounded-full <%= blog.isBlocked ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %> font-bold"
              >
                <%= blog.isBlocked ? 'Blocked' : 'Published' %>
              </span>
              <div class="flex gap-4">
                <button
                  onclick="openEditModal()"
                  class="text-blue-600 hover:text-blue-800 text-sm font-bold flex items-center gap-1"
                >
                  <i class="fa-solid fa-pen"></i> Edit
                </button>
                <button
                  onclick="deleteBlog('<%= blog._id %>')"
                  class="text-red-600 hover:text-red-800 text-sm font-bold flex items-center gap-1"
                >
                  <i class="fa-solid fa-trash"></i> Delete
                </button>
              </div>
            </div>
            <% } %>
          </div>

          <article class="prose prose-blue max-w-none text-gray-800">
            <%- blog.content %>
          </article>

          <hr class="my-8 border-gray-100" />

          <div class="flex items-center justify-between">
            <button
              id="likeBtn"
              class="flex items-center gap-2 px-4 py-2 rounded-full transition <%= userLiked ? 'bg-red-50 text-red-500' : 'bg-gray-50 text-gray-600' %>"
              onclick="toggleLike('<%= blog._id %>')"
            >
              <i
                class="fa-heart <%= userLiked ? 'fa-solid' : 'fa-regular' %>"
              ></i>
              <span id="likeCount" class="font-bold"><%= likeCount %></span>
            </button>

            <a
              href="#commentText"
              class="text-gray-500 text-sm hover:underline"
            >
              <i class="fa-regular fa-comment mr-1"></i> <%= comments.length %>
              Comments
            </a>
          </div>

          <div class="mt-10">
            <h3 class="font-bold text-xl text-gray-900 mb-6">Conversation</h3>

            <div class="space-y-6">
              <% comments.forEach(c => { %>
              <div
                class="flex gap-4 p-4 rounded-lg bg-gray-50 border border-gray-100"
              >
                <div
                  class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center shrink-0"
                >
                  <span class="text-blue-600 font-bold uppercase text-xs"
                    ><%= c.user.name.charAt(0) %></span
                  >
                </div>
                <div class="flex-1">
                  <div class="flex justify-between items-start">
                    <p class="font-bold text-sm text-gray-900">
                      <%= c.user.name %>
                    </p>
                    <% if (user && c.user._id.toString() ===
                    user._id.toString()) { %>
                    <div class="flex gap-2">
                      <button
                        onclick="openEditCommentModal('<%= c._id %>', `<%- c.comment %>`)"
                        class="text-blue-500 text-xs hover:underline"
                      >
                        Edit
                      </button>
                      <button
                        onclick="deleteComment('<%= c._id %>')"
                        class="text-red-500 text-xs hover:underline"
                      >
                        Delete
                      </button>
                    </div>
                    <% } %>
                  </div>
                  <p class="text-gray-700 text-sm mt-1"><%= c.comment %></p>
                </div>
              </div>
              <% }) %>
            </div>

            <div
              class="mt-8 bg-white border-2 border-gray-100 rounded-xl p-2 focus-within:border-blue-400 transition"
            >
              <textarea
                id="commentText"
                placeholder="Write a thoughtful comment..."
                class="w-full p-3 outline-none resize-none text-sm h-24 lg:h-32"
              ></textarea>
              <div class="flex justify-end p-2">
                <button
                  onclick="addComment('<%= blog._id %>')"
                  class="bg-blue-600 text-white px-6 py-2 rounded-lg text-sm font-bold hover:bg-blue-700 transition shadow-md"
                >
                  Post Comment
                </button>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <div
      id="editModal"
      class="fixed inset-0 bg-black/60 hidden items-center justify-center z-[100] p-4"
    >
      <div
        class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl p-6 lg:p-8 relative max-h-[90vh] overflow-y-auto"
      >
        <h2 class="text-xl font-bold mb-4">Edit Your Story</h2>
        <input
          id="editTitle"
          class="w-full border-2 border-gray-100 rounded-xl p-4 mb-4 focus:border-blue-500 outline-none font-bold"
          value="<%= blog.title %>"
        />
        <textarea id="editContent"><%- blog.content %></textarea>
        <div class="flex justify-end gap-3 mt-6">
          <button
            onclick="closeEditModal()"
            class="px-6 py-2 border-2 border-gray-100 rounded-xl font-bold"
          >
            Cancel
          </button>
          <button
            onclick="updateBlog('<%= blog._id %>')"
            class="px-8 py-2 bg-blue-600 text-white rounded-xl font-bold hover:bg-blue-700"
          >
            Update Story
          </button>
        </div>
      </div>
    </div>

     <script src="/user/js/blog-details.js"></script>

  </body>
</html>
