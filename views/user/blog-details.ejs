<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= blog.title %> | ReadNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>

  <body class="bg-gray-50">
    <main class="max-w-3xl mx-auto px-4 py-10 bg-white shadow rounded-lg mt-10">
      <!-- Title -->
      <h1 class="text-3xl font-bold text-gray-900 mb-4"><%= blog.title %></h1>

      <p class="text-sm text-gray-500 mb-6">
        By
        <span class="font-medium text-gray-700">
          <%= blog.author?.name %>
        </span>
        · <%= new Date(blog.createdAt).toDateString() %>
      </p>

      <!-- Blog Content -->
      <article class="prose max-w-none"><%- blog.content %></article>

      <!-- Divider -->
      <hr class="my-8" />

      <!-- LIKE BUTTON -->
      <button
        id="likeBtn"
        class="flex items-center gap-2 <%= userLiked ? 'text-red-500' : 'text-gray-600' %>"
        onclick="toggleLike('<%= blog._id %>')"
      >
        <i class="fa-heart <%= userLiked ? 'fa-solid' : 'fa-regular' %>"></i>
        <span id="likeCount"><%= likeCount %></span>
      </button>

      <!-- COMMENTS -->
      <h3 id="comments" class="mt-8 font-semibold text-lg">
        Comments (<%= comments.length %>)
      </h3>

      <% comments.forEach(c => { %>
      <div class="border-b py-3">
        <p class="text-sm font-medium"><%= c.user.name %></p>
        <p class="text-gray-700"><%= c.comment %></p>
      </div>
      <% }) %>

      <!-- ADD COMMENT -->
      <textarea
        id="commentText"
        class="w-full border rounded p-2 mt-4"
      ></textarea>
      <button
        onclick="addComment('<%= blog._id %>')"
        class="bg-blue-600 text-white px-4 py-2 rounded mt-2"
      >
        Post Comment
      </button>
    </main>

    <script>
      async function toggleLike(blogId) {
        const res = await fetch("/blog/like", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ blogId }),
        });

        const data = await res.json();
        location.reload();
      }

      async function addComment(blogId) {
        const text = document.getElementById("commentText").value;

        const res = await fetch("/blog/comment", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ blogId, comment: text }),
        });

        const data = await res.json();
        if (data.success) location.reload();
      }
    </script>
  </body>
</html>
