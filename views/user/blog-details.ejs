<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= blog.title %> | ReadNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>
  </head>

  <body class="bg-gray-50">
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <!-- Logo -->
          <div class="flex items-center space-x-2">
            <div class="w-14 h-14 rounded-full overflow-hidden">
              <a href="/">
                <img
                  src="/images/logo2.png"
                  class="w-full h-full object-cover"
                />
              </a>
            </div>
            <a href="/" class="text-xl font-bold text-gray-800"> ReadNest </a>
          </div>

          <!-- Right Menu -->
          <div class="flex items-center space-x-6">
            <button
              onclick="openBlog()"
              class="flex items-center space-x-2 px-4 py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50"
            >
              <i class="fas fa-bars text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700">BLOG</span>
            </button>

            <a href="/cart" class="flex items-center space-x-1">
              <i class="fas fa-shopping-cart text-xl text-gray-700"></i>
              <span class="text-sm text-gray-700">Cart</span>
            </a>

            <a href="/account" class="flex items-center space-x-2">
              <i class="fas fa-user-circle text-2xl text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700">Account</span>
            </a>
          </div>
        </div>
      </div>
    </header>
    <section class="sticky top-[76px] z-40 bg-white border-b border-blue-100">
      <div
        class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between"
      >
        <!-- Back -->
        <button
          onclick="window.history.back()"
          class="flex items-center gap-2 text-blue-600 font-medium hover:text-blue-700"
        >
          <i class="fa-solid fa-arrow-left"></i>
          Back
        </button>

        <!-- Notification -->
        <button
          class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center hover:bg-blue-100"
        >
          <i class="fa-regular fa-bell text-blue-600 text-lg"></i>
        </button>
      </div>
    </section>
    <%- include("../../views/partials/user/blogSidebar") %>
    <main class="max-w-3xl mx-auto px-4 py-10 bg-white shadow rounded-lg mt-10">
      <!-- Title -->
      <div class="flex items-start justify-between mb-4">
        <h1 class="text-3xl font-bold text-gray-900"><%= blog.title %></h1>

        <% if (user && blog.author && blog.author._id.toString() ===
        user._id.toString()) { %>
        <div class="flex gap-3">
          <!-- EDIT BLOG -->
          <button
            onclick="openEditModal()"
            class="text-blue-600 hover:text-blue-800 text-sm font-medium"
          >
            <i class="fa-solid fa-pen"></i> Edit
          </button>

          <!-- DELETE BLOG -->
          <button
            onclick="deleteBlog('<%= blog._id %>')"
            class="text-red-600 hover:text-red-800 text-sm font-medium"
          >
            <i class="fa-solid fa-trash"></i> Delete
          </button>
        </div>
        <% } %>
      </div>

      <!-- Blog Content -->
      <article class="prose max-w-none"><%- blog.content %></article>

      <!-- Divider -->
      <hr class="my-8" />

      <!-- LIKE BUTTON -->
      <button
        id="likeBtn"
        class="flex items-center gap-2 <%= userLiked ? 'text-red-500' : 'text-gray-600' %>"
        onclick="toggleLike('<%= blog._id %>')"
      >
        <i class="fa-heart <%= userLiked ? 'fa-solid' : 'fa-regular' %>"></i>
        <span id="likeCount"><%= likeCount %></span>
      </button>

      <!-- COMMENTS -->
      <h3 id="comments" class="mt-8 font-semibold text-lg">
        Comments (<%= comments.length %>)
      </h3>

      <% comments.forEach(c => { %>
      <div class="border-b py-3 flex justify-between items-start">
        <div>
          <p class="text-grey-100 "><%= c.user.name %></p>
          <p class="text font-medium"><%= c.comment %></p>
        </div>

        <% if (user && c.user._id.toString() === user._id.toString()) { %>
        <div class="flex gap-3">
          <!-- EDIT COMMENT -->
          <button
            onclick="openEditCommentModal('<%= c._id %>', `<%- c.comment %>`)"
            class="text-blue-500 hover:text-blue-700 text-sm"
            title="Edit comment"
          >
            <i class="fa-solid fa-pen"></i>
          </button>

          <!-- DELETE COMMENT -->
          <button
            onclick="deleteComment('<%= c._id %>')"
            class="text-red-500 hover:text-red-700 text-sm"
            title="Delete comment"
          >
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
        <% } %>
      </div>
      <% }) %>

      <!-- ADD COMMENT -->
      <textarea
        id="commentText"
        class="w-full border rounded p-2 mt-4"
      ></textarea>
      <button
        onclick="addComment('<%= blog._id %>')"
        class="bg-blue-600 text-white px-4 py-2 rounded mt-2"
      >
        Post Comment
      </button>
    </main>
    <!-- EDIT BLOG MODAL -->
    <div
      id="editModal"
      class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50"
    >
      <div class="bg-white w-full max-w-3xl rounded-lg shadow-lg p-6 relative">
        <!-- Close -->
        <button
          onclick="closeEditModal()"
          class="absolute top-3 right-3 text-gray-500 hover:text-gray-800"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>

        <h2 class="text-xl font-semibold mb-4">Edit Blog</h2>

        <!-- TITLE -->
        <input
          id="editTitle"
          class="w-full border rounded p-3 mb-4"
          value="<%= blog.title %>"
        />

        <!-- CONTENT -->
        <textarea id="editContent"><%- blog.content %></textarea>

        <!-- ACTIONS -->
        <div class="flex justify-end gap-3 mt-4">
          <button onclick="closeEditModal()" class="px-4 py-2 border rounded">
            Cancel
          </button>

          <button
            onclick="updateBlog('<%= blog._id %>')"
            class="px-5 py-2 bg-blue-600 text-white rounded"
          >
            Update
          </button>
        </div>
      </div>
    </div>

    <!-- EDIT COMMENT MODAL -->
    <div
      id="editCommentModal"
      class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50"
    >
      <div class="bg-white w-full max-w-md rounded-lg shadow-lg p-6 relative">
        <!-- Close -->
        <button
          onclick="closeEditCommentModal()"
          class="absolute top-3 right-3 text-gray-500 hover:text-gray-800"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>

        <h3 class="text-lg font-semibold mb-4">Edit Comment</h3>

        <textarea
          id="editCommentText"
          class="w-full border rounded p-3"
          rows="4"
        ></textarea>

        <div class="flex justify-end gap-3 mt-4">
          <button
            onclick="closeEditCommentModal()"
            class="px-4 py-2 border rounded"
          >
            Cancel
          </button>

          <button
            onclick="updateComment()"
            class="px-4 py-2 bg-blue-600 text-white rounded"
          >
            Update
          </button>
        </div>
      </div>
    </div>

    <script>
      async function toggleLike(blogId) {
        const res = await fetch("/blog/like", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ blogId }),
        });

        const data = await res.json();
        location.reload();
      }

      async function addComment(blogId) {
        const text = document.getElementById("commentText").value;

        const res = await fetch("/blog/comment", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ blogId, comment: text }),
        });

        const data = await res.json();
        if (data.success) location.reload();
      }

      function deleteBlog(blogId) {
        Swal.fire({
          title: "Delete this blog?",
          text: "This action cannot be undone!",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#d33",
          confirmButtonText: "Yes, delete",
        }).then(async (result) => {
          if (result.isConfirmed) {
            const res = await fetch(`/blog/delete/${blogId}`, {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
            });

            if (!res.ok) {
              Swal.fire("Error", "Something went wrong", "error");
              return;
            }

            const data = await res.json();
            if (data.success) {
              Swal.fire("Deleted!", "Blog removed.", "success").then(() => {
                window.location.href = "/blog";
              });
            }
          }
        });
      }

      function deleteComment(commentId) {
        Swal.fire({
          title: "Delete comment?",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#d33",
          confirmButtonText: "Delete",
        }).then(async (result) => {
          if (result.isConfirmed) {
            const res = await fetch(`/blog/comment/${commentId}`, {
              method: "DELETE",
            });

            const data = await res.json();
            if (data.success) location.reload();
          }
        });
      }
      let editor;

      function openEditModal() {
        const modal = document.getElementById("editModal");
        modal.classList.remove("hidden");
        modal.classList.add("flex");

        if (!editor) {
          editor = CKEDITOR.replace("editContent", {
            height: 300,
            toolbar: [
              { name: "styles", items: ["Font", "FontSize"] },
              {
                name: "basicstyles",
                items: ["Bold", "Italic", "Underline", "Strike"],
              },
              { name: "colors", items: ["TextColor", "BGColor"] },
              { name: "paragraph", items: ["NumberedList", "BulletedList"] },
              { name: "links", items: ["Link", "Unlink"] },
              { name: "cleanup", items: ["RemoveFormat"] },
            ],
            removePlugins: "resize,elementspath",
          });
        }
      }

      function closeEditModal() {
        const modal = document.getElementById("editModal");
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }

      async function updateBlog(blogId) {
        const title = document.getElementById("editTitle").value;
        const content = editor.getData();

        if (!title.trim() || !content.trim()) {
          Swal.fire("Error", "Title and content required", "error");
          return;
        }

        const res = await fetch(`/blog/edit/${blogId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title, content }),
        });

        const data = await res.json();

        if (data.success) {
          Swal.fire("Updated!", "Blog updated successfully", "success").then(
            () => location.reload()
          );
        } else {
          Swal.fire("Error", data.message || "Update failed", "error");
        }
      }
      let currentCommentId = null;

      function openEditCommentModal(commentId, commentText) {
        currentCommentId = commentId;

        document.getElementById("editCommentText").value = commentText;

        const modal = document.getElementById("editCommentModal");
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }

      function closeEditCommentModal() {
        const modal = document.getElementById("editCommentModal");
        modal.classList.add("hidden");
        modal.classList.remove("flex");

        currentCommentId = null;
      }

      async function updateComment() {
        const text = document.getElementById("editCommentText").value.trim();

        if (!text) {
          Swal.fire("Error", "Comment cannot be empty", "error");
          return;
        }

        const res = await fetch(`/blog/comment/${currentCommentId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ comment: text }),
        });

        const data = await res.json();

        if (data.success) {
          Swal.fire("Updated!", "Comment updated", "success").then(() =>
            location.reload()
          );
        } else {
          Swal.fire("Error", data.message || "Update failed", "error");
        }
      }
    </script>
  </body>
</html>
