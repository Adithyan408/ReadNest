<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
   <link rel="stylesheet" href="/user/css/notFound.css">
</head>

<body class="bg-gray-100 min-h-screen overflow-x-hidden relative flex flex-col">
    <div class="particles" id="particles"></div>
    
    <main class="flex-grow flex items-center justify-center px-4 py-12 relative z-10">
        <div class="max-w-6xl w-full">
            <div class="flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-16">
                
                <div class="w-full lg:w-1/2 text-center">
                    <div class="mb-4 sm:mb-8">
                        <h1 class="text-7xl sm:text-8xl md:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-purple-600 glitch tracking-tighter">
                            404
                        </h1>
                    </div>
                    
                    <div class="relative h-64 sm:h-80 flex items-center justify-center">
                        <div class="absolute left-4 sm:left-10 book-stack">
                            <div class="w-16 h-24 sm:w-20 sm:h-28 bg-gradient-to-br from-orange-400 to-orange-600 rounded-lg shadow-xl transform -rotate-12"></div>
                        </div>
                        <div class="absolute right-4 sm:right-10 book-stack" style="animation-delay: 0.5s;">
                            <div class="w-16 h-24 sm:w-20 sm:h-28 bg-gradient-to-br from-purple-400 to-purple-600 rounded-lg shadow-xl transform rotate-12"></div>
                        </div>
                        
                        <div class="floating-book relative z-10">
                            <div class="w-40 h-56 sm:w-48 sm:h-64 bg-gray-800 rounded-2xl shadow-2xl flex items-center justify-center border-4 border-gray-700">
                                <div class="text-center px-2">
                                    <i class="fas fa-book-open text-4xl sm:text-5xl text-orange-500 mb-3"></i>
                                    <div class="text-white font-bold">
                                        <div class="text-xl sm:text-2xl">ReadNest</div>
                                        <div class="text-[10px] sm:text-xs text-gray-400 mt-1 uppercase tracking-widest">Missing Page</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <i class="hidden sm:block fas fa-bookmark absolute top-0 left-20 text-3xl text-orange-400 opacity-30 floating-book" style="animation-delay: 1s;"></i>
                        <i class="hidden sm:block fas fa-feather-alt absolute bottom-0 right-20 text-2xl text-purple-400 opacity-30 floating-book" style="animation-delay: 1.5s;"></i>
                    </div>
                </div>
                
                <div class="w-full lg:w-1/2 text-center lg:text-left space-y-6">
                    <div>
                        <div class="inline-flex items-center px-3 py-1 bg-red-100 rounded-full text-red-600 font-bold text-xs uppercase tracking-tighter mb-4">
                            <i class="fas fa-exclamation-triangle mr-2"></i>Lost in the Stacks
                        </div>
                        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-gray-900 leading-tight">
                            Oops! This page is out of print.
                        </h2>
                    </div>
                    
                    <p class="text-base sm:text-lg text-gray-600 leading-relaxed max-w-xl mx-auto lg:mx-0">
                        The chapter you're looking for doesn't exist or has been moved to another section of our library.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row gap-4 pt-4">
                        <button onclick="goHome()" class="w-full sm:w-auto px-10 py-4 bg-orange-600 text-white font-bold rounded-xl shadow-lg shadow-orange-100 hover:bg-orange-700 active:scale-95 transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-home text-sm"></i> Back to Home
                        </button>
                        <button onclick="goBack()" class="w-full sm:w-auto px-10 py-4 bg-white text-gray-700 font-bold rounded-xl shadow-md border-2 border-gray-100 hover:bg-gray-50 active:scale-95 transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-arrow-left text-sm"></i> Go Back
                        </button>
                    </div>
                    
                    <div class="mt-10">
                        <p class="text-[10px] text-gray-400 font-black uppercase tracking-[0.2em] mb-4">Popular Sections</p>
                        <div class="flex flex-wrap gap-2 justify-center lg:justify-start">
                            <a href="/books" class="px-4 py-2 bg-white rounded-lg text-xs font-bold text-gray-600 border border-gray-100 hover:text-orange-600 transition-colors">Bestsellers</a>
                            <a href="/categories" class="px-4 py-2 bg-white rounded-lg text-xs font-bold text-gray-600 border border-gray-100 hover:text-orange-600 transition-colors">Categories</a>
                            <a href="/blog" class="px-4 py-2 bg-white rounded-lg text-xs font-bold text-gray-600 border border-gray-100 hover:text-orange-600 transition-colors">Read Blog</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="p-6 text-center text-gray-400 text-xs mt-auto">
        <p>&copy; 2026 ReadNest. All rights reserved.</p>
    </footer>

    <script src="/user/js/notFound.js"></script>
</body>
</html>