<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Account | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
   <link rel="stylesheet" href="/user/css/verify-otp.css">
</head>

<body class="flex items-center justify-center min-h-screen p-4 sm:p-6">
    <div class="form-container bg-white rounded-[2.5rem] shadow-2xl max-w-lg w-full p-6 sm:p-10 lg:p-12 border border-white/20">
        
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-indigo-50 rounded-full mb-4">
                <i class="fas fa-envelope-open-text text-3xl text-indigo-600"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-gray-900 leading-tight">Verification Code</h1>
            <p class="text-gray-500 text-sm mt-3 px-2 leading-relaxed">
                We've sent a 6-digit secure code to <br/>
                <span class="font-bold text-gray-800"><%= email %></span>
            </p>
        </div>

        <div id="successMessage" class="hidden mb-6 p-4 bg-emerald-50 border-l-4 border-emerald-500 text-emerald-700 rounded-r-xl text-xs font-bold animate-pulse"></div>
        <div id="errorMessage" class="hidden mb-6 p-4 bg-rose-50 border-l-4 border-rose-500 text-rose-700 rounded-r-xl text-xs font-bold">
            <i class="fas fa-circle-exclamation mr-2"></i><span id="errorText"></span>
        </div>

        <div class="grid grid-cols-6 gap-2 sm:gap-3 mb-8" id="otpContainer">
            <% for(let i=1; i<=6; i++) { %>
                <input type="text" maxlength="1" class="otp-input outline-none" id="otp<%= i %>" autocomplete="one-time-code" inputmode="numeric" />
            <% } %>
        </div>

        <div class="text-center mb-8">
            <div class="flex items-center justify-center gap-2 mb-4">
                <i class="fa-regular fa-clock text-gray-400 text-sm"></i>
                <span class="timer font-black text-indigo-600 text-sm tracking-widest" id="timer">01:00</span>
            </div>
            <button id="resendLink" onclick="resendCode()" disabled
                class="text-xs font-black uppercase tracking-widest text-gray-400 disabled:opacity-50 transition-all hover:text-indigo-600">
                I didn’t receive a code — <span class="underline">Resend</span>
            </button>
        </div>

        <div class="space-y-4">
            <button id="confirmBtn" onclick="verifyCode()" 
                class="w-full bg-indigo-600 text-white font-black text-sm uppercase tracking-[0.2em] py-4 rounded-2xl shadow-xl shadow-indigo-100 hover:bg-indigo-700 active:scale-[0.98] transition-all">
                Confirm Code
            </button>
            
            <div class="text-center">
                <a href="/signup" class="inline-flex items-center gap-2 text-xs font-bold text-gray-400 hover:text-indigo-600 transition-colors">
                    <i class="fas fa-arrow-left text-[10px]"></i> Back to SignUp
                </a>
            </div>
        </div>
    </div>
    <script>
  window.APP_CONFIG = {
    forgotPass: <%- JSON.stringify(fromForgotPassword) %>,
    email: <%- JSON.stringify(email) %>
  };
</script>

   <script src="/user/js/verify-otp.js"></script>
</body>
</html>