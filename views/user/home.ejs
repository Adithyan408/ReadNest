<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReadNest - Online Book Store</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");
    * { font-family: "Poppins", sans-serif; }

    .rating-badge {
      background: #22c55e;
      color: white;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
    }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { scrollbar-width: none; }

    .filter-sidebar {
      position: sticky;
      top: 90px;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
    }
  </style>
</head>

<body class="bg-gray-100">

<%- include("../../views/partials/user/header") %>

<!-- ================= MOBILE UI (UNCHANGED) ================= -->

<!-- MOBILE CATEGORY BAR -->
<div class="lg:hidden bg-white border-b px-3 py-2 overflow-x-auto no-scrollbar">
  <div class="flex gap-2 whitespace-nowrap">
    <a href="/" class="px-4 py-2 rounded-full text-xs font-bold
      <%= !selectedCategory ? 'bg-indigo-600 text-white' : 'bg-gray-200' %>">
      All
    </a>
    <% categories.forEach(cat => { %>
      <a href="/?category=<%= cat.categoryName %>"
         class="px-4 py-2 rounded-full text-xs font-bold
         <%= selectedCategory === cat.categoryName ? 'bg-indigo-600 text-white' : 'bg-gray-200' %>">
        <%= cat.categoryName %>
      </a>
    <% }) %>
  </div>
</div>

<!-- MOBILE SORT + LANGUAGE -->
<div class="lg:hidden bg-white px-3 py-3 border-b flex gap-3">
  <select id="mobileSort" class="w-1/2 border rounded-lg px-3 py-2 text-sm">
    <option value="">Sort By</option>
    <option value="priceAsc">Price: Low → High</option>
    <option value="priceDesc">Price: High → Low</option>
    <option value="newest">Newest</option>
    <option value="oldest">Oldest</option>
  </select>

  <select id="mobileLanguage" class="w-1/2 border rounded-lg px-3 py-2 text-sm">
    <option value="">Language</option>
    <% languages.forEach(lang => { %>
      <option value="<%= lang %>" <%= selectedLanguages.includes(lang) ? 'selected' : '' %>>
        <%= lang %>
      </option>
    <% }) %>
  </select>
</div>

<!-- ================= DESKTOP SORT BAR ================= -->

<div class="hidden lg:block bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 py-3">
    <form id="desktopSortForm" method="GET"
          class="flex items-center gap-6 text-sm overflow-x-auto no-scrollbar">

      <% if (selectedCategory) { %>
        <input type="hidden" name="category" value="<%= selectedCategory %>">
      <% } %>

      <% selectedLanguages.forEach(lang => { %>
        <input type="hidden" name="languages" value="<%= lang %>">
      <% }) %>

      <% if (min) { %><input type="hidden" name="min" value="<%= min %>"><% } %>
      <% if (max) { %><input type="hidden" name="max" value="<%= max %>"><% } %>

      <span class="font-semibold text-gray-700">Sort By:</span>

      <% const sorts = [
        {v:'priceAsc',l:'Price Low-High'},
        {v:'priceDesc',l:'Price High-Low'},
        {v:'nameAsc',l:'Name A-Z'},
        {v:'nameDesc',l:'Name Z-A'},
        {v:'newest',l:'Newest'},
        {v:'oldest',l:'Oldest'}
      ]; %>

      <% sorts.forEach(s => { %>
        <label class="flex items-center gap-2 cursor-pointer whitespace-nowrap">
          <input type="radio" name="sort" value="<%= s.v %>" <%= sort === s.v ? 'checked' : '' %>>
          <span><%= s.l %></span>
        </label>
      <% }) %>
    </form>
  </div>
</div>

<!-- ================= MAIN LAYOUT ================= -->

<div class="max-w-7xl mx-auto px-4 py-6">
  <div class="flex flex-col lg:flex-row gap-6">

    <!-- ================= DESKTOP SIDEBAR ================= -->
    <aside class="hidden lg:block w-64">
      <div class="bg-white p-6 rounded-lg shadow-sm filter-sidebar space-y-8">

        <!-- CATEGORIES -->
        <div>
          <h3 class="font-semibold mb-3">Categories</h3>
          <ul class="space-y-2 text-sm">
            <li>
              <a href="/" class="<%= !selectedCategory ? 'text-indigo-600 font-bold' : '' %>">
                All Books
              </a>
            </li>
            <% categories.forEach(cat => { %>
              <li>
                <a href="/?category=<%= cat.categoryName %>"
                   class="<%= selectedCategory === cat.categoryName ? 'text-indigo-600 font-bold' : '' %>">
                  <%= cat.categoryName %>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>

        <!-- LANGUAGE (AUTO APPLY) -->
        <div>
          <h3 class="font-semibold mb-3">Language</h3>
          <form id="desktopLanguageForm" method="GET" action="/" class="space-y-2">

            <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>"><% } %>
            <% if (sort) { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
            <% if (min) { %><input type="hidden" name="min" value="<%= min %>"><% } %>
            <% if (max) { %><input type="hidden" name="max" value="<%= max %>"><% } %>

            <% languages.forEach(lang => { %>
              <label class="flex items-center gap-2 text-sm cursor-pointer">
                <input type="checkbox"
                       name="languages"
                       value="<%= lang %>"
                       class="desktop-lang"
                       <%= selectedLanguages.includes(lang) ? 'checked' : '' %>>
                <span><%= lang %></span>
              </label>
            <% }) %>
          </form>
        </div>

        <!-- PRICE -->
        <div>
          <h3 class="font-semibold mb-3">Price</h3>
          <form id="priceFilterForm" method="GET" action="/" class="space-y-3">

  <% if (selectedCategory) { %>
    <input type="hidden" name="category" value="<%= selectedCategory %>">
  <% } %>

  <% selectedLanguages.forEach(lang => { %>
    <input type="hidden" name="languages" value="<%= lang %>">
  <% }) %>

  <% if (sort) { %>
    <input type="hidden" name="sort" value="<%= sort %>">
  <% } %>

  <!-- Price Inputs -->
  <div class="flex gap-2">
    <input
      type="number"
      name="min"
      id="minPrice"
      placeholder="Min"
      value="<%= min || '' %>"
      class="w-full border rounded px-3 py-2"
    />

    <input
      type="number"
      name="max"
      id="maxPrice"
      placeholder="Max"
      value="<%= max || '' %>"
      class="w-full border rounded px-3 py-2"
    />
  </div>

  <!-- ERROR MESSAGE -->
  <p id="priceError" class="text-sm text-red-600 hidden"></p>

  <button
    type="submit"
    class="w-full py-2 bg-indigo-600 text-white rounded-lg"
  >
    Apply
  </button>
</form>

        </div>

      </div>
    </aside>

    <!-- ================= PRODUCTS ================= -->
    <main class="flex-1">

  <!-- NO PRODUCTS -->
  <% if (!products.length) { %>
    <div class="bg-white p-10 rounded-xl shadow-sm text-center">
      <i class="fas fa-box-open text-5xl text-gray-400 mb-4"></i>
      <h2 class="text-xl font-semibold text-gray-700">No books found</h2>
      <p class="text-gray-500 mt-2">Try adjusting filters or check back later.</p>
    </div>
  <% } else { %>

  <!-- PRODUCT GRID -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">

    <% products.forEach((product, index) => { %>

      <!-- INSERT BANNER AFTER 8 ITEMS -->
      <% if (isHome && index === 8) { %>
        </div>

        <!-- BANNER -->
        <div class="my-6 sm:my-10 rounded-2xl overflow-hidden shadow-md">
          <img
            src="<%= homeBanner %>"
            alt="Promotional Banner"
            class="w-full h-40 sm:h-64 lg:h-80 object-cover"
          />
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      <% } %>

      <!-- PRODUCT CARD -->
      <a
        href="/product?id=<%= product._id %><%= baseQuery ? '&' + baseQuery : '' %>"
        class="bg-white rounded-xl shadow-sm hover:shadow-lg transition overflow-hidden group"
      >

        <!-- IMAGE -->
        <div class="relative aspect-[2/3] bg-gray-100 overflow-hidden">
          <% if (product.productImage && product.productImage.length > 0) { %>
            <img
              src="<%= product.productImage[0] %>"
              alt="<%= product.productName %>"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
          <% } else { %>
            <div class="w-full h-full bg-gray-200 flex items-center justify-center">
              <i class="fas fa-book text-3xl text-gray-400"></i>
            </div>
          <% } %>

          <!-- WISHLIST -->
          <button
            class="wishlist-btn absolute top-2 right-2 bg-white/90 backdrop-blur p-2 rounded-full shadow hover:scale-105 transition"
            data-product-id="<%= product._id %>"
            onclick="event.preventDefault();"
          >
            <% if (wishlistProducts?.includes(product._id.toString())) { %>
              <i class="fa-solid fa-heart text-red-500"></i>
            <% } else { %>
              <i class="fa-regular fa-heart text-gray-600"></i>
            <% } %>
          </button>
        </div>

        <!-- CONTENT -->
        <div class="p-3 flex flex-col">

          <!-- RATING -->
          <span class="rating-badge w-fit mb-1">
            <%= product.rating || "4.5" %> ★
          </span>

          <!-- TITLE -->
          <h3 class="text-sm font-semibold text-gray-800 line-clamp-2 mb-1">
            <%= product.productName %>
          </h3>

          <!-- PRICE (UNCHANGED LOGIC) -->
          <div class="mt-auto">
            <% if (product.offerPrice && product.offerPrice < product.regularPrice) { %>
              <span class="text-xs text-gray-400 line-through">
                ₹<%= product.regularPrice %>
              </span>
              <span class="ml-2 text-lg font-bold text-red-600">
                ₹<%= product.offerPrice %>
              </span>
            <% } else { %>
              <span class="text-lg font-bold text-gray-900">
                ₹<%= product.regularPrice %>
              </span>
            <% } %>
          </div>

        </div>
      </a>

    <% }) %>
  </div>
  <div class="flex justify-center lg:justify-end items-center p-4 sm:p-6 border-t border-gray-200">

  <nav aria-label="Page navigation">
    <ul class="flex items-center gap-2 text-sm">

      <!-- PREVIOUS -->
      <% if (currentPage > 1) { %>
        <li>
          <a
            href="?page=<%= currentPage - 1 %><%= baseQuery ? '&' + baseQuery : '' %>"
            class="px-3 py-2 rounded-lg border bg-white hover:bg-gray-100"
          >
            Prev
          </a>
        </li>
      <% } %>

      <!-- MOBILE: CURRENT PAGE ONLY -->
      <li class="block sm:hidden">
        <span
          class="px-4 py-2 rounded-lg bg-indigo-600 text-white font-semibold"
        >
          <%= currentPage %> / <%= totalPages %>
        </span>
      </li>

      <!-- DESKTOP: ALL PAGE NUMBERS -->
      <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="hidden sm:block">
          <a
            href="?page=<%= i %><%= baseQuery ? '&' + baseQuery : '' %>"
            class="px-4 py-2 rounded-lg border font-medium transition
              <%= i === currentPage
                ? 'bg-indigo-600 text-white border-indigo-600'
                : 'bg-white text-gray-700 hover:bg-gray-100' %>"
          >
            <%= i %>
          </a>
        </li>
      <% } %>

      <!-- NEXT -->
      <% if (currentPage < totalPages) { %>
        <li>
          <a
            href="?page=<%= currentPage + 1 %><%= baseQuery ? '&' + baseQuery : '' %>"
            class="px-3 py-2 rounded-lg border bg-white hover:bg-gray-100"
          >
            Next
          </a>
        </li>
      <% } %>

    </ul>
  </nav>
</div>


  <% } %>
</main>

  </div>
</div>

<%- include("../../views/partials/user/footer") %>

<!-- ================= JS ================= -->
<script>
  /* MOBILE SORT */
  document.getElementById("mobileSort")?.addEventListener("change", e => {
    const params = new URLSearchParams(window.location.search);
    if (e.target.value) params.set("sort", e.target.value);
    else params.delete("sort");
    window.location.search = params.toString();
  });

  /* MOBILE LANGUAGE AUTO APPLY */
  document.getElementById("mobileLanguage")?.addEventListener("change", e => {
    const params = new URLSearchParams(window.location.search);
    params.delete("languages");
    if (e.target.value) params.append("languages", e.target.value);
    window.location.search = params.toString();
  });

  /* DESKTOP LANGUAGE AUTO APPLY */
  document.querySelectorAll(".desktop-lang").forEach(cb => {
    cb.addEventListener("change", () => {
      document.getElementById("desktopLanguageForm").submit();
    });
  });

  /* DESKTOP SORT AUTO APPLY */
  document.querySelectorAll('#desktopSortForm input[name="sort"]').forEach(r => {
    r.addEventListener("change", () => {
      document.getElementById("desktopSortForm").submit();
    });
  });
   document.getElementById("priceFilterForm")?.addEventListener("submit", (e) => {
    const minInput = document.getElementById("minPrice");
    const maxInput = document.getElementById("maxPrice");
    const errorEl = document.getElementById("priceError");

    const min = minInput.value.trim();
    const max = maxInput.value.trim();

    errorEl.classList.add("hidden");
    errorEl.textContent = "";

    // Convert to numbers if present
    const minVal = min !== "" ? Number(min) : null;
    const maxVal = max !== "" ? Number(max) : null;

    // ❌ Negative values
    if ((minVal !== null && minVal < 0) || (maxVal !== null && maxVal < 0)) {
      e.preventDefault();
      errorEl.textContent = "Price cannot be a negative value.";
      errorEl.classList.remove("hidden");
      return;
    }

    // ❌ Min greater than Max
    if (minVal !== null && maxVal !== null && minVal > maxVal) {
      e.preventDefault();
      errorEl.textContent = "Minimum price cannot be greater than maximum price.";
      errorEl.classList.remove("hidden");
      return;
    }

    // ✅ Valid → allow submit
  });
</script>

</body>
</html>
