<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReadNest - Online Book Store</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");
    * { font-family: "Poppins", sans-serif; }

    /* Hide scrollbars but keep functionality */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Custom Rating Badge */
    .rating-badge {
      background: #22c55e;
      color: white;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 700;
    }

    /* Fixed Category bar on mobile */
    @media (max-width: 1023px) {
      .mobile-category-bar {
        position: sticky;
        top: 60px; /* Adjust based on your header height */
        z-index: 40;
        background: white;
      }
    }
  </style>
</head>

<body class="bg-gray-100">
  <%- include("../../views/partials/user/header") %>

  <div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 md:py-6">
    <%- include('../../views/partials/breadCrumb') %>

    <div class="bg-white rounded-lg shadow-sm px-4 py-3 mb-4 flex items-center gap-4 border border-gray-200 overflow-hidden">
      <span class="hidden md:inline font-bold text-gray-700 whitespace-nowrap">Sort By:</span>
      <form id="sortForm" method="GET" class="flex items-center gap-4 overflow-x-auto no-scrollbar whitespace-nowrap">
        <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>" /><% } %>
        <% selectedLanguages.forEach(lang => { %><input type="hidden" name="languages" value="<%= lang %>" /><% }) %>
        <% if (min) { %><input type="hidden" name="min" value="<%= min %>" /><% } %>
        <% if (max) { %><input type="hidden" name="max" value="<%= max %>" /><% } %>

        <% const sorts = [
            {v: 'priceAsc', l: 'Price: Low-High'}, {v: 'priceDesc', l: 'Price: High-Low'},
            {v: 'nameAsc', l: 'A - Z'}, {v: 'nameDesc', l: 'Z - A'},
            {v: 'newest', l: 'Newest'}, {v: 'oldest', l: 'Oldest'}
        ] %>
        <% sorts.forEach(s => { %>
          <label class="flex items-center gap-1.5 cursor-pointer text-xs md:text-sm group transition">
            <input type="radio" name="sort" value="<%= s.v %>" <%= sort === s.v ? "checked" : "" %> 
                   class="w-3 h-3 text-indigo-600 focus:ring-0 border-gray-300">
            <span class="<%= sort === s.v ? 'text-indigo-600 font-bold' : 'text-gray-500' %> group-hover:text-indigo-600"><%= s.l %></span>
          </label>
        <% }) %>
      </form>
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
      
      <aside class="w-full lg:w-64 flex-shrink-0">
        <div class="mobile-category-bar lg:hidden mb-4 border-b pb-2 no-scrollbar overflow-x-auto flex gap-2">
            <a href="/" class="px-4 py-2 rounded-full text-xs whitespace-nowrap font-bold transition <%= !selectedCategory ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700' %>">
                All Books
            </a>
            <% categories.forEach(category => { %>
                <a href="/?category=<%= category.categoryName %><%= sort ? '&sort=' + sort : '' %>" 
                   class="px-4 py-2 rounded-full text-xs whitespace-nowrap font-bold transition <%= selectedCategory == category.categoryName ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700' %>">
                    <%= category.categoryName %>
                </a>
            <% }) %>
        </div>

        <div class="hidden lg:block bg-white rounded-xl shadow-sm p-6 sticky top-24">
          <h2 class="text-lg font-bold mb-6 flex items-center gap-2"><i class="fas fa-filter text-indigo-600"></i> Filters</h2>
          
          <div class="mb-8">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Categories</h3>
            <ul class="space-y-3">
              <li><a href="/" class="text-sm <%= !selectedCategory ? 'text-indigo-600 font-bold' : 'text-gray-600' %> hover:text-indigo-600">All Books</a></li>
              <% categories.forEach(category => { %>
                <li>
                  <a href="/?category=<%= category.categoryName %><%= sort ? '&sort=' + sort : '' %>" 
                     class="text-sm flex justify-between items-center group <%= selectedCategory == category.categoryName ? 'text-indigo-600 font-bold' : 'text-gray-600 hover:text-indigo-600' %>">
                    <%= category.categoryName %>
                    <i class="fas fa-chevron-right text-[10px] opacity-0 group-hover:opacity-100 transition"></i>
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>

          <div class="mb-8">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Price Range</h3>
            <form action="/" method="GET" class="space-y-4">
              <div class="flex items-center gap-2">
                <input type="number" name="min" placeholder="Min" value="<%= min || '' %>" class="w-full px-3 py-2 border rounded-lg text-xs outline-none focus:border-indigo-500" />
                <span class="text-gray-400">-</span>
                <input type="number" name="max" placeholder="Max" value="<%= max || '' %>" class="w-full px-3 py-2 border rounded-lg text-xs outline-none focus:border-indigo-500" />
              </div>
              <button type="submit" class="w-full py-2.5 bg-indigo-600 text-white rounded-lg text-xs font-bold hover:bg-indigo-700 transition shadow-md shadow-indigo-100 uppercase tracking-wider">Apply</button>
            </form>
          </div>
        </div>
      </aside>

      <main class="flex-1">
        <% if (products.length === 0) { %>
          <div class="bg-white rounded-2xl shadow-sm p-12 text-center border-2 border-dashed border-gray-200">
            <i class="fas fa-search text-5xl text-gray-300 mb-4"></i>
            <h2 class="text-xl font-bold text-gray-700">No books found</h2>
            <p class="text-gray-500 mt-2">Try adjusting your filters or search query.</p>
          </div>
        <% } else { %>

          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-4 md:gap-6">
            <% products.forEach((product, index) => { %>

              <% if (isHome && index === 8) { %>
                </div><div class="w-full h-32 sm:h-64 md:h-80 bg-gray-200 rounded-xl overflow-hidden my-6 shadow-sm">
                  <img src="<%= homeBanner %>" class="w-full h-full object-cover" />
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-4 md:gap-6">
              <% } %>

              <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-all flex flex-col group relative">
                <button class="wishlist-btn absolute top-2 right-2 z-10 bg-white/90 backdrop-blur-sm w-8 h-8 rounded-full shadow-sm flex items-center justify-center transition active:scale-90" data-product-id="<%= product._id %>">
                  <i class="<%= wishlistProducts?.includes(product._id.toString()) ? 'fa-solid fa-heart text-red-500' : 'fa-regular fa-heart text-gray-400' %> text-sm"></i>
                </button>

                <a href="/product?id=<%= product._id %><%= baseQuery ? '&' + baseQuery : '' %>" class="flex flex-col h-full">
                  <div class="aspect-[2/3] w-full bg-gray-50 overflow-hidden">
                    <% if (product.productImage?.length > 0) { %>
                      <img src="<%= product.productImage[0] %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="<%= product.productName %>" />
                    <% } else { %>
                      <div class="w-full h-full bg-gray-200 flex items-center justify-center"><i class="fas fa-book text-gray-400 text-3xl"></i></div>
                    <% } %>
                  </div>

                  <div class="p-2 sm:p-4 flex flex-col flex-1">
                    <span class="rating-badge w-fit mb-1"><%= product.rating || "4.5" %> ★</span>
                    <h3 class="font-bold text-gray-800 text-[11px] sm:text-sm line-clamp-2 mb-1 group-hover:text-indigo-600 transition tracking-tight leading-tight">
                      <%= product.productName %>
                    </h3>
                    
                    <div class="mt-auto pt-1">
                      <% if (product.offerPrice < product.regularPrice) { %>
                        <div class="flex flex-col">
                            <span class="text-red-600 font-black text-sm sm:text-lg">₹<%= product.offerPrice %></span>
                            <span class="text-gray-400 line-through text-[10px] sm:text-xs italic">₹<%= product.regularPrice %></span>
                        </div>
                      <% } else { %>
                        <span class="text-gray-900 font-black text-sm sm:text-lg">₹<%= product.regularPrice %></span>
                      <% } %>
                    </div>
                  </div>
                </a>
              </div>

            <% }) %>
          </div>

          <div class="mt-12 flex justify-center pb-10 overflow-x-auto no-scrollbar">
            <nav class="flex items-center gap-1.5 sm:gap-2 px-4">
              <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %><%= baseQuery ? '&' + baseQuery : '' %>" 
                   class="w-9 h-9 sm:w-11 sm:h-11 flex items-center justify-center rounded-xl border-2 font-bold text-xs sm:text-sm transition-all
                   <%= (i === currentPage) ? 'bg-indigo-600 text-white border-indigo-600 shadow-lg shadow-indigo-100' : 'bg-white text-gray-500 border-transparent hover:border-gray-200' %>">
                  <%= i %>
                </a>
              <% } %>
            </nav>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <%- include("../../views/partials/user/footer") %>

  <script>
    document.querySelectorAll("input[name='sort']").forEach(r => r.addEventListener("change", () => document.getElementById("sortForm").submit()));

    document.addEventListener("click", async (e) => {
      const btn = e.target.closest(".wishlist-btn");
      if (!btn) return;
      e.preventDefault(); e.stopPropagation();
      const icon = btn.querySelector("i");
      
      const res = await fetch("/wishlist/toggle", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ productId: btn.dataset.productId }),
      });

      if (res.status === 401) return window.location.href = "/login";
      const data = await res.json();
      icon.className = data.inWishlist ? "fa-solid fa-heart text-red-500 text-sm" : "fa-regular fa-heart text-gray-400 text-sm";
    });
  </script>
</body>
</html>