<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout - ReadNest</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");

      * {
        font-family: "Poppins", sans-serif;
      }
    </style>
  </head>

  <body class="bg-gray-100">
    <!-- Header -->
    <%- include("../../views/partials/user/header") %>

    <main class="max-w-4xl mx-auto px-6 py-16">
      <!-- Failed Card -->
      <div class="bg-white shadow-xl rounded-2xl p-10 text-center space-y-6">
        <!-- Failed Icon -->
        <div class="flex justify-center">
          <div class="bg-red-100 p-5 rounded-full">
            <i class="fa-solid fa-circle-xmark text-red-600 text-5xl"></i>
          </div>
        </div>

        <!-- Heading -->
        <h1 class="text-3xl font-bold text-gray-800">Payment Failed</h1>

        <!-- Message -->
        <p class="text-gray-600 text-lg leading-relaxed">
          Unfortunately, your payment could not be completed.
          <br />
          <span class="font-semibold text-red-600">
            <%= reason || "Please try again." %>
          </span>
        </p>

        <!-- Info Box -->
        <div
          class="bg-gray-50 border border-red-200 rounded-xl p-6 text-left space-y-3"
        >
          <h2 class="text-xl font-bold text-gray-800 mb-3">What You Can Do</h2>

          <ul class="list-disc list-inside text-gray-700 space-y-2">
            <li>Retry the payment using the same or a different method</li>
            <li>Check your internet connection or bank balance</li>
            <li>Contact your bank if the issue persists</li>
          </ul>
        </div>

        <!-- Buttons -->
        <div class="flex justify-center gap-4 mt-8">
          <a
            href="/checkout/payment"
            class="bg-blue-600 text-white px-6 py-3 rounded-lg text-lg font-semibold hover:bg-blue-700 transition"
          >
            Retry Payment
          </a>

          <a
            href="/cart"
            class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg text-lg font-semibold hover:bg-gray-300 transition"
          >
            Back to Cart
          </a>
        </div>
      </div>
    </main>
    <%- include("../../views/partials/user/footer") %>
    <script>
      window.history.pushState(null, "", window.location.href);
      window.onpopstate = function () {
        window.location.href = "/cart";
      };
    </script>
  </body>
</html>
