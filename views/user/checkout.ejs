<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/user/css/checkout.css">
 
  </head>

  <body class="bg-gray-50">
    <%- include("../../views/partials/user/header") %>

    <main class="max-w-7xl mx-auto px-4 py-6 lg:py-12">
      <%- include('../../views/partials/breadCrumb') %>

      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1 space-y-6">
          <div
            class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100"
          >
            <div class="flex justify-between items-center mb-4">
              <h2
                class="text-lg font-bold text-gray-800 flex items-center gap-2"
              >
                <i class="fas fa-location-dot text-blue-600"></i> Delivery
                Address
              </h2>
              <button
                onclick="toggleModal('addressModal')"
                class="text-blue-600 font-bold text-xs hover:bg-blue-50 px-3 py-1.5 rounded-lg transition"
              >
                CHANGE
              </button>
            </div>

            <% if (addresses.length === 0) { %>
            <div
              class="p-8 text-center border-2 border-dashed rounded-2xl bg-gray-50/50"
            >
              <button
                onclick="toggleModal('addAddressModal')"
                class="bg-blue-600 text-white px-6 py-2.5 rounded-xl text-sm font-bold shadow-lg"
              >
                Add Address
              </button>
            </div>
            <% } else { %>
            <div
              class="border border-blue-100 p-5 rounded-2xl bg-blue-50/30 relative"
            >
              <button
                onclick="openEditAddressModal('<%= selectedAddress._id %>')"
                class="absolute right-4 top-4 text-blue-600 font-bold text-xs hover:underline"
              >
                Edit
              </button>
              <p class="font-bold text-gray-900 mb-1">
                <%= selectedAddress.addressLabel %> Address
              </p>
              <p class="text-gray-700 text-sm leading-relaxed">
                <%= selectedAddress.houseName %>, <%=
                selectedAddress.houseNumber %>, <%= selectedAddress.street %><br />
                <%= selectedAddress.district %> - <%= selectedAddress.pincode
                %><br />
                <span class="font-medium">Phone:</span> <%=
                selectedAddress.phone %><br />
                <span class="font-medium">Alt Phone:</span> <%=
                selectedAddress.altPhone %>
              </p>
            </div>
            <% } %>
          </div>

          <div
            class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden"
          >
            <div class="p-6 border-b border-gray-50 bg-gray-50/30">
              <h2 class="text-lg font-bold text-gray-800">Review Items</h2>
            </div>
            <div class="divide-y divide-gray-100 px-6">
              <% cart.forEach(item => { %>
              <div class="py-6 flex gap-6">
                <img
                  src="<%= item.image %>"
                  class="w-20 h-28 object-contain bg-gray-50 rounded-xl"
                />
                <div class="flex-1 min-w-0">
                  <h3
                    class="font-bold text-gray-900 text-sm sm:text-base line-clamp-1 sm:line-clamp-2 break-words"
                  >
                    <%= item.name %>
                  </h3>
                  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                    <div
                      class="flex items-center border rounded-xl bg-white p-1"
                    >
                      <button
                        class="w-8 h-8 text-blue-600"
                        onclick="updateCheckoutQty('<%= item._id %>', -1)"
                      >
                        -
                      </button>
                      <input
                        type="text"
                        id="qty-<%= item._id %>"
                        value="<%= item.quantity %>"
                        readonly
                        class="w-8 text-center text-xs font-black"
                      />
                      <button
                        class="w-8 h-8 text-blue-600"
                        onclick="updateCheckoutQty('<%= item._id %>', 1)"
                      >
                        +
                      </button>
                    </div>
                    <p
                      class="font-black text-gray-900"
                      id="price-<%= item._id %>"
                    >
                      ₹<%= item.price * item.quantity %>
                    </p>
                  </div>
                  <input
                    type="hidden"
                    id="stock-<%= item._id %>"
                    value="<%= item.stock %>"
                  />
                  <input
                    type="hidden"
                    id="unitPrice-<%= item._id %>"
                    value="<%= item.price %>"
                  />
                </div>
              </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="w-full lg:w-96">
          <div
            class="bg-white p-8 rounded-[2.5rem] shadow-xl border border-white sticky lg:top-24"
          >
            <h2 class="text-xl font-black text-gray-900 uppercase mb-6">
              Order Summary
            </h2>
            <div class="space-y-4">
              <div class="flex justify-between text-sm">
                <span class="text-gray-400 font-bold uppercase"
                  >Total Items</span
                >
                <span class="font-bold" id="rs-item-count"
                  ><%= cart.length %></span
                >
              </div>
              <div class="pt-6 mt-6 border-t flex justify-between items-center">
                <span class="font-black text-gray-800">Total Amount</span>
                <span class="text-3xl font-black text-blue-600" id="rs-total"
                  >₹0</span
                >
              </div>
            </div>
            <input type="hidden" />
            <button
              onclick="proceedToPayment()"
              class="w-full mt-8 bg-blue-600 text-white py-5 rounded-2xl font-black text-lg shadow-xl hover:bg-blue-700 transition-all active:scale-95"
            >
              Secure Payment
            </button>
          </div>
        </div>
      </div>
    </main>
    <%- include("../../views/partials/user/footer") %>

    <div
      id="addressModal"
      class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center z-[200] p-4"
    >
      <div
        class="bg-white w-full max-w-lg rounded-[2.5rem] p-8 max-h-[85vh] overflow-hidden flex flex-col modal-animate"
      >
        <h3 class="font-black text-2xl mb-6 uppercase">Select Address</h3>
        <div class="flex-1 overflow-y-auto space-y-4 mb-6 no-scrollbar">
          <% addresses.forEach(a => { %>
          <label
            class="flex items-start gap-4 p-4 border-2 rounded-2xl cursor-pointer hover:border-blue-600 transition-all"
          >
            <input
              type="radio"
              name="chooseAddress"
              value="<%= a._id %>"
              class="mt-1 w-5 h-5"
            />
            <div>
              <p
                class="font-black text-gray-900 text-xs uppercase tracking-widest"
              >
                <%= a.addressLabel %> Address
              </p>
              <p class="text-xs text-gray-500 font-medium">
                <%= a.houseName %>, <%= a.street %>, <%= a.district %> - <%=
                a.pincode %>
              </p>
            </div>
          </label>
          <% }) %>
        </div>
        <div class="space-y-4">
          <button
            onclick="setSelectedAddress()"
            class="w-full bg-blue-600 text-white py-4 rounded-2xl font-black uppercase"
          >
            Confirm
          </button>
          <button
            onclick="toggleModals('addressModal', 'addAddressModal')"
            class="w-full text-blue-600 font-black text-xs uppercase"
          >
            + New Address
          </button>
          <button
            onclick="toggleModal('addressModal')"
            class="w-full text-gray-400 font-bold text-xs uppercase"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>

    <div
      id="addAddressModal"
      class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center z-[210] p-4"
    >
      <div
        class="bg-white w-full max-w-2xl rounded-[2.5rem] p-8 lg:p-12 max-h-[90vh] overflow-y-auto no-scrollbar modal-animate"
      >
        <h2 class="text-2xl font-black mb-8 text-center uppercase">
          New Address
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="md:col-span-2">
            <label
              class="text-[10px] font-black text-gray-400 uppercase mb-1 block"
              >Type</label
            >
            <select
              id="add_addrLabel"
              class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            >
              <option value="Home">Home</option>
              <option value="Office">Office</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <input
            id="add_addrHouseName"
            type="text"
            placeholder="House Name"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
          />
          <input
            id="add_addrHouseNumber"
            type="text"
            placeholder="House No"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
          />
          <input
            id="add_addrStreet"
            type="text"
            placeholder="Street"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
          />
          <input
            id="add_addrPost"
            type="text"
            placeholder="Post Office"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
          />
          <input
            id="add_addrDistrict"
            type="text"
            placeholder="District"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
          />
          <input
            id="add_addrState"
            type="text"
            placeholder="State"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
          />
          <input
            id="add_addrPincode"
            type="number"
            placeholder="Pincode"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
          />
          <input
            id="add_addrPhone"
            type="number"
            placeholder="Phone"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
          />
          <div class="md:col-span-2">
            <input
              id="add_addrAltPhone"
              type="number"
              placeholder="Alternate Phone *"
              class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            />
          </div>
        </div>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <button
            onclick="saveNewAddress()"
            class="flex-1 bg-blue-600 text-white py-4 rounded-2xl font-black uppercase shadow-xl"
          >
            Save
          </button>
          <button
            onclick="toggleModal('addAddressModal')"
            class="flex-1 bg-gray-100 text-gray-600 py-4 rounded-2xl font-black uppercase"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>

    <div
      id="editAddressModal"
      class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center z-[210] p-4"
    >
      <div
        class="bg-white w-full max-w-2xl rounded-[2.5rem] p-8 lg:p-12 max-h-[90vh] overflow-y-auto no-scrollbar modal-animate"
      >
        <h2 class="text-2xl font-black mb-8 text-center uppercase">
          Update Address
        </h2>
        <input type="hidden" id="edit_addressId" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="md:col-span-2">
            <label
              class="text-[10px] font-black text-gray-400 uppercase mb-1 block"
              >Type</label
            >
            <select
              id="edit_addrLabel"
              class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            >
              <option value="Home">Home</option>
              <option value="Office">Office</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <input
            id="edit_addrHouseName"
            type="text"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            placeholder="Building Name"
          />
          <input
            id="edit_addrHouseNumber"
            type="text"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            placeholder="House No"
          />
          <input
            id="edit_addrStreet"
            type="text"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            placeholder="Street"
          />
          <input
            id="edit_addrPost"
            type="text"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            placeholder="Post Office"
          />
          <input
            id="edit_addrDistrict"
            type="text"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            placeholder="District"
          />
          <input
            id="edit_addrState"
            type="text"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            placeholder="State"
          />
          <input
            id="edit_addrPincode"
            type="number"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            placeholder="Pincode"
          />
          <input
            id="edit_addrPhone"
            type="number"
            class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
            placeholder="Phone"
          />
          <div class="md:col-span-2">
            <input
              id="edit_addrAltPhone"
              type="number"
              class="w-full bg-gray-50 border-2 border-transparent focus:border-blue-500 p-4 rounded-2xl font-bold outline-none"
              placeholder="Alternate Phone *"
            />
          </div>
        </div>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <button
            onclick="saveEditedAddress()"
            class="flex-1 bg-blue-600 text-white py-4 rounded-2xl font-black uppercase shadow-xl"
          >
            Update
          </button>
          <button
            onclick="toggleModal('editAddressModal')"
            class="flex-1 bg-gray-100 text-gray-500 py-4 rounded-2xl font-black uppercase"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>

    <script id="checkout-cart" type="application/json">
      <%- JSON.stringify(cart) %>
    </script>
    <script id="addresses-data" type="application/json">
      <%- JSON.stringify(addresses) %>
    </script>
    <script src="/user/js/checkout.js"></script>
    
  </body>
</html>
