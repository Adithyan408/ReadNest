
   <!DOCTYPE html>
   <html lang="en">
   <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
   </head>
   <body>
    
        <body>
            <%- include("../../views/partials/user/account") %>
      <!-- Right Content Area -->
      <main class="main-scroll-area flex-1 bg-gray-100 p-10">

  <!-- PERSONAL INFO CARD -->
  <div class="bg-white rounded-xl shadow p-6 mb-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Personal Information</h2>
      <button class="text-blue-600 font-semibold hover:text-blue-700">Edit</button>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <!-- Full Name -->
      <div class="bg-gray-100 rounded-lg p-4 h-14 flex items-center text-gray-700 font-medium">
        Adithyan K S
      </div>

      <!-- Username -->
      <div class="bg-gray-100 rounded-lg p-4 h-14 flex items-center text-gray-700 font-medium">
        adithyan_ks
      </div>
    </div>
  </div>

  <!-- GENDER SECTION -->
  <div class="bg-white rounded-xl shadow p-6 mb-8">
    <h3 class="text-xl font-bold text-gray-900 mb-4">Gender</h3>
    <div class="flex items-center space-x-8">
      <label class="flex items-center space-x-2 cursor-pointer">
        <input type="radio" name="gender" value="male" checked class="w-5 h-5 text-blue-600" />
        <span class="text-base font-medium text-gray-900">Male</span>
      </label>

      <label class="flex items-center space-x-2 cursor-pointer">
        <input type="radio" name="gender" value="female" class="w-5 h-5 text-blue-600" />
        <span class="text-base font-medium text-gray-900">Female</span>
      </label>
    </div>
  </div>

  <!-- EMAIL SECTION -->
  <div class="bg-white rounded-xl shadow p-6 mb-8">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-xl font-bold text-gray-900">E-mail Address</h3>
      <button class="text-blue-600 font-semibold hover:text-blue-700">Edit</button>
    </div>
    <div class="bg-gray-100 rounded-lg p-4 h-14 max-w-md flex items-center text-gray-700 font-medium">
      adithyan.ks@example.com
    </div>
  </div>

  <!-- MOBILE SECTION -->
  <div class="bg-white rounded-xl shadow p-6 mb-8">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-xl font-bold text-gray-900">Mobile Number</h3>
      <button class="text-blue-600 font-semibold hover:text-blue-700">Edit</button>
    </div>
    <div class="bg-gray-100 rounded-lg p-4 h-14 max-w-md flex items-center text-gray-700 font-medium">
      +91 98765 43210
    </div>
  </div>

  <!-- PASSWORD SECTION -->
  <div class="bg-white rounded-xl shadow p-6 mb-8">
    <h3 class="text-xl font-bold text-gray-900 mb-4">Password</h3>
    <div class="flex items-center space-x-4">
      <div class="bg-gray-100 rounded-lg p-4 h-14 flex-1 max-w-md flex items-center">
        <span class="text-2xl tracking-widest">••••••••</span>
      </div>
      <button class="bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700 transition">
        CHANGE PASSWORD
      </button>
    </div>
  </div>

  <!-- ACTION BUTTONS -->
  <div class="flex items-center space-x-4 mt-6">
    <button class="bg-blue-600 text-white px-12 py-3 rounded-lg text-lg font-semibold hover:bg-blue-700 transition">
      Update
    </button>
    <button class="bg-gray-300 text-gray-800 px-12 py-3 rounded-lg text-lg font-semibold hover:bg-gray-400 transition">
      Reset
    </button>
  </div>

</main>

</div>  
    <%- include("../../views/partials/user/footer") %>
  </body>
  
</html>
