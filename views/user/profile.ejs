<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Account | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/user/css/profile.css">
</head>

<body class="bg-gray-50">
    <%- include("../../views/partials/user/header") %>

    <div class="max-w-[1440px] mx-auto flex flex-col lg:flex-row">
        
        <aside class="w-full lg:w-72 bg-white border-b lg:border-b-0 lg:border-r border-gray-200 sidebar-fixed">
            <div class="hidden lg:block p-8 border-b border-gray-100">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">Welcome back,</p>
                <h2 class="text-xl font-black text-gray-800 truncate"><%= user.name %></h2>
            </div>

            <nav class="flex flex-row lg:flex-col overflow-x-auto lg:overflow-x-visible no-scrollbar p-2 lg:p-0">
                <a href="/account" class="sidebar-link active flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm">
                    <i class="fas fa-user-circle text-lg"></i> Profile Details
                </a>
                <a href="/address" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm">
                    <i class="fas fa-map-marked-alt text-lg"></i> Addresses
                </a>
                <a href="/orders" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm">
                    <i class="fas fa-shopping-bag text-lg"></i> My Orders
                </a>
                <a href="/wallet" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm">
                    <i class="fas fa-wallet text-lg"></i> Wallet
                </a>
                <a href="/wishlist" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap lg:border-b border-gray-50 font-semibold text-sm">
                    <i class="fas fa-heart text-lg"></i> Wishlist
                </a>
                <a href="/logout" class="sidebar-link flex items-center gap-3 px-6 py-4 whitespace-nowrap font-semibold text-sm text-red-500 hover:bg-red-50">
                    <i class="fas fa-sign-out-alt text-lg"></i> Logout
                </a>
            </nav>
        </aside>

        <main class="flex-1 p-4 sm:p-8 lg:p-12 desktop-scroll-area no-scrollbar">
            
            <% if (message && status) { %>
                <div class="<%= status === 'success' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200' %> border p-4 rounded-2xl mb-8 flex items-center gap-3 animate-pulse">
                    <i class="fas <%= status === 'success' ? 'fa-check-circle' : 'fa-circle-exclamation' %>"></i>
                    <span class="text-sm font-bold uppercase tracking-tight"><%= message %></span>
                </div>
            <% } %>

            <section class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-10 mb-8 flex flex-col items-center text-center">
                <h2 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-8">Identity</h2>
                
                <div class="relative group">
                    <div class="w-32 h-32 sm:w-44 sm:h-44 rounded-full p-1 border-4 border-blue-500/20 group-hover:border-blue-500 transition-all duration-500">
                        <img id="profileImagePreview" src="<%= user.profileImage || '/images/default-avatar.png' %>" 
                             class="w-full h-full object-cover rounded-full shadow-inner" />
                    </div>

                    <div class="absolute inset-0 flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/20 rounded-full backdrop-blur-[2px]">
                        <button onclick="document.getElementById('profileImageInput').click()" class="bg-white text-blue-600 w-10 h-10 rounded-full flex items-center justify-center shadow-xl hover:scale-110 transition"><i class="fas fa-pencil"></i></button>
                        <button onclick="deleteProfileImage()" class="bg-white text-red-600 w-10 h-10 rounded-full flex items-center justify-center shadow-xl hover:scale-110 transition"><i class="fas fa-trash"></i></button>
                    </div>
                </div>

                <input type="file" id="profileImageInput" class="hidden" accept="image/*" />
                <p class="mt-6 text-gray-500 text-sm font-medium">Click image to change your profile photo</p>
            </section>

            <section class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-10 mb-8">
                <div class="flex items-center justify-between mb-10">
                    <h2 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em]">Basic Info</h2>
                    <button id="profileEditBtn" onclick="toggleProfileEdit()" 
                            class="bg-blue-600 text-white px-6 py-2 rounded-xl text-xs font-bold shadow-lg shadow-blue-200 hover:bg-blue-700 transition active:scale-95">
                        EDIT PROFILE
                    </button>
                </div>

                <% 
                    const nameParts = user.name.split(" ");
                    const firstName = nameParts[0];
                    const lastName = nameParts.slice(1).join(" ");
                %>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase ml-1">First Name</label>
                        <input id="firstName" type="text" value="<%= firstName %>" disabled 
                               class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 text-gray-700 font-bold focus:bg-white focus:border-blue-500 outline-none transition-all disabled:opacity-60" />
                    </div>
                    <div id="lastNameWrapper" class="<%= lastName ? '' : 'sm:block' %> space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase ml-1">Last Name</label>
                        <input id="lastName" type="text" value="<%= lastName %>" disabled 
                               class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 text-gray-700 font-bold focus:bg-white focus:border-blue-500 outline-none transition-all disabled:opacity-60" />
                    </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase ml-1">Phone Connection</label>
                        <div class="relative">
                            <i class="fas fa-phone absolute left-4 top-1/2 -translate-y-1/2 text-gray-300"></i>
                            <input id="phoneInput" type="text" value="<%= user.phone %>" disabled 
                                   class="w-full pl-12 pr-4 py-4 bg-gray-50 border-2 border-transparent rounded-2xl text-gray-700 font-bold focus:bg-white focus:border-blue-500 outline-none transition-all disabled:opacity-60" />
                        </div>
                    </div>
                </div>
            </section>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-10">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-xs font-black text-gray-400 uppercase tracking-widest">Email Address</h3>
                        <button onclick="openEmailModal()" class="text-blue-600 font-black text-[10px] uppercase hover:underline">Change</button>
                    </div>
                    <p class="text-gray-800 font-black truncate"><%= user.email %></p>
                    <p class="text-gray-400 text-xs mt-1">Verified primary email</p>
                </div>

                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-10">
                    <h3 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-6">Account Security</h3>
                    <button onclick="<%= user.password ? 'openChangePasswordModal()' : 'openSetPasswordModal()' %>" 
                            class="w-full py-4 rounded-2xl border-2 border-gray-100 font-black text-xs uppercase tracking-widest text-gray-700 hover:border-blue-500 hover:text-blue-600 transition">
                        <%= user.password ? 'Change Password' : 'Set Account Password' %>
                    </button>
                </div>
            </div>

            <section class="bg-indigo-900 rounded-[2.5rem] shadow-2xl p-8 sm:p-12 text-white relative overflow-hidden">
                <div class="relative z-10">
                    <h3 class="text-xs font-black uppercase tracking-[0.3em] text-indigo-300 mb-4">The Referral Program</h3>
                    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
                        <div>
                            <p class="text-3xl sm:text-4xl font-black mb-2 tracking-tighter"><%= user.referralCode %></p>
                            <p class="text-indigo-200 text-sm font-medium">Share your code and get ₹50 for every friend who joins.</p>
                        </div>
                        <button onclick="copyReferral()" class="w-full md:w-auto bg-white text-indigo-900 px-10 py-4 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-indigo-50 transition active:scale-95">
                            Copy Code
                        </button>
                    </div>
                </div>
                <div class="absolute -right-10 -top-10 w-40 h-40 bg-white/10 rounded-full"></div>
            </section>

        </main>
    </div>

      <!-- ================= EMAIL UPDATE MODAL ================= -->
        <div
          id="emailUpdateModal"
          class="fixed inset-0 bg-black bg-opacity-40 flex justify-center items-center hidden z-50"
        >
          <div class="bg-white w-[450px] p-6 rounded-xl shadow-lg">
            <!-- Header -->
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold">Update Email</h2>

              <button
                onclick="closeEmailModal()"
                class="text-gray-600 hover:text-gray-900"
              >
                <i class="fas fa-arrow-left text-xl"></i>
              </button>
            </div>

            <!-- EMAIL INPUT -->
            <label class="block font-medium text-gray-700 mb-1"
              >New Email</label
            >
            <input
              id="emailInputField"
              type="email"
              placeholder="Enter new email"
              class="w-full bg-gray-100 p-3 rounded-lg mb-3"
            />

            <!-- SEND OTP BTN -->
            <button
              id="sendOtpEmailBtn"
              onclick="sendOtpForEmailUpdate()"
              class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold mb-4"
            >
              Send OTP
            </button>

            <!-- OTP + VERIFY SECTION (hidden until OTP sent) -->
            <div id="emailOtpSection" class="hidden">
              <label class="block font-medium text-gray-700 mb-1"
                >Enter OTP</label
              >
              <input
                id="emailOtpInput"
                type="text"
                placeholder="OTP"
                class="w-full bg-gray-100 p-3 rounded-lg mb-4"
              />

              <button
                onclick="verifyEmailOtp()"
                class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold"
              >
                Verify & Update Email
              </button>
            </div>
          </div>
        </div>

        
        <!-- ================= SET PASSWORD MODAL ================= -->
        <div
          id="setPassModal"
          class="fixed inset-0 bg-black bg-opacity-40 flex justify-center items-center hidden z-50"
        >
          <div class="bg-white w-[450px] p-6 rounded-xl shadow-lg">
            <!-- HEADER + BACK BUTTON -->
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold">Set Password</h2>

              <button
                onclick="closeSetPasswordModal()"
                class="text-gray-600 hover:text-gray-900 transition"
                title="Back"
              >
                <i class="fas fa-arrow-left text-xl"></i>
              </button>
            </div>

            <label class="block font-medium text-gray-700">Email</label>
            <input
              id="setPassEmail"
              type="email"
              value="<%= user.email %>"
              disabled
              class="w-full bg-gray-100 p-3 rounded-lg mb-3"
            />

            <button
              id="sendOtpBtn"
              onclick="sendOtpForSetPassword()"
              class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold mb-4"
            >
              Send OTP
            </button>

            <div id="setPassOtpArea" class="hidden">
              <!-- (rest of your modal content remains same) -->

              <label class="block font-medium text-gray-700">OTP</label>
              <input
                id="setPassOtp"
                name="otp"
                type="text"
                class="w-full bg-gray-100 p-3 rounded-lg mb-3"
              />

              <!-- NEW PASSWORD -->
              <label class="block font-medium text-gray-700"
                >New Password</label
              >
              <div class="relative mb-3">
                <input
                  id="setNewPassword"
                  name="password"
                  type="password"
                  class="w-full bg-gray-100 p-3 rounded-lg"
                />
                <button
                  type="button"
                  onclick="toggleVisibility('setNewPassword', 'eyeNewPass')"
                  class="absolute right-3 top-3 text-gray-600 hover:text-gray-800"
                >
                  <i id="eyeNewPass" class="fas fa-eye"></i>
                </button>
              </div>

              <!-- CONFIRM PASSWORD -->
              <label class="block font-medium text-gray-700"
                >Confirm Password</label
              >
              <div class="relative mb-5">
                <input
                  id="setConfirmPassword"
                  name="confirmPassword"
                  type="password"
                  class="w-full bg-gray-100 p-3 rounded-lg"
                />
                <button
                  type="button"
                  onclick="toggleVisibility('setConfirmPassword', 'eyeConfirmPass')"
                  class="absolute right-3 top-3 text-gray-600 hover:text-gray-800"
                >
                  <i id="eyeConfirmPass" class="fas fa-eye"></i>
                </button>
              </div>

              <button
                onclick="submitSetPassword()"
                class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold"
              >
                Update Password
              </button>
            </div>
          </div>
        </div>

        <!-- ================= CHANGE PASSWORD MODAL ================= -->
        <div
          id="changePassModal"
          class="fixed inset-0 bg-black bg-opacity-40 flex justify-center items-center hidden z-50"
        >
          <div class="bg-white w-[450px] p-6 rounded-xl shadow-lg relative">
            <!-- HEADER -->
            <div class="flex items-center justify-center mb-6 relative">
              <!-- Back Button (Left Aligned) -->
              <button
                onclick="closeChangePasswordModal()"
                class="absolute left-0 text-gray-600 hover:text-gray-900 transition"
                title="Back"
              >
                <i class="fas fa-arrow-left text-xl"></i>
              </button>

              <!-- TITLE CENTERED -->
              <h2 class="text-xl font-bold">Change Password</h2>
            </div>

            <!-- CURRENT PASSWORD -->
            <label class="block font-medium text-gray-700"
              >Current Password</label
            >
            <div class="relative mb-2">
              <input
                id="currentPass"
                type="password"
                class="w-full bg-gray-100 p-3 rounded-lg"
              />
              <button
                type="button"
                onclick="toggleVisibility('currentPass', 'eyeCurrentPass')"
                class="absolute right-3 top-3 text-gray-600 hover:text-gray-800"
              >
                <i id="eyeCurrentPass" class="fas fa-eye"></i>
              </button>
            </div>

            <!-- FORGOT PASSWORD LINK -->
            <div class="mb-4">
              <a
                href="/forgot-password"
                class="text-blue-600 text-sm hover:underline"
              >
                Forgot password?
              </a>
            </div>

            <!-- NEW PASSWORD -->
            <label class="block font-medium text-gray-700">New Password</label>
            <div class="relative mb-3">
              <input
                id="newPass"
                type="password"
                class="w-full bg-gray-100 p-3 rounded-lg"
              />
              <button
                type="button"
                onclick="toggleVisibility('newPass', 'eyeNewPassChange')"
                class="absolute right-3 top-3 text-gray-600 hover:text-gray-800"
              >
                <i id="eyeNewPassChange" class="fas fa-eye"></i>
              </button>
            </div>

            <!-- CONFIRM PASSWORD -->
            <label class="block font-medium text-gray-700"
              >Confirm Password</label
            >
            <div class="relative mb-5">
              <input
                id="confirmPass"
                type="password"
                class="w-full bg-gray-100 p-3 rounded-lg"
              />
              <button
                type="button"
                onclick="toggleVisibility('confirmPass', 'eyeConfirmPassChange')"
                class="absolute right-3 top-3 text-gray-600 hover:text-gray-800"
              >
                <i id="eyeConfirmPassChange" class="fas fa-eye"></i>
              </button>
            </div>

            <!-- SUBMIT BUTTON -->
            <button
              id="updatePassBtn"
              onclick="submitChangePassword()"
              class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold"
            >
              Update Password
            </button>
          </div>
        </div>


    <div id="cropperModal" class="fixed inset-0 bg-black/90 backdrop-blur-md hidden flex flex-col justify-center items-center z-[200] p-4">
        <div class="bg-white rounded-[2rem] w-full max-w-2xl overflow-hidden shadow-2xl">
            <div class="p-6 border-b flex justify-between items-center bg-gray-50">
                <h2 class="font-black text-gray-800 uppercase text-sm tracking-widest">Adjust Photo</h2>
                <button onclick="cancelCrop()" class="text-gray-400 hover:text-black">✕</button>
            </div>
            <div class="p-4 bg-gray-100 flex justify-center items-center max-h-[60vh]">
                <img id="cropperImage" class="max-w-full" />
            </div>
            <div class="p-6 flex flex-col sm:flex-row gap-3">
                <button onclick="cancelCrop()" class="flex-1 py-4 rounded-2xl font-bold text-gray-500 bg-gray-50">Cancel</button>
                <button onclick="applyCrop()" class="flex-1 py-4 rounded-2xl font-black text-xs uppercase tracking-widest bg-blue-600 text-white shadow-lg shadow-blue-200">Save Image</button>
            </div>
        </div>
    </div>

    <form id="profileImageForm" action="/account/profile-image" method="POST" enctype="multipart/form-data" class="hidden">
        <input type="file" name="profileImage" id="hiddenProfileImageInput" />
    </form>

    <%- include("../../views/partials/user/footer") %>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

   <script src="/user/js/profile.js"></script>
</body>
</html>