<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.productName %> - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/drift-zoom/dist/drift-basic.min.css" />
    <script src="https://unpkg.com/drift-zoom/dist/Drift.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
   <link rel="stylesheet" href="/user/css/productsDetails.css">
</head>

<body class="bg-gray-50">
    <%- include("../../views/partials/user/header") %>

    <main class="max-w-7xl mx-auto px-4 py-4 lg:py-8">
        <%- include('../../views/partials/breadCrumb') %>
        
        <button onclick="goBack()" class="text-blue-600 font-bold text-sm flex items-center gap-2 mb-6">
            <i class="fas fa-arrow-left"></i> BACK
        </button>

        <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
            
            <div class="w-full lg:w-1/2 lg:sticky lg:top-28 h-max">
                <div class="flex flex-col-reverse md:flex-row gap-4">
                    
                    <div class="flex flex-row md:flex-col gap-3 overflow-x-auto md:overflow-y-auto no-scrollbar pb-2 md:pb-0">
                        <% product.productImage.forEach((img, index) => { %>
                        <img src="<%= img %>" 
                             class="w-16 h-20 sm:w-20 sm:h-28 object-cover rounded-lg cursor-pointer flex-shrink-0 transition-all <%= index === 0 ? 'thumbnail-active' : 'border border-gray-200' %>" 
                             onclick="changeMainImage('<%= img %>', event)" />
                        <% }); %>
                    </div>

                    <div class="flex-1 relative bg-white rounded-2xl border border-gray-100 p-4 sm:p-8 flex items-center justify-center">
                        <button class="wishlist-btn absolute top-4 right-4 bg-white/90 backdrop-blur shadow-md p-2.5 rounded-full z-20 active:scale-90 transition" data-product-id="<%= product._id %>">
                            <i class="<%= wishlistProducts?.includes(product._id.toString()) ? 'fa-solid fa-heart text-red-500' : 'fa-regular fa-heart text-gray-400' %> text-xl"></i>
                        </button>

                        <div class="relative w-full aspect-[3/4] max-h-[500px]">
                            <img id="mainImage" data-zoom="<%= product.productImage[0] %>" src="<%= product.productImage[0] %>" 
                                 class="w-full h-full object-contain rounded-lg drift-trigger" />
                            <div id="zoom-pane" class="hidden lg:block"></div>
                        </div>
                    </div>
                </div>

                <% const isOutOfStock = product.stock <= 0; %>
                <% const isUnlisted = isProductListed === false || isCategoryListed === false; %>
                <% const isDisabled = isOutOfStock || isUnlisted; %>

               <div class="grid grid-cols-2 gap-3 mt-6">
  <button
    onclick="addToCart(event, '<%= product._id %>')"
    <%= isDisabled ? "disabled" : "" %>
    class="col-span-2 py-4 rounded-xl font-bold transition shadow-lg flex items-center justify-center gap-2 buy-btn
           <%= isDisabled ? 'bg-gray-300 text-gray-500 cursor-not-allowed' : 'bg-white border-2 border-blue-600 text-blue-600 hover:bg-blue-50' %>">
    <i class="fa-solid fa-cart-shopping"></i>
    <span>ADD TO CART</span>
  </button>
</div>

            </div>

            <div class="w-full lg:w-1/2 space-y-8">
                <div class="bg-white p-6 lg:p-0 rounded-2xl lg:bg-transparent">
                    <h1 class="text-2xl lg:text-4xl font-black text-gray-900 leading-tight mb-2"><%= product.productName %></h1>
                    <p class="text-blue-600 font-bold text-lg mb-4">By <%= product.author %></p>

                    <div class="flex items-center gap-4 flex-wrap">
                        <% if (isOutOfStock) { %>
                            <span class="text-3xl font-black text-gray-400 line-through">₹<%= product.regularPrice %></span>
                            <span class="bg-red-100 text-red-600 px-4 py-1 rounded-full text-xs font-black uppercase">Out of Stock</span>
                        <% } else { %>
                            <% if (product.offerPrice < product.regularPrice) { %>
                                <span class="text-4xl font-black text-gray-900">₹<%= product.offerPrice %></span>
                                <span class="text-xl text-gray-400 line-through">₹<%= product.regularPrice %></span>
                                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-lg text-xs font-black"><%= product.bestDiscount %>% OFF</span>
                            <% } else { %>
                                <span class="text-4xl font-black text-gray-900">₹<%= product.regularPrice %></span>
                            <% } %>
                        <% } %>
                        <div class="rating-badge"><%= product.rating || "4.5" %>★</div>
                    </div>
                    
                    <% if (product.stock > 0 && product.stock < 10) { %>
                        <p class="text-orange-600 font-bold text-xs mt-3 uppercase tracking-wider italic">Only <%= product.stock %> items left!</p>
                    <% } %>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-gray-100">
                    <h3 class="font-black text-gray-900 uppercase tracking-widest text-xs mb-4">Product Details</h3>
                    <div class="grid grid-cols-2 gap-y-4 text-sm">
                        <div class="text-gray-400">Language</div><div class="font-bold text-gray-700"><%= product.language %></div>
                        <div class="text-gray-400">Publisher</div><div class="font-bold text-gray-700"><%= product.publisher %></div>
                        <div class="text-gray-400">ISBN</div><div class="font-bold text-gray-700"><%= product.isbnNumber %></div>
                        <div class="text-gray-400">Pages</div><div class="font-bold text-gray-700"><%= product.pages %></div>
                    </div>
                </div>

                <div class="prose prose-sm max-w-none text-gray-600">
                    <h3 class="text-gray-900 font-black uppercase tracking-widest text-xs">Synopsis</h3>
                    <p class="leading-relaxed"><%= product.description %></p>
                </div>
            </div>
        </div>

        <div class="mt-16 bg-white p-6 lg:p-10 rounded-3xl shadow-sm border border-gray-100">
            <h2 class="text-2xl font-black text-gray-900 mb-8">You might also like</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-8">
                <% (similarProducts || []).slice(0, 4).forEach(similar => { %>
                <div class="group cursor-pointer" onclick="location.href='/product/?id=<%= similar._id %>'">
                    <div class="aspect-[2/3] bg-gray-50 rounded-xl overflow-hidden mb-3 border border-gray-100 p-4 flex items-center justify-center">
                        <img src="<%= similar.productImage[0] %>" class="max-h-full max-w-full object-contain group-hover:scale-110 transition duration-500" />
                    </div>
                    <h4 class="font-bold text-gray-800 text-xs sm:text-sm line-clamp-1"><%= similar.productName %></h4>
                    <p class="text-blue-600 font-black text-sm mt-1">₹<%= similar.offerPrice || similar.regularPrice %></p>
                </div>
                <% }) %>
            </div>
        </div>
    </main>

    <%- include("../../views/partials/user/footer") %>
    <script src="/user/js/productsDetails.js"></script>
   
</body>
</html>