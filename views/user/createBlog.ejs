<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Create Blog</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    <style>
      /* CKEditor Styling */
      .cke {
        border-radius: 12px !important;
        border: 2px solid #e5e7eb !important;
      }

      .cke_top {
        background: #f9fafb !important;
        border-bottom: 1px solid #e5e7eb !important;
        padding: 10px !important;
      }

      .cke_button_icon {
        transform: scale(1.25);
      }

      .cke_contents {
        padding: 14px !important;
      }
    </style>
  </head>

  <body class="bg-blue-50 min-h-screen">
    <!-- ================= HEADER ================= -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <!-- Logo -->
          <div class="flex items-center space-x-2">
            <div class="w-14 h-14 rounded-full overflow-hidden">
              <a href="/">
                <img
                  src="/images/logo2.png"
                  class="w-full h-full object-cover"
                />
              </a>
            </div>
            <a href="/" class="text-xl font-bold text-gray-800"> ReadNest </a>
          </div>

          <!-- Right Menu -->
          <div class="flex items-center space-x-6">
            <button
              onclick="openBlog()"
              class="flex items-center space-x-2 px-4 py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50"
            >
              <i class="fas fa-bars text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700">BLOG</span>
            </button>

            <a href="/cart" class="flex items-center space-x-1">
              <i class="fas fa-shopping-cart text-xl text-gray-700"></i>
              <span class="text-sm text-gray-700">Cart</span>
            </a>

            <a href="/account" class="flex items-center space-x-2">
              <i class="fas fa-user-circle text-2xl text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700">Account</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ================= PAGE TOOLBAR ================= -->
    <section
  class="sticky top-[76px] z-40 bg-white border-b border-blue-100"
>

      <div
        class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between"
      >
        <!-- Back -->
        <button
          onclick="window.history.back()"
          class="flex items-center gap-2 text-blue-600 font-medium hover:text-blue-700"
        >
          <i class="fa-solid fa-arrow-left"></i>
          Back
        </button>

        <!-- Notification -->
        <button
            id="notificationBtn"
            class="relative w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center hover:bg-blue-100 transition"
          >
            <i class="fa-regular fa-bell text-blue-600"></i>

            <!-- Count -->
            <span
              id="notifCount"
              class="hidden absolute -top-1 -right-1 bg-red-600 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center"
            ></span>
          </button>
      </div>
    </section>

    <!-- ================= MAIN ================= -->
    <main class="max-w-4xl mx-auto mt-10 bg-white p-6 rounded-xl shadow">
      <h1 class="text-2xl font-bold text-center text-blue-700 mb-6">
        Create New Blog
      </h1>

      <form action="/blog/addBlog" method="POST" class="space-y-5">
        <input
          type="text"
          name="title"
          placeholder="Blog title"
          required
          class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-400"
        />

        <textarea id="editor" name="content"></textarea>

        <div class="flex justify-end">
          <button
            type="submit"
            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium"
          >
            Publish Blog
          </button>
        </div>
      </form>
    </main>
    <div
        id="notificationModal"
        class="hidden absolute right-6 top-[132px] z-50 w-96"
      >
        <div
          class="bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden"
        >
          <!-- Header -->
          <div class="flex justify-between items-center px-4 py-3 border-b">
            <button
              id="closeNotification"
              class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1"
            >
              <i class="fa-solid fa-arrow-left"></i>
              Back
            </button>

            <h3 class="font-semibold text-sm">Notifications</h3>

            <button
              id="markAllRead"
              class="text-xs text-blue-600 hover:underline"
            >
              ✓ Mark all
            </button>
          </div>

          <!-- List -->
          <div
            id="notificationList"
            class="max-h-80 overflow-y-auto divide-y"
          ></div>
        </div>
      </div>

    

    <!-- ================= SCRIPTS ================= -->
    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>

    <script>
      let activeEditor = null;

      /* ================= CKEDITOR ================= */
      CKEDITOR.plugins.add("customimage", {
        init(editor) {
          editor.addCommand("openImageUpload", {
            exec() {
              activeEditor = editor;
              openModal();
            },
          });

          editor.ui.addButton("CustomImage", {
            label: "Insert Image",
            command: "openImageUpload",
            toolbar: "insert",
            icon: "https://cdn-icons-png.flaticon.com/512/337/337940.png",
          });
        },
      });

      CKEDITOR.replace("editor", {
        height: 360,
        extraPlugins: "customimage",
        toolbar: [
          { name: "styles", items: ["Font", "FontSize"] },
          {
            name: "basicstyles",
            items: ["Bold", "Italic", "Underline", "Strike"],
          },
          { name: "colors", items: ["TextColor", "BGColor"] },
          { name: "paragraph", items: ["NumberedList", "BulletedList"] },
          { name: "links", items: ["Link", "Unlink"] },
          { name: "cleanup", items: ["RemoveFormat"] },
        ],
        removePlugins: "resize,elementspath",
      });

     
      const notifBtn = document.getElementById("notificationBtn");
      const notifModal = document.getElementById("notificationModal");

      notifBtn.onclick = async () => {
        notifModal.classList.toggle("hidden");

        if (notifModal.classList.contains("hidden")) return;

        const res = await fetch("/notifications");
        const notifications = await res.json();

        const list = document.getElementById("notificationList");
        list.innerHTML = "";

        if (notifications.length === 0) {
          list.innerHTML = `<p class="p-6 text-center text-gray-500 text-sm">No notifications</p>`;
          return;
        }

        notifications.forEach((n) => {
          list.innerHTML += `
      <div class="p-4 flex gap-3 ${n.isRead ? "bg-white" : "bg-blue-50"}">
        <i class="fa-solid ${
          n.type === "like"
            ? "fa-heart text-red-500"
            : "fa-comment text-blue-500"
        } mt-1"></i>

        <div class="text-sm">
          <p>
            <strong>${n.sender.name}</strong>
            ${n.type === "like" ? "liked" : "commented on"}
            <a href="/blogs/${
              n.blog._id
            }" class="text-blue-600 hover:underline">
              ${n.blog.title}
            </a>
          </p>

          <p class="text-xs text-gray-400">
            ${new Date(n.createdAt).toLocaleString()}
          </p>
        </div>
      </div>
    `;
        });
      };

      document.getElementById("closeNotification").onclick = () => {
        document.getElementById("notificationModal").classList.add("hidden");
      };

      document.getElementById("markAllRead").onclick = async () => {
        await fetch("/notifications/mark-all-read", { method: "POST" });

        document.getElementById(
          "notificationList"
        ).innerHTML = `<p class="p-6 text-center text-gray-500">All caught up 🎉</p>`;

        document.getElementById("notifCount").classList.add("hidden");
      };

      async function loadUnreadCount() {
        const res = await fetch("/notifications/unread-count");
        const data = await res.json();

        const badge = document.getElementById("notifCount");
        if (data.count > 0) {
          badge.textContent = data.count;
          badge.classList.remove("hidden");
        } else {
          badge.classList.add("hidden");
        }
      }

      loadUnreadCount();
      
    </script>
  </body>
</html>
