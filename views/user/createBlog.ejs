<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Create Blog</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    <style>
      /* CKEditor Styling */
      .cke {
        border-radius: 12px !important;
        border: 2px solid #e5e7eb !important;
      }

      .cke_top {
        background: #f9fafb !important;
        border-bottom: 1px solid #e5e7eb !important;
        padding: 10px !important;
      }

      .cke_button_icon {
        transform: scale(1.25);
      }

      .cke_contents {
        padding: 14px !important;
      }
    </style>
  </head>

  <body class="bg-blue-50 min-h-screen">
    <!-- ================= HEADER ================= -->
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <!-- Logo -->
          <div class="flex items-center space-x-2">
            <div class="w-14 h-14 rounded-full overflow-hidden">
              <a href="/">
                <img
                  src="/images/logo2.png"
                  class="w-full h-full object-cover"
                />
              </a>
            </div>
            <a href="/" class="text-xl font-bold text-gray-800"> ReadNest </a>
          </div>

          <!-- Right Menu -->
          <div class="flex items-center space-x-6">
            <button
              onclick="openBlog()"
              class="flex items-center space-x-2 px-4 py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50"
            >
              <i class="fas fa-bars text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700">BLOG</span>
            </button>

            <a href="/cart" class="flex items-center space-x-1">
              <i class="fas fa-shopping-cart text-xl text-gray-700"></i>
              <span class="text-sm text-gray-700">Cart</span>
            </a>

            <a href="/account" class="flex items-center space-x-2">
              <i class="fas fa-user-circle text-2xl text-gray-700"></i>
              <span class="text-sm font-medium text-gray-700">Account</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ================= PAGE TOOLBAR ================= -->
    <section
  class="sticky top-[76px] z-40 bg-white border-b border-blue-100"
>

      <div
        class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between"
      >
        <!-- Back -->
        <button
          onclick="window.history.back()"
          class="flex items-center gap-2 text-blue-600 font-medium hover:text-blue-700"
        >
          <i class="fa-solid fa-arrow-left"></i>
          Back
        </button>

        <!-- Notification -->
        <button
          class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center hover:bg-blue-100"
        >
          <i class="fa-regular fa-bell text-blue-600 text-lg"></i>
        </button>
      </div>
    </section>

    <!-- ================= MAIN ================= -->
    <main class="max-w-4xl mx-auto mt-10 bg-white p-6 rounded-xl shadow">
      <h1 class="text-2xl font-bold text-center text-blue-700 mb-6">
        Create New Blog
      </h1>

      <form action="/blog/addBlog" method="POST" class="space-y-5">
        <input
          type="text"
          name="title"
          placeholder="Blog title"
          required
          class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-400"
        />

        <textarea id="editor" name="content"></textarea>

        <div class="flex justify-end">
          <button
            type="submit"
            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium"
          >
            Publish Blog
          </button>
        </div>
      </form>
    </main>

    

    <!-- ================= SCRIPTS ================= -->
    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>

    <script>
      let activeEditor = null;

      /* ================= CKEDITOR ================= */
      CKEDITOR.plugins.add("customimage", {
        init(editor) {
          editor.addCommand("openImageUpload", {
            exec() {
              activeEditor = editor;
              openModal();
            },
          });

          editor.ui.addButton("CustomImage", {
            label: "Insert Image",
            command: "openImageUpload",
            toolbar: "insert",
            icon: "https://cdn-icons-png.flaticon.com/512/337/337940.png",
          });
        },
      });

      CKEDITOR.replace("editor", {
        height: 360,
        extraPlugins: "customimage",
        toolbar: [
          { name: "styles", items: ["Font", "FontSize"] },
          {
            name: "basicstyles",
            items: ["Bold", "Italic", "Underline", "Strike"],
          },
          { name: "colors", items: ["TextColor", "BGColor"] },
          { name: "paragraph", items: ["NumberedList", "BulletedList"] },
          { name: "links", items: ["Link", "Unlink"] },
          { name: "cleanup", items: ["RemoveFormat"] },
        ],
        removePlugins: "resize,elementspath",
      });

     

      
    </script>
  </body>
</html>
