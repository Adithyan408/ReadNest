<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Create Blog | ReadNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/user/css/createBlog.css">
   
</head>

<body class="bg-blue-50 min-h-screen">
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2 shrink-0">
                    <div class="w-10 h-10 lg:w-14 lg:h-14 rounded-full overflow-hidden">
                        <a href="/"><img src="/images/logo2.png" class="w-full h-full object-cover" /></a>
                    </div>
                    <a href="/" class="text-lg lg:text-xl font-bold text-gray-800">ReadNest</a>
                </div>

                <div class="flex items-center space-x-3 lg:space-x-6">
                    <button onclick="window.location.href='/blog'" class="flex items-center p-2 lg:px-4 lg:py-2 bg-white rounded-lg border border-gray-300">
                        <i class="fas fa-bars text-gray-700"></i>
                        <span class="hidden lg:inline text-sm font-medium ml-2">BLOG</span>
                    </button>
                    <a href="/cart" class="p-2"><i class="fas fa-shopping-cart text-xl text-gray-700"></i></a>
                    <a href="/account" class="p-2"><i class="fas fa-user-circle text-2xl text-gray-700"></i></a>
                </div>
            </div>
        </div>
    </header>

    <section class="sticky top-[64px] lg:top-[76px] z-40 bg-white border-b border-blue-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <button onclick="window.history.back()" class="flex items-center gap-2 text-blue-600 font-bold text-sm lg:text-base hover:text-blue-700">
                <i class="fa-solid fa-arrow-left"></i> Back
            </button>

            <button id="notificationBtn" class="relative w-9 h-9 lg:w-10 lg:h-10 rounded-full bg-gray-100 flex items-center justify-center hover:bg-blue-100 transition">
                <i class="fa-regular fa-bell text-blue-600"></i>
                <span id="notifCount" class="hidden absolute -top-1 -right-1 bg-red-600 text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-white"></span>
            </button>
        </div>
    </section>

    <main class="max-w-4xl mx-auto mt-6 lg:mt-10 px-4 mb-10">
        <div class="bg-white p-5 lg:p-8 rounded-2xl shadow-md border border-blue-100">
            <div class="mb-8 text-center">
                <h1 class="text-2xl lg:text-3xl font-extrabold text-blue-800">Create New Story</h1>
                <p class="text-gray-500 text-xs lg:text-sm mt-1">Share your literary thoughts with the ReadNest community</p>
            </div>

            <form action="/blog/addBlog" method="POST" class="space-y-6">
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Title</label>
                    <input
                        type="text"
                        name="title"
                        placeholder="Enter a catchy title..."
                        required
                        class="w-full px-4 py-4 border-2 border-gray-100 rounded-xl focus:border-blue-400 outline-none transition text-lg font-bold text-gray-800 placeholder:text-gray-300"
                    />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Story Content</label>
                    <textarea id="editor" name="content"></textarea>
                </div>

                <div class="flex justify-center lg:justify-end pt-4">
                    <button
                        type="submit"
                        class="w-full lg:w-auto bg-blue-600 hover:bg-blue-700 text-white px-10 py-4 rounded-xl font-black text-lg shadow-lg shadow-blue-100 transition transform active:scale-95"
                    >
                        Publish Story
                    </button>
                </div>
            </form>
        </div>
    </main>

    <div id="notificationModal" class="hidden fixed lg:absolute right-4 left-4 lg:left-auto lg:right-6 top-[120px] lg:top-[132px] z-50 w-auto lg:w-96">
        <div class="bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden">
            <div class="flex justify-between items-center px-4 py-3 border-b bg-gray-50">
                <button id="closeNotification" class="text-xs text-gray-500 font-bold flex items-center gap-1">
                    <i class="fa-solid fa-chevron-left text-[10px]"></i> Back
                </button>
                <h3 class="font-bold text-sm">Notifications</h3>
                <button id="markAllRead" class="text-xs text-blue-600 font-bold">Mark all read</button>
            </div>
            <div id="notificationList" class="max-h-80 overflow-y-auto divide-y divide-gray-50 no-scrollbar"></div>
        </div>
    </div>

    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>

   <script src="/user/js/createBlog.js"></script>
</body>
</html>