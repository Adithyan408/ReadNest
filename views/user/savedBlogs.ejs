<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogs | ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/user/css/savedBlogs.css">
</head>

<body class="bg-gray-100 min-h-screen">
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <div class="w-10 h-10 lg:w-14 lg:h-14 rounded-full overflow-hidden shrink-0">
                        <a href="/">
                            <img src="/images/logo2.png" class="w-full h-full object-cover" alt="ReadNest Logo" />
                        </a>
                    </div>
                    <a href="/" class="text-lg lg:text-xl font-bold text-gray-800 tracking-tight uppercase">ReadNest</a>
                </div>

                <div class="flex items-center space-x-3 lg:space-x-6">
                    <button onclick="window.location.href='/blog'" class="flex items-center space-x-2 px-3 lg:px-4 py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50 transition">
                        <i class="fas fa-bars text-gray-700"></i>
                        <span class="hidden sm:inline text-xs font-bold text-gray-700">BLOG</span>
                    </button>
                    <a href="/cart" class="p-2 relative"><i class="fas fa-shopping-cart text-xl text-gray-700"></i></a>
                    <a href="/account" class="flex items-center space-x-2 p-2">
                        <i class="fas fa-user-circle text-2xl text-gray-700"></i>
                        <span class="hidden md:inline text-xs font-bold text-gray-700 max-w-[100px] truncate"><%= user.name %></span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <section class="sticky top-[64px] lg:top-[76px] z-40 bg-white/95 backdrop-blur border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 lg:px-6 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2 sm:gap-3">
                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-feather-pointed text-blue-600 text-sm sm:text-base"></i>
                </div>
                <div>
                    <h2 class="text-sm sm:text-lg font-bold text-gray-800 leading-tight">Stories</h2>
                    <p class="hidden xs:block text-[10px] sm:text-xs text-gray-400 font-medium">Community Insights</p>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-4">
                <button onclick="window.location.href='/blog/addBlog'" class="flex items-center gap-2 px-4 sm:px-6 py-2 rounded-full bg-blue-600 text-white text-xs sm:text-sm font-bold hover:bg-blue-700 transition shadow-lg shadow-blue-100">
                    <i class="fa-solid fa-plus text-[10px]"></i>
                    <span>Publish</span>
                </button>

                <button id="notificationBtn" class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-gray-50 flex items-center justify-center hover:bg-blue-50 transition border border-gray-100">
                    <i class="fa-regular fa-bell text-blue-600 text-base sm:text-lg"></i>
                    <span id="notifCount" class="hidden absolute -top-1 -right-1 bg-red-600 text-white text-[9px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-white font-bold"></span>
                </button>
            </div>
        </div>
    </section>

    <div class="flex flex-col lg:flex-row max-w-7xl mx-auto min-h-screen">
        
        <div class="w-full lg:w-64 shrink-0">
            <%- include("../../views/partials/user/blogSidebar") %>
        </div>

        <main class="flex-1 px-4 py-6 lg:py-10 main-content-area no-scrollbar">
            <div class="max-w-3xl mx-auto">
                <% if (blogs.length === 0) { %>
                    <div class="text-center py-20 bg-white rounded-3xl border-2 border-dashed border-gray-200">
                        <i class="fa-solid fa-book-open-reader text-gray-200 text-6xl mb-4 block"></i>
                        <p class="text-gray-400 font-bold italic">The library is empty today...</p>
                    </div>
                <% } %>

                <% blogs.forEach(blog => { %>
                <div class="bg-white rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 p-6 lg:p-8 mb-6 group">
                    <a href="/blogs/<%= blog._id %>" class="block">
                        <h3 class="text-lg lg:text-2xl font-black text-gray-800 group-hover:text-blue-600 transition-colors leading-snug mb-3">
                            <%= blog.title %>
                        </h3>
                    </a>
                    
                    <div class="flex items-center gap-3 mb-5">
                        <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-xs uppercase">
                            <%= blog.author?.name ? blog.author.name.charAt(0) : '?' %>
                        </div>
                        <p class="text-xs lg:text-sm text-gray-400">
                            By <span class="font-bold text-gray-700"><%= blog.author?.name || "Unknown" %></span> 
                            <span class="mx-1">•</span> <%= new Date(blog.createdAt).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %>
                        </p>
                    </div>

                    <a href="/blogs/<%= blog._id %>" class="inline-flex items-center gap-2 text-blue-600 text-xs sm:text-sm font-black uppercase tracking-widest hover:gap-4 transition-all mb-8">
                        Dive Deeper <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </a>
                    
                    <div class="flex justify-between items-center border-t border-gray-50 pt-5">
                        <div class="flex gap-6 sm:gap-10">
                            <button onclick="toggleLike('<%= blog._id %>', this)" class="flex items-center gap-2.5 text-gray-500 hover:text-red-500 transition-all group/btn">
                                <i class="fa-heart <%= blog.userLiked ? 'fa-solid text-red-500 scale-110' : 'fa-regular' %> text-xl sm:text-lg transition-transform group-active/btn:scale-125"></i>
                                <span class="text-xs font-black count-span"><%= blog.likeCount %></span>
                            </button>

                            <a href="/blogs/<%= blog._id %>#comments" class="flex items-center gap-2.5 text-gray-500 hover:text-blue-600 transition-all">
                                <i class="fa-regular fa-comment text-xl sm:text-lg"></i>
                                <span class="text-xs font-black"><%= blog.commentCount %></span>
                            </a>
                        </div>

                        <div class="flex items-center gap-5">
                            <button onclick="toggleSave('<%= blog._id %>', this)" class="p-2 rounded-full hover:bg-gray-50 transition-colors" title="Bookmark">
                                <i class="fa-bookmark text-xl <%= blog.isSaved ? 'fa-solid text-blue-600' : 'fa-regular text-gray-400' %>"></i>
                            </button>

                            <button class="flex items-center gap-2 text-gray-400 hover:text-indigo-600 transition-colors py-2 px-3 rounded-xl border border-transparent hover:border-indigo-100">
                                <i class="fa-solid fa-share-nodes text-lg"></i>
                                <span class="hidden sm:inline text-[10px] font-black uppercase tracking-widest">Share</span>
                            </button>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </main>
    </div>

    <div id="notificationModal" class="hidden fixed lg:absolute right-4 left-4 lg:left-auto lg:right-6 top-[120px] lg:top-[132px] z-50 w-auto lg:w-96 animate-in fade-in zoom-in-95">
        <div class="bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden">
            <div class="flex justify-between items-center px-5 py-4 border-b bg-gray-50">
                <button id="closeNotification" class="text-[10px] font-black uppercase tracking-widest text-gray-400 hover:text-black flex items-center gap-1">
                    <i class="fa-solid fa-chevron-left text-[8px]"></i> Close
                </button>
                <h3 class="font-black text-xs uppercase tracking-[0.2em] text-gray-800">Alerts</h3>
                <button id="markAllRead" class="text-[10px] font-black text-blue-600 uppercase tracking-widest hover:underline">Clear All</button>
            </div>
            <div id="notificationList" class="max-h-80 lg:max-h-[450px] overflow-y-auto divide-y divide-gray-50 no-scrollbar"></div>
        </div>
    </div>

    <script src="/user/js/savedBlogs.js"></script>
</body>
</html>