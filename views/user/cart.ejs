<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
   <link rel="stylesheet" href="/user/css/cart.css">
</head>

<body class="bg-gray-50">
    <%- include("../../views/partials/user/header") %>

    <main class="max-w-7xl mx-auto px-4 py-6 lg:py-8">
        <%- include('../../views/partials/breadCrumb') %>

        <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
            <div class="flex-1">
                <div class="bg-white rounded-xl shadow-sm p-4 lg:p-6 mb-4">
                    <h1 class="text-xl lg:text-2xl font-bold mb-6 text-gray-800">Your Cart</h1>

                    <% if (!cart || cart.length === 0) { %>
                    <div class="text-center py-12">
                        <img src="https://cdn-icons-png.flaticon.com/512/2038/2038854.png" class="w-24 lg:w-32 mx-auto opacity-50 mb-6" />
                        <h2 class="text-lg lg:text-xl font-semibold text-gray-700">Your cart is empty</h2>
                        <a href="/" class="inline-block mt-6 bg-blue-600 text-white px-8 py-3 rounded-lg font-bold shadow-md hover:bg-blue-700 transition">
                            Continue Shopping
                        </a>
                    </div>
                    <% } else { %>

                    <div class="space-y-6">
                        <% cart.forEach(item => { %>
                        <div class="cart-item border-b border-gray-100 pb-6 last:border-0 last:pb-0">
                            <div class="flex flex-col sm:flex-row gap-4 lg:gap-6">
                                
                                <div class="flex sm:block gap-4">
                                    <div class="w-24 h-36 lg:w-32 lg:h-48 flex-shrink-0 bg-gray-50 rounded-lg overflow-hidden border border-gray-100">
                                        <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-contain p-2" />
                                    </div>
                                    <button onclick="removeItem('<%= item._id %>')" class="sm:hidden text-red-500 font-bold text-sm h-fit mt-2">
                                        <i class="fas fa-trash-can mr-1"></i> Remove
                                    </button>
                                </div>

                                <div class="flex-1 flex flex-col justify-between">
                                    <div>
                                        <div class="flex justify-between items-start">
                                            <h3 class="font-bold text-gray-900 lg:text-lg leading-tight"><%= item.name %></h3>
                                            <button onclick="removeItem('<%= item._id %>')" class="hidden sm:block text-gray-400 hover:text-red-600 transition">
                                                <i class="fas fa-trash-can"></i>
                                            </button>
                                        </div>
                                        
                                        <div class="flex items-center gap-3 mt-2">
                                            <span class="text-xl lg:text-2xl font-black text-gray-900">₹<%= item.price %></span>
                                            <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded text-[10px] lg:text-xs font-bold uppercase tracking-wider">
                                                <%= item.rating || 4.5 %> <i class="fas fa-star text-[8px]"></i>
                                            </span>
                                        </div>

                                        <div class="mt-3 space-y-1">
                                            <p class="text-[10px] lg:text-xs font-bold text-orange-600 uppercase tracking-tighter">Available Offers</p>
                                            <p class="text-[10px] lg:text-xs text-gray-500">Bank Offer — 5% cashback on Axis Bank Debit Card</p>
                                        </div>
                                    </div>

                                    <div class="mt-4 flex items-center justify-between">
                                        <div class="flex items-center border border-gray-300 rounded-lg bg-white overflow-hidden shadow-sm">
                                            <button class="px-3 lg:px-4 py-2 hover:bg-gray-50 active:bg-gray-100 text-gray-600" onclick="updateQuantity('<%= item._id %>', -1)">
                                                <i class="fas fa-minus text-xs"></i>
                                            </button>
                                            <input type="text" id="quantity-<%= item._id %>" value="<%= item.quantity %>" readonly 
                                                   class="w-10 lg:w-12 text-center text-sm lg:text-base font-bold text-gray-800 pointer-events-none" />
                                            <button class="px-3 lg:px-4 py-2 hover:bg-gray-50 active:bg-gray-100 text-gray-600" onclick="updateQuantity('<%= item._id %>', 1)">
                                                <i class="fas fa-plus text-xs"></i>
                                            </button>
                                        </div>
                                        <input type="hidden" id="stock-<%= item._id %>" value="<%= item.stock %>" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                </div>
            </div>

            <% if (cart && cart.length > 0) { %>
            <div class="w-full lg:w-96">
                <div class="bg-white rounded-xl shadow-sm p-6 lg:sticky lg:top-24 border border-gray-100">
                    <h2 class="text-lg font-bold text-gray-900 border-b border-gray-50 pb-4 mb-4">Order Summary</h2>

                    <div class="space-y-3 mb-6">
                        <div class="flex justify-between text-gray-600 text-sm">
                            <span>Price (<span id="total-items"><%= cart.length %></span> items)</span>
                            <span class="font-bold text-gray-900">₹<span id="subtotal">0</span></span>
                        </div>
                        
                        <div class="border-t border-gray-50 pt-3 flex justify-between items-center">
                            <span class="font-bold text-gray-900">Total Amount</span>
                            <span class="text-xl font-black text-blue-600">₹<span id="total">0</span></span>
                        </div>
                    </div>

                    <button onclick="proceedToCheckout()" class="w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg shadow-lg shadow-blue-200 hover:bg-blue-700 active:scale-[0.98] transition">
                        Proceed to Checkout
                    </button>
                </div>
            </div>
            <% } %>
        </div>
    </main>

    <%- include("../../views/partials/user/footer") %>

    <script type="application/json" id="cart-data"><%- JSON.stringify(cart) %></script>
    <script src="/user/js/cart.js"></script>
</body>
</html>