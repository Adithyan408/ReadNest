<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart - ReadNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap");
      * {
        font-family: "Poppins", sans-serif;
      }
    </style>
  </head>

  <body class="bg-gray-50">
    <!-- Header -->
    <%- include("../../views/partials/user/header") %>

    <main class="max-w-7xl mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <%- include('../../views/partials/breadcrumb') %>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- LEFT SECTION -->
        <div class="flex-1">
          <!-- Address -->
          <div
            class="bg-white rounded-lg shadow-sm p-6 mb-6 flex items-center justify-between"
          >
            <p class="text-gray-600 font-medium">From Saved Address</p>
            <div class="relative">
              <button
                onclick="toggleAddressDropdown()"
                class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-2 rounded font-semibold"
              >
                Change Address
              </button>

              <!-- Dropdown -->
              <div
                id="addressDropdown"
                class="hidden absolute mt-2 w-80 bg-white shadow-xl border rounded-lg z-50"
              >
                <div class="p-4 border-b">
                  <h3 class="font-semibold text-gray-800">
                    Select Delivery Address
                  </h3>
                </div>

                <!-- Address List -->
                <div class="max-h-60 overflow-y-auto px-3">
                  <% if (addresses.length > 0 && addresses[0].addresses.length >
                  0) { %> <% addresses[0].addresses.forEach((addr, index) => {
                  %>

                  <label
                    class="flex gap-3 p-3 border-b cursor-pointer hover:bg-gray-100"
                  >
                    <!-- Radio Button -->
                    <input type="radio" name="selectedAddress" value="<%=
                    addr._id %>" class="w-4 h-4 mt-1" <%= index === 0 ?
                    "checked" : "" %> />

                    <!-- Address Content -->
                    <div>
                      <p class="font-semibold">
                        <%= addr.addressLabel %> Address
                      </p>

                      <p class="text-sm text-gray-700">
                        <%= addr.houseName %>, <%= addr.phone %>
                      </p>

                      <p class="text-xs text-gray-500">
                        <%= addr.houseNumber %>, <%= addr.street %>, <%=
                        addr.district %> - <%= addr.pincode %>
                      </p>
                    </div>
                  </label>

                  <% }) %> <% } %>
                </div>

                <!-- Set Address Button -->
                <div class="p-3 border-t">
                  <button
                    onclick="confirmAddressSelection()"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-md font-semibold"
                  >
                    Set Address
                  </button>
                </div>

                <!-- Add New Address -->
                <div class="p-4">
                  <a
                    href="/add-address"
                    class="block text-blue-600 font-semibold hover:underline"
                  >
                    + Add New Address
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- CART BOX -->
          <div class="bg-white rounded-lg shadow-sm p-6 mb-4">
            <h1 class="text-2xl font-bold mb-4">Your Cart</h1>

            <% if (!cart || cart.length === 0) { %>

            <!-- EMPTY CART MESSAGE -->
            <div class="text-center py-10">
              <img
                src="https://cdn-icons-png.flaticon.com/512/2038/2038854.png"
                class="w-32 mx-auto opacity-70 mb-4"
              />
              <h2 class="text-xl font-semibold text-gray-700">
                Your cart is empty
              </h2>
              <p class="text-gray-500 mt-2">
                Add items to your cart to continue shopping.
              </p>

              <a
                href="/"
                class="inline-block mt-6 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold"
              >
                Continue Shopping
              </a>
            </div>

            <% } else { %>

            <!-- CART ITEMS -->
            <div class="space-y-4">
              <% cart.forEach(item => { %>

              <div class="bg-white rounded-lg shadow-sm p-6 mb-4 cart-item">
                <div class="flex gap-6">
                  <!-- Book Image -->
                  <div class="w-32 h-48 flex-shrink-0">
                    <img
                      src="<%= item.image %>"
                      alt="<%= item.name %>"
                      class="w-full h-full object-contain"
                    />
                  </div>

                  <!-- Book Details -->
                  <div class="flex-1">
                    <!-- Title -->
                    <h3 class="font-semibold text-gray-800 mb-2">
                      <%= item.name %>
                    </h3>

                    <!-- Price + Rating -->
                    <div class="flex items-center gap-2 mb-3">
                      <span class="text-2xl font-bold text-gray-800"
                        >₹ <%= item.price %></span
                      >

                      <!-- Rating tag -->
                      <span
                        class="bg-green-600 text-white px-2 py-0.5 rounded text-xs font-semibold"
                      >
                        <%= item.rating || 4.5 %> ★
                      </span>
                    </div>

                    <!-- Offers -->
                    <div class="mb-3">
                      <p class="text-sm font-semibold text-gray-700">
                        Available Offers
                      </p>
                      <p class="text-xs text-gray-600">
                        Bank Offer — 5% cashback on Axis Bank Debit Card up to
                        ₹750
                      </p>
                    </div>

                    <!-- Quantity Controls -->
                    <div
                      class="flex items-center gap-0 border-2 border-gray-300 rounded w-fit"
                    >
                      <button
                        class="quantity-btn px-4 py-2 text-xl font-bold text-gray-700 hover:bg-gray-100"
                        onclick="updateQuantity('<%= item._id %>', -1)"
                      >
                        -
                      </button>

                      <input
                        type="text"
                        id="quantity-<%= item._id %>"
                        value="<%= item.quantity %>"
                        readonly
                        class="w-12 text-center border-x-2 border-gray-300 py-2 font-semibold"
                      />

                      <button
                        class="quantity-btn px-4 py-2 text-xl font-bold text-gray-700 hover:bg-gray-100"
                        onclick="updateQuantity('<%= item._id %>', 1)"
                      >
                        +
                      </button>
                    </div>
                  </div>

                  <!-- Remove Button -->
                  <form
                    action="/remove-from-cart"
                    method="POST"
                    class="flex items-start"
                  >
                    <input
                      type="hidden"
                      name="productId"
                      value="<%= item._id %>"
                    />
                    <button
                      class="text-red-600 hover:text-red-800 font-medium ml-4 mt-1"
                    >
                      Remove
                    </button>
                  </form>
                </div>
              </div>

              <% }) %>
            </div>

            <% } %>
          </div>
        </div>

        <!-- RIGHT SECTION: Price Summary -->
        <% if (cart && cart.length > 0) { %>
        <div class="w-full lg:w-96">
          <div class="bg-white rounded-lg shadow-sm p-6 sticky top-24">
            <h2 class="text-xl font-bold text-gray-700 mb-6">Price Details</h2>

            <div class="space-y-4 mb-6">
              <div class="flex justify-between text-gray-700">
                <span
                  >Price (<span id="total-items"><%= cart.length %></span>
                  items)</span
                >
                <span>₹ <span id="subtotal">0</span></span>
              </div>

              <div class="flex justify-between text-gray-700">
                <span>Discount</span>
                <span>- ₹ <span id="discount">0</span></span>
              </div>
            </div>

            <div class="border-t pt-4 mb-6">
              <div class="flex justify-between text-lg font-bold text-gray-800">
                <span>Total</span>
                <span>₹ <span id="total">0</span></span>
              </div>
            </div>

            <button
              class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-bold text-lg"
            >
              Place Order
            </button>
          </div>
        </div>
        <% } %>
      </div>
    </main>

    <!-- Footer -->
    <%- include("../../views/partials/user/footer") %>
  </body>

  <!-- Inject cart as JSON -->
  <script type="application/json" id="cart-data">
    <%- JSON.stringify(cart) %>
  </script>

  <!-- WORKING JS -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const CART_ITEMS = JSON.parse(
        document.getElementById("cart-data").textContent
      );

      window.updateQuantity = function (productId, change) {
        const qtyField = document.getElementById("quantity-" + productId);
        let qty = parseInt(qtyField.value);

        qty += change;
        if (qty < 1) return;

        qtyField.value = qty;
        updateTotals();
      };

      function updateTotals() {
        let subtotal = 0;
        let totalItems = 0;

        CART_ITEMS.forEach((item) => {
          const qtyField = document.getElementById("quantity-" + item._id);
          if (!qtyField) return;

          const qty = parseInt(qtyField.value);
          subtotal += item.price * qty;
          totalItems += qty;
        });

        const discount = Math.floor(subtotal * 0.05);
        const total = subtotal - discount;

        document.getElementById("total-items").textContent = totalItems;
        document.getElementById("subtotal").textContent = subtotal;
        document.getElementById("discount").textContent = discount;
        document.getElementById("total").textContent = total;
      }

      updateTotals();
    });

    function toggleAddressDropdown() {
      const drop = document.getElementById("addressDropdown");
      drop.classList.toggle("hidden");
    }

    // When user selects an address
    function selectAddress(id) {
      fetch("/set-address", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ addressId: id }),
      })
        .then((res) => res.json())
        .then((data) => {
          if (data.success) {
            alert("Address Selected: " + data.message);
            location.reload();
          }
        });
    }
  </script>
</html>
