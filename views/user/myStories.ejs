<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blogs | ReadNest</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
   <link rel="stylesheet" href="/user/css/myStories.css"> 
   
  </head>

  <body class="bg-gray-100 min-h-screen">
    <header class="bg-gray-300 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="w-10 h-10 lg:w-14 lg:h-14 rounded-full overflow-hidden shrink-0">
              <a href="/">
                <img src="/images/logo2.png" class="w-full h-full object-cover" alt="Logo" />
              </a>
            </div>
            <a href="/" class="text-lg lg:text-xl font-bold text-gray-800 tracking-tight">ReadNest</a>
          </div>

          <div class="flex items-center space-x-3 lg:space-x-6">
            <button onclick="openBlog()" class="flex items-center space-x-2 px-3 lg:px-4 py-2 bg-white rounded-lg border border-gray-300 hover:bg-gray-50 transition">
              <i class="fas fa-bars text-gray-700"></i>
              <span class="hidden sm:inline text-sm font-medium text-gray-700">BLOG</span>
            </button>

            <a href="/cart" class="flex items-center space-x-1 p-2">
              <i class="fas fa-shopping-cart text-xl text-gray-700"></i>
              <span class="hidden md:inline text-sm text-gray-700">Cart</span>
            </a>

            <a href="/account" class="flex items-center space-x-2 p-2">
              <i class="fas fa-user-circle text-2xl text-gray-700"></i>
              <span class="hidden md:inline text-sm font-medium text-gray-700"><%= user.name %></span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <section class="sticky top-[64px] lg:top-[76px] z-40 bg-white/90 backdrop-blur border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 lg:px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
            <i class="fa-solid fa-book-open text-blue-600 text-sm sm:text-base"></i>
          </div>
          <div>
            <h2 class="text-sm sm:text-lg font-semibold text-gray-800 leading-tight">Blogs</h2>
            <p class="hidden xs:block text-[10px] sm:text-xs text-gray-500">Read & share thoughts</p>
          </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-4">
          <button onclick="window.location.href='/blog/addBlog'" class="flex items-center gap-2 px-4 sm:px-5 py-2 rounded-full bg-blue-600 text-white text-xs sm:text-sm font-medium hover:bg-blue-700 transition shadow-md">
            <i class="fa-solid fa-pen"></i>
            <span>Publish</span>
          </button>

          <button id="notificationBtn" class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-gray-100 flex items-center justify-center hover:bg-blue-100 transition">
            <i class="fa-regular fa-bell text-blue-600 text-base sm:text-lg"></i>
            <span id="notifCount" class="hidden absolute -top-1 -right-1 bg-red-600 text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-white"></span>
          </button>
        </div>
      </div>
    </section>

    <div class="flex flex-col lg:flex-row max-w-7xl mx-auto">
        <%- include("../../views/partials/user/blogSidebar") %>
        
        <main class="flex-1 px-4 py-6 lg:py-10">
          <div class="max-w-3xl mx-auto space-y-6">
            <% if (blogs.length === 0) { %>
                <div class="text-center py-20 bg-white rounded-2xl border border-dashed border-gray-300">
                    <i class="fa-solid fa-feather-pointed text-gray-300 text-5xl mb-4 block"></i>
                    <p class="text-gray-500 text-sm italic">No blogs published yet</p>
                </div>
            <% } %> 

            <% blogs.forEach(blog => { %>
              <div class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow p-5 lg:p-8 mb-6">
                <div class="flex items-start justify-between gap-4 mb-2">
                  <a href="/blogs/<%= blog._id %>" class="group">
                    <h3 class="text-lg lg:text-xl font-bold text-gray-900 group-hover:text-blue-700 transition-colors leading-snug">
                      <%= blog.title %>
                    </h3>
                  </a>
                  
                  <span class="shrink-0 text-[10px] px-2.5 py-1 rounded-full font-bold uppercase tracking-wider <%= blog.isBlocked ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>">
                    <%= blog.isBlocked ? 'Blocked' : 'Published' %>
                  </span>
                </div>
              
                <p class="text-xs lg:text-sm text-gray-500 mb-4 italic">
                  By <span class="font-bold text-gray-700"><%= blog.author?.name || "Unknown" %></span> 
                  <span class="mx-1">•</span> <%= new Date(blog.createdAt).toDateString() %>
                </p>

                <a href="/blogs/<%= blog._id %>" class="inline-flex items-center gap-1 text-blue-600 text-xs sm:text-sm font-bold hover:underline mb-6">
                  Read full story <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
              
                <div class="flex justify-between items-center border-t border-gray-100 pt-4">
                  <div class="flex gap-5 sm:gap-8">
                    <button onclick="toggleLike('<%= blog._id %>')" class="flex items-center gap-2 text-gray-600 hover:text-red-500 transition-colors">
                      <i class="fa-heart <%= blog.userLiked ? 'fa-solid text-red-500' : 'fa-regular' %> text-lg sm:text-base"></i>
                      <span class="text-xs font-bold"><%= blog.likeCount %></span>
                    </button>

                    <a href="/blogs/<%= blog._id %>#comments" class="flex items-center gap-2 text-gray-600 hover:text-blue-600 transition-colors">
                      <i class="fa-regular fa-comment text-lg sm:text-base"></i>
                      <span class="text-xs font-bold text-gray-600"><%= blog.commentCount %></span>
                    </a>
                  </div>

                  <div class="flex items-center gap-4 sm:gap-6">
                    <button onclick="toggleSave('<%= blog._id %>')" class="p-1 hover:scale-110 transition-transform" title="Save Story">
                      <i class="fa-bookmark text-lg <%= blog.isSaved ? 'fa-solid text-blue-600' : 'fa-regular text-gray-400 hover:text-black' %>"></i>
                    </button>

                    <button class="flex items-center gap-1.5 text-gray-500 text-xs font-bold hover:text-indigo-600 transition-colors">
                      <i class="fa-solid fa-share-nodes text-base sm:text-sm"></i>
                      <span class="hidden sm:inline">Share</span>
                    </button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </main>
    </div>

    <div id="notificationModal" class="hidden fixed lg:absolute right-4 left-4 lg:left-auto lg:right-6 top-[120px] lg:top-[132px] z-50 w-auto lg:w-96">
      <div class="bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden">
        <div class="flex justify-between items-center px-4 py-3 border-b bg-gray-50">
          <button id="closeNotification" class="text-xs text-gray-500 font-bold flex items-center gap-1 hover:text-black">
            <i class="fa-solid fa-chevron-left text-[10px]"></i> Close
          </button>
          <h3 class="font-bold text-xs uppercase tracking-wider text-gray-400">Activity</h3>
          <button id="markAllRead" class="text-xs text-blue-600 font-bold hover:underline">Clear All</button>
        </div>
        <div id="notificationList" class="max-h-80 lg:max-h-96 overflow-y-auto divide-y divide-gray-50 no-scrollbar"></div>
      </div>
    </div>

   <script src="/user/js/myStories.js"></script>
  </body>
</html>